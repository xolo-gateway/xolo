XOLO_SECRET_KEY="" # Generate it with "openssl rand -hex 32"

XOLO_LOGGER_LEVEL=-4
XOLO_LOGGER_DEBUG=true

XOLO_HTTP_SESSION_KEYS=abcdefghijklmnopqrstuvwxyz000002
XOLO_HTTP_BASE_URL=http://localhost:3002

XOLO_HTTP_AUTHN_DEFAULT_ADMINS="<your_email>"

# What happens when someone authenticates against a configured identity
# provider but Xolo does not know them yet. The two flags combine:
#
#   AUTO_CREATE_USERS=true  ACTIVE_BY_DEFAULT=true   account created, usable right away
#   AUTO_CREATE_USERS=true  ACTIVE_BY_DEFAULT=false  account created but inactive,
#                                                    waiting for an administrator
#   AUTO_CREATE_USERS=false                          sign-in refused unless the identity
#                                                    was provisioned beforehand
#
# The addresses listed in DEFAULT_ADMINS are always created, even with
# AUTO_CREATE_USERS=false: it is the only way to bootstrap a fresh instance.
# An address holding a pending organization invitation is the other exception:
# the invitation stands for pre-provisioning, so the account is created on
# first sign-in even with AUTO_CREATE_USERS=false. Its activation still follows
# ACTIVE_BY_DEFAULT — and an inactive invitee can accept the invitation anyway,
# /join/{token} being the one route that does not require an active account.
# XOLO_HTTP_AUTHN_AUTO_CREATE_USERS=true
# XOLO_HTTP_AUTHN_ACTIVE_BY_DEFAULT=false

XOLO_HTTP_AUTHN_PROVIDERS_GITEA_KEY=
XOLO_HTTP_AUTHN_PROVIDERS_GITEA_SECRET=
XOLO_HTTP_AUTHN_PROVIDERS_GITEA_LABEL="My Gitea Identity Provider"
XOLO_HTTP_AUTHN_PROVIDERS_GITEA_AUTH_URL=https://gitea-server/login/oauth/authorize
XOLO_HTTP_AUTHN_PROVIDERS_GITEA_TOKEN_URL=https://gitea-server/login/oauth/access_token
XOLO_HTTP_AUTHN_PROVIDERS_GITEA_PROFILE_URL=https://gitea-server/login/oauth/userinfo
XOLO_HTTP_AUTHN_PROVIDERS_GITEA_SCOPES=openid,email

XOLO_HTTP_AUTHN_PROVIDERS_GOOGLE_KEY=
XOLO_HTTP_AUTHN_PROVIDERS_GOOGLE_SECRET=

XOLO_HTTP_AUTHN_PROVIDERS_GITHUB_KEY=
XOLO_HTTP_AUTHN_PROVIDERS_GITHUB_SECRET=
XOLO_HTTP_AUTHN_PROVIDERS_GITHUB_SCOPES=openid,user

# Multiple named OIDC providers (login + API opaque-token validation).
# List their IDs, then configure each under _<ID>_ (ID upper-cased).
# XOLO_HTTP_AUTHN_OIDC_PROVIDERS=auth0,keycloak
# XOLO_HTTP_AUTHN_OIDC_PROVIDER_AUTH0_DISCOVERY_URL=https://tenant.eu.auth0.com/.well-known/openid-configuration
# XOLO_HTTP_AUTHN_OIDC_PROVIDER_AUTH0_KEY=
# XOLO_HTTP_AUTHN_OIDC_PROVIDER_AUTH0_SECRET=
# XOLO_HTTP_AUTHN_OIDC_PROVIDER_AUTH0_LABEL="Auth0"
# XOLO_HTTP_AUTHN_OIDC_PROVIDER_AUTH0_ICON=log-in
# XOLO_HTTP_AUTHN_OIDC_PROVIDER_AUTH0_SCOPES=openid,profile,email
# Enforced only on the introspection path (ignored when validated via userinfo):
# XOLO_HTTP_AUTHN_OIDC_PROVIDER_AUTH0_REQUIRED_AUDIENCE=<api-identifier>
# XOLO_HTTP_AUTHN_OIDC_PROVIDER_AUTH0_REQUIRED_SCOPE=

# Validate incoming opaque OAuth2 access tokens on the API (introspection when
# the provider exposes it, otherwise the OIDC userinfo endpoint).
# XOLO_HTTP_AUTHN_OAUTH2TOKEN_ENABLED=true
# XOLO_HTTP_AUTHN_OAUTH2TOKEN_CACHE_TTL=60s
# XOLO_HTTP_AUTHN_OAUTH2TOKEN_CACHE_SIZE=1024

XOLO_PLUGINS_DIR=bin/plugins

# Provisionning API (machine-to-machine instance administration).
# Served on its own listener and authenticated with mutual TLS only: no OIDC,
# no session, no user token. Disabled by default. See internal/provisionning/README.md.
# XOLO_PROVISIONNING_API_ENABLED=true
# XOLO_PROVISIONNING_API_ADDRESS=:3003
# XOLO_PROVISIONNING_API_TLS_CERT_FILE=dev-pki/server.crt
# XOLO_PROVISIONNING_API_TLS_KEY_FILE=dev-pki/server.key
# XOLO_PROVISIONNING_API_TLS_CLIENT_CA_FILE=dev-pki/ca.crt
# XOLO_PROVISIONNING_API_SHUTDOWN_TIMEOUT=10s

# Multi-tenancy. Disabled by default: the instance owns a single tenant, created
# by the schema migration and never surfaced to its users — no subdomain, no
# change of URL. Once enabled, the tenant is read from the request host and a
# host matching no tenant answers 404.
#
# XOLO_HTTP_BASE_URL must then be absolute (scheme and host) — the server
# refuses to start otherwise. It stops being the URL of the instance and becomes
# the template each tenant derives its own from: scheme and path are kept, the
# host is replaced by the one the request came in on, so links, redirects and
# OAuth callbacks all stay on the tenant's host. The callback URL to declare at
# the identity provider therefore varies per tenant:
#
#   https://{tenant}.xolo.example.com/auth/oidc/providers/{provider}/callback
#
# A provider accepting a wildcard redirect_uri (Keycloak, Authentik…) covers
# every tenant at once; a GitHub OAuth App takes a single callback URL and
# Google only exact URIs, so both need one declaration per subdomain.
# XOLO_MULTITENANCY_ENABLED=true
# XOLO_MULTITENANCY_HOST_PATTERN={tenant}.xolo.example.com
# XOLO_MULTITENANCY_DEFAULT_TENANT_SLUG=default
