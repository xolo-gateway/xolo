          "pluginName": "script-processor",
          "config": {
            "script": "export func(ctx) {\n    inputs := ctx.inputs\n    if inputs[\"has_vision\"] {\n        return { outputs: { model_name: inputs[\"model_vision\"] } }\n    } else if inputs[\"has_reasoning\"] {\n        return { outputs: { model_name: inputs[\"model_reasoning\"] } }\n    } else if inputs[\"power_level\"] > 0.75 {\n        return { outputs: { model_name: inputs[\"model_puissant\"] } }\n    } else if inputs[\"power_level\"] > 0.35 {\n        return { outputs: { model_name: inputs[\"model_moyen\"] } }\n    }\n    return { outputs: { model_name: inputs[\"model_leger\"] } }\n}",
