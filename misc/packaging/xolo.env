# Configuration of the xolo service, read by systemd: one VARIABLE=value per
# line, no "export", no shell expansion. Restart the service after a change:
#
#   systemctl restart xolo
#
# The whole list of variables is in the documentation:
# https://xolo-gateway.org/latest/administration/installation/configuration/
#
# XOLO_SECRET_KEY and XOLO_HTTP_SESSION_KEYS are generated on the first
# installation in /etc/xolo/secret.env. Keep that file in your backups: without
# XOLO_SECRET_KEY the provider API keys stored in the database cannot be read.

# Listening address of the public HTTP server.
#XOLO_HTTP_ADDRESS=:3002

# Public URL of the instance, as its users reach it.
XOLO_HTTP_BASE_URL=http://localhost:3002

# E-mail addresses made administrators on their first sign-in (comma-separated).
XOLO_HTTP_AUTHN_DEFAULT_ADMINS=

# Database. SQLite under /var/lib/xolo by default; a postgres:// DSN otherwise.
#XOLO_STORAGE_DATABASE_DSN=/var/lib/xolo/data.sqlite

# One identity provider at least is needed to sign in. Generic OpenID Connect:
#XOLO_HTTP_AUTHN_OIDC_PROVIDERS=sso
#XOLO_HTTP_AUTHN_OIDC_PROVIDER_SSO_DISCOVERY_URL=https://sso.example.com/.well-known/openid-configuration
#XOLO_HTTP_AUTHN_OIDC_PROVIDER_SSO_KEY=
#XOLO_HTTP_AUTHN_OIDC_PROVIDER_SSO_SECRET=
#XOLO_HTTP_AUTHN_OIDC_PROVIDER_SSO_LABEL=SSO
