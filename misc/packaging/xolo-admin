#!/bin/sh
# Runs xolo-migrate or xolo-adoption against the database of the xolo service,
# with the environment of the service and under its account:
#
#   sudo xolo-admin migrate diagnose
#   sudo xolo-admin adoption export -out /var/lib/xolo/inventory.json
#
# Those commands read their configuration from the environment only. A command
# run as root would leave SQLite files owned by root that the service cannot
# open, hence the xolo account; the files they write must be writable by it.
set -eu

usage="usage: xolo-admin migrate|adoption ARGUMENTS..."

[ "$#" -ge 1 ] || { echo "$usage" >&2; exit 2; }
case "$1" in
    migrate | adoption) command=/usr/bin/xolo-$1 ;;
    -h | --help) echo "$usage"; exit 0 ;;
    *) echo "$usage" >&2; exit 2 ;;
esac
shift

if [ "$(id -u)" -ne 0 ]; then
    echo "xolo-admin: run it as root, it reads /etc/xolo/secret.env" >&2
    exit 1
fi

# Same defaults as misc/packaging/xolo.service; the files below win.
XOLO_STORAGE_DATABASE_DSN=/var/lib/xolo/data.sqlite
export XOLO_STORAGE_DATABASE_DSN

# The subset of the systemd environment file syntax these files use: one
# VARIABLE=value per line, comments, optional quotes around the value.
load() {
    [ -r "$1" ] || return 0
    while IFS= read -r line || [ -n "$line" ]; do
        case "$line" in
            '' | '#'* | ';'*) continue ;;
        esac
        name=${line%%=*}
        value=${line#*=}
        case "$name" in
            '' | *[!A-Za-z0-9_]* | [0-9]*)
                echo "xolo-admin: $1: ignoring the line for ${name:-?}" >&2
                continue
                ;;
        esac
        case "$value" in
            \"*\") value=${value#\"}; value=${value%\"} ;;
            \'*\') value=${value#\'}; value=${value%\'} ;;
        esac
        export "$name=$value"
    done <"$1"
}

load /etc/xolo/xolo.env
load /etc/xolo/secret.env

exec runuser -u xolo -- "$command" "$@"
