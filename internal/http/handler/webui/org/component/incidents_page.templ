package component

import (
	"strconv"

	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/i18n"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/collapsible"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
)

templ IncidentsPage(vmodel IncidentsPageVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(i18n.T(ctx, "org.events.incidents.page_title", vmodel.Org.Name()))) {
		<div>
			@common.PageHeader(common.PageHeaderProps{
				Title:    i18n.T(ctx, "org.nav.incidents"),
				Subtitle: i18n.T(ctx, "org.events.incidents.subtitle"),
			})
			<div class="mb-3.5">
				@EventsTabs(vmodel.Org, "incidents", vmodel.View)
			</div>
			if len(vmodel.Incidents) == 0 {
				@common.EmptyState(common.EmptyStateProps{
					Icon:        icon.CircleCheck,
					Title:       i18n.T(ctx, "org.events.incidents.empty_title"),
					Description: i18n.T(ctx, "org.events.incidents.empty_description"),
				})
			} else {
				<div class="space-y-2.5">
					for _, view := range vmodel.Incidents {
						@incidentCard(view)
					}
				</div>
			}
		</div>
	}
}

// incidentCard renders one incident as the left-ruled card of the mockup: the
// rule carries the state, so an open incident is spotted without reading.
templ incidentCard(view IncidentView) {
	@common.Section(common.SectionProps{Class: incidentRuleClass(view.Incident.Status())}) {
		@common.SectionBody(common.SectionBodyProps{Class: "space-y-2.5"}) {
			<div class="flex flex-wrap items-start gap-3">
				<div class="min-w-0 space-y-1">
					<div class="text-sm font-semibold">
						if view.Alert != nil {
							{ view.Alert.Name() }
						} else {
							<span class="text-muted-foreground">{ i18n.T(ctx, "org.events.incidents.alert_deleted") }</span>
						}
					</div>
					<div class="text-xs text-muted-foreground">
						{ i18n.T(ctx, "org.events.incidents.started_at", formatEventTime(view.Incident.StartedAt())) }
						if view.Incident.ResolvedAt() != nil {
							{ " " }{ i18n.T(ctx, "org.events.incidents.resolved_at", formatOptionalTime(view.Incident.ResolvedAt())) }
						}
					</div>
				</div>
				<div class="ml-auto flex shrink-0 items-center gap-2">
					<span class="tnum text-xs text-muted-foreground">
						{ i18n.T(ctx, "org.events.incidents.peak", strconv.FormatFloat(view.Incident.PeakValue(), 'f', -1, 64)) }
					</span>
					if view.Incident.Status() == "firing" {
						@common.Badge(common.ToneNegative, "firing")
						<!-- TODO(rework-ux): la maquette propose d'acquitter un
						incident. Le modèle d'incident ne porte ni acquittement ni
						auteur d'acquittement, et aucune route ne l'expose
						(cf. lot 7 du plan). -->
						@button.Button(button.Props{
							Variant:  button.VariantOutline,
							Size:     button.SizeSm,
							Disabled: true,
							Attributes: templ.Attributes{
								"title": i18n.T(ctx, "org.events.incidents.coming_soon"),
							},
						}) {
							{ i18n.T(ctx, "org.events.incidents.acknowledge") }
						}
					} else {
						@common.Badge(common.TonePositive, "resolved")
					}
				</div>
			</div>
			if len(view.Events) > 0 {
				@collapsible.Collapsible(collapsible.Props{Class: "text-sm"}) {
					@collapsible.Trigger(collapsible.TriggerProps{Class: "cursor-pointer text-xs text-muted-foreground"}) {
						{ i18n.T(ctx, "org.events.incidents.pinned_events", len(view.Events)) }
					}
					@collapsible.Content(collapsible.ContentProps{Class: "mt-2 space-y-1"}) {
						for _, e := range view.Events {
							<div class="flex items-center gap-2 text-xs">
								<span class="whitespace-nowrap font-mono text-muted-foreground">{ formatEventTime(e.CreatedAt()) }</span>
								<span class="font-mono">{ e.Type() }</span>
								<span class="min-w-0 truncate">{ e.Message() }</span>
							</div>
						}
					}
				}
			}
		}
	}
}

// incidentRuleClass returns the coloured left rule of an incident card.
func incidentRuleClass(status string) string {
	if status == "firing" {
		return "border-l-3 border-l-destructive"
	}
	return "border-l-3 border-l-success"
}
