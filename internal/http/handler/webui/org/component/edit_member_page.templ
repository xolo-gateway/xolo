package component

import (
	"github.com/xolo-gateway/xolo/internal/core/model"
	"github.com/xolo-gateway/xolo/internal/core/rbac"
	commonComp "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/card"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/checkbox"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/form"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/label"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

type EditMemberPageVModel struct {
	AppLayoutVModel commonComp.AppLayoutVModel
	Membership      model.Membership
	Org             model.Organization
	OrgRoles        []model.Role
	AssignedRoleIDs map[model.RoleID]bool
}

templ EditMemberPage(vmodel EditMemberPageVModel) {
	@commonComp.AppLayout(vmodel.AppLayoutVModel,
		commonComp.WithTitle(i18n.T(ctx, "org.members.edit_page.title")),
	) {
		{{ readonly := !commonComp.HasPermission(ctx, vmodel.Org.ID(), rbac.PermMembersWrite) }}
		<div class="space-y-6">
			<!-- Header with back button and title -->
			<div class="flex items-center justify-between">
				<div class="flex items-center gap-4">
					@button.Button(button.Props{
						Variant:    button.VariantOutline,
						Size:       button.SizeIcon,
						Href:       commonComp.BaseURLString(ctx, commonComp.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/members")),
						Attributes: templ.Attributes{"title": i18n.T(ctx, "org.members.edit_page.back")},
					}) {
						@icon.ArrowLeft(icon.Props{Class: "h-4 w-4"})
					}
					@commonComp.PageHeader(commonComp.PageHeaderProps{
						Title: i18n.T(ctx, "org.members.edit_page.title"),
					})
				</div>
			</div>
			<!-- Member Info (read-only) -->
			@card.Card() {
				@card.Header() {
					@card.Title() {
						@icon.User(icon.Props{Class: "h-4 w-4 inline mr-2"})
						{ i18n.T(ctx, "org.members.edit_page.info") }
					}
				}
				@card.Content(card.ContentProps{Class: "space-y-4"}) {
					<div class="space-y-2">
						@form.Label() {
							{ i18n.T(ctx, "org.members.edit_page.display_name") }
						}
						<div class="p-3 rounded-md border bg-muted/50">{ vmodel.Membership.User().DisplayName() }</div>
					</div>
					<div class="space-y-2">
						@form.Label() {
							{ i18n.T(ctx, "org.members.edit_page.email") }
						}
						<div class="p-3 rounded-md border bg-muted/50">{ vmodel.Membership.User().Email() }</div>
					</div>
					<div class="space-y-2">
						@form.Label() {
							{ i18n.T(ctx, "org.members.edit_page.member_since") }
						}
						<div class="p-3 rounded-md border bg-muted/50">{ vmodel.Membership.CreatedAt().Format("02/01/2006") }</div>
					</div>
				}
			}
			<!-- Edit Roles -->
			@card.Card() {
				@card.Header() {
					@card.Title() {
						@icon.Shield(icon.Props{Class: "h-4 w-4 inline mr-2"})
						{ i18n.T(ctx, "org.members.edit_page.roles") }
					}
					<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "org.members.edit_page.roles_help") }</p>
				}
				@card.Content() {
					<form method="POST" action={ commonComp.BaseURL(ctx, commonComp.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/members/", string(vmodel.Membership.ID()), "/edit")) }>
						<div class="space-y-4">
							<div class="space-y-3">
								for _, role := range vmodel.OrgRoles {
									<div class="flex items-start gap-3">
										@checkbox.Checkbox(checkbox.Props{
											ID:       "role-" + string(role.ID()),
											Name:     "roles",
											Value:    string(role.ID()),
											Checked:  vmodel.AssignedRoleIDs[role.ID()],
											Disabled: readonly,
										})
										<div class="grid gap-0.5 leading-none">
											@label.Label(label.Props{For: "role-" + string(role.ID())}) {
												{ role.Name() }
											}
											if role.Description() != "" {
												<p class="text-xs text-muted-foreground">{ role.Description() }</p>
											}
										</div>
									</div>
								}
							</div>
							<!-- Action buttons -->
							<div class="flex items-center gap-2 pt-2">
								if commonComp.HasPermission(ctx, vmodel.Org.ID(), rbac.PermMembersWrite) {
									@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeLg}) {
										@icon.Save()
										<span>{ i18n.T(ctx, "org.members.edit_page.save") }</span>
									}
								}
								@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeLg, Href: commonComp.BaseURLString(ctx, commonComp.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/members"))}) {
									{ i18n.T(ctx, "org.members.edit_page.cancel") }
								}
							</div>
						</div>
					</form>
				}
			}
		</div>
	}
}
