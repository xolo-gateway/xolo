package component

import (
	"strconv"

	"github.com/xolo-gateway/xolo/internal/core/rbac"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/pagination"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/table"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

// ── Members Page ──────────────────────────────────────────────────────────────
templ MembersPage(vmodel MembersPageVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(i18n.T(ctx, "org.members.page_title", vmodel.Org.Name()))) {
		@common.PageHeader(common.PageHeaderProps{
			Title:    i18n.T(ctx, "org.members.title"),
			Subtitle: i18n.T(ctx, "org.members.subtitle", strconv.Itoa(vmodel.TotalMembers)),
		}) {
			if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermInvitesWrite) {
				@button.Button(button.Props{
					Size:  button.SizeSm,
					Class: "gap-1.5",
					Href:  common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/invites/new")),
				}) {
					@icon.UserPlus(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "org.members.invite") }
				}
			}
		}
		if vmodel.Success != "" {
			<div class="mb-3.5">
				@common.InfoBanner(common.TonePositive, i18n.T(ctx, "org.members.success"))
			</div>
		}
		if len(vmodel.Members) == 0 {
			@common.EmptyState(common.EmptyStateProps{
				Icon:        icon.Users,
				Title:       i18n.T(ctx, "org.members.empty_title"),
				Description: i18n.T(ctx, "org.members.empty_description"),
			}) {
				if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermInvitesWrite) {
					@button.Button(button.Props{
						Size: button.SizeSm,
						Href: common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/invites/new")),
					}) {
						{ i18n.T(ctx, "org.members.invite") }
					}
				}
			}
		} else {
			@common.Section() {
				@table.Table() {
					@table.Header() {
						@table.Head() {
							{ i18n.T(ctx, "org.members.col.member") }
						}
						@table.Head() {
							{ i18n.T(ctx, "org.members.col.roles") }
						}
						@table.Head() {
							{ i18n.T(ctx, "org.members.col.status") }
						}
						@table.Head(table.HeadProps{Class: "text-right"}) {
							{ i18n.T(ctx, "org.members.col.actions") }
						}
					}
					@table.Body() {
						for _, m := range vmodel.Members {
							@table.Row() {
								@table.Cell() {
									<div class="flex items-center gap-2.5">
										if m.User() != nil {
											@common.PersonAvatar(m.User().DisplayName())
										}
										<div class="min-w-0">
											if m.User() != nil {
												<div class="truncate text-sm font-semibold">{ m.User().DisplayName() }</div>
												@common.Mono(m.User().Email())
											}
										</div>
									</div>
								}
								@table.Cell() {
									<div class="flex flex-wrap gap-1">
										if len(m.Roles()) == 0 {
											@common.Badge(common.ToneNeutral, i18n.T(ctx, "org.members.no_role"))
										} else {
											for _, role := range m.Roles() {
												@common.Badge(common.ToneInfo, role.Name())
											}
										}
									</div>
								}
								@table.Cell() {
									if m.User() != nil && m.User().Active() {
										@common.Badge(common.TonePositive, i18n.T(ctx, "org.members.active"))
									} else {
										@common.Badge(common.ToneNeutral, i18n.T(ctx, "org.members.inactive"))
									}
								}
								@table.Cell(table.CellProps{Class: "text-right"}) {
									<div class="inline-flex gap-1">
										if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermMembersWrite) {
											@button.Button(button.Props{
												Href:       common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/members/", string(m.ID()), "/edit")),
												Variant:    button.VariantGhost,
												Size:       button.SizeIcon,
												Class:      "size-7",
												Attributes: templ.Attributes{"title": i18n.T(ctx, "org.members.edit")},
											}) {
												@icon.Pencil(icon.Props{Class: "size-3.5"})
											}
										}
										if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermQuotaWrite) {
											@button.Button(button.Props{
												Href:       common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/members/", string(m.ID()), "/quota")),
												Variant:    button.VariantGhost,
												Size:       button.SizeIcon,
												Class:      "size-7",
												Attributes: templ.Attributes{"title": i18n.T(ctx, "org.members.individual_budget")},
											}) {
												@icon.PiggyBank(icon.Props{Class: "size-3.5"})
											}
										}
										if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermMembersWrite) {
											@common.ConfirmDelete(common.ConfirmDeleteProps{
												URL:          common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/members/", string(m.ID()))),
												Icon:         icon.UserX,
												Tooltip:      i18n.T(ctx, "org.members.remove"),
												Title:        i18n.T(ctx, "org.members.remove_title"),
												Description:  i18n.T(ctx, "org.members.remove_description"),
												ConfirmLabel: i18n.T(ctx, "org.members.remove"),
											})
										}
									</div>
								}
							}
						}
					}
				}
			}
			@membersPagination(vmodel)
		}
	}
}

templ membersPagination(vmodel MembersPageVModel) {
	{{ totalPages := (vmodel.TotalMembers + vmodel.PageSize - 1) / vmodel.PageSize }}
	if totalPages > 1 {
		{{ paginator := pagination.CreatePagination(vmodel.CurrentPage, totalPages, 5) }}
		@pagination.Pagination(pagination.Props{Class: "mt-3"}) {
			@pagination.Content() {
				@pagination.Previous(pagination.PreviousProps{
					Href:     common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/members"), common.WithValues("page", strconv.Itoa(vmodel.CurrentPage-1))),
					Disabled: !paginator.HasPrevious,
					Label:    i18n.T(ctx, "org.members.pagination.previous"),
				})
				for _, page := range paginator.Pages {
					@pagination.Item() {
						@pagination.Link(pagination.LinkProps{
							Href:     common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/members"), common.WithValues("page", strconv.Itoa(page))),
							IsActive: page == vmodel.CurrentPage,
						}) {
							{ strconv.Itoa(page) }
						}
					}
				}
				@pagination.Next(pagination.NextProps{
					Href:     common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/members"), common.WithValues("page", strconv.Itoa(vmodel.CurrentPage+1))),
					Disabled: !paginator.HasNext,
					Label:    i18n.T(ctx, "org.members.pagination.next"),
				})
			}
		}
	}
}
