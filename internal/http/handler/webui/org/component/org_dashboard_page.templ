package component

import (
	"fmt"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/i18n"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/card"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/separator"
)

// ── Org Dashboard ─────────────────────────────────────────────────────────────
templ OrgDashboard(vmodel OrgDashboardVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(vmodel.Org.Name())) {
		<div class="space-y-6">
			@common.PageHeader(common.PageHeaderProps{
				Title:    vmodel.Org.Name(),
				Subtitle: vmodel.Org.Description(),
			})
			@separator.Separator()
			<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
				@card.Card() {
					@card.Header() {
						@card.Title() {
							{ i18n.T(ctx, "org.nav.members") }
						}
					}
					@card.Content() {
						<p class="text-3xl font-bold">{ fmt.Sprintf("%d", len(vmodel.Members)) }</p>
					}
					@card.Footer() {
						@button.Button(button.Props{Href: common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/members")), Variant: button.VariantOutline, Size: button.SizeSm}) {
							{ i18n.T(ctx, "org.dashboard.page.manage") }
						}
					}
				}
				@card.Card() {
					@card.Header() {
						@card.Title() {
							{ i18n.T(ctx, "org.nav.providers") }
						}
					}
					@card.Content() {
						<p class="text-3xl font-bold">{ fmt.Sprintf("%d", len(vmodel.Providers)) }</p>
					}
					@card.Footer() {
						@button.Button(button.Props{Href: common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers")), Variant: button.VariantOutline, Size: button.SizeSm}) {
							{ i18n.T(ctx, "org.dashboard.page.manage") }
						}
					}
				}
				@card.Card() {
					@card.Header() {
						@card.Title() {
							{ i18n.T(ctx, "org.dashboard.page.usage_30d") }
						}
					}
					@card.Content() {
						<p class="text-3xl font-bold">—</p>
					}
					@card.Footer() {
						@button.Button(button.Props{Href: common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/usage")), Variant: button.VariantOutline, Size: button.SizeSm}) {
							{ i18n.T(ctx, "org.dashboard.page.view") }
						}
					}
				}
			</div>
		</div>
	}
}
