package component

import (
	"strconv"

	"github.com/xolo-gateway/xolo/internal/core/model"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/i18n"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/table"
)

templ AlertsPage(vmodel AlertsPageVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(i18n.T(ctx, "org.alerts.page_title", vmodel.Org.Name()))) {
		{{ slug := vmodel.Org.Slug() }}
		<div class="space-y-6">
			@common.PageHeader(common.PageHeaderProps{
				Title:    i18n.T(ctx, "org.nav.alerts"),
				Subtitle: alertsSubtitle(ctx, vmodel),
			}) {
				@button.Button(button.Props{
					Size:  button.SizeSm,
					Class: "gap-1.5",
					Href:  viewedPath(common.BaseURLString(ctx, common.WithPath("/orgs/", slug, "/events/alerts/new")), vmodel.View),
				}) {
					@icon.Plus(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "org.alerts.new") }
				}
			}
			<div class="mb-3.5">
				@EventsTabs(vmodel.Org, "alerts", vmodel.View)
			</div>
			@common.FlashToast(vmodel.Success, i18n.T(ctx, "org.alerts.flash_subject"))
			@common.Section() {
				@table.Table() {
					@table.Header() {
						@table.Row() {
							@table.Head() {
								{ i18n.T(ctx, "org.alerts.col.name") }
							}
							@table.Head() {
								{ i18n.T(ctx, "org.alerts.col.scope") }
							}
							@table.Head() {
								{ i18n.T(ctx, "org.alerts.col.query") }
							}
							@table.Head() {
								{ i18n.T(ctx, "org.alerts.col.condition") }
							}
							@table.Head() {
								{ i18n.T(ctx, "org.alerts.col.state") }
							}
							@table.Head() {
								{ i18n.T(ctx, "org.alerts.col.enabled") }
							}
							@table.Head()
						}
					}
					@table.Body() {
						if len(vmodel.Alerts) == 0 {
							@table.Row() {
								@table.Cell(table.CellProps{Attributes: templ.Attributes{"colspan": "7"}, Class: "py-8 text-center text-sm text-muted-foreground"}) {
									{ i18n.T(ctx, "org.alerts.empty") }
								}
							}
						}
						for _, a := range vmodel.Alerts {
							@alertRow(slug, a, vmodel.View)
						}
					}
				}
			}
		</div>
	}
}

templ alertRow(slug string, a model.Alert, view string) {
	@table.Row() {
		@table.Cell(table.CellProps{Class: "font-medium"}) {
			{ a.Name() }
		}
		@table.Cell() {
			if a.Scope() == model.AlertScopePersonal {
				@common.Badge(common.ToneNeutral, "perso")
			} else {
				@common.Badge(common.ToneInfo, "org")
			}
		}
		@table.Cell(table.CellProps{Class: "font-mono text-xs max-w-xs truncate"}) {
			{ a.Query() }
		}
		@table.Cell(table.CellProps{Class: "text-xs whitespace-nowrap"}) {
			count({ a.Window().String() }) { " " }{ string(a.Comparator()) } { strconv.FormatFloat(a.Threshold(), 'f', -1, 64) }
		}
		@table.Cell() {
			@common.Badge(alertStateTone(a.State()), string(a.State()))
		}
		@table.Cell() {
			if a.Enabled() {
				@common.Badge(common.TonePositive, i18n.T(ctx, "org.alerts.yes"))
			} else {
				@common.Badge(common.ToneNeutral, i18n.T(ctx, "org.alerts.no"))
			}
		}
		@table.Cell(table.CellProps{Class: "text-right whitespace-nowrap"}) {
			<div class="flex gap-2 justify-end">
				@button.Button(button.Props{
					Variant:    button.VariantGhost,
					Size:       button.SizeIcon,
					Class:      "size-7",
					Href:       viewedPath(common.BaseURLString(ctx, common.WithPath("/orgs/", slug, "/events/alerts/", string(a.ID()), "/edit")), view),
					Attributes: templ.Attributes{"title": i18n.T(ctx, "org.alerts.edit")},
				}) {
					@icon.Pencil(icon.Props{Class: "size-3.5"})
				}
				@common.ConfirmDelete(common.ConfirmDeleteProps{
					URL:         viewedPath(common.BaseURLString(ctx, common.WithPath("/orgs/", slug, "/events/alerts/", string(a.ID()), "/delete")), view),
					Method:      "POST",
					Tooltip:     i18n.T(ctx, "org.alerts.delete"),
					Title:       i18n.T(ctx, "org.alerts.delete_title"),
					Description: i18n.T(ctx, "org.alerts.delete_description"),
				})
			</div>
		}
	}
}
