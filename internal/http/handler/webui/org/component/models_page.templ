package component

import (
	"github.com/xolo-gateway/xolo/internal/core/model"
	"github.com/xolo-gateway/xolo/internal/core/rbac"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/dropdown"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/table"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

// ── Models Page ───────────────────────────────────────────────────────────────
templ ModelsPage(vmodel ModelsPageVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(i18n.T(ctx, "org.models.page_title", vmodel.Provider.Name()))) {
		@common.PageHeader(common.PageHeaderProps{
			Title:    i18n.T(ctx, "org.models.title"),
			Subtitle: i18n.T(ctx, "org.models.subtitle", vmodel.Provider.Name()),
		}) {
			@button.Button(button.Props{
				Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers")),
				Variant: button.VariantOutline,
				Size:    button.SizeSm,
			}) {
				{ i18n.T(ctx, "org.models.back_to_providers") }
			}
			@providerBundleExportMenu(vmodel)
			if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermProvidersWrite) {
				@button.Button(button.Props{
					Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/", string(vmodel.Provider.ID()), "/import")),
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Class:   "gap-1.5",
				}) {
					@icon.FileUp(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "org.provider_bundle.import_bundle") }
				}
				@button.Button(button.Props{
					Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/", string(vmodel.Provider.ID()), "/models/import")),
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Class:   "gap-1.5",
				}) {
					@icon.Import(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "org.models.import_from_provider") }
				}
				@button.Button(button.Props{
					Size:  button.SizeSm,
					Class: "gap-1.5",
					Href:  common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/", string(vmodel.Provider.ID()), "/models/new")),
				}) {
					@icon.Plus(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "org.models.add") }
				}
			}
		}
		if vmodel.Success != "" {
			<div class="mb-3.5">
				@common.InfoBanner(common.TonePositive, i18n.T(ctx, "org.models.success"))
			</div>
		}
		if len(vmodel.Models) == 0 {
			@common.EmptyState(common.EmptyStateProps{
				Icon:        icon.BrainCircuit,
				Title:       i18n.T(ctx, "org.models.empty_title"),
				Description: i18n.T(ctx, "org.models.empty_description"),
			}) {
				if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermProvidersWrite) {
					@button.Button(button.Props{
						Size: button.SizeSm,
						Href: common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/", string(vmodel.Provider.ID()), "/models/new")),
					}) {
						{ i18n.T(ctx, "org.models.add") }
					}
				}
			}
		} else {
			@common.Section() {
				@common.SectionHeader() {
					@common.SectionTitle() {
						{ i18n.T(ctx, "org.models.count", len(vmodel.Models)) }
					}
					<span class="ml-auto text-xs text-muted-foreground">
						{ i18n.T(ctx, "org.models.cost_unit_note", vmodel.Provider.Currency()) }
					</span>
				}
				<div class="overflow-x-auto">
					@table.Table() {
						@table.Header() {
							@table.Head() {
								{ i18n.T(ctx, "org.models.col.proxy_name") }
							}
							@table.Head() {
								{ i18n.T(ctx, "org.models.col.real_model") }
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								{ i18n.T(ctx, "org.models.col.prompt") }
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								{ i18n.T(ctx, "org.models.col.cached_prompt") }
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								{ i18n.T(ctx, "org.models.col.completion") }
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								{ i18n.T(ctx, "org.models.col.context") }
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								{ i18n.T(ctx, "org.models.col.output") }
							}
							@table.Head() {
								{ i18n.T(ctx, "org.models.col.capabilities") }
							}
							@table.Head() {
								{ i18n.T(ctx, "org.models.col.enabled") }
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								{ i18n.T(ctx, "org.models.col.actions") }
							}
						}
						@table.Body() {
							for _, m := range vmodel.Models {
								@table.Row() {
									@table.Cell(table.CellProps{Class: "font-mono text-xs font-semibold"}) {
										{ vmodel.Org.Slug() }/{ m.ProxyName() }
									}
									@table.Cell() {
										@common.Mono(m.RealModel())
									}
									@table.Cell(table.CellProps{Class: "text-right tnum"}) {
										{ formatCostRateBare(m.PromptCostPer1KTokens()) }
									}
									@table.Cell(table.CellProps{Class: "text-right tnum text-muted-foreground"}) {
										{ formatCostRateBare(m.CachedPromptCostPer1KTokens()) }
									}
									@table.Cell(table.CellProps{Class: "text-right tnum"}) {
										{ formatCostRateBare(m.CompletionCostPer1KTokens()) }
									}
									@table.Cell(table.CellProps{Class: "text-right tnum text-muted-foreground"}) {
										{ formatTokenWindow(m.ContextWindow()) }
									}
									@table.Cell(table.CellProps{Class: "text-right tnum text-muted-foreground"}) {
										{ formatTokenWindow(m.OutputWindow()) }
									}
									@table.Cell() {
										@modelCapabilities(m.Kind(), m.Capabilities())
									}
									@table.Cell() {
										if m.Enabled() {
											@common.Badge(common.TonePositive, i18n.T(ctx, "org.models.badge_enabled"))
										} else {
											@common.Badge(common.ToneNeutral, i18n.T(ctx, "org.models.badge_disabled"))
										}
									}
									@table.Cell(table.CellProps{Class: "text-right"}) {
										if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermProvidersWrite) {
											<div class="inline-flex gap-1">
												@button.Button(button.Props{
													Href:       common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/", string(vmodel.Provider.ID()), "/models/", string(m.ID()), "/edit")),
													Variant:    button.VariantGhost,
													Size:       button.SizeIcon,
													Class:      "size-7",
													Attributes: templ.Attributes{"title": i18n.T(ctx, "org.models.edit")},
												}) {
													@icon.Pencil(icon.Props{Class: "size-3.5"})
												}
											</div>
										}
									}
								}
							}
						}
					}
				</div>
			}
		}
	}
}

// modelCapabilities renders the capability pills of a model. Nothing is drawn
// when none is declared: a row of "non" pills would weigh more than the absence
// it describes. A model of another kind than completion says so first: it
// answers no conversation.
templ modelCapabilities(kind model.ModelKind, caps model.ModelCapabilities) {
	<div class="flex flex-wrap gap-1">
		if kind != model.ModelKindCompletion {
			@common.Badge(common.ToneInfo, common.ModelKindLabel(ctx, kind))
		}
		if caps.Tools {
			@common.Badge(common.ToneNeutral, i18n.T(ctx, "org.models.cap.tools"))
		}
		if caps.Vision {
			@common.Badge(common.ToneNeutral, i18n.T(ctx, "org.models.cap.vision"))
		}
		if caps.Reasoning {
			@common.Badge(common.ToneNeutral, i18n.T(ctx, "org.models.cap.reasoning"))
		}
		if caps.Audio {
			@common.Badge(common.ToneNeutral, i18n.T(ctx, "org.models.cap.audio"))
		}
	</div>
}

// providerBundleExportMenu downloads the provider and its models as a bundle,
// with every model or the enabled ones only.
templ providerBundleExportMenu(vmodel ModelsPageVModel) {
	{{ exportURL := common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/", string(vmodel.Provider.ID()), "/export")) }}
	{{ download := templ.Attributes{"download": "", "hx-boost": "false"} }}
	@dropdown.Dropdown(dropdown.Props{ID: "provider-export"}) {
		@dropdown.Trigger() {
			@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Class: "gap-1.5", Attributes: templ.Attributes{"type": "button"}}) {
				@icon.FileDown(icon.Props{Class: "size-3.5"})
				{ i18n.T(ctx, "org.provider_bundle.export") }
			}
		}
		@dropdown.Content(dropdown.ContentProps{Class: "w-56"}) {
			@dropdown.Item(dropdown.ItemProps{Href: exportURL, Attributes: download}) {
				{ i18n.T(ctx, "org.provider_bundle.export_all") }
			}
			@dropdown.Item(dropdown.ItemProps{Href: exportURL + "?enabled_only=1", Attributes: download}) {
				{ i18n.T(ctx, "org.provider_bundle.export_enabled") }
			}
		}
	}
}
