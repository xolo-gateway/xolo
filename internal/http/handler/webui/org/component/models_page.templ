package component

import (
	"github.com/xolo-gateway/xolo/internal/core/model"
	"github.com/xolo-gateway/xolo/internal/core/rbac"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/table"
)

// ── Models Page ───────────────────────────────────────────────────────────────
templ ModelsPage(vmodel ModelsPageVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle("Modèles — "+vmodel.Provider.Name())) {
		@common.PageHeader(common.PageHeaderProps{
			Title:    "Modèles",
			Subtitle: "Routes de proxy exposées par le fournisseur " + vmodel.Provider.Name() + ".",
		}) {
			@button.Button(button.Props{
				Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers")),
				Variant: button.VariantOutline,
				Size:    button.SizeSm,
			}) {
				Retour aux fournisseurs
			}
			if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermProvidersWrite) {
				@button.Button(button.Props{
					Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/", string(vmodel.Provider.ID()), "/models/import")),
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Class:   "gap-1.5",
				}) {
					@icon.Import(icon.Props{Class: "size-3.5"})
					Importer depuis le fournisseur
				}
				@button.Button(button.Props{
					Size:  button.SizeSm,
					Class: "gap-1.5",
					Href:  common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/", string(vmodel.Provider.ID()), "/models/new")),
				}) {
					@icon.Plus(icon.Props{Class: "size-3.5"})
					Ajouter un modèle
				}
			}
		}
		if vmodel.Success != "" {
			<div class="mb-3.5">
				@common.InfoBanner(common.TonePositive, "Opération réussie.")
			</div>
		}
		if len(vmodel.Models) == 0 {
			@common.EmptyState(common.EmptyStateProps{
				Icon:        icon.BrainCircuit,
				Title:       "Aucun modèle",
				Description: "Déclarez les modèles que ce fournisseur expose pour les rendre appelables via la passerelle.",
			}) {
				if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermProvidersWrite) {
					@button.Button(button.Props{
						Size: button.SizeSm,
						Href: common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/", string(vmodel.Provider.ID()), "/models/new")),
					}) {
						Ajouter un modèle
					}
				}
			}
		} else {
			@common.Section() {
				@common.SectionHeader() {
					@common.SectionTitle() {
						{ Pluralize(len(vmodel.Models), "modèle", "modèles") }
					}
					<span class="ml-auto text-xs text-muted-foreground">
						Coûts par million de tokens, en { vmodel.Provider.Currency() } — la devise du fournisseur
					</span>
				}
				<div class="overflow-x-auto">
					@table.Table() {
						@table.Header() {
							@table.Head() {
								Nom proxy
							}
							@table.Head() {
								Modèle réel
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								Prompt
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								Prompt en cache
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								Complétion
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								Contexte
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								Sortie
							}
							@table.Head() {
								Capacités
							}
							@table.Head() {
								Activé
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								Actions
							}
						}
						@table.Body() {
							for _, m := range vmodel.Models {
								@table.Row() {
									@table.Cell(table.CellProps{Class: "font-mono text-xs font-semibold"}) {
										{ vmodel.Org.Slug() }/{ m.ProxyName() }
									}
									@table.Cell() {
										@common.Mono(m.RealModel())
									}
									@table.Cell(table.CellProps{Class: "text-right tnum"}) {
										{ formatCostRateBare(m.PromptCostPer1KTokens()) }
									}
									@table.Cell(table.CellProps{Class: "text-right tnum text-muted-foreground"}) {
										{ formatCostRateBare(m.CachedPromptCostPer1KTokens()) }
									}
									@table.Cell(table.CellProps{Class: "text-right tnum"}) {
										{ formatCostRateBare(m.CompletionCostPer1KTokens()) }
									}
									@table.Cell(table.CellProps{Class: "text-right tnum text-muted-foreground"}) {
										{ formatTokenWindow(m.ContextWindow()) }
									}
									@table.Cell(table.CellProps{Class: "text-right tnum text-muted-foreground"}) {
										{ formatTokenWindow(m.OutputWindow()) }
									}
									@table.Cell() {
										@modelCapabilities(m.Kind(), m.Capabilities())
									}
									@table.Cell() {
										if m.Enabled() {
											@common.Badge(common.TonePositive, "Activé")
										} else {
											@common.Badge(common.ToneNeutral, "Désactivé")
										}
									}
									@table.Cell(table.CellProps{Class: "text-right"}) {
										if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermProvidersWrite) {
											<div class="inline-flex gap-1">
												@button.Button(button.Props{
													Href:       common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/", string(vmodel.Provider.ID()), "/models/", string(m.ID()), "/edit")),
													Variant:    button.VariantGhost,
													Size:       button.SizeIcon,
													Class:      "size-7",
													Attributes: templ.Attributes{"title": "Modifier"},
												}) {
													@icon.Pencil(icon.Props{Class: "size-3.5"})
												}
											</div>
										}
									}
								}
							}
						}
					}
				</div>
			}
		}
	}
}

// modelCapabilities renders the capability pills of a model. Nothing is drawn
// when none is declared: a row of "non" pills would weigh more than the absence
// it describes. A model of another kind than completion says so first: it
// answers no conversation.
templ modelCapabilities(kind model.ModelKind, caps model.ModelCapabilities) {
	<div class="flex flex-wrap gap-1">
		if kind != model.ModelKindCompletion {
			@common.Badge(common.ToneInfo, common.ModelKindLabel(kind))
		}
		if caps.Tools {
			@common.Badge(common.ToneNeutral, "outils")
		}
		if caps.Vision {
			@common.Badge(common.ToneNeutral, "vision")
		}
		if caps.Reasoning {
			@common.Badge(common.ToneNeutral, "raisonnement")
		}
		if caps.Audio {
			@common.Badge(common.ToneNeutral, "audio")
		}
	</div>
}
