package component

import (
	"strconv"

	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/alert"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/checkbox"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/form"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/input"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/label"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/table"
)

// ── Model Import ──────────────────────────────────────────────────────────────
templ ModelImportPage(vmodel ModelImportVModel) {
	{{ modelsURL := common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/", string(vmodel.Provider.ID()), "/models")) }}
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle("Importer des modèles — "+vmodel.Provider.Name())) {
		@common.PageHeader(common.PageHeaderProps{
			Title:    "Importer des modèles",
			Subtitle: "Modèles que le fournisseur " + vmodel.Provider.Name() + " liste sur son API.",
		}) {
			@button.Button(button.Props{Href: modelsURL, Variant: button.VariantOutline, Size: button.SizeSm}) {
				Retour aux modèles
			}
		}
		<div class="space-y-4">
			if vmodel.Error != "" {
				@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
					@alert.Description() {
						{ vmodel.Error }
					}
				}
			}
			if len(vmodel.Skipped) > 0 {
				@alert.Alert() {
					@alert.Description() {
						<p class="font-medium">
							{ Pluralize(vmodel.Imported, "modèle importé", "modèles importés") }, { Pluralize(len(vmodel.Skipped), "modèle laissé de côté", "modèles laissés de côté") } :
						</p>
						<ul class="mt-1 list-disc pl-5 text-sm">
							for _, reason := range vmodel.Skipped {
								<li>{ reason }</li>
							}
						</ul>
					}
				}
			}
			if len(vmodel.Candidates) > 0 {
				{{ importURL := common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/", string(vmodel.Provider.ID()), "/models/import")) }}
				<form method="POST" action={ templ.SafeURL(importURL) } class="space-y-4">
					<!-- Une ligne par modèle du tableau, vide pour un modèle déjà
					déclaré : l'aperçu des noms proxy retrouve chaque ligne par
					son rang. -->
					for _, c := range vmodel.Candidates {
						if c.DeclaredAs == "" {
							<input type="hidden" name="candidate" value={ c.ID }/>
						} else {
							<input type="hidden" name="candidate" value=""/>
						}
					}
					@common.Section() {
						@common.SectionBody(common.SectionBodyProps{Class: "space-y-2"}) {
							@form.Label(form.LabelProps{For: "proxy_prefix"}) {
								Préfixe du nom proxy
							}
							@form.Description() {
								Facultatif. Chaque modèle importé est appelé <code>{ vmodel.Org.Slug() }/&lt;préfixe&gt;&lt;identifiant&gt;</code>. Un préfixe comme <code>opencode-</code> évite les conflits avec les modèles d'autres fournisseurs.
							}
							@input.Input(input.Props{
								ID:    "proxy_prefix",
								Name:  "proxy_prefix",
								Value: vmodel.Prefix,
								Class: "font-mono max-w-sm",
								Attributes: templ.Attributes{
									"hx-post":      importURL + "/preview",
									"hx-trigger":   "input changed delay:250ms",
									"hx-include":   "closest form",
									"hx-swap":      "none",
									// A slow answer must not overwrite the names of a later prefix.
									"hx-sync":      "this:replace",
									"autocomplete": "off",
								},
							})
							@modelImportPrefixError("", false)
							@form.Description() {
								Les modèles sont créés désactivés, avec un coût à zéro, le type d'API et l'URL du fournisseur. Saisissez leurs coûts dans leur formulaire avant de les activer : un modèle sans coût n'est ni valorisé ni limité par les quotas. Réglez-y aussi le type d'API d'un modèle servi par une autre API.
							}
						}
					}
					@common.Section() {
						@common.SectionHeader() {
							@common.SectionTitle() {
								{ Pluralize(len(vmodel.Candidates), "modèle listé", "modèles listés") }
							}
						}
						<div class="overflow-x-auto">
							@table.Table() {
								@table.Header() {
									@table.Head(table.HeadProps{Class: "w-8"}) {
										@checkbox.Checkbox(checkbox.Props{Group: "import-models", GroupParent: true, Attributes: templ.Attributes{"aria-label": "Tout cocher"}})
									}
									@table.Head() {
										Identifiant
									}
									@table.Head() {
										Nom
									}
									@table.Head() {
										Nom proxy
									}
									@table.Head(table.HeadProps{Class: "text-right"}) {
										Contexte
									}
									@table.Head(table.HeadProps{Class: "text-right"}) {
										Sortie
									}
									@table.Head() {
										État
									}
								}
								@table.Body() {
									for i, c := range vmodel.Candidates {
										{{ id := "import-model-" + strconv.Itoa(i) }}
										@table.Row() {
											@table.Cell() {
												if c.DeclaredAs == "" {
													@checkbox.Checkbox(checkbox.Props{ID: id, Name: "models", Value: c.ID, Group: "import-models", Checked: c.Checked})
												} else {
													@checkbox.Checkbox(checkbox.Props{ID: id, Disabled: true})
												}
											}
											@table.Cell(table.CellProps{}) {
												@label.Label(label.Props{For: id, Class: "font-mono text-xs font-normal"}) {
													{ c.ID }
												}
											}
											@table.Cell(table.CellProps{Class: "text-muted-foreground"}) {
												{ c.DisplayName }
											}
											@table.Cell() {
												if c.DeclaredAs == "" {
													@modelImportProxyName(i, c, false)
												}
											}
											@table.Cell(table.CellProps{Class: "text-right tnum text-muted-foreground"}) {
												{ formatTokenWindow(c.ContextWindow) }
											}
											@table.Cell(table.CellProps{Class: "text-right tnum text-muted-foreground"}) {
												{ formatTokenWindow(c.OutputWindow) }
											}
											@table.Cell() {
												if c.DeclaredAs != "" {
													@common.Badge(common.ToneNeutral, "déjà déclaré : "+c.DeclaredAs)
												}
											}
										}
									}
								}
							}
						</div>
					}
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Class: "gap-1.5"}) {
						@icon.Import(icon.Props{Class: "size-3.5"})
						Importer la sélection
					}
				</form>
			} else if vmodel.Error == "" {
				@common.EmptyState(common.EmptyStateProps{
					Icon:        icon.BrainCircuit,
					Title:       "Aucun modèle listé",
					Description: "Le fournisseur n'a renvoyé aucun modèle.",
				})
			}
		</div>
	}
}

// ModelImportProxyNames is the answer to a preview of the proxy names: one
// out-of-band swap per row whose model is not yet declared, and one for the
// message on the prefix.
templ ModelImportProxyNames(candidates []ModelImportCandidate, prefixError string) {
	@modelImportPrefixError(prefixError, true)
	for i, c := range candidates {
		if c.DeclaredAs == "" {
			@modelImportProxyName(i, c, true)
		}
	}
}

// modelImportPrefixError is what is wrong with the prefix being typed, if
// anything.
templ modelImportPrefixError(message string, oob bool) {
	<p id="import-prefix-error" class="text-xs text-destructive empty:hidden" if oob { hx-swap-oob="true" }>{ message }</p>
}

// modelImportProxyName is the proxy name a row would be imported under, and
// why it cannot be, if so.
templ modelImportProxyName(i int, c ModelImportCandidate, oob bool) {
	<div id={ "import-name-" + strconv.Itoa(i) } class="space-y-0.5" if oob { hx-swap-oob="true" }>
		<span class="font-mono text-xs">{ c.ProxyName }</span>
		if c.Conflict != "" {
			<p class="max-w-xs text-xs text-destructive">{ c.Conflict }</p>
		}
	</div>
}
