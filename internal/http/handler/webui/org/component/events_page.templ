package component

import (
	"context"
	"strconv"

	"github.com/xolo-gateway/xolo/internal/core/model"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/i18n"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/input"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/pagination"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/table"
)

templ EventsExplorerPage(vmodel EventsExplorerVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(i18n.T(ctx, "org.events.page_title", vmodel.Org.Name()))) {
		{{ base := common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/events")) }}
		<div>
			@common.PageHeader(common.PageHeaderProps{
				Title:    i18n.T(ctx, "org.nav.events"),
				Subtitle: i18n.T(ctx, "org.events.subtitle"),
			})
			<div class="mb-3.5">
				@EventsTabs(vmodel.Org, "events", vmodel.View)
			</div>
			<!-- Barre EventQL. Le chevron et le rappel « ⏎ exécuter » sont posés
			par-dessus le champ : input.Input n'a pas de slot d'ornement, et la
			requête doit rester un vrai champ de formulaire pour partir en GET
			sans JavaScript. -->
			<form method="GET" action={ templ.SafeURL(base) } class="mb-3 flex flex-wrap items-center gap-2">
				// Hidden inputs carry the current scope and view across the search
				// submission. They hold values, they are not controls — templui has
				// no equivalent and none is wanted.
				<input type="hidden" name="scope" value={ vmodel.Scope }/>
				if vmodel.View != "" {
					<input type="hidden" name="view" value={ vmodel.View }/>
				}
				<div class="relative min-w-64 flex-1">
					<span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 font-mono text-sm text-muted-foreground">&gt;</span>
					@input.Input(input.Props{
						Name:        "query",
						Value:       vmodel.Query,
						Placeholder: `{type="proxy.request"} | model="gpt-4o"`,
						Class:       "pl-7 pr-24 font-mono",
					})
					<span class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 font-mono text-2xs text-muted-foreground">{ i18n.T(ctx, "org.events.run_hint") }</span>
				</div>
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
					{ i18n.T(ctx, "org.events.search") }
				}
				if vmodel.CanReadAll || vmodel.CanReadTeams {
					@common.SegmentedNav(scopeSegments(ctx, base, vmodel.Query, vmodel.Scope, vmodel.View, vmodel.CanReadAll))
				}
			</form>
			if vmodel.Error != "" {
				<div class="mb-3.5">
					@common.InfoBanner(common.ToneNegative, vmodel.Error)
				</div>
			}
			if len(vmodel.Events) == 0 {
				@common.EmptyState(common.EmptyStateProps{
					Icon:        icon.Bell,
					Title:       i18n.T(ctx, "org.events.empty_title"),
					Description: i18n.T(ctx, "org.events.empty_description"),
				})
			} else {
				@common.Section() {
					@table.Table() {
						@table.Header() {
							@table.Row() {
								@table.Head() {
									{ i18n.T(ctx, "org.events.col.date") }
								}
								@table.Head() {
									{ i18n.T(ctx, "org.events.col.severity") }
								}
								@table.Head() {
									{ i18n.T(ctx, "org.events.col.type") }
								}
								@table.Head() {
									{ i18n.T(ctx, "org.events.col.source") }
								}
								@table.Head() {
									{ i18n.T(ctx, "org.events.col.user") }
								}
								@table.Head() {
									{ i18n.T(ctx, "org.events.col.message") }
								}
							}
						}
						@table.Body() {
							for _, e := range vmodel.Events {
								@eventRow(e, vmodel.Actors)
							}
						}
					}
				}
			}
			if vmodel.HasPrev || vmodel.HasNext {
				// Cursor pagination: the query returns one page at a time and the
				// total is unknown, so there are no numbered links to render —
				// only the two arrows and the current page as a marker.
				@pagination.Pagination() {
					@pagination.Content() {
						@pagination.Item() {
							@pagination.Previous(pagination.PreviousProps{
								Label:    i18n.T(ctx, "org.events.previous"),
								Href:     explorerHref(base, vmodel.Scope, vmodel.Query, vmodel.Page-1, vmodel.View),
								Disabled: !vmodel.HasPrev,
							})
						}
						@pagination.Item() {
							@pagination.Link(pagination.LinkProps{IsActive: true, Disabled: true}) {
								{ strconv.Itoa(vmodel.Page) }
							}
						}
						@pagination.Item() {
							@pagination.Next(pagination.NextProps{
								Label:    i18n.T(ctx, "org.events.next"),
								Href:     explorerHref(base, vmodel.Scope, vmodel.Query, vmodel.Page+1, vmodel.View),
								Disabled: !vmodel.HasNext,
							})
						}
					}
				}
			}
		</div>
	}
}

// scopeSegments builds the "Mes événements / Tous / Globaux" segmented control.
// Switching scope always restarts at page 1: the cursor of the previous scope
// means nothing in the next one.
func scopeSegments(ctx context.Context, base, query, current, view string, readAll bool) []common.Segment {
	scopes := []struct {
		scope string
		label string
	}{
		{EventScopeMine, i18n.T(ctx, "org.events.scope.mine")},
		{EventScopeTeams, i18n.T(ctx, "org.events.scope.teams")},
	}
	if readAll {
		scopes = []struct {
			scope string
			label string
		}{
			{EventScopeMine, i18n.T(ctx, "org.events.scope.mine")},
			{EventScopeAll, i18n.T(ctx, "org.events.scope.all")},
			{EventScopeGlobal, i18n.T(ctx, "org.events.scope.global")},
		}
	}

	segments := make([]common.Segment, 0, len(scopes))
	for _, s := range scopes {
		segments = append(segments, common.Segment{
			Label:  s.label,
			Href:   explorerHref(base, s.scope, query, 1, view),
			Active: s.scope == current,
		})
	}

	return segments
}

templ eventRow(e model.Event, actors map[model.UserID]EventActor) {
	@table.Row() {
		@table.Cell(table.CellProps{Class: "whitespace-nowrap text-xs text-muted-foreground"}) {
			{ formatEventTime(e.CreatedAt()) }
		}
		@table.Cell() {
			@common.Badge(severityTone(e.Severity()), string(e.Severity()))
		}
		@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
			{ e.Type() }
		}
		@table.Cell(table.CellProps{Class: "text-xs"}) {
			{ e.Source() }
		}
		@table.Cell(table.CellProps{Class: "text-xs"}) {
			if e.UserID() != "" {
				{{ actor := eventActor(e, actors) }}
				<span class="inline-flex items-center gap-1" title={ string(e.UserID()) }>
					if actor.IsApplication {
						@icon.AppWindow(icon.Props{Size: 12, Class: "shrink-0 text-muted-foreground"})
					}
					{ actor.Label }
				</span>
			} else {
				<span class="text-muted-foreground">{ i18n.T(ctx, "org.events.global_actor") }</span>
			}
		}
		@table.Cell() {
			<div class="space-y-1">
				<div class="text-sm">{ e.Message() }</div>
				if len(e.Attributes()) > 0 {
					<div class="flex flex-wrap gap-1">
						for _, a := range sortedAttrs(e.Attributes()) {
							<span class="rounded-sm bg-muted px-1.5 py-px font-mono text-2xs text-muted-foreground">{ a.Key }={ a.Value }</span>
						}
					</div>
				}
			</div>
		}
	}
}
