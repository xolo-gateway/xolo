package component

import (
	"github.com/xolo-gateway/xolo/internal/core/model"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/card"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/form"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/input"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/selectbox"
)

// ── Invite Form ───────────────────────────────────────────────────────────────
templ InviteForm(vmodel InviteFormVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle("Créer une invitation")) {
		<div class="space-y-6">
			@common.PageHeader(common.PageHeaderProps{
				Title: "Créer une invitation",
			})
			<form method="POST" action={ common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/invites")) } class="space-y-4">
				@card.Card() {
					@card.Content() {
						<div class="space-y-4 pt-4">
							<div class="space-y-2">
								@form.Label(form.LabelProps{}) {
									Email de l'invité (optionnel) 
								}
								@input.Input(input.Props{Name: "invitee_email", Type: "email", Placeholder: "utilisateur@exemple.com"})
								@form.Description() {
									Laisser vide pour un lien utilisable par n'importe qui. 
								}
							</div>
							if len(vmodel.Teams) > 0 {
								<div class="space-y-2">
									@form.Label(form.LabelProps{}) {
										Équipe
										if !vmodel.TeamOnly {
											{ " (optionnel)" }
										}
									}
									@selectbox.SelectBox(selectbox.Props{ID: "invite_team"}) {
										@selectbox.Trigger(selectbox.TriggerProps{Name: "team_id", Attributes: inviteTeamAttributes(vmodel)}) {
											@selectbox.Value(selectbox.ValueProps{Placeholder: "Aucune équipe"})
										}
										@selectbox.Content(selectbox.ContentProps{NoSearch: len(vmodel.Teams) < 8}) {
											@selectbox.Group() {
												if !vmodel.TeamOnly {
													@selectbox.Item(selectbox.ItemProps{Value: "", Selected: true}) {
														Aucune équipe
													}
												}
												for i, team := range vmodel.Teams {
													@selectbox.Item(selectbox.ItemProps{Value: string(team.ID()), Selected: vmodel.TeamOnly && i == 0}) {
														{ team.Name() }
													}
												}
											}
										}
									}
									@form.Description() {
										L'invité rejoint aussi cette équipe en rejoignant l'organisation.
									}
								</div>
							}
							if vmodel.TeamOnly {
								<input type="hidden" name="role" value={ model.RoleMember }/>
								<p class="text-sm text-muted-foreground">L'invité rejoint l'organisation avec le rôle de membre.</p>
							} else {
							<div class="space-y-2">
								@form.Label(form.LabelProps{}) {
									Rôle 
								}
								@selectbox.SelectBox(selectbox.Props{ID: "invite_role"}) {
									@selectbox.Trigger(selectbox.TriggerProps{Name: "role"}) {
										@selectbox.Value(selectbox.ValueProps{Placeholder: "Sélectionner un rôle"})
									}
									@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
										@selectbox.Group() {
											for _, r := range vmodel.OrgRoles {
												{{ label := r.Name() }}
												if r.BuiltinKind() != "" {
													{{ label = BuiltinRoleLabel(r.BuiltinKind()) }}
												}
												@selectbox.Item(selectbox.ItemProps{Value: string(r.ID()), Selected: r.BuiltinKind() == model.BuiltinKindMember}) {
													{ label }
												}
											}
										}
									}
								}
							</div>
							}
							<div class="space-y-2">
								@form.Label(form.LabelProps{}) {
									Date d'expiration (optionnel) 
								}
								@input.Input(input.Props{Name: "expires_at", Type: "date"})
							</div>
							<div class="space-y-2">
								@form.Label(form.LabelProps{}) {
									Nombre max d'utilisations (optionnel) 
								}
								@input.Input(input.Props{Name: "max_uses", Type: "number", Placeholder: "1"})
							</div>
						</div>
					}
					<div class="pt-0 flex items-center p-6">
						@button.Button(button.Props{Type: button.TypeSubmit}) {
							Créer le lien
						}
					</div>
				}
			</form>
		</div>
	}
}

// inviteTeamAttributes makes the team required for a viewer inviting on its
// teams only.
func inviteTeamAttributes(vmodel InviteFormVModel) templ.Attributes {
	if vmodel.TeamOnly {
		return templ.Attributes{"required": "required"}
	}
	return nil
}
