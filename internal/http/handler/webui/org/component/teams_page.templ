package component

import (
	"context"
	"fmt"

	"github.com/xolo-gateway/xolo/internal/core/model"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/form"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/input"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/label"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/table"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/textarea"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

func teamsURL(ctx context.Context, org model.Organization, parts ...string) string {
	return common.BaseURLString(ctx, common.WithPath(append([]string{"/orgs/", org.Slug(), "/admin/teams"}, parts...)...))
}

// ── Teams Page ────────────────────────────────────────────────────────────────
templ TeamsPage(vmodel TeamsPageVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(i18n.T(ctx, "org.teams.page_title", vmodel.Org.Name()))) {
		@common.PageHeader(common.PageHeaderProps{
			Title:    i18n.T(ctx, "org.teams.title"),
			Subtitle: i18n.T(ctx, "org.teams.subtitle", vmodel.Org.Slug()),
		}) {
			if vmodel.CanEdit {
				@button.Button(button.Props{
					Size:  button.SizeSm,
					Class: "gap-1.5",
					Href:  teamsURL(ctx, vmodel.Org, "/new"),
				}) {
					@icon.Plus(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "org.teams.new") }
				}
			}
		}
		if vmodel.Success != "" {
			<div class="mb-3.5">
				@common.InfoBanner(common.TonePositive, teamSuccessMessage(ctx, vmodel.Success))
			</div>
		}
		if len(vmodel.Teams) == 0 {
			@common.EmptyState(common.EmptyStateProps{
				Icon:        icon.UsersRound,
				Title:       i18n.T(ctx, "org.teams.empty_title"),
				Description: i18n.T(ctx, "org.teams.empty_description"),
			}) {
				if vmodel.CanEdit {
					@button.Button(button.Props{Size: button.SizeSm, Href: teamsURL(ctx, vmodel.Org, "/new")}) {
						{ i18n.T(ctx, "org.teams.new") }
					}
				}
			}
		} else {
			@common.Section() {
				@table.Table() {
					@table.Header() {
						@table.Head() {
							{ i18n.T(ctx, "org.teams.col.team") }
						}
						@table.Head() {
							{ i18n.T(ctx, "org.teams.col.members") }
						}
						@table.Head() {
							{ i18n.T(ctx, "org.teams.col.models") }
						}
						@table.Head(table.HeadProps{Class: "text-right"}) {
							{ i18n.T(ctx, "org.teams.col.actions") }
						}
					}
					@table.Body() {
						for _, row := range vmodel.Teams {
							@table.Row() {
								@table.Cell() {
									<div class="min-w-0">
										<div class="flex items-center gap-1.5">
											<span class="truncate text-sm font-semibold">{ row.Team.Name() }</span>
											if row.Team.Status() == model.StatusSuspended {
												@common.Badge(common.ToneWarning, i18n.T(ctx, "org.teams.badge_suspended"))
											}
										</div>
										@common.Mono(vmodel.Org.Slug() + "/" + row.Team.Slug() + "/…")
									</div>
								}
								@table.Cell() {
									{ fmt.Sprintf("%d", row.Members) }
								}
								@table.Cell() {
									{ fmt.Sprintf("%d", len(row.Team.ModelGrants())) }
								}
								@table.Cell(table.CellProps{Class: "text-right"}) {
									@button.Button(button.Props{
										Href:       teamsURL(ctx, vmodel.Org, "/", string(row.Team.ID())),
										Variant:    button.VariantGhost,
										Size:       button.SizeIcon,
										Class:      "size-7",
										Attributes: templ.Attributes{"title": i18n.T(ctx, "org.teams.open")},
									}) {
										@icon.Pencil(icon.Props{Class: "size-3.5"})
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

// ── New Team ──────────────────────────────────────────────────────────────────
templ TeamForm(vmodel TeamFormVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(i18n.T(ctx, "org.teams.new"))) {
		<div class="max-w-3xl">
			@common.PageHeader(common.PageHeaderProps{
				Title:    i18n.T(ctx, "org.teams.new"),
				Subtitle: i18n.T(ctx, "org.teams.form.subtitle"),
			}) {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Class: "gap-1.5", Href: teamsURL(ctx, vmodel.Org)}) {
					@icon.ArrowLeft(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "org.teams.back") }
				}
			}
			if vmodel.Error != "" {
				<div class="mb-3.5">
					@common.InfoBanner(common.ToneNegative, vmodel.Error)
				</div>
			}
			<form method="POST" action={ templ.SafeURL(teamsURL(ctx, vmodel.Org)) } class="space-y-3.5">
				@common.Section() {
					@common.SectionHeader() {
						@common.SectionTitle() {
							{ i18n.T(ctx, "org.teams.form.section_info") }
						}
					}
					@common.SectionBody(common.SectionBodyProps{Class: "space-y-3.5"}) {
						<div class="grid gap-3.5 sm:grid-cols-2">
							@form.Item() {
								@label.Label(label.Props{For: "name"}) {
									{ i18n.T(ctx, "org.teams.form.name") }
								}
								@input.Input(input.Props{ID: "name", Name: "name", Value: vmodel.Name, Placeholder: i18n.T(ctx, "org.teams.form.name_placeholder"), Attributes: templ.Attributes{"required": "required"}})
							}
							@form.Item() {
								@label.Label(label.Props{For: "slug"}) {
									{ i18n.T(ctx, "org.teams.form.slug") }
								}
								@input.Input(input.Props{ID: "slug", Name: "slug", Value: vmodel.Slug, Placeholder: i18n.T(ctx, "org.teams.form.slug_placeholder"), Attributes: templ.Attributes{"required": "required", "pattern": "[a-z0-9]([a-z0-9-]*[a-z0-9])?", "maxlength": "63"}})
								@form.Description() {
									{ i18n.T(ctx, "org.teams.form.slug_help", vmodel.Org.Slug()) }
								}
							}
						</div>
						@form.Item() {
							@label.Label(label.Props{For: "description"}) {
								{ i18n.T(ctx, "org.teams.form.description") }
							}
							@textarea.Textarea(textarea.Props{ID: "description", Name: "description", Value: vmodel.Description, Rows: 2})
						}
					}
					@common.SectionHeader(common.SectionHeaderProps{Class: "border-b-0 border-t"}) {
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Class: "gap-1.5"}) {
							@icon.Save(icon.Props{Class: "size-3.5"})
							{ i18n.T(ctx, "org.teams.form.create") }
						}
					}
				}
			</form>
		</div>
	}
}

func teamSuccessMessage(ctx context.Context, code string) string {
	switch code {
	case "deleted":
		return i18n.T(ctx, "org.teams.success.deleted")
	case "created":
		return i18n.T(ctx, "org.teams.success.created")
	}
	return i18n.T(ctx, "org.teams.success.saved")
}
