package component

import (
	"fmt"

	"github.com/xolo-gateway/xolo/internal/core/rbac"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/alert"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/form"
)

// ── Quota Page ────────────────────────────────────────────────────────────────
templ QuotaPage(vmodel QuotaPageVModel) {
	{{ title := "Budget de l'organisation" }}
	{{ action := common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/quota")) }}
	if vmodel.ScopeType == "user" && vmodel.Membership != nil {
		{{ title = "Budget du membre" }}
		{{ action = common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/members/", string(vmodel.Membership.ID()), "/quota")) }}
	}
	if vmodel.ScopeType == "application" && vmodel.Application != nil {
		{{ title = "Budget de l'application" }}
		{{ action = common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/applications/", string(vmodel.Application.ID()), "/quota")) }}
	}
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(title)) {
		{{ readonly := !common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermQuotaWrite) }}
		<div class="max-w-4xl">
			@common.PageHeader(common.PageHeaderProps{
				Title:    title,
				Subtitle: "Les plafonds bloquent les nouvelles requêtes une fois atteints. Ils ne s'appliquent qu'aux fournisseurs en mode pay-as-you-go ; les fournisseurs en abonnement ont leurs propres limites de plan.",
			})
			if vmodel.Success != "" {
				<div class="mb-3.5">
					@common.InfoBanner(common.TonePositive, "Budget enregistré.")
				</div>
			}
			if vmodel.LoadError != "" {
				<div class="mb-3.5">
					@common.InfoBanner(common.ToneNegative, vmodel.LoadError)
				</div>
			}
			if len(vmodel.FieldErrors) > 0 {
				<div class="mb-3.5">
					@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
						@alert.Title() {
							Plafond invalide
						}
						@alert.Description() {
							{ quotaFormErrorSummary(vmodel.FieldErrors) }
						}
					}
				</div>
			}
			<form method="POST" action={ templ.SafeURL(action) } class="space-y-3.5" novalidate>
				@common.Section() {
					@common.SectionHeader() {
						@common.SectionTitle() {
							Plafonds
						}
						<span class="ml-auto text-xs text-muted-foreground">
							Devise : { vmodel.Org.Currency() }
						</span>
					}
					@common.SectionBody(common.SectionBodyProps{Class: "space-y-3.5"}) {
						<div class="grid gap-3.5 sm:grid-cols-3">
							@budgetField("quota-daily", "daily_budget", "Journalier", "10.00", budgetInputValue(vmodel, "daily_budget", budgetScopeDaily), vmodel.Org.Currency(), readonly, quotaFieldError(vmodel.FieldErrors, "daily_budget"))
							@budgetField("quota-monthly", "monthly_budget", "Mensuel", "100.00", budgetInputValue(vmodel, "monthly_budget", budgetScopeMonthly), vmodel.Org.Currency(), readonly, quotaFieldError(vmodel.FieldErrors, "monthly_budget"))
							@budgetField("quota-yearly", "yearly_budget", "Annuel", "1000.00", budgetInputValue(vmodel, "yearly_budget", budgetScopeYearly), vmodel.Org.Currency(), readonly, quotaFieldError(vmodel.FieldErrors, "yearly_budget"))
						</div>
						<p class="text-xs text-muted-foreground">
							Un champ vide vaut « illimité ». Saisissez 0 pour geler immédiatement les dépenses (toute nouvelle requête payante reçoit un 429). Pour changer la devise, passez par les
							<a href={ templ.SafeURL(common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/settings"))) } class="font-medium underline">paramètres de l'organisation</a>.
						</p>
					}
					if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermQuotaWrite) {
						@common.SectionHeader(common.SectionHeaderProps{Class: "border-b-0 border-t"}) {
							@button.Button(button.Props{Type: "submit", Size: button.SizeSm}) {
								Enregistrer
							}
						}
					}
				}
			</form>
			if vmodel.Quota != nil && (vmodel.Quota.DailyBudget() != nil || vmodel.Quota.MonthlyBudget() != nil || vmodel.Quota.YearlyBudget() != nil) {
				<div class="mt-3.5">
					@common.Section() {
						@common.SectionHeader() {
							@common.SectionTitle() {
								Consommation
							}
						}
						@common.SectionBody(common.SectionBodyProps{Class: "space-y-3.5"}) {
							if vmodel.Quota.DailyBudget() != nil {
								@quotaUsageRow("Journalier", vmodel.DailyCost, *vmodel.Quota.DailyBudget(), vmodel.Org.Currency())
							}
							if vmodel.Quota.MonthlyBudget() != nil {
								@quotaUsageRow("Mensuel", vmodel.MonthlyCost, *vmodel.Quota.MonthlyBudget(), vmodel.Org.Currency())
							}
							if vmodel.Quota.YearlyBudget() != nil {
								@quotaUsageRow("Annuel", vmodel.YearlyCost, *vmodel.Quota.YearlyBudget(), vmodel.Org.Currency())
							}
						}
					}
				</div>
			}
		</div>
	}
}

templ budgetField(id string, name string, label string, placeholder string, value string, currency string, readonly bool, errMsg string) {
	@form.Item() {
		@form.Label(form.LabelProps{For: id}) {
			{ label }
		}
		@common.MoneyInput(common.MoneyInputProps{
			ID:          id,
			Name:        name,
			Value:       value,
			Placeholder: placeholder,
			Currency:    currency,
			Disabled:    readonly,
			HasError:    errMsg != "",
		})
		if errMsg != "" {
			@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
				{ errMsg }
			}
		}
	}
}

templ quotaUsageRow(label string, spent int64, budget int64, currency string) {
	{{ pct := common.UsagePercent(spent, &budget) }}
	<div class="space-y-1.5">
		<div class="flex flex-wrap items-baseline gap-2 text-sm">
			<span class="font-medium">{ label }</span>
			<span class="tnum text-muted-foreground">
				{ common.FormatCost(spent, currency) } / { common.FormatCost(budget, currency) }
			</span>
			<span class="ml-auto">
				@common.Badge(common.BudgetTone(pct), fmt.Sprintf("%d %%", pct))
			</span>
		</div>
		<!-- TODO(rework-ux): la maquette ajoute un repère noir de projection de fin
		de période sur la jauge. Il demande une extrapolation de la dépense (rythme
		courant × jours restants) qui n'existe pas côté domaine ; BudgetGauge sait
		déjà le dessiner dès qu'une projection lui sera fournie (cf. lot 7 du plan). -->
		@common.BudgetGauge(pct, 0, "")
	</div>
}
