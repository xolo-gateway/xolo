package component

import (
	"context"
	"fmt"
	"strconv"
	"time"

	"github.com/xolo-gateway/xolo/internal/core/model"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/card"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/collapsible"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/popover"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/progress"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/utils"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

// SubscriptionUsageSection renders plan consumption for each subscription provider.
// Shown at the top of the usage page only when at least one subscription provider exists.
templ SubscriptionUsageSection(providers []SubscriptionProviderUsage) {
	if len(providers) > 0 {
		<div class="space-y-3">
			@common.SectionTitle() {
				{ i18n.T(ctx, "org.subscription.title") }
			}
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				for _, pu := range providers {
					@subscriptionProviderCard(pu)
				}
			</div>
		</div>
	}
}

templ subscriptionProviderCard(pu SubscriptionProviderUsage) {
	{{ groups := groupSubscriptionConstraints(pu.Constraints) }}
	@card.Card() {
		@card.Header() {
			@card.Title() {
				<div class="flex flex-wrap items-center gap-2">
					<span>{ pu.Provider.Name() }</span>
					if pu.PerUser {
						@common.Badge(common.ToneNeutral, i18n.T(ctx, "org.subscription.my_share"))
					}
					// The most constrained gauge, so the card can be read without
					// scanning every row.
					if peak, ok := peakOf(groups); ok {
						<span class="ml-auto text-xs font-normal text-muted-foreground">
							{ i18n.T(ctx, "org.subscription.peak", subscriptionPeakLabel(peak)) }
						</span>
					}
				</div>
			}
			@card.Description() {
				if pu.PerUser {
					{ i18n.T(ctx, "org.subscription.personal_share", pu.Plan.Label) }
				} else {
					{ pu.Plan.Label }
				}
			}
		}
		@card.Content() {
			<div class="@container space-y-4">
				for _, g := range groups {
					@subscriptionConstraintGroupView(g)
				}
				if len(groups) == 0 {
					<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "org.subscription.no_constraints") }</p>
				}
				if len(pu.Keys) > 0 {
					@subscriptionKeysView(pu.Keys)
				}
			</div>
		}
	}
}

// subscriptionKeysView breaks a pooled plan down by API key, folded: the card
// leads with the pool its users share.
templ subscriptionKeysView(keys []SubscriptionKeyUsage) {
	@collapsible.Collapsible() {
		@collapsible.Trigger(collapsible.TriggerProps{Class: "cursor-pointer text-xs text-muted-foreground hover:text-foreground"}) {
			{ i18n.T(ctx, "org.subscription.keys_detail", len(keys)) }
		}
		@collapsible.Content(collapsible.ContentProps{Class: "mt-3 space-y-4"}) {
			for _, k := range keys {
				<div class="space-y-2 border-l-2 border-border pl-3">
					<p class="text-xs font-medium text-foreground">{ subscriptionKeyLabel(ctx, k) }</p>
					for _, g := range groupSubscriptionConstraints(k.Constraints) {
						@subscriptionConstraintGroupView(g)
					}
				</div>
			}
		}
	}
}

// subscriptionConstraintGroupView renders one plan constraint: a header saying
// once what its rows share, then one compact line per gauge.
templ subscriptionConstraintGroupView(g subscriptionConstraintGroup) {
	<div class="space-y-1.5">
		<div class="flex flex-wrap items-baseline gap-x-2 text-xs text-muted-foreground">
			<span class="text-sm font-medium text-foreground">{ g.Constraint.Label }</span>
			<span>{ subscriptionGroupTiming(ctx, g) }</span>
			if g.Kind != gaugeNone && g.Kind != gaugeConcurrency {
				<span class="ml-auto">{ subscriptionGaugeKindLabel(ctx, g.Kind) }</span>
			}
		</div>
		if g.IdlePerModel {
			<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "org.subscription.per_model_note") }</p>
		}
		// The degraded share holds for the whole constraint: said once rather
		// than on every model.
		if g.ShareDegraded {
			<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "org.subscription.share_degraded") }</p>
		}
		for _, r := range g.Rows {
			@subscriptionGaugeLine(g, r)
		}
		if len(g.Folded) > 0 {
			@collapsible.Collapsible() {
				@collapsible.Trigger(collapsible.TriggerProps{Class: "cursor-pointer text-xs text-muted-foreground hover:text-foreground"}) {
					{ subscriptionFoldLabel(ctx, g) }
				}
				@collapsible.Content(collapsible.ContentProps{Class: "mt-1.5"}) {
					<div class="space-y-1.5">
						for _, r := range g.Folded {
							@subscriptionGaugeLine(g, r)
						}
					</div>
				}
			}
		}
	</div>
}

// subscriptionGaugeLine renders one gauge on a single line: name, thin bar and
// percentage, then the secondary figures, which wrap below on a narrow card.
templ subscriptionGaugeLine(g subscriptionConstraintGroup, r subscriptionGaugeRow) {
	{{ cu := r.Usage }}
	<div class="flex flex-wrap items-center gap-x-3 gap-y-0.5 text-xs">
		<span class="w-full min-w-0 truncate @md:w-40">
			if cu.UpstreamModel != "" {
				<code title={ cu.UpstreamModel }>{ cu.UpstreamModel }</code>
			} else if g.IdlePerModel {
				@common.Badge(common.ToneNeutral, i18n.T(ctx, "org.subscription.per_model"))
			} else if cu.Constraint.Kind == model.ConstraintConcurrency {
				{ i18n.T(ctx, "org.subscription.concurrent_requests") }
			} else {
				{ i18n.T(ctx, "org.subscription.all_models") }
			}
		</span>
		if r.Kind != gaugeNone {
			<div class="min-w-16 flex-1">
				@progressBar(r.Pct, r.Pct >= subscriptionDangerPct || cu.Exhausted)
			</div>
			<span class="min-w-12 whitespace-nowrap text-right tabular-nums">
				if r.Kind == gaugeConcurrency {
					{ fmt.Sprintf("%d / %d", cu.InFlight, *cu.Constraint.MaxConcurrent) }
				} else {
					if g.Kind == gaugeNone {
						<span class="text-muted-foreground">{ subscriptionGaugeKindLabel(ctx, r.Kind) }</span>
					}
					{ fmt.Sprintf(" %d%%", r.Pct) }
				}
			</span>
		}
		<div class="flex w-full flex-wrap items-center gap-x-2 gap-y-0.5 text-muted-foreground @md:pl-43 @2xl:w-auto @2xl:pl-0">
			if cu.Exhausted {
				if cu.Constraint.Kind == model.ConstraintConcurrency {
					@common.Badge(common.ToneNegative, i18n.T(ctx, "org.subscription.exhausted"))
				} else {
					@common.Badge(common.ToneWarning, i18n.T(ctx, "org.subscription.exhausted_upstream"))
				}
			}
			// On a line showing two budgets under different regimes, each tooltip
			// names the budget it is for; a regime shared by both is said once.
			if r.OtherKind != gaugeNone && r.OtherMode != r.Mode {
				@fairShareBadge(r.Mode, subscriptionGaugeKindLabel(ctx, r.Kind))
				@fairShareBadge(r.OtherMode, subscriptionGaugeKindLabel(ctx, r.OtherKind))
			} else {
				@fairShareBadge(r.Mode, "")
			}
			{{ figures := subscriptionGaugeFigures(ctx, g, r) }}
			for i, part := range figures {
				if i > 0 {
					<span aria-hidden="true">·</span>
				}
				<span>{ part }</span>
			}
			if cu.ActiveUsers > 0 && cu.MemberCount > 0 && !cu.ShareDegraded {
				if len(figures) > 0 {
					<span aria-hidden="true">·</span>
				}
				// The allocation basis. A share computed on the active users moves
				// between two visits, so the figures it was computed from are shown
				// rather than left for the reader to guess.
				@subscriptionExplanation(i18n.T(ctx, "org.subscription.share_basis", strconv.Itoa(cu.ActiveUsers), strconv.Itoa(cu.MemberCount))) {
					<span class="underline decoration-dotted underline-offset-2">
						{ i18n.T(ctx, "org.subscription.share_basis_short", strconv.Itoa(cu.ActiveUsers), strconv.Itoa(cu.MemberCount)) }
					</span>
				}
			}
		</div>
	</div>
}

// fairShareBadge names the regime a gauge was allocated under, its explanation
// a tap away, prefixed with the budget it applies to when one is given. The
// nominal regime carries no badge: only a share that is narrower or wider than
// usual needs accounting for.
templ fairShareBadge(mode model.FairShareMode, budget string) {
	if notableFairShare(mode) {
		{{ note := fairShareNote(ctx, mode) }}
		if budget != "" {
			{{ note = i18n.T(ctx, "org.subscription.share_note_of", budget, note) }}
		}
		@subscriptionExplanation(note) {
			if mode == model.FairShareModeHappyHour {
				@common.Badge(common.TonePositive, i18n.T(ctx, "org.subscription.share_happy_hour"))
			} else if mode == model.FairShareModeCapped {
				@common.Badge(common.ToneWarning, i18n.T(ctx, "org.subscription.share_capped"))
			} else if mode == model.FairShareModeThrottled {
				@common.Badge(common.ToneWarning, i18n.T(ctx, "org.subscription.share_throttled"))
			}
		}
	}
}

// subscriptionExplanation opens a sentence on click rather than on hover, so
// it can be read on a touch screen too.
templ subscriptionExplanation(text string) {
	{{ id := "subscription-note-" + utils.RandomID() }}
	@popover.Trigger(popover.TriggerProps{For: id, Class: "cursor-help"}) {
		{ children... }
	}
	@popover.Content(popover.ContentProps{ID: id, Placement: popover.PlacementTop, ShowArrow: true, Class: "max-w-xs p-2 text-xs"}) {
		{ text }
	}
}

// progressBar renders a plan consumption bar.
// danger=true colours it with the destructive token instead of the primary one.
templ progressBar(pct int, danger bool) {
	{{ barClass := "bg-primary" }}
	if danger {
		{{ barClass = "bg-destructive" }}
	}
	@progress.Progress(progress.Props{
		Value:    pct,
		BarClass: barClass,
	})
}

// ── Helpers ───────────────────────────────────────────────────────────────────

// subscriptionGroupTiming describes the window of a constraint group. A fixed
// window resets at the same instant for every model, so its countdown belongs
// here; a sliding window frees up per model, so its countdown stays on the rows.
func subscriptionGroupTiming(ctx context.Context, g subscriptionConstraintGroup) string {
	if g.Constraint.Kind == model.ConstraintConcurrency {
		return i18n.T(ctx, "org.subscription.concurrency")
	}
	duration := formatDurationLabel(ctx, g.Constraint.Duration.Duration())
	if g.Anchored {
		if g.ResetAt.IsZero() {
			return i18n.T(ctx, "org.subscription.fixed_window_of", duration)
		}
		return i18n.T(ctx, "org.subscription.fixed_window_reset", duration, formatUntil(ctx, g.ResetAt))
	}
	return i18n.T(ctx, "org.subscription.sliding_window_of", duration)
}

func subscriptionGaugeKindLabel(ctx context.Context, kind subscriptionGaugeKind) string {
	switch kind {
	case gaugeTokens:
		return i18n.T(ctx, "org.subscription.tokens")
	case gaugeValue:
		return i18n.T(ctx, "org.subscription.value")
	case gaugeConcurrency:
		return i18n.T(ctx, "org.subscription.concurrency")
	default:
		return ""
	}
}

// subscriptionGaugeFigures returns the secondary figures of a gauge line, in
// reading order: the other budget, the tokens consumed, the release countdown.
func subscriptionGaugeFigures(ctx context.Context, g subscriptionConstraintGroup, r subscriptionGaugeRow) []string {
	cu := r.Usage
	var parts []string
	if cu.Constraint.Kind == model.ConstraintConcurrency {
		if r.Kind == gaugeNone {
			parts = append(parts, i18n.T(ctx, "org.subscription.concurrent_in_flight", strconv.Itoa(cu.InFlight)))
		}
		return parts
	}
	if r.OtherKind != gaugeNone {
		parts = append(parts, i18n.T(ctx, "org.subscription.other_gauge", subscriptionGaugeKindLabel(ctx, r.OtherKind), fmt.Sprintf("%d%%", r.OtherPct)))
	}
	if r.Kind == gaugeNone && cu.TokensUsed > 0 {
		parts = append(parts, i18n.T(ctx, "org.subscription.tokens_used_unlimited", formatLargeInt(cu.TokensUsed)))
	} else if cu.TokensUsed > 0 {
		parts = append(parts, i18n.T(ctx, "org.subscription.tokens_count", formatLargeInt(cu.TokensUsed)))
	}
	// Sliding window: usage frees up progressively as the oldest records age out.
	// The idle per-model row already has its note.
	if !g.Anchored && !cu.OldestUsage.IsZero() {
		parts = append(parts, i18n.T(ctx, "org.subscription.frees_in", formatTimeUntilReset(ctx, cu.OldestUsage, cu.Constraint.Duration.Duration())))
	} else if !g.Anchored && !g.IdlePerModel && cu.TokensUsed == 0 && cu.ValueUsed == 0 {
		parts = append(parts, i18n.T(ctx, "org.subscription.no_usage"))
	}
	return parts
}

// subscriptionFoldLabel sums up the folded rows on their toggle: the highest
// percentage hidden, and apart the models without a limit, which have none.
func subscriptionFoldLabel(ctx context.Context, g subscriptionConstraintGroup) string {
	gauged := len(g.Folded) - g.FoldedUnlimited
	peak := fmt.Sprintf("%d%%", g.FoldedPeak)
	switch {
	case gauged == 0:
		return i18n.T(ctx, "org.subscription.more_models_unlimited", g.FoldedUnlimited)
	case g.FoldedUnlimited == 0:
		return i18n.T(ctx, "org.subscription.more_models", gauged, peak)
	default:
		return i18n.T(ctx, "org.subscription.more_models_mixed", gauged, peak, g.FoldedUnlimited)
	}
}

func subscriptionPeakLabel(p subscriptionPeak) string {
	label := fmt.Sprintf("%d%% · %s", p.Pct, p.Label)
	if p.UpstreamModel != "" {
		label += " · " + p.UpstreamModel
	}
	return label
}

func fairShareNote(ctx context.Context, mode model.FairShareMode) string {
	switch mode {
	case model.FairShareModeThrottled:
		return i18n.T(ctx, "org.subscription.note_throttled")
	case model.FairShareModeCapped:
		return i18n.T(ctx, "org.subscription.note_capped")
	case model.FairShareModeHappyHour:
		return i18n.T(ctx, "org.subscription.note_happy_hour")
	default:
		return ""
	}
}

func clampPct(used, total int64) int {
	if total <= 0 {
		return 0
	}
	pct := int(used * 100 / total)
	if pct > 100 {
		return 100
	}
	if pct < 0 {
		return 0
	}
	return pct
}

func formatLargeInt(n int64) string {
	if n >= 1_000_000_000 {
		return fmt.Sprintf("%.1fG", float64(n)/1_000_000_000)
	}
	if n >= 1_000_000 {
		return fmt.Sprintf("%.1fM", float64(n)/1_000_000)
	}
	if n >= 1_000 {
		return fmt.Sprintf("%.1fK", float64(n)/1_000)
	}
	return fmt.Sprintf("%d", n)
}

// formatRemaining renders a duration as a compact, timezone-independent countdown.
func formatRemaining(ctx context.Context, remaining time.Duration) string {
	if remaining <= 0 {
		return i18n.T(ctx, "org.subscription.soon")
	}
	d := int(remaining.Hours()) / 24
	h := int(remaining.Hours()) % 24
	m := int(remaining.Minutes()) % 60
	if d > 0 {
		return i18n.T(ctx, "org.subscription.remaining_days", strconv.Itoa(d), fmt.Sprintf("%02d", h))
	}
	if h > 0 {
		return i18n.T(ctx, "org.subscription.remaining_hours", strconv.Itoa(h), fmt.Sprintf("%02d", m))
	}
	return i18n.T(ctx, "org.subscription.remaining_minutes", strconv.Itoa(m))
}

// formatUntil renders the countdown until the given instant.
func formatUntil(ctx context.Context, t time.Time) string {
	return formatRemaining(ctx, time.Until(t))
}

// formatTimeUntilReset returns the countdown until the oldest usage still counted in a
// sliding window ages out (oldestUsage + duration).
func formatTimeUntilReset(ctx context.Context, oldestUsage time.Time, duration time.Duration) string {
	return formatRemaining(ctx, time.Until(oldestUsage.Add(duration)))
}

// formatDurationLabel renders a plan window duration in a compact human form
// ("5h", "7j", "30m").
func formatDurationLabel(ctx context.Context, d time.Duration) string {
	switch {
	case d%(24*time.Hour) == 0:
		return i18n.T(ctx, "org.subscription.duration_days", strconv.Itoa(int(d.Hours())/24))
	case d%time.Hour == 0:
		return i18n.T(ctx, "org.subscription.duration_hours", strconv.Itoa(int(d.Hours())))
	case d%time.Minute == 0:
		return i18n.T(ctx, "org.subscription.duration_minutes", strconv.Itoa(int(d.Minutes())))
	default:
		return d.String()
	}
}

// subscriptionKeyLabel names a key of a pooled plan: its label, or the
// provider's own key.
func subscriptionKeyLabel(ctx context.Context, k SubscriptionKeyUsage) string {
	if k.Label == "" {
		return i18n.T(ctx, "org.subscription.primary_key")
	}
	return k.Label
}
