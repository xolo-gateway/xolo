package component

import (
	"context"
	"fmt"
	"strconv"
	"time"

	"github.com/xolo-gateway/xolo/internal/core/model"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/card"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/progress"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

// SubscriptionUsageSection renders plan consumption for each subscription provider.
// Shown at the top of the usage page only when at least one subscription provider exists.
templ SubscriptionUsageSection(providers []SubscriptionProviderUsage) {
	if len(providers) > 0 {
		<div class="space-y-3">
			@common.SectionTitle() {
				{ i18n.T(ctx, "org.subscription.title") }
			}
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				for _, pu := range providers {
					@subscriptionProviderCard(pu)
				}
			</div>
		</div>
	}
}

templ subscriptionProviderCard(pu SubscriptionProviderUsage) {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				<div class="flex items-center gap-2">
					<span>{ pu.Provider.Name() }</span>
					if pu.PerUser {
						@common.Badge(common.ToneNeutral, i18n.T(ctx, "org.subscription.my_share"))
					}
				</div>
			}
			@card.Description() {
				if pu.PerUser {
					{ i18n.T(ctx, "org.subscription.personal_share", pu.Plan.Label) }
				} else {
					{ pu.Plan.Label }
				}
			}
		}
		@card.Content() {
			<div class="space-y-4">
				for _, cu := range pu.Constraints {
					if cu.Constraint.Kind == model.ConstraintRollingWindow {
						@rollingWindowConstraintRow(cu)
					} else if cu.Constraint.Kind == model.ConstraintConcurrency {
						@concurrencyConstraintRow(cu)
					}
				}
				if len(pu.Constraints) == 0 {
					<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "org.subscription.no_constraints") }</p>
				}
			</div>
		}
	}
}

templ rollingWindowConstraintRow(cu SubscriptionConstraintUsage) {
	<div class="space-y-2">
		<div class="flex flex-wrap items-center gap-2">
			<span class="text-sm font-medium">{ cu.Constraint.Label }</span>
			if cu.UpstreamModel != "" {
				<code class="text-xs">{ cu.UpstreamModel }</code>
			} else if cu.Constraint.PerModel() {
				@common.Badge(common.ToneNeutral, i18n.T(ctx, "org.subscription.per_model"))
			}
			if cu.Anchored {
				@common.Badge(common.ToneNeutral, i18n.T(ctx, "org.subscription.fixed_window"))
			} else {
				@common.Badge(common.ToneNeutral, i18n.T(ctx, "org.subscription.sliding_window"))
			}
			if cu.Exhausted {
				@common.Badge(common.ToneWarning, i18n.T(ctx, "org.subscription.exhausted_upstream"))
			}
		</div>
		if cu.Constraint.PerModel() && cu.UpstreamModel == "" {
			<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "org.subscription.per_model_note") }</p>
		}
		// The allocation basis. A share computed on the active users moves between
		// two visits, so the figures it was computed from are shown rather than left
		// for the reader to guess.
		if cu.ShareDegraded {
			<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "org.subscription.share_degraded") }</p>
		} else if cu.ActiveUsers > 0 && cu.MemberCount > 0 {
			<p class="text-xs text-muted-foreground">
				{ i18n.T(ctx, "org.subscription.share_basis", fmt.Sprintf("%d", cu.ActiveUsers), fmt.Sprintf("%d", cu.MemberCount)) }
			</p>
		}
		// Token budget bar
		if cu.Constraint.TokenBudget != nil && *cu.Constraint.TokenBudget > 0 {
			{{ pctTokens := clampPct(cu.TokensUsed, *cu.Constraint.TokenBudget) }}
			<div class="space-y-1">
				<div class="flex justify-between text-xs text-muted-foreground">
					<span class="flex items-center gap-2">
						{ i18n.T(ctx, "org.subscription.tokens") }
						@fairShareBadge(cu.TokenMode)
					</span>
					<span>{ fmt.Sprintf("%d%%", pctTokens) }</span>
				</div>
				@progressBar(pctTokens, pctTokens >= 90)
			</div>
			@fairShareNote(cu.TokenMode)
		} else if cu.Constraint.TokenBudget == nil && cu.TokensUsed > 0 {
			<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "org.subscription.tokens_used_unlimited", formatLargeInt(cu.TokensUsed)) }</p>
		}
		// Value budget bar
		if cu.Constraint.ValueBudget != nil && *cu.Constraint.ValueBudget > 0 {
			{{ pctValue := clampPct(cu.ValueUsed, *cu.Constraint.ValueBudget) }}
			<div class="space-y-1">
				<div class="flex justify-between text-xs text-muted-foreground">
					<span class="flex items-center gap-2">
						{ i18n.T(ctx, "org.subscription.value") }
						@fairShareBadge(cu.ValueMode)
					</span>
					<span>{ fmt.Sprintf("%d%%", pctValue) }</span>
				</div>
				@progressBar(pctValue, pctValue >= 90)
			</div>
			if cu.TokenMode != cu.ValueMode {
				@fairShareNote(cu.ValueMode)
			}
		}
		// Window timing. We always show a timezone-independent relative countdown.
		if cu.Anchored && !cu.ResetAt.IsZero() {
			// Fixed (tumbling) window aligned on the provider's real reset schedule.
			<p class="text-xs text-muted-foreground">
				{ i18n.T(ctx, "org.subscription.fixed_window_reset", formatDurationLabel(ctx, cu.Constraint.Duration.Duration()), formatUntil(ctx, cu.ResetAt)) }
			</p>
		} else if !cu.OldestUsage.IsZero() {
			// Sliding window: usage frees up progressively as the oldest records age out.
			<p class="text-xs text-muted-foreground">
				{ i18n.T(ctx, "org.subscription.sliding_window_frees", formatDurationLabel(ctx, cu.Constraint.Duration.Duration()), formatTimeUntilReset(ctx, cu.OldestUsage, cu.Constraint.Duration.Duration())) }
			</p>
		} else {
			<p class="text-xs text-muted-foreground">
				{ i18n.T(ctx, "org.subscription.sliding_window_idle", formatDurationLabel(ctx, cu.Constraint.Duration.Duration())) }
			</p>
		}
	</div>
}

// fairShareBadge names the regime a gauge was allocated under. The nominal
// regime carries no badge: only a share that is narrower or wider than usual
// needs accounting for.
templ fairShareBadge(mode model.FairShareMode) {
	if mode == model.FairShareModeThrottled {
		@common.Badge(common.ToneWarning, i18n.T(ctx, "org.subscription.share_throttled"))
	} else if mode == model.FairShareModeCapped {
		@common.Badge(common.ToneWarning, i18n.T(ctx, "org.subscription.share_capped"))
	} else if mode == model.FairShareModeHappyHour {
		@common.Badge(common.TonePositive, i18n.T(ctx, "org.subscription.share_happy_hour"))
	}
}

templ fairShareNote(mode model.FairShareMode) {
	if mode == model.FairShareModeThrottled {
		<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "org.subscription.note_throttled") }</p>
	} else if mode == model.FairShareModeCapped {
		<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "org.subscription.note_capped") }</p>
	} else if mode == model.FairShareModeHappyHour {
		<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "org.subscription.note_happy_hour") }</p>
	}
}

templ concurrencyConstraintRow(cu SubscriptionConstraintUsage) {
	<div class="space-y-2">
		<div class="flex items-center gap-2">
			<span class="text-sm font-medium">{ cu.Constraint.Label }</span>
			@common.Badge(common.ToneNeutral, i18n.T(ctx, "org.subscription.concurrency"))
			if cu.Exhausted {
				@common.Badge(common.ToneNegative, i18n.T(ctx, "org.subscription.exhausted"))
			}
		</div>
		if cu.Constraint.MaxConcurrent != nil {
			{{ pctConc := clampPct(int64(cu.InFlight), int64(*cu.Constraint.MaxConcurrent)) }}
			<div class="space-y-1">
				<div class="flex justify-between text-xs text-muted-foreground">
					<span>{ i18n.T(ctx, "org.subscription.concurrent_requests") }</span>
					<span>{ fmt.Sprintf("%d", cu.InFlight) } / { fmt.Sprintf("%d", *cu.Constraint.MaxConcurrent) }</span>
				</div>
				@progressBar(pctConc, cu.Exhausted)
			</div>
		} else {
			<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "org.subscription.concurrent_in_flight", fmt.Sprintf("%d", cu.InFlight)) }</p>
		}
	</div>
}

// progressBar renders a plan consumption bar.
// danger=true colours it with the destructive token instead of the primary one.
templ progressBar(pct int, danger bool) {
	{{ barClass := "bg-primary" }}
	if danger {
		{{ barClass = "bg-destructive" }}
	}
	@progress.Progress(progress.Props{
		Value:    pct,
		BarClass: barClass,
	})
}

// ── Helpers ───────────────────────────────────────────────────────────────────

func clampPct(used, total int64) int {
	if total <= 0 {
		return 0
	}
	pct := int(used * 100 / total)
	if pct > 100 {
		return 100
	}
	if pct < 0 {
		return 0
	}
	return pct
}

func formatLargeInt(n int64) string {
	if n >= 1_000_000_000 {
		return fmt.Sprintf("%.1fG", float64(n)/1_000_000_000)
	}
	if n >= 1_000_000 {
		return fmt.Sprintf("%.1fM", float64(n)/1_000_000)
	}
	if n >= 1_000 {
		return fmt.Sprintf("%.1fK", float64(n)/1_000)
	}
	return fmt.Sprintf("%d", n)
}

// formatRemaining renders a duration as a compact, timezone-independent countdown.
func formatRemaining(ctx context.Context, remaining time.Duration) string {
	if remaining <= 0 {
		return i18n.T(ctx, "org.subscription.soon")
	}
	d := int(remaining.Hours()) / 24
	h := int(remaining.Hours()) % 24
	m := int(remaining.Minutes()) % 60
	if d > 0 {
		return i18n.T(ctx, "org.subscription.remaining_days", strconv.Itoa(d), fmt.Sprintf("%02d", h))
	}
	if h > 0 {
		return i18n.T(ctx, "org.subscription.remaining_hours", strconv.Itoa(h), fmt.Sprintf("%02d", m))
	}
	return i18n.T(ctx, "org.subscription.remaining_minutes", strconv.Itoa(m))
}

// formatUntil renders the countdown until the given instant.
func formatUntil(ctx context.Context, t time.Time) string {
	return formatRemaining(ctx, time.Until(t))
}

// formatTimeUntilReset returns the countdown until the oldest usage still counted in a
// sliding window ages out (oldestUsage + duration).
func formatTimeUntilReset(ctx context.Context, oldestUsage time.Time, duration time.Duration) string {
	return formatRemaining(ctx, time.Until(oldestUsage.Add(duration)))
}

// formatDurationLabel renders a plan window duration in a compact human form
// ("5h", "7j", "30m").
func formatDurationLabel(ctx context.Context, d time.Duration) string {
	switch {
	case d%(24*time.Hour) == 0:
		return i18n.T(ctx, "org.subscription.duration_days", strconv.Itoa(int(d.Hours())/24))
	case d%time.Hour == 0:
		return i18n.T(ctx, "org.subscription.duration_hours", strconv.Itoa(int(d.Hours())))
	case d%time.Minute == 0:
		return i18n.T(ctx, "org.subscription.duration_minutes", strconv.Itoa(int(d.Minutes())))
	default:
		return d.String()
	}
}
