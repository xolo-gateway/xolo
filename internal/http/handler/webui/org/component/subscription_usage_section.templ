package component

import (
	"fmt"
	"time"

	"github.com/xolo-gateway/xolo/internal/core/model"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/card"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/progress"
)

// SubscriptionUsageSection renders plan consumption for each subscription provider.
// Shown at the top of the usage page only when at least one subscription provider exists.
templ SubscriptionUsageSection(providers []SubscriptionProviderUsage) {
	if len(providers) > 0 {
		<div class="space-y-3">
			@common.SectionTitle() {
				Abonnements
			}
			<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
				for _, pu := range providers {
					@subscriptionProviderCard(pu)
				}
			</div>
		</div>
	}
}

templ subscriptionProviderCard(pu SubscriptionProviderUsage) {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				<div class="flex items-center gap-2">
					<span>{ pu.Provider.Name() }</span>
					if pu.PerUser {
						@common.Badge(common.ToneNeutral, "Ma part")
					}
				</div>
			}
			@card.Description() {
				if pu.PerUser {
					{ pu.Plan.Label } — part personnelle (répartition équitable)
				} else {
					{ pu.Plan.Label }
				}
			}
		}
		@card.Content() {
			<div class="space-y-4">
				for _, cu := range pu.Constraints {
					if cu.Constraint.Kind == model.ConstraintRollingWindow {
						@rollingWindowConstraintRow(cu)
					} else if cu.Constraint.Kind == model.ConstraintConcurrency {
						@concurrencyConstraintRow(cu)
					}
				}
				if len(pu.Constraints) == 0 {
					<p class="text-xs text-muted-foreground">Aucune contrainte définie.</p>
				}
			</div>
		}
	}
}

templ rollingWindowConstraintRow(cu SubscriptionConstraintUsage) {
	<div class="space-y-2">
		<div class="flex items-center gap-2">
			<span class="text-sm font-medium">{ cu.Constraint.Label }</span>
			if cu.Anchored {
				@common.Badge(common.ToneNeutral, "Fenêtre fixe")
			} else {
				@common.Badge(common.ToneNeutral, "Fenêtre glissante")
			}
		</div>
		// The allocation basis. A share computed on the active users moves between
		// two visits, so the figures it was computed from are shown rather than left
		// for the reader to guess.
		if cu.ShareDegraded {
			<p class="text-xs text-muted-foreground">Nombre d'utilisateurs actifs indisponible : part calculée sur l'effectif complet.</p>
		} else if cu.ActiveUsers > 0 && cu.MemberCount > 0 {
			<p class="text-xs text-muted-foreground">
				Part calculée sur { fmt.Sprintf("%d", cu.ActiveUsers) } utilisateur(s) actif(s) sur { fmt.Sprintf("%d", cu.MemberCount) } membre(s)
			</p>
		}
		// Token budget bar
		if cu.Constraint.TokenBudget != nil && *cu.Constraint.TokenBudget > 0 {
			{{ pctTokens := clampPct(cu.TokensUsed, *cu.Constraint.TokenBudget) }}
			<div class="space-y-1">
				<div class="flex justify-between text-xs text-muted-foreground">
					<span class="flex items-center gap-2">
						Tokens
						@fairShareBadge(cu.TokenMode)
					</span>
					<span>{ fmt.Sprintf("%d%%", pctTokens) }</span>
				</div>
				@progressBar(pctTokens, pctTokens >= 90)
			</div>
			@fairShareNote(cu.TokenMode)
		} else if cu.Constraint.TokenBudget == nil && cu.TokensUsed > 0 {
			<p class="text-xs text-muted-foreground">{ formatLargeInt(cu.TokensUsed) } tokens consommés (pas de limite)</p>
		}
		// Value budget bar
		if cu.Constraint.ValueBudget != nil && *cu.Constraint.ValueBudget > 0 {
			{{ pctValue := clampPct(cu.ValueUsed, *cu.Constraint.ValueBudget) }}
			<div class="space-y-1">
				<div class="flex justify-between text-xs text-muted-foreground">
					<span class="flex items-center gap-2">
						Valeur
						@fairShareBadge(cu.ValueMode)
					</span>
					<span>{ fmt.Sprintf("%d%%", pctValue) }</span>
				</div>
				@progressBar(pctValue, pctValue >= 90)
			</div>
			if cu.TokenMode != cu.ValueMode {
				@fairShareNote(cu.ValueMode)
			}
		}
		// Window timing. We always show a timezone-independent relative countdown.
		if cu.Anchored && !cu.ResetAt.IsZero() {
			// Fixed (tumbling) window aligned on the provider's real reset schedule.
			<p class="text-xs text-muted-foreground">
				Fenêtre fixe de { formatDurationLabel(cu.Constraint.Duration.Duration()) } — réinitialisation dans { formatUntil(cu.ResetAt) }
			</p>
		} else if !cu.OldestUsage.IsZero() {
			// Sliding window: usage frees up progressively as the oldest records age out.
			<p class="text-xs text-muted-foreground">
				Fenêtre glissante de { formatDurationLabel(cu.Constraint.Duration.Duration()) } — se libère dans { formatTimeUntilReset(cu.OldestUsage, cu.Constraint.Duration.Duration()) }
			</p>
		} else {
			<p class="text-xs text-muted-foreground">
				Fenêtre glissante de { formatDurationLabel(cu.Constraint.Duration.Duration()) } — aucune consommation en cours
			</p>
		}
	</div>
}

// fairShareBadge names the regime a gauge was allocated under. The nominal
// regime carries no badge: only a share that is narrower or wider than usual
// needs accounting for.
templ fairShareBadge(mode model.FairShareMode) {
	if mode == model.FairShareModeThrottled {
		@common.Badge(common.ToneWarning, "Part réduite")
	} else if mode == model.FairShareModeHappyHour {
		@common.Badge(common.TonePositive, "Quota ouvert")
	}
}

templ fairShareNote(mode model.FairShareMode) {
	if mode == model.FairShareModeThrottled {
		<p class="text-xs text-muted-foreground">Le forfait se consomme plus vite que la fenêtre ne s'écoule : votre part est resserrée jusqu'à ce que la consommation rejoigne son rythme.</p>
	} else if mode == model.FairShareModeHappyHour {
		<p class="text-xs text-muted-foreground">Fin de fenêtre : le quota restant serait perdu à la réinitialisation, il est réparti entre les utilisateurs actifs.</p>
	}
}

templ concurrencyConstraintRow(cu SubscriptionConstraintUsage) {
	<div class="space-y-2">
		<div class="flex items-center gap-2">
			<span class="text-sm font-medium">{ cu.Constraint.Label }</span>
			@common.Badge(common.ToneNeutral, "Concurrence")
			if cu.Exhausted {
				@common.Badge(common.ToneNegative, "Épuisé")
			}
		</div>
		if cu.Constraint.MaxConcurrent != nil {
			{{ pctConc := clampPct(int64(cu.InFlight), int64(*cu.Constraint.MaxConcurrent)) }}
			<div class="space-y-1">
				<div class="flex justify-between text-xs text-muted-foreground">
					<span>Requêtes simultanées</span>
					<span>{ fmt.Sprintf("%d", cu.InFlight) } / { fmt.Sprintf("%d", *cu.Constraint.MaxConcurrent) }</span>
				</div>
				@progressBar(pctConc, cu.Exhausted)
			</div>
		} else {
			<p class="text-xs text-muted-foreground">{ fmt.Sprintf("%d", cu.InFlight) } requêtes simultanées en cours</p>
		}
	</div>
}

// progressBar renders a plan consumption bar.
// danger=true colours it with the destructive token instead of the primary one.
templ progressBar(pct int, danger bool) {
	{{ barClass := "bg-primary" }}
	if danger {
		{{ barClass = "bg-destructive" }}
	}
	@progress.Progress(progress.Props{
		Value:    pct,
		BarClass: barClass,
	})
}

// ── Helpers ───────────────────────────────────────────────────────────────────

func clampPct(used, total int64) int {
	if total <= 0 {
		return 0
	}
	pct := int(used * 100 / total)
	if pct > 100 {
		return 100
	}
	if pct < 0 {
		return 0
	}
	return pct
}

func formatLargeInt(n int64) string {
	if n >= 1_000_000_000 {
		return fmt.Sprintf("%.1fG", float64(n)/1_000_000_000)
	}
	if n >= 1_000_000 {
		return fmt.Sprintf("%.1fM", float64(n)/1_000_000)
	}
	if n >= 1_000 {
		return fmt.Sprintf("%.1fK", float64(n)/1_000)
	}
	return fmt.Sprintf("%d", n)
}

// formatRemaining renders a duration as a compact, timezone-independent countdown.
func formatRemaining(remaining time.Duration) string {
	if remaining <= 0 {
		return "bientôt"
	}
	d := int(remaining.Hours()) / 24
	h := int(remaining.Hours()) % 24
	m := int(remaining.Minutes()) % 60
	if d > 0 {
		return fmt.Sprintf("%dj%02dh", d, h)
	}
	if h > 0 {
		return fmt.Sprintf("%dh%02d", h, m)
	}
	return fmt.Sprintf("%dm", m)
}

// formatUntil renders the countdown until the given instant.
func formatUntil(t time.Time) string {
	return formatRemaining(time.Until(t))
}

// formatTimeUntilReset returns the countdown until the oldest usage still counted in a
// sliding window ages out (oldestUsage + duration).
func formatTimeUntilReset(oldestUsage time.Time, duration time.Duration) string {
	return formatRemaining(time.Until(oldestUsage.Add(duration)))
}

// formatDurationLabel renders a plan window duration in a compact human form
// ("5h", "7j", "30m").
func formatDurationLabel(d time.Duration) string {
	switch {
	case d%(24*time.Hour) == 0:
		return fmt.Sprintf("%dj", int(d.Hours())/24)
	case d%time.Hour == 0:
		return fmt.Sprintf("%dh", int(d.Hours()))
	case d%time.Minute == 0:
		return fmt.Sprintf("%dm", int(d.Minutes()))
	default:
		return d.String()
	}
}
