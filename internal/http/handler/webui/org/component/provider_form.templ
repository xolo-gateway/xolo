package component

import (
	"fmt"

	"github.com/xolo-gateway/xolo/internal/core/model"
	"github.com/xolo-gateway/xolo/internal/core/rbac"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/form"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/input"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/selectbox"
	switchcomp "github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/switch"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

// ── Provider Form ─────────────────────────────────────────────────────────────
templ ProviderForm(vmodel ProviderFormVModel) {
	{{ title := i18n.T(ctx, "org.provider.title_new") }}
	{{ action := common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers")) }}
	if !vmodel.IsNew && vmodel.Provider != nil {
		{{ title = i18n.T(ctx, "org.provider.title_edit", vmodel.Provider.Name()) }}
		{{ action = common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/", string(vmodel.Provider.ID()), "/edit")) }}
	}
	{{ writable := common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermProvidersWrite) }}
	{{ readonly := !writable }}
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(title)) {
		<div class="max-w-4xl">
			<form method="POST" action={ templ.SafeURL(action) }>
				@common.PageHeader(common.PageHeaderProps{Title: title}) {
					@button.Button(button.Props{
						Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers")),
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
						Type:    button.TypeButton,
					}) {
						{ i18n.T(ctx, "org.provider.cancel") }
					}
					if writable {
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
							{ i18n.T(ctx, "org.provider.save") }
						}
					}
				}
				@common.FlashError(vmodel.Error, i18n.T(ctx, "org.provider.flash_subject"))
				@common.Section() {
					@common.SectionBody(common.SectionBodyProps{Class: "flex flex-col gap-4"}) {
						<div class="grid gap-4 sm:grid-cols-[minmax(0,1fr)_200px]">
							@form.Item() {
								@form.Label(form.LabelProps{For: "provider_name"}) {
									{ i18n.T(ctx, "org.provider.name") }
								}
								@input.Input(input.Props{
									ID:         "provider_name",
									Name:       "name",
									Value:      providerName(vmodel),
									Disabled:   readonly,
									Attributes: templ.Attributes{"required": "required"},
								})
							}
							@form.Item() {
								@form.Label(form.LabelProps{}) {
									{ i18n.T(ctx, "org.provider.type") }
								}
								@selectbox.SelectBox(selectbox.Props{ID: "provider_type"}) {
									@selectbox.Trigger(selectbox.TriggerProps{Name: "provider_type", Disabled: readonly}) {
										@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "org.provider.type_placeholder")})
									}
									@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
										@selectbox.Group() {
											for _, t := range model.ProviderTypes() {
												@selectbox.Item(selectbox.ItemProps{Value: t, Selected: vmodel.Provider != nil && vmodel.Provider.Type() == t}) {
													{ t }
												}
											}
										}
									}
								}
							}
						</div>
						@form.Item() {
							@form.Label(form.LabelProps{For: "provider_base_url"}) {
								{ i18n.T(ctx, "org.provider.base_url") }
							}
							@form.Description() {
								{ i18n.T(ctx, "org.provider.base_url_examples") }
								@common.InlineSnippet("https://api.openai.com/v1")
								@common.InlineSnippet("https://api.mistral.ai/v1")
								@common.InlineSnippet("https://openrouter.ai/api/v1")
								@common.InlineSnippet("https://api.anthropic.com")
							}
							@input.Input(input.Props{
								ID:          "provider_base_url",
								Name:        "base_url",
								Value:       providerBaseURL(vmodel),
								Placeholder: "https://api.mistral.ai/v1",
								Class:       "font-mono",
								Disabled:    readonly,
								Attributes:  templ.Attributes{"required": "required"},
							})
						}
						@form.Item() {
							@form.Label(form.LabelProps{For: "provider_api_key"}) {
								if vmodel.IsNew {
									{ i18n.T(ctx, "org.provider.api_key") }
								} else {
									{ i18n.T(ctx, "org.provider.api_key_keep") }
								}
							}
							@input.Input(input.Props{
								ID:          "provider_api_key",
								Name:        "api_key",
								Type:        input.TypePassword,
								Placeholder: "sk-...",
								Class:       "font-mono",
								Disabled:    readonly,
								Attributes:  apiKeyAttributes(vmodel),
							})
							if vmodel.IsNew && vmodel.Error != "" {
								@form.Description() {
									{ i18n.T(ctx, "org.provider.api_key_retype") }
								}
							}
						}
						<div class="grid gap-4 sm:grid-cols-[200px_minmax(0,1fr)]">
							@form.Item() {
								@form.Label(form.LabelProps{}) {
									{ i18n.T(ctx, "org.provider.currency") }
								}
								@selectbox.SelectBox(selectbox.Props{ID: "provider_currency"}) {
									@selectbox.Trigger(selectbox.TriggerProps{Name: "currency", Disabled: readonly}) {
										@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "org.provider.currency_placeholder")})
									}
									@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
										@selectbox.Group() {
											for _, c := range model.SupportedCurrencies {
												@selectbox.Item(selectbox.ItemProps{Value: c, Selected: vmodel.Provider != nil && vmodel.Provider.Currency() == c}) {
													{ c }
												}
											}
										}
									}
								}
							}
							@form.Item() {
								@form.Label(form.LabelProps{}) {
									{ i18n.T(ctx, "org.provider.cloud_tier") }
								}
								@form.Description() {
									{ i18n.T(ctx, "org.provider.cloud_tier_help") }
								}
								{{ currentTier := 0 }}
								if vmodel.Provider != nil {
									{{ currentTier = vmodel.Provider.CloudTier() }}
								}
								@selectbox.SelectBox(selectbox.Props{ID: "cloud_tier"}) {
									@selectbox.Trigger(selectbox.TriggerProps{Name: "cloud_tier", Disabled: readonly}) {
										@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "org.provider.cloud_tier_placeholder")})
									}
									@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
										@selectbox.Group() {
											@selectbox.Item(selectbox.ItemProps{Value: "0", Selected: currentTier == 0}) {
												{ i18n.T(ctx, "org.provider.cloud_tier_0") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "1", Selected: currentTier == 1}) {
												{ i18n.T(ctx, "org.provider.cloud_tier_1") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: "2", Selected: currentTier == 2}) {
												{ i18n.T(ctx, "org.provider.cloud_tier_2") }
											}
										}
									}
								}
							}
						</div>
						<div class="max-w-xs">
							@form.Item() {
								@form.Label(form.LabelProps{}) {
									{ i18n.T(ctx, "org.provider.billing_mode") }
								}
								{{ currentBillingMode := model.BillingModePayg }}
								if vmodel.Provider != nil {
									{{ currentBillingMode = vmodel.Provider.BillingMode() }}
								}
								@selectbox.SelectBox(selectbox.Props{ID: "billing_mode"}) {
									@selectbox.Trigger(selectbox.TriggerProps{Name: "billing_mode", Disabled: readonly}) {
										@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "org.provider.billing_mode_placeholder")})
									}
									@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
										@selectbox.Group() {
											@selectbox.Item(selectbox.ItemProps{Value: string(model.BillingModePayg), Selected: currentBillingMode == model.BillingModePayg}) {
												{ i18n.T(ctx, "org.provider.billing_payg") }
											}
											@selectbox.Item(selectbox.ItemProps{Value: string(model.BillingModeSubscription), Selected: currentBillingMode == model.BillingModeSubscription}) {
												{ i18n.T(ctx, "org.provider.billing_subscription") }
											}
										}
									}
								}
							}
						</div>
						if !vmodel.IsNew && vmodel.Provider != nil {
							@form.ItemFlex() {
								@switchcomp.Switch(switchcomp.Props{ID: "active", Name: "active", Checked: vmodel.Provider.Active(), Disabled: readonly})
								@form.Label(form.LabelProps{For: "active"}) {
									{ i18n.T(ctx, "org.provider.active") }
								}
							}
						}
					}
				}
				if !vmodel.IsNew && vmodel.Provider != nil && vmodel.Provider.BillingMode() == model.BillingModeSubscription {
					<div class="mt-3.5">
						@SubscriptionPlanEditor(vmodel.Provider.SubscriptionPlan(), readonly, vmodel.Submitted)
					</div>
					@providerKeysSection(vmodel, readonly)
				}
				if !vmodel.IsNew && vmodel.Provider != nil {
					@providerResilienceSection(vmodel, readonly)
				}
				// Shown on creation too: a gateway that requires a session
				// header (OpenCode Go) refuses every request until it is set.
				@providerHeadersSection(vmodel, readonly)
				if writable {
					<div class="mt-3.5 flex flex-wrap items-center gap-2">
						@button.Button(button.Props{Type: button.TypeSubmit}) {
							{ i18n.T(ctx, "org.provider.save") }
						}
						if !vmodel.IsNew && vmodel.Provider != nil {
							@button.Button(button.Props{
								Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/", string(vmodel.Provider.ID()), "/test")),
								Variant: button.VariantOutline,
								Type:    button.TypeButton,
							}) {
								{ i18n.T(ctx, "org.provider.test_connection") }
							}
						}
					</div>
				}
			</form>
			if !vmodel.IsNew && vmodel.Provider != nil {
				@providerModelsShortcut(vmodel)
				<div class="mt-3.5">
					@common.Section(common.SectionProps{Class: "border-destructive/40"}) {
						@common.SectionHeader(common.SectionHeaderProps{Class: "border-destructive/40"}) {
							@common.SectionTitle() {
								{ i18n.T(ctx, "org.provider.danger_zone") }
							}
						}
						@common.SectionBody(common.SectionBodyProps{Class: "flex flex-wrap items-center gap-3.5"}) {
							<p class="min-w-0 flex-1 text-sm text-muted-foreground">
								{ i18n.T(ctx, "org.provider.delete_warning") }
							</p>
							@common.ConfirmDelete(common.ConfirmDeleteProps{
								URL:         common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/", string(vmodel.Provider.ID()))),
								Variant:     button.VariantDestructive,
								Label:       i18n.T(ctx, "org.provider.delete_label"),
								Title:       i18n.T(ctx, "org.provider.delete_title"),
								Description: i18n.T(ctx, "org.provider.delete_description"),
							})
						}
					}
				</div>
			}
		</div>
	}
}

// providerModelsShortcut points at the models screen. The mockup embeds the
// pricing table directly in the editor; the models live behind their own route
// and their own permission check here, so the editor links to them rather than
// duplicating the table.
templ providerModelsShortcut(vmodel ProviderFormVModel) {
	<div class="mt-3.5">
		@common.Section() {
			@common.SectionBody(common.SectionBodyProps{Class: "flex flex-wrap items-center gap-3.5"}) {
				<div class="min-w-0 flex-1">
					<div class="text-sm font-semibold">{ i18n.T(ctx, "org.provider.models_title") }</div>
					<p class="mt-0.5 text-sm text-muted-foreground">
						{ i18n.T(ctx, "org.provider.models_description", vmodel.Provider.Currency()) }
					</p>
				</div>
				@button.Button(button.Props{
					Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/", string(vmodel.Provider.ID()), "/models")),
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Class:   "gap-1.5",
				}) {
					@icon.BrainCircuit(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "org.provider.manage_models") }
				}
			}
		}
	</div>
}

// providerResilienceSection groups retry and rate limit, the two knobs that
// govern how the gateway behaves when the upstream endpoint misbehaves.
templ providerResilienceSection(vmodel ProviderFormVModel, readonly bool) {
	{{ retryCfg := vmodel.Provider.RetryConfig() }}
	{{ rlCfg := vmodel.Provider.RateLimitConfig() }}
	<div class="mt-3.5">
		@common.Section() {
			@common.SectionHeader() {
				@common.SectionTitle() {
					{ i18n.T(ctx, "org.provider.resilience") }
				}
			}
			@common.SectionBody(common.SectionBodyProps{Class: "flex flex-col gap-5"}) {
				<div class="flex flex-col gap-3.5">
					@form.ItemFlex() {
						@switchcomp.Switch(switchcomp.Props{ID: "retry_enabled", Name: "retry_enabled", Checked: retryCfg != nil && retryCfg.Enabled, Disabled: readonly})
						@form.Label(form.LabelProps{For: "retry_enabled"}) {
							{ i18n.T(ctx, "org.provider.retry") }
						}
					}
					<div class="grid gap-3.5 sm:grid-cols-2">
						@form.Item() {
							@form.Label(form.LabelProps{For: "retry_max_attempts"}) {
								{ i18n.T(ctx, "org.provider.retry_attempts") }
							}
							@input.Input(input.Props{
								ID:          "retry_max_attempts",
								Name:        "retry_max_attempts",
								Type:        input.TypeNumber,
								Value:       retryAttemptsValue(retryCfg),
								Placeholder: "3",
								Disabled:    readonly,
								Attributes:  templ.Attributes{"min": "1"},
							})
						}
						@form.Item() {
							@form.Label(form.LabelProps{For: "retry_delay_value"}) {
								{ i18n.T(ctx, "org.provider.retry_delay") }
							}
							<div class="flex gap-2">
								@input.Input(input.Props{
									ID:          "retry_delay_value",
									Name:        "retry_delay_value",
									Type:        input.TypeNumber,
									Value:       retryDelayValue(retryCfg),
									Placeholder: "1",
									Class:       "flex-1",
									Disabled:    readonly,
									Attributes:  templ.Attributes{"min": "1"},
								})
								@durationUnitSelect("retry_delay_unit", retryDelayUnit(retryCfg), readonly)
							</div>
						}
					</div>
				</div>
				<div class="flex flex-col gap-3.5 border-t pt-5">
					@form.ItemFlex() {
						@switchcomp.Switch(switchcomp.Props{ID: "rate_limit_enabled", Name: "rate_limit_enabled", Checked: rlCfg != nil && rlCfg.Enabled, Disabled: readonly})
						@form.Label(form.LabelProps{For: "rate_limit_enabled"}) {
							{ i18n.T(ctx, "org.provider.rate_limit") }
						}
					}
					<div class="grid gap-3.5 sm:grid-cols-2">
						@form.Item() {
							@form.Label(form.LabelProps{For: "rate_limit_interval_value"}) {
								{ i18n.T(ctx, "org.provider.rate_limit_interval") }
							}
							<div class="flex gap-2">
								@input.Input(input.Props{
									ID:          "rate_limit_interval_value",
									Name:        "rate_limit_interval_value",
									Type:        input.TypeNumber,
									Value:       rateLimitIntervalValue(rlCfg),
									Placeholder: "1",
									Class:       "flex-1",
									Disabled:    readonly,
									Attributes:  templ.Attributes{"min": "1"},
								})
								@durationUnitSelect("rate_limit_interval_unit", rateLimitIntervalUnit(rlCfg), readonly)
							</div>
						}
						@form.Item() {
							@form.Label(form.LabelProps{For: "rate_limit_max_burst"}) {
								{ i18n.T(ctx, "org.provider.rate_limit_burst") }
							}
							@input.Input(input.Props{
								ID:          "rate_limit_max_burst",
								Name:        "rate_limit_max_burst",
								Type:        input.TypeNumber,
								Value:       rateLimitBurstValue(rlCfg),
								Placeholder: "10",
								Disabled:    readonly,
								Attributes:  templ.Attributes{"min": "1"},
							})
						}
					</div>
				</div>
			}
		}
	</div>
}

// providerHeadersSection configures the headers a gateway requires, such as
// the session header and the User-Agent OpenCode Go asks for.
templ providerHeadersSection(vmodel ProviderFormVModel, readonly bool) {
	<div class="mt-3.5">
		@common.Section() {
			@common.SectionHeader() {
				@common.SectionTitle() {
					{ i18n.T(ctx, "org.provider.headers") }
				}
			}
			@common.SectionBody(common.SectionBodyProps{Class: "flex flex-col gap-5"}) {
				@form.Item() {
					@form.Label(form.LabelProps{For: "session_header"}) {
						{ i18n.T(ctx, "org.provider.session_header") }
					}
					@input.Input(input.Props{
						ID:          "session_header",
						Name:        "session_header",
						Value:       providerSessionHeader(vmodel.Provider),
						Placeholder: "x-opencode-session",
						Class:       "font-mono",
						Disabled:    readonly,
					})
					@form.Description() {
						@templ.Raw(i18n.T(ctx, "org.provider.session_header_help"))
					}
				}
				<div class="space-y-2">
					@form.Label(form.LabelProps{}) {
						{ i18n.T(ctx, "org.provider.fixed_headers") }
					}
					@ProviderHeadersEditor(providerHeaderRows(vmodel.Provider), readonly)
					@form.Description() {
						@templ.Raw(i18n.T(ctx, "org.provider.fixed_headers_help"))
					}
				</div>
			}
		}
	</div>
}

// providerKeysSection lists the keys a subscription provider holds besides
// its own, such as the keys of the members of a team subscription. The plan
// applies to each key; users are spread over the keys without ever seeing
// them.
templ providerKeysSection(vmodel ProviderFormVModel, readonly bool) {
	<div class="mt-3.5">
		@common.Section() {
			@common.SectionHeader() {
				@common.SectionTitle() {
					{ i18n.T(ctx, "org.provider.api_keys") }
				}
			}
			@common.SectionBody(common.SectionBodyProps{Class: "flex flex-col gap-3"}) {
				@form.Description() {
					@templ.Raw(i18n.T(ctx, "org.provider.api_keys_help"))
				}
				@ProviderKeysEditor(vmodel.Provider.ExtraAPIKeys(), vmodel.Provider.SubscriptionPlan(), readonly)
			}
		}
	</div>
}

// durationUnitSelect renders the ms/s/min companion of a duration field. Both
// resilience knobs pair a number with the same three units, so the select is
// factored out rather than written twice.
templ durationUnitSelect(name string, selected string, readonly bool) {
	@selectbox.SelectBox(selectbox.Props{ID: name, Class: "w-24"}) {
		@selectbox.Trigger(selectbox.TriggerProps{Name: name, Disabled: readonly}) {
			@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "org.provider.unit")})
		}
		@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
			@selectbox.Group() {
				for _, unit := range []string{"ms", "s", "min"} {
					@selectbox.Item(selectbox.ItemProps{Value: unit, Selected: unit == selected}) {
						{ unit }
					}
				}
			}
		}
	}
}

// apiKeyAttributes makes the API key mandatory on creation only: on edit an
// empty key means "keep the stored one".
func apiKeyAttributes(vmodel ProviderFormVModel) templ.Attributes {
	if vmodel.IsNew {
		return templ.Attributes{"required": "required"}
	}
	return nil
}

// providerName and providerBaseURL read a field of the provider being
// edited, or of the one rebuilt from a rejected creation form, so a
// validation error never costs the administrator what was typed. On a blank
// creation form Provider is nil and the fields are empty.
func providerName(vmodel ProviderFormVModel) string {
	if vmodel.Provider == nil {
		return ""
	}
	return vmodel.Provider.Name()
}

func providerBaseURL(vmodel ProviderFormVModel) string {
	if vmodel.Provider == nil {
		return ""
	}
	return vmodel.Provider.BaseURL()
}

// The retry*/rateLimit* helpers below render a possibly-nil config: a provider
// that has never had retry configured has no RetryConfig at all, and the field
// must then be empty so the placeholder shows the default.
func retryAttemptsValue(cfg *model.RetryConfig) string {
	if cfg == nil {
		return ""
	}
	return fmt.Sprintf("%d", cfg.MaxAttempts)
}

func retryDelayValue(cfg *model.RetryConfig) string {
	if cfg == nil {
		return ""
	}
	return durationValue(cfg.Delay)
}

// retryDelayUnit defaults to seconds, which is the unit a retry delay is written
// in when nothing has been configured.
func retryDelayUnit(cfg *model.RetryConfig) string {
	if cfg == nil {
		return "s"
	}
	return durationUnit(cfg.Delay)
}

func rateLimitIntervalValue(cfg *model.RateLimitConfig) string {
	if cfg == nil {
		return ""
	}
	return durationValue(cfg.Interval)
}

func rateLimitIntervalUnit(cfg *model.RateLimitConfig) string {
	if cfg == nil {
		return "s"
	}
	return durationUnit(cfg.Interval)
}

func rateLimitBurstValue(cfg *model.RateLimitConfig) string {
	if cfg == nil {
		return ""
	}
	return fmt.Sprintf("%d", cfg.MaxBurst)
}
