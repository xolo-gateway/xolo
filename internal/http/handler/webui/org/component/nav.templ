package component

import (
	"context"

	"github.com/xolo-gateway/xolo/internal/core/model"
	"github.com/xolo-gateway/xolo/internal/core/rbac"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

// EventsTabs renders the in-page sub-navigation shared by the events explorer,
// alerts and incidents pages. Alerts/Incidents tabs appear only for users who
// can manage alerts (org-wide or personal).
templ EventsTabs(org model.Organization, current, view string) {
	@common.SegmentedNav(eventsSegments(ctx, org, current, view))
}

// eventsSegments builds the three sub-navigation entries, dropping the ones the
// user is not allowed to see.
func eventsSegments(ctx context.Context, org model.Organization, current, view string) []common.Segment {
	slug := org.Slug()
	base := func(path string) string {
		return viewedPath(common.BaseURLString(ctx, common.WithPath("/orgs/", slug, path)), view)
	}

	segments := []common.Segment{
		{Label: i18n.T(ctx, "org.nav.events"), Href: base("/events"), Active: current == "events"},
	}

	canAlerts := common.HasPermission(ctx, org.ID(), rbac.PermEventsWrite) ||
		common.HasPermission(ctx, org.ID(), rbac.PermEventsAlertsOwn)
	if canAlerts {
		segments = append(segments,
			common.Segment{Label: i18n.T(ctx, "org.nav.alerts"), Href: base("/events/alerts"), Active: current == "alerts"},
			common.Segment{Label: i18n.T(ctx, "org.nav.incidents"), Href: base("/events/incidents"), Active: current == "incidents"},
		)
	}

	return segments
}
