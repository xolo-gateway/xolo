package component

import (
	"strconv"

	"github.com/xolo-gateway/xolo/internal/core/model"
	"github.com/xolo-gateway/xolo/internal/core/rbac"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/checkbox"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/input"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/label"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/selectbox"
	switchcomp "github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/switch"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/textarea"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

templ MiddlewaresPage(vmodel MiddlewaresPageVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(i18n.T(ctx, "org.middlewares.page_title", vmodel.Org.Name()))) {
		@common.PageHeader(common.PageHeaderProps{
			Title:    i18n.T(ctx, "org.middlewares.title"),
			Subtitle: i18n.T(ctx, "org.middlewares.subtitle"),
		}) {
			if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermMiddlewaresWrite) {
				@button.Button(button.Props{
					Size:  button.SizeSm,
					Class: "gap-1.5",
					Href:  common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/middlewares/new")),
				}) {
					@icon.Plus(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "org.middlewares.new") }
				}
			}
		}
		@common.FlashToast(vmodel.Success, i18n.T(ctx, "org.middlewares.flash_subject_success"))
		@common.FlashError(vmodel.Error, i18n.T(ctx, "org.middlewares.flash_subject_error"))
		if len(vmodel.Middlewares) == 0 {
			@common.EmptyState(common.EmptyStateProps{
				Icon:        icon.Layers,
				Title:       i18n.T(ctx, "org.middlewares.empty_title"),
				Description: i18n.T(ctx, "org.middlewares.empty_description"),
			}) {
				if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermMiddlewaresWrite) {
					@button.Button(button.Props{
						Size: button.SizeSm,
						Href: common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/middlewares/new")),
					}) {
						{ i18n.T(ctx, "org.middlewares.new") }
					}
				}
			}
		} else {
			<div class="flex flex-col gap-2">
				for _, mw := range vmodel.Middlewares {
					@middlewareRow(vmodel, mw)
				}
			</div>
			@common.SectionNote() {
				{ i18n.T(ctx, "org.middlewares.order_note") }
			}
		}
	}
}

// middlewareRow renders one middleware as the mockup's dense row: priority,
// identity, scope, then the enable switch and the pipeline shortcut.
templ middlewareRow(vmodel MiddlewaresPageVModel, mw model.Middleware) {
	{{ writable := common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermMiddlewaresWrite) }}
	<div class={ "flex flex-wrap items-center gap-3 rounded-lg border bg-card px-3.5 py-2.5", templ.KV("opacity-60", !mw.Enabled()) }>
		<span class="w-6 shrink-0 text-right font-mono text-xs text-muted-foreground" title={ i18n.T(ctx, "org.middlewares.priority") }>
			{ strconv.Itoa(mw.Priority()) }
		</span>
		@common.IconSquare(icon.Layers, middlewareTintClass(mw))
		<div class="min-w-0 flex-1">
			<div class="flex flex-wrap items-center gap-2">
				<span class="text-sm font-semibold">{ mw.Name() }</span>
				if plugin := middlewarePluginName(ctx, mw); plugin != "" {
					@common.Mono(plugin)
				}
			</div>
			if mw.Description() != "" {
				<div class="mt-0.5 text-xs text-muted-foreground">{ mw.Description() }</div>
			}
		</div>
		<span class="shrink-0">
			if mw.AppliesToAll() {
				@common.Badge(common.ToneInfo, i18n.T(ctx, "org.middlewares.all_models_badge"))
			} else {
				@common.Badge(common.ToneNeutral, i18n.T(ctx, "org.middlewares.target_count", len(mw.Targets())))
			}
		</span>
		<div class="w-24 shrink-0 text-right">
			// TODO(rework-ux): la maquette compte les déclenchements par middleware.
			// L'exécution d'un pipeline n'émet pas encore d'événement compté par
			// entité (cf. lot 7 du plan).
			@common.PendingValue(i18n.T(ctx, "org.middlewares.triggers_pending"))
			<div class="text-2xs text-muted-foreground">{ i18n.T(ctx, "org.middlewares.triggers") }</div>
		</div>
		<div class="flex shrink-0 items-center gap-2">
			@middlewareToggle(vmodel, mw, writable)
			if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermMiddlewaresRead) {
				@button.Button(button.Props{
					Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/middlewares/", string(mw.ID()), "/pipeline")),
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
				}) {
					{ i18n.T(ctx, "org.middlewares.pipeline") }
				}
			}
			if writable {
				@button.Button(button.Props{
					Href:       common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/middlewares/", string(mw.ID()), "/edit")),
					Variant:    button.VariantGhost,
					Size:       button.SizeIcon,
					Class:      "size-7",
					Attributes: templ.Attributes{"title": i18n.T(ctx, "org.middlewares.edit")},
				}) {
					@icon.Pencil(icon.Props{Class: "size-3.5"})
				}
				@common.ConfirmDelete(common.ConfirmDeleteProps{
					URL:         common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/middlewares/", string(mw.ID()))),
					Tooltip:     i18n.T(ctx, "org.middlewares.delete_tooltip"),
					Title:       i18n.T(ctx, "org.middlewares.delete_title"),
					Description: i18n.T(ctx, "org.middlewares.delete_description"),
				})
			}
		</div>
	</div>
}

// middlewareToggle renders the enable switch of a row.
//
// It posts to the edit endpoint the form page already uses, so toggling from the
// list goes through the same validation as toggling from the editor; the switch
// submits its own form to keep the row a link-and-form area rather than a script.
templ middlewareToggle(vmodel MiddlewaresPageVModel, mw model.Middleware, writable bool) {
	if writable {
		<form
			method="POST"
			action={ templ.SafeURL(common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/middlewares/", string(mw.ID()), "/toggle"))) }
			class="flex items-center"
		>
			@switchcomp.Switch(switchcomp.Props{
				ID:      "enabled-" + string(mw.ID()),
				Name:    "enabled",
				Value:   "1",
				Checked: mw.Enabled(),
				Attributes: templ.Attributes{
					"data-xolo-submit-on-change": true,
					"title":                      middlewareToggleTitle(ctx, mw),
				},
			})
		</form>
	} else {
		if mw.Enabled() {
			@common.Badge(common.TonePositive, i18n.T(ctx, "org.middlewares.enabled_badge"))
		} else {
			@common.Badge(common.ToneNeutral, i18n.T(ctx, "org.middlewares.disabled_badge"))
		}
	}
}

templ MiddlewareFormPage(vmodel MiddlewareFormVModel) {
	{{ title := i18n.T(ctx, "org.middlewares.title_new") }}
	{{ action := common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/middlewares")) }}
	if !vmodel.IsNew {
		{{ title = i18n.T(ctx, "org.middlewares.title_edit") }}
		{{ action = common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/middlewares/", string(vmodel.Middleware.ID()), "/edit")) }}
	}
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(title)) {
		<div class="space-y-6 max-w-2xl">
			@common.PageHeader(common.PageHeaderProps{
				Title: title,
			})
			@common.FlashError(vmodel.Error, i18n.T(ctx, "org.middlewares.flash_subject_error"))
			<form method="POST" action={ templ.SafeURL(action) } class="space-y-5">
				<div class="space-y-2">
					@label.Label(label.Props{For: "name"}) {
						{ i18n.T(ctx, "org.middlewares.name") }
					}
					@input.Input(input.Props{
						ID:          "name",
						Name:        "name",
						Value:       vmodel.Name,
						Placeholder: i18n.T(ctx, "org.middlewares.name_placeholder"),
						Attributes:  templ.Attributes{"required": true},
					})
				</div>
				<div class="space-y-2">
					@label.Label(label.Props{For: "description"}) {
						{ i18n.T(ctx, "org.middlewares.description") }
					}
					@textarea.Textarea(textarea.Props{ID: "description", Name: "description", Rows: 2, Value: vmodel.Description})
				</div>
				if !vmodel.IsNew {
					<div class="flex items-center gap-2">
						@checkbox.Checkbox(checkbox.Props{ID: "enabled", Name: "enabled", Value: "1", Checked: vmodel.Enabled})
						@label.Label(label.Props{For: "enabled"}) {
							{ i18n.T(ctx, "org.middlewares.enabled") }
						}
					</div>
					<div class="space-y-2">
						@label.Label(label.Props{For: "priority"}) {
							{ i18n.T(ctx, "org.middlewares.priority") }
						}
						@input.Input(input.Props{
							ID:    "priority",
							Name:  "priority",
							Type:  input.TypeNumber,
							Value: strconv.Itoa(vmodel.Priority),
						})
						<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "org.middlewares.priority_help") }</p>
					</div>
					<div class="space-y-3 rounded-lg border p-4">
						<div class="flex items-center gap-2">
							@checkbox.Checkbox(checkbox.Props{ID: "applies_to_all", Name: "applies_to_all", Value: "1", Checked: vmodel.AppliesToAll})
							@label.Label(label.Props{For: "applies_to_all"}) {
								{ i18n.T(ctx, "org.middlewares.applies_to_all") }
							}
						</div>
						<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "org.middlewares.targets_help") }</p>
						if len(vmodel.Options) == 0 {
							<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "org.middlewares.no_models") }</p>
						} else {
							@selectbox.SelectBox() {
								@selectbox.Trigger(selectbox.TriggerProps{
									Name:              "targets",
									Multiple:          true,
									ShowPills:         true,
									SelectedCountText: i18n.T(ctx, "org.middlewares.selected_count"),
								}) {
									@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "org.middlewares.targets_placeholder"), Multiple: true})
								}
								@selectbox.Content(selectbox.ContentProps{SearchPlaceholder: i18n.T(ctx, "org.middlewares.targets_search")}) {
									for _, opt := range vmodel.Options {
										{{ key := TargetKey(opt.Kind, opt.ID) }}
										@selectbox.Item(selectbox.ItemProps{Value: key, Selected: vmodel.Selected[key]}) {
											{ opt.Label }
										}
									}
								}
							}
						}
					</div>
				}
				<div class="flex gap-2">
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						{ i18n.T(ctx, "org.middlewares.save") }
					}
					@button.Button(button.Props{
						Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/middlewares")),
						Variant: button.VariantOutline,
					}) {
						{ i18n.T(ctx, "org.middlewares.cancel") }
					}
				</div>
			</form>
			if !vmodel.IsNew {
				<div class="rounded-lg border p-4 flex items-center justify-between">
					<div>
						<div class="font-medium">{ i18n.T(ctx, "org.middlewares.pipeline") }</div>
						<div class="text-sm text-muted-foreground">{ i18n.T(ctx, "org.middlewares.pipeline_help") }</div>
					</div>
					@button.Button(button.Props{
						Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/middlewares/", string(vmodel.Middleware.ID()), "/pipeline")),
						Variant: button.VariantOutline,
					}) {
						@icon.Workflow(icon.Props{Size: 14, Class: "mr-2"})
						{ i18n.T(ctx, "org.middlewares.configure_pipeline") }
					}
				</div>
			}
		</div>
	}
}
