package component

import (
	"context"

	"github.com/xolo-gateway/xolo/internal/core/rbac"
	commonComp "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/checkbox"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/form"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/input"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/label"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

// roleFormAction returns the form submission URL for create or edit.
func roleFormAction(ctx context.Context, vmodel RoleFormVModel) string {
	if vmodel.IsNew || vmodel.Role == nil {
		return commonComp.BaseURLString(ctx, commonComp.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/roles"))
	}
	return commonComp.BaseURLString(ctx, commonComp.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/roles/", string(vmodel.Role.ID()), "/edit"))
}

templ RoleForm(vmodel RoleFormVModel) {
	@commonComp.AppLayout(vmodel.AppLayoutVModel, commonComp.WithTitle(i18n.T(ctx, "org.members.role_form.page_title"))) {
		{{ readonly := !commonComp.HasPermission(ctx, vmodel.Org.ID(), rbac.PermRolesWrite) }}
		<div class="max-w-5xl">
			@commonComp.PageHeader(commonComp.PageHeaderProps{
				Title:    roleFormTitle(ctx, vmodel),
				Subtitle: i18n.T(ctx, "org.members.role_form.subtitle"),
			}) {
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Class:   "gap-1.5",
					Href:    commonComp.BaseURLString(ctx, commonComp.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/roles")),
				}) {
					@icon.ArrowLeft(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "org.members.role_form.back") }
				}
			}
			if vmodel.Error != "" {
				<div class="mb-3.5">
					@commonComp.InfoBanner(commonComp.ToneNegative, vmodel.Error)
				</div>
			}
			<div class="mb-3.5">
				@commonComp.InfoBanner(commonComp.ToneInfo, i18n.T(ctx, "org.members.role_form.models_note"))
			</div>
			<form method="POST" action={ templ.SafeURL(roleFormAction(ctx, vmodel)) }>
				<div class="space-y-3.5">
					@commonComp.Section() {
						@commonComp.SectionHeader() {
							@commonComp.SectionTitle() {
								{ i18n.T(ctx, "org.members.role_form.section_info") }
							}
						}
						@commonComp.SectionBody() {
							<div class="grid gap-3.5 sm:grid-cols-2">
								@form.Item() {
									@label.Label(label.Props{For: "name"}) {
										{ i18n.T(ctx, "org.members.role_form.name") }
									}
									@input.Input(input.Props{
										ID:          "name",
										Name:        "name",
										Value:       roleName(vmodel),
										Placeholder: i18n.T(ctx, "org.members.role_form.name_placeholder"),
										Disabled:    roleFieldsLocked(vmodel) || readonly,
										Attributes:  templ.Attributes{"required": "required"},
									})
								}
								@form.Item() {
									@label.Label(label.Props{For: "description"}) {
										{ i18n.T(ctx, "org.members.role_form.description") }
									}
									@input.Input(input.Props{
										ID:          "description",
										Name:        "description",
										Value:       roleDescription(vmodel),
										Placeholder: i18n.T(ctx, "org.members.role_form.description_placeholder"),
										Disabled:    roleFieldsLocked(vmodel) || readonly,
									})
								}
							</div>
						}
					}
					<!-- Groupes de permissions sur deux colonnes : la maquette pose
					l'éditeur en 2 colonnes, chaque groupe restant une carte. -->
					<div class="grid gap-3.5 lg:grid-cols-2">
						for _, group := range rbac.Catalog() {
							@commonComp.Section() {
								@commonComp.SectionHeader() {
									@commonComp.SectionTitle() {
										{ commonComp.PermissionGroupLabel(ctx, group) }
									}
								}
								@commonComp.SectionBody(commonComp.SectionBodyProps{Class: "space-y-2.5"}) {
									for _, def := range group.Perms {
										<div class="flex items-start gap-3">
											@checkbox.Checkbox(checkbox.Props{
												ID:       "perm-" + string(def.Code),
												Name:     "permissions",
												Value:    string(def.Code),
												Checked:  vmodel.Selected[string(def.Code)],
												Disabled: readonly,
											})
											@label.Label(label.Props{For: "perm-" + string(def.Code)}) {
												{ commonComp.PermissionLabel(ctx, def) }
												if def.TeamScopable {
													<span class={ "ml-1.5 inline-flex rounded px-1.5 py-0.5 text-[11px] font-medium", commonComp.ToneInfo.BadgeClass() }>{ i18n.T(ctx, "org.members.role_form.team_scopable") }</span>
												}
											}
										</div>
									}
								}
							}
						}
					</div>
					<div class="flex items-center gap-2">
						if commonComp.HasPermission(ctx, vmodel.Org.ID(), rbac.PermRolesWrite) {
							@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Class: "gap-1.5"}) {
								@icon.Save(icon.Props{Class: "size-3.5"})
								{ i18n.T(ctx, "org.members.role_form.save") }
							}
						}
						@button.Button(button.Props{Variant: button.VariantGhost, Size: button.SizeSm, Href: commonComp.BaseURLString(ctx, commonComp.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/roles"))}) {
							{ i18n.T(ctx, "org.members.role_form.cancel") }
						}
					</div>
				</div>
			</form>
		</div>
	}
}

func roleName(vmodel RoleFormVModel) string {
	if vmodel.Role == nil {
		return ""
	}
	return vmodel.Role.Name()
}

func roleDescription(vmodel RoleFormVModel) string {
	if vmodel.Role == nil {
		return ""
	}
	return vmodel.Role.Description()
}

// roleFieldsLocked reports whether the name/description fields are read-only
// (true for builtin roles, whose identity is fixed).
func roleFieldsLocked(vmodel RoleFormVModel) bool {
	return vmodel.Role != nil && vmodel.Role.Builtin()
}

// roleFormTitle names the screen: a new role has no name yet, an existing one
// carries its own.
func roleFormTitle(ctx context.Context, vmodel RoleFormVModel) string {
	if vmodel.IsNew || vmodel.Role == nil {
		return i18n.T(ctx, "org.members.role_form.new_title")
	}
	return vmodel.Role.Name()
}
