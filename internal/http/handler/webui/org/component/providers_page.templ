package component

import (
	"strconv"

	"github.com/xolo-gateway/xolo/internal/core/model"
	"github.com/xolo-gateway/xolo/internal/core/rbac"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

// ── Providers Page ────────────────────────────────────────────────────────────
templ ProvidersPage(vmodel ProvidersPageVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(i18n.T(ctx, "org.models.providers.page_title", vmodel.Org.Name()))) {
		@common.PageHeader(common.PageHeaderProps{
			Title:    i18n.T(ctx, "org.models.providers.title"),
			Subtitle: i18n.T(ctx, "org.models.providers.subtitle", vmodel.Org.Name()),
		}) {
			if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermProvidersWrite) {
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Class:   "gap-1.5",
					Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/import")),
				}) {
					@icon.FileUp(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "org.provider_bundle.import_provider") }
				}
				@button.Button(button.Props{
					Size:  button.SizeSm,
					Class: "gap-1.5",
					Href:  common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/new")),
				}) {
					@icon.Plus(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "org.models.providers.add") }
				}
			}
		}
		if vmodel.Success != "" {
			<div class="mb-3.5">
				@common.InfoBanner(common.TonePositive, i18n.T(ctx, "org.models.providers.success"))
			</div>
		}
		if len(vmodel.Providers) == 0 {
			@common.EmptyState(common.EmptyStateProps{
				Icon:        icon.Server,
				Title:       i18n.T(ctx, "org.models.providers.empty_title"),
				Description: i18n.T(ctx, "org.models.providers.empty_description"),
			}) {
				if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermProvidersWrite) {
					@button.Button(button.Props{
						Size: button.SizeSm,
						Href: common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/new")),
					}) {
						{ i18n.T(ctx, "org.models.providers.add") }
					}
				}
			}
		} else {
			<div class="flex flex-col gap-2.5">
				for _, p := range vmodel.Providers {
					@providerRow(vmodel, p)
				}
			</div>
		}
	}
}

// providerRow renders one provider as the mockup's framed row: identity on the
// left, the figures strip in the middle, the actions on the right, and — for a
// subscription provider — a footer carrying the plan.
templ providerRow(vmodel ProvidersPageVModel, p model.Provider) {
	@common.Section() {
		@common.SectionBody(common.SectionBodyProps{Class: "flex flex-wrap items-center gap-3.5"}) {
			@common.IconSquare(icon.Server, providerTintClass(p))
			<div class="min-w-0 flex-1">
				<div class="flex flex-wrap items-center gap-2">
					<span class="text-sm font-semibold">{ p.Name() }</span>
					if p.Active() {
						@common.Badge(common.TonePositive, i18n.T(ctx, "org.models.providers.badge_active"))
					} else {
						@common.Badge(common.ToneNeutral, i18n.T(ctx, "org.models.providers.badge_inactive"))
					}
					@common.Badge(common.ToneNeutral, p.Type())
					if p.BillingMode() == model.BillingModeSubscription {
						@common.Badge(common.ToneInfo, i18n.T(ctx, "org.models.providers.badge_subscription"))
					}
				</div>
				@common.Mono(p.BaseURL())
			</div>
			<div class="flex shrink-0 flex-wrap items-start gap-5.5">
				@common.InlineStat(i18n.T(ctx, "org.models.providers.models"), common.ToneNeutral) {
					{ strconv.Itoa(vmodel.ModelCounts[p.ID()]) }
				}
				// TODO(rework-ux): la maquette affiche coût 30 j, p95 et taux
				// d'erreur par fournisseur. Aucun agrégat d'usage n'est indexé par
				// ProviderID côté domaine (port.UsageStore agrège par modèle), donc
				// les colonnes gardent leur place sans inventer de chiffre.
				@common.InlineStat(i18n.T(ctx, "org.models.providers.stat_cost_30d"), common.ToneNeutral) {
					@common.PendingValue(i18n.T(ctx, "org.models.providers.pending_cost"))
				}
				@common.InlineStat(i18n.T(ctx, "org.models.providers.stat_p95"), common.ToneNeutral) {
					@common.PendingValue(i18n.T(ctx, "org.models.providers.pending_latency"))
				}
				@common.InlineStat(i18n.T(ctx, "org.models.providers.stat_errors"), common.ToneNeutral) {
					@common.PendingValue(i18n.T(ctx, "org.models.providers.pending_errors"))
				}
			</div>
			<div class="flex shrink-0 items-center gap-1">
				@button.Button(button.Props{
					Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/", string(p.ID()), "/models")),
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
				}) {
					{ i18n.T(ctx, "org.models.providers.models") }
				}
				if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermProvidersWrite) {
					@button.Button(button.Props{
						Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/", string(p.ID()), "/edit")),
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
					}) {
						{ i18n.T(ctx, "org.models.providers.configure") }
					}
					@common.ConfirmDelete(common.ConfirmDeleteProps{
						URL:         common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers/", string(p.ID()))),
						Tooltip:     i18n.T(ctx, "org.models.providers.delete"),
						Title:       i18n.T(ctx, "org.models.providers.delete_title"),
						Description: i18n.T(ctx, "org.models.providers.delete_description"),
					})
				}
			</div>
		}
		if plan := p.SubscriptionPlan(); plan != nil && plan.Label != "" {
			<div class="flex flex-wrap items-center gap-2.5 border-t bg-row-hover px-4 py-2">
				<span class="text-xs text-muted-foreground">{ i18n.T(ctx, "org.models.providers.plan", plan.Label) }</span>
				// TODO(rework-ux): la maquette montre ici la jauge de consommation
				// du forfait. Elle demande un rapprochement usage ↔ contraintes de
				// plan qui n'existe pas encore (cf. lot 7 du plan).
				@common.PendingValue(i18n.T(ctx, "org.models.providers.pending_plan_usage"))
			</div>
		}
	}
}

// providerTintClass returns the tint of a provider's icon square: the semantic
// colour of an inactive provider is the muted one, so a disabled endpoint reads
// as switched off before the pill is even read.
func providerTintClass(p model.Provider) string {
	if !p.Active() {
		return "bg-muted text-muted-foreground"
	}
	return "bg-primary-tint text-primary"
}
