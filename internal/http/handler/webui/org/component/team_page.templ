package component

import (
	"context"
	"strings"

	"github.com/xolo-gateway/xolo/internal/core/model"
	"github.com/xolo-gateway/xolo/internal/core/rbac"
	"github.com/xolo-gateway/xolo/internal/i18n"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/checkbox"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/form"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/input"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/label"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/radio"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/selectbox"
	switchcomp "github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/switch"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/table"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/textarea"
)

// ── Team Page ─────────────────────────────────────────────────────────────────
templ TeamPage(vmodel TeamPageVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(i18n.T(ctx, "org.team.page_title", vmodel.Team.Name()))) {
		<div class="max-w-5xl space-y-3.5">
			@common.PageHeader(common.PageHeaderProps{
				Title:    vmodel.Team.Name(),
				Subtitle: i18n.T(ctx, "org.team.subtitle", vmodel.SampleModel),
			}) {
				if vmodel.CanEditTeam {
					<form method="POST" action={ templ.SafeURL(teamsURL(ctx, vmodel.Org, "/", string(vmodel.Team.ID()), "/status")) }>
						if vmodel.Team.Status() == model.StatusSuspended {
							<input type="hidden" name="status" value="active"/>
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm, Class: "gap-1.5"}) {
								@icon.CirclePlay(icon.Props{Class: "size-3.5"})
								{ i18n.T(ctx, "org.team.reactivate") }
							}
						} else {
							<input type="hidden" name="status" value="suspended"/>
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm, Class: "gap-1.5"}) {
								@icon.CirclePause(icon.Props{Class: "size-3.5"})
								{ i18n.T(ctx, "org.team.suspend") }
							}
						}
					</form>
				}
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Class: "gap-1.5", Href: teamsURL(ctx, vmodel.Org)}) {
					@icon.ArrowLeft(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "org.team.back") }
				}
			}
			if vmodel.Team.Status() == model.StatusSuspended {
				@common.InfoBanner(common.ToneWarning, i18n.T(ctx, "org.team.suspended_banner"))
			}
			if vmodel.Success != "" {
				@common.InfoBanner(common.TonePositive, teamSuccessMessage(ctx, vmodel.Success))
			}
			if vmodel.Error != "" {
				@common.InfoBanner(common.ToneNegative, vmodel.Error)
			}
			<form method="POST" action={ templ.SafeURL(teamsURL(ctx, vmodel.Org, "/", string(vmodel.Team.ID()), "/edit")) } class="space-y-3.5">
				@common.Section() {
					@common.SectionHeader() {
						@common.SectionTitle() {
							{ i18n.T(ctx, "org.team.info.title") }
						}
						<span class="ml-auto">
							@common.Mono(vmodel.Org.Slug() + "/" + vmodel.Team.Slug() + "/…")
						</span>
					}
					@common.SectionBody(common.SectionBodyProps{Class: "space-y-3.5"}) {
						@form.Item() {
							@label.Label(label.Props{For: "name"}) {
								{ i18n.T(ctx, "org.team.info.name") }
							}
							@input.Input(input.Props{ID: "name", Name: "name", Value: vmodel.Team.Name(), Disabled: !vmodel.CanEditTeam, Attributes: templ.Attributes{"required": "required"}})
						}
						@form.Item() {
							@label.Label(label.Props{For: "slug"}) {
								{ i18n.T(ctx, "org.team.info.slug") }
							}
							@input.Input(input.Props{ID: "slug", Name: "slug", Value: vmodel.Team.Slug(), Disabled: !vmodel.CanEditTeam, Attributes: templ.Attributes{"required": "required", "pattern": "[a-z0-9]([a-z0-9-]*[a-z0-9])?", "maxlength": "63"}})
							@form.Description() {
								{ i18n.T(ctx, "org.team.info.slug_help", vmodel.Org.Slug(), vmodel.Team.Slug()) }
							}
						}
						@form.Item() {
							@label.Label(label.Props{For: "description"}) {
								{ i18n.T(ctx, "org.team.info.description") }
							}
							@textarea.Textarea(textarea.Props{ID: "description", Name: "description", Value: vmodel.Team.Description(), Rows: 2, Disabled: !vmodel.CanEditTeam})
						}
					}
				}
				<div class="grid gap-3.5 lg:grid-cols-2">
					@common.Section() {
						@common.SectionHeader() {
							@common.SectionTitle() {
								{ i18n.T(ctx, "org.team.models.title") }
							}
						}
						@common.SectionBody(common.SectionBodyProps{Class: "space-y-2.5"}) {
							<p class="text-xs text-muted-foreground">
								{ i18n.T(ctx, "org.team.models.help") }
							</p>
							if len(vmodel.ModelOptions) == 0 {
								<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "org.team.models.empty") }</p>
							}
							for _, opt := range vmodel.ModelOptions {
								<div class="flex items-start gap-3">
									@checkbox.Checkbox(checkbox.Props{
										ID:       "model-" + opt.Kind + "-" + opt.ID,
										Name:     "models",
										Value:    opt.Kind + ":" + opt.ID,
										Checked:  vmodel.SelectedModels[opt.Kind+":"+opt.ID],
										Disabled: !vmodel.CanEditTeam,
									})
									@label.Label(label.Props{For: "model-" + opt.Kind + "-" + opt.ID}) {
										<span class="font-mono text-xs">{ opt.Label }</span>
										if opt.Kind == rbac.ModelKindVirtual {
											<span class="ml-1">
												@common.Badge(common.ToneInfo, i18n.T(ctx, "org.team.models.virtual_badge"))
											</span>
										}
									}
								</div>
							}
						}
					}
					@common.Section() {
						@common.SectionHeader() {
							@common.SectionTitle() {
								{ i18n.T(ctx, "org.team.middlewares.title") }
							}
						}
						@common.SectionBody(common.SectionBodyProps{Class: "space-y-2.5"}) {
							<p class="text-xs text-muted-foreground">
								{ i18n.T(ctx, "org.team.middlewares.help") }
							</p>
							if len(vmodel.MiddlewareOptions) == 0 {
								<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "org.team.middlewares.empty") }</p>
							}
							for _, opt := range vmodel.MiddlewareOptions {
								<div class="flex items-start gap-3">
									@checkbox.Checkbox(checkbox.Props{
										ID:       "mw-" + opt.ID,
										Name:     "middlewares",
										Value:    opt.ID,
										Checked:  vmodel.SelectedMiddlewares[opt.ID],
										Disabled: !vmodel.CanEditTeam,
									})
									@label.Label(label.Props{For: "mw-" + opt.ID}) {
										{ opt.Name }
										if !opt.Enabled {
											<span class="ml-1">
												@common.Badge(common.ToneNeutral, i18n.T(ctx, "org.team.middlewares.disabled_badge"))
											</span>
										}
									}
								</div>
							}
						}
					}
				</div>
				if vmodel.CanEditTeam {
					<div class="flex items-center gap-2">
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Class: "gap-1.5"}) {
							@icon.Save(icon.Props{Class: "size-3.5"})
							{ i18n.T(ctx, "org.team.save") }
						}
					</div>
				}
			</form>
			@teamMembersSection(vmodel)
			if vmodel.CanReadBudget {
				@teamBudgetSection(vmodel)
			}
			if vmodel.CanEditTeam {
				@common.Section() {
					@common.SectionHeader() {
						@common.SectionTitle() {
							{ i18n.T(ctx, "org.team.delete.title") }
						}
					}
					@common.SectionBody(common.SectionBodyProps{Class: "flex flex-wrap items-center gap-3"}) {
						<p class="flex-1 text-sm text-muted-foreground">
							if len(vmodel.Applications) > 0 {
								{ i18n.T(ctx, "org.team.delete.apps_bound") }
							} else {
								{ i18n.T(ctx, "org.team.delete.consequence", vmodel.SampleModel) }
							}
						</p>
						if len(vmodel.Applications) == 0 {
							@common.ConfirmDelete(common.ConfirmDeleteProps{
								URL:          teamsURL(ctx, vmodel.Org, "/", string(vmodel.Team.ID()), "/delete"),
								Method:       "POST",
								Label:        i18n.T(ctx, "org.team.delete.button"),
								Variant:      button.VariantDestructive,
								Title:        i18n.T(ctx, "org.team.delete.confirm_title"),
								Description:  i18n.T(ctx, "org.team.delete.confirm_description"),
								ConfirmLabel: i18n.T(ctx, "org.team.delete.button"),
							})
						}
					}
				}
			}
		</div>
	}
}

templ teamMembersSection(vmodel TeamPageVModel) {
	@common.Section() {
		@common.SectionHeader() {
			@common.SectionTitle() {
				{ i18n.T(ctx, "org.team.members.title") }
			}
		}
		if len(vmodel.Members) == 0 {
			@common.SectionBody() {
				<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "org.team.members.empty") }</p>
			}
		} else {
			@table.Table() {
				@table.Header() {
					@table.Head() {
						{ i18n.T(ctx, "org.team.members.member") }
					}
					@table.Head() {
						{ i18n.T(ctx, "org.team.members.roles") }
					}
					@table.Head() {
						{ i18n.T(ctx, "org.team.members.monthly_budget") }
					}
					@table.Head(table.HeadProps{Class: "text-right"}) {
						{ i18n.T(ctx, "org.team.members.actions") }
					}
				}
				@table.Body() {
					for _, row := range vmodel.Members {
						@table.Row() {
							@table.Cell() {
								<div class="flex items-center gap-2.5">
									if row.Member.User() != nil {
										@common.PersonAvatar(row.Member.User().DisplayName())
										<div class="min-w-0">
											<div class="flex items-center gap-1.5">
												<span class="truncate text-sm font-semibold">{ row.Member.User().DisplayName() }</span>
												if row.Member.Status() == model.StatusSuspended {
													@common.Badge(common.ToneWarning, i18n.T(ctx, "org.team.members.suspended_badge"))
												}
											</div>
											@common.Mono(row.Member.User().Email())
										</div>
									}
								</div>
							}
							@table.Cell() {
								<div class="flex flex-wrap gap-1">
									if len(row.RoleNames) == 0 {
										<span class="text-xs text-muted-foreground">—</span>
									}
									for _, name := range row.RoleNames {
										@common.Badge(common.ToneInfo, name)
									}
								</div>
							}
							@table.Cell() {
								<span class="tnum text-sm">
									{ common.FormatCost(ctx, row.MonthSpend, vmodel.Org.Currency()) }
									if row.Budget != nil && row.Budget.MonthlyBudget() != nil {
										{ " / " + common.FormatCost(ctx, *row.Budget.MonthlyBudget(), vmodel.Org.Currency()) }
									}
								</span>
							}
							@table.Cell(table.CellProps{Class: "text-right"}) {
								<div class="inline-flex gap-1">
									@button.Button(button.Props{
										Href:       teamsURL(ctx, vmodel.Org, "/", string(vmodel.Team.ID()), "/members/", string(row.Member.MembershipID())),
										Variant:    button.VariantGhost,
										Size:       button.SizeIcon,
										Class:      "size-7",
										Attributes: templ.Attributes{"title": i18n.T(ctx, "org.team.members.edit_title")},
									}) {
										@icon.Pencil(icon.Props{Class: "size-3.5"})
									}
									if vmodel.CanManageMembers {
										<form method="POST" action={ templ.SafeURL(teamsURL(ctx, vmodel.Org, "/", string(vmodel.Team.ID()), "/members/", string(row.Member.MembershipID()), "/status")) }>
											if row.Member.Status() == model.StatusSuspended {
												<input type="hidden" name="status" value="active"/>
												@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeIcon, Class: "size-7", Attributes: templ.Attributes{"title": i18n.T(ctx, "org.team.members.reactivate")}}) {
													@icon.CirclePlay(icon.Props{Class: "size-3.5"})
												}
											} else {
												<input type="hidden" name="status" value="suspended"/>
												@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeIcon, Class: "size-7", Attributes: templ.Attributes{"title": i18n.T(ctx, "org.team.members.suspend")}}) {
													@icon.CirclePause(icon.Props{Class: "size-3.5"})
												}
											}
										</form>
										@common.ConfirmDelete(common.ConfirmDeleteProps{
											URL:          teamsURL(ctx, vmodel.Org, "/", string(vmodel.Team.ID()), "/members/", string(row.Member.MembershipID())),
											Icon:         icon.UserX,
											Tooltip:      i18n.T(ctx, "org.team.members.remove_tooltip"),
											Title:        i18n.T(ctx, "org.team.members.remove_title"),
											Description:  i18n.T(ctx, "org.team.members.remove_description"),
											ConfirmLabel: i18n.T(ctx, "org.team.members.remove_confirm"),
										})
									}
								</div>
							}
						}
					}
				}
			}
		}
		if vmodel.CanManageMembers && len(vmodel.Candidates) > 0 {
			@common.SectionHeader(common.SectionHeaderProps{Class: "border-b-0 border-t"}) {
				<form method="POST" action={ templ.SafeURL(teamsURL(ctx, vmodel.Org, "/", string(vmodel.Team.ID()), "/members")) } class="flex w-full flex-wrap items-center gap-2">
					<div class="min-w-64 flex-1">
						@selectbox.SelectBox(selectbox.Props{ID: "team-member-candidate"}) {
							@selectbox.Trigger(selectbox.TriggerProps{Name: "membership_id"}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "org.team.members.candidate_placeholder")})
							}
							@selectbox.Content() {
								@selectbox.Group() {
									for _, m := range vmodel.Candidates {
										if m.User() != nil {
											@selectbox.Item(selectbox.ItemProps{Value: string(m.ID())}) {
												{ m.User().DisplayName() + " · " + m.User().Email() }
											}
										}
									}
								}
							}
						}
					</div>
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Class: "gap-1.5"}) {
						@icon.UserPlus(icon.Props{Class: "size-3.5"})
						{ i18n.T(ctx, "org.team.members.add") }
					}
				</form>
			}
		}
	}
}

templ teamBudgetSection(vmodel TeamPageVModel) {
	<form method="POST" action={ templ.SafeURL(teamsURL(ctx, vmodel.Org, "/", string(vmodel.Team.ID()), "/budget")) }>
		@common.Section() {
			@common.SectionHeader() {
				@common.SectionTitle() {
					{ i18n.T(ctx, "org.team.budget.title") }
				}
				<span class="ml-auto text-xs text-muted-foreground">
					{ i18n.T(ctx, "org.team.budget.currency", vmodel.Org.Currency()) }
				</span>
			}
			@common.SectionBody(common.SectionBodyProps{Class: "space-y-3.5"}) {
				<p class="text-xs text-muted-foreground">
					{ i18n.T(ctx, "org.team.budget.help") }
				</p>
				<div class="grid gap-3.5 sm:grid-cols-3">
					@budgetField("team-daily", "daily_budget", i18n.T(ctx, "org.team.budget.daily"), "10.00", quotaFieldValue(vmodel.TeamQuota, budgetScopeDaily), vmodel.Org.Currency(), !vmodel.CanEditTeamBudget, "")
					@budgetField("team-monthly", "monthly_budget", i18n.T(ctx, "org.team.budget.monthly"), "100.00", quotaFieldValue(vmodel.TeamQuota, budgetScopeMonthly), vmodel.Org.Currency(), !vmodel.CanEditTeamBudget, "")
					@budgetField("team-yearly", "yearly_budget", i18n.T(ctx, "org.team.budget.yearly"), "1000.00", quotaFieldValue(vmodel.TeamQuota, budgetScopeYearly), vmodel.Org.Currency(), !vmodel.CanEditTeamBudget, "")
				</div>
				if vmodel.TeamQuota != nil {
					<div class="space-y-3.5">
						if vmodel.TeamQuota.DailyBudget() != nil {
							@quotaUsageRow(i18n.T(ctx, "org.team.budget.daily"), vmodel.Spend[0], *vmodel.TeamQuota.DailyBudget(), vmodel.Org.Currency())
						}
						if vmodel.TeamQuota.MonthlyBudget() != nil {
							@quotaUsageRow(i18n.T(ctx, "org.team.budget.monthly"), vmodel.Spend[1], *vmodel.TeamQuota.MonthlyBudget(), vmodel.Org.Currency())
						}
						if vmodel.TeamQuota.YearlyBudget() != nil {
							@quotaUsageRow(i18n.T(ctx, "org.team.budget.yearly"), vmodel.Spend[2], *vmodel.TeamQuota.YearlyBudget(), vmodel.Org.Currency())
						}
					</div>
				}
				@cascadeChoice("team-cascade", i18n.T(ctx, "org.team.budget.cascade_title"), quotaCascade(vmodel.TeamQuota), !vmodel.CanSplitBudget)
				@form.ItemFlex() {
					@switchcomp.Switch(switchcomp.Props{ID: "share_quota_equally", Name: "share_quota_equally", Value: "1", Checked: vmodel.Team.ShareQuotaEqually(), Disabled: !vmodel.CanSplitBudget})
					@form.Label(form.LabelProps{For: "share_quota_equally"}) {
						{ i18n.T(ctx, "org.team.budget.share_equally") }
					}
				}
			}
			if vmodel.CanEditTeamBudget || vmodel.CanSplitBudget {
				@common.SectionHeader(common.SectionHeaderProps{Class: "border-b-0 border-t"}) {
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
						{ i18n.T(ctx, "org.team.save") }
					}
				}
			}
		}
	</form>
}

// cascadeChoice lets the parent level of a budget constrain the budgets of its
// children when they are saved.
templ cascadeChoice(id, title string, current model.QuotaCascade, readonly bool) {
	<fieldset class="space-y-2">
		<legend class="text-sm font-medium">{ title }</legend>
		for _, opt := range cascadeOptions {
			<div class="flex items-start gap-3">
				@radio.Radio(radio.Props{ID: id + "-" + string(opt.Value), Name: "cascade", Value: string(opt.Value), Checked: current == opt.Value, Disabled: readonly})
				@label.Label(label.Props{For: id + "-" + string(opt.Value)}) {
					<span class="font-medium">{ i18n.T(ctx, opt.Label) }</span>
					<span class="block text-xs font-normal text-muted-foreground">{ i18n.T(ctx, opt.Help) }</span>
				}
			</div>
		}
	</fieldset>
}

// cascadeOptions holds message keys, translated where they are rendered.
var cascadeOptions = []struct {
	Value model.QuotaCascade
	Label string
	Help  string
}{
	{model.QuotaCascadeFree, "org.team.cascade.free", "org.team.cascade.free_help"},
	{model.QuotaCascadeCapped, "org.team.cascade.capped", "org.team.cascade.capped_help"},
	{model.QuotaCascadeSplit, "org.team.cascade.split", "org.team.cascade.split_help"},
}

func quotaCascade(q model.Quota) model.QuotaCascade {
	if q == nil {
		return model.QuotaCascadeFree
	}
	return q.Cascade()
}

func quotaFieldValue(q model.Quota, scope budgetScope) string {
	if q == nil {
		return ""
	}
	return budgetFieldValue(QuotaPageVModel{Quota: q}, scope)
}

// ── Team Member Page ──────────────────────────────────────────────────────────
templ TeamMemberPage(vmodel TeamMemberPageVModel) {
	{{ name := "" }}
	if vmodel.Member.User() != nil {
		{{ name = vmodel.Member.User().DisplayName() }}
	}
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(i18n.T(ctx, "org.team.member.page_title", name, vmodel.Team.Name()))) {
		<div class="max-w-4xl space-y-3.5">
			@common.PageHeader(common.PageHeaderProps{
				Title:    name,
				Subtitle: i18n.T(ctx, "org.team.member.subtitle", vmodel.Team.Name()),
			}) {
				@button.Button(button.Props{Variant: button.VariantOutline, Size: button.SizeSm, Class: "gap-1.5", Href: teamsURL(ctx, vmodel.Org, "/", string(vmodel.Team.ID()))}) {
					@icon.ArrowLeft(icon.Props{Class: "size-3.5"})
					{ vmodel.Team.Name() }
				}
			}
			if vmodel.Success != "" {
				@common.InfoBanner(common.TonePositive, teamSuccessMessage(ctx, vmodel.Success))
			}
			if vmodel.Error != "" {
				@common.InfoBanner(common.ToneNegative, vmodel.Error)
			}
			<form method="POST" action={ templ.SafeURL(teamsURL(ctx, vmodel.Org, "/", string(vmodel.Team.ID()), "/members/", string(vmodel.Member.MembershipID()))) }>
				@common.Section() {
					@common.SectionHeader() {
						@common.SectionTitle() {
							{ i18n.T(ctx, "org.team.members.roles") }
						}
					}
					@common.SectionBody(common.SectionBodyProps{Class: "space-y-2.5"}) {
						<p class="text-xs text-muted-foreground">
							{ i18n.T(ctx, "org.team.member.roles_help") }
						</p>
						for _, role := range vmodel.Roles {
							<div class="flex items-start gap-3">
								@checkbox.Checkbox(checkbox.Props{
									ID:       "role-" + string(role.ID()),
									Name:     "roles",
									Value:    string(role.ID()),
									Checked:  vmodel.SelectedRoles[string(role.ID())],
									Disabled: !vmodel.CanManageMembers || !vmodel.AssignableRoles[string(role.ID())],
								})
								@label.Label(label.Props{For: "role-" + string(role.ID())}) {
									{ role.Name() }
									<span class="block text-xs font-normal text-muted-foreground">{ teamScopedPermissionsLabel(ctx, role) }</span>
								}
							</div>
						}
					}
					if vmodel.CanManageMembers {
						@common.SectionHeader(common.SectionHeaderProps{Class: "border-b-0 border-t"}) {
							@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
								{ i18n.T(ctx, "org.team.member.save_roles") }
							}
						}
					}
				}
			</form>
			<form method="POST" action={ templ.SafeURL(teamsURL(ctx, vmodel.Org, "/", string(vmodel.Team.ID()), "/members/", string(vmodel.Member.MembershipID()), "/budget")) }>
				@common.Section() {
					@common.SectionHeader() {
						@common.SectionTitle() {
							{ i18n.T(ctx, "org.team.member.budget_title") }
						}
					}
					@common.SectionBody(common.SectionBodyProps{Class: "space-y-3.5"}) {
						<div class="grid gap-3.5 sm:grid-cols-3">
							@budgetField("member-daily", "daily_budget", i18n.T(ctx, "org.team.budget.daily"), "10.00", quotaFieldValue(vmodel.Budget, budgetScopeDaily), vmodel.Org.Currency(), !vmodel.CanSplitBudget, "")
							@budgetField("member-monthly", "monthly_budget", i18n.T(ctx, "org.team.budget.monthly"), "100.00", quotaFieldValue(vmodel.Budget, budgetScopeMonthly), vmodel.Org.Currency(), !vmodel.CanSplitBudget, "")
							@budgetField("member-yearly", "yearly_budget", i18n.T(ctx, "org.team.budget.yearly"), "1000.00", quotaFieldValue(vmodel.Budget, budgetScopeYearly), vmodel.Org.Currency(), !vmodel.CanSplitBudget, "")
						</div>
						<p class="text-xs text-muted-foreground">
							{ i18n.T(ctx, "org.team.member.budget_help") }
						</p>
						if vmodel.Budget != nil {
							if vmodel.Budget.DailyBudget() != nil {
								@quotaUsageRow(i18n.T(ctx, "org.team.budget.daily"), vmodel.Spend[0], *vmodel.Budget.DailyBudget(), vmodel.Org.Currency())
							}
							if vmodel.Budget.MonthlyBudget() != nil {
								@quotaUsageRow(i18n.T(ctx, "org.team.budget.monthly"), vmodel.Spend[1], *vmodel.Budget.MonthlyBudget(), vmodel.Org.Currency())
							}
							if vmodel.Budget.YearlyBudget() != nil {
								@quotaUsageRow(i18n.T(ctx, "org.team.budget.yearly"), vmodel.Spend[2], *vmodel.Budget.YearlyBudget(), vmodel.Org.Currency())
							}
						}
					}
					if vmodel.CanSplitBudget {
						@common.SectionHeader(common.SectionHeaderProps{Class: "border-b-0 border-t"}) {
							@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
								{ i18n.T(ctx, "org.team.member.save_budget") }
							}
						}
					}
				}
			</form>
		</div>
	}
}

// teamScopedPermissionsLabel lists what a role grants when held on a team.
func teamScopedPermissionsLabel(ctx context.Context, role model.Role) string {
	var labels []string
	for _, group := range rbac.Catalog() {
		for _, def := range group.Perms {
			if !def.TeamScopable {
				continue
			}
			for _, code := range role.Permissions() {
				if code == string(def.Code) {
					labels = append(labels, common.PermissionLabel(ctx, def))
				}
			}
		}
	}
	if len(labels) == 0 {
		return i18n.T(ctx, "org.team.member.no_team_permission")
	}
	return strings.Join(labels, " · ")
}
