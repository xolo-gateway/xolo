package component

import (
	"strconv"

	"github.com/xolo-gateway/xolo/internal/core/model"
	"github.com/xolo-gateway/xolo/internal/core/rbac"
	"github.com/xolo-gateway/xolo/internal/i18n"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/alert"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/checkbox"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/form"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/input"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/label"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/selectbox"
	switchcomp "github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/switch"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/table"
)

type ApplicationsPageVModel struct {
	common.AppLayoutVModel
	Org      model.Organization
	Apps     []model.Application
	AppRoles map[model.ApplicationID][]model.Role
	// TokenCounts is how many API keys each application holds. Zero means the
	// application cannot call anything, which the list flags.
	TokenCounts map[model.ApplicationID]int
	Success     string
}

type ApplicationFormVModel struct {
	common.AppLayoutVModel
	Org             model.Organization
	App             model.Application
	Tokens          []model.AuthToken
	// CreatedToken is the clear-text value of a key that was just created. It
	// is shown once, right after creation: stored keys are rendered masked and
	// their value cannot be recovered later.
	CreatedToken    string
	OrgRoles        []model.Role
	AssignedRoleIDs map[model.RoleID]bool
	// Teams are the teams the application can be bound to.
	Teams []model.Team
	IsNew           bool
	Error           string
	// QuotaSummary is a short description of the budget currently set on the
	// application ("Aucun budget", "10,00 EUR / jour + 100,00 / mois", ...).
	// It is shown inline in the application edit form so the operator can see
	// at a glance whether a budget is in effect, with a link to the full
	// editor for changes. Filled only on edit (not on the new-application
	// form), so empty on IsNew.
	QuotaSummary string
	// QuotaEditURL is the URL of the dedicated budget editor. The application
	// edit form links to it instead of carrying its own POST: the budget is
	// configured via its own page so the edit form does not have to mix
	// principal metadata and spending caps in the same submit.
	QuotaEditURL string
	// QuotaLoadError is set when the budget store returned an error other
	// than ErrNotFound. The summary still renders the cached value (which
	// may be stale), but a banner warns the operator so the UI does not
	// silently disagree with what the enforcer actually applies.
	QuotaLoadError string
}

// HasAssignedRole reports whether at least one role is assigned. An application
// without roles resolves to an empty permission set and every API call it makes
// is rejected, so the form warns about it explicitly.
func (v ApplicationFormVModel) HasAssignedRole() bool {
	for _, assigned := range v.AssignedRoleIDs {
		if assigned {
			return true
		}
	}
	return false
}

templ ApplicationsPage(vmodel ApplicationsPageVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(i18n.T(ctx, "org.applications.page_title", vmodel.Org.Name()))) {
		@common.PageHeader(common.PageHeaderProps{
			Title:    i18n.T(ctx, "org.applications.title"),
			Subtitle: i18n.T(ctx, "org.applications.subtitle"),
		}) {
			if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermApplicationsWrite) {
				@button.Button(button.Props{
					Size:  button.SizeSm,
					Class: "gap-1.5",
					Href:  common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/applications/new")),
				}) {
					@icon.Plus(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "org.applications.new") }
				}
			}
		}
		if vmodel.Success != "" {
			<div class="mb-3.5">
				@common.InfoBanner(common.TonePositive, i18n.T(ctx, "org.applications.success"))
			</div>
		}
		if len(vmodel.Apps) == 0 {
			@common.EmptyState(common.EmptyStateProps{
				Icon:        icon.AppWindow,
				Title:       i18n.T(ctx, "org.applications.empty_title"),
				Description: i18n.T(ctx, "org.applications.empty_description"),
			}) {
				if common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermApplicationsWrite) {
					@button.Button(button.Props{
						Size: button.SizeSm,
						Href: common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/applications/new")),
					}) {
						{ i18n.T(ctx, "org.applications.new") }
					}
				}
			}
		} else {
			@common.Section() {
				<div class="overflow-x-auto">
					@table.Table() {
						@table.Header() {
							@table.Head() {
								{ i18n.T(ctx, "org.applications.col.application") }
							}
							@table.Head() {
								{ i18n.T(ctx, "org.applications.col.roles") }
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								{ i18n.T(ctx, "org.applications.col.tokens") }
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								{ i18n.T(ctx, "org.applications.col.requests_30d") }
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								{ i18n.T(ctx, "org.applications.col.cost_30d") }
							}
							@table.Head() {
								{ i18n.T(ctx, "org.applications.col.status") }
							}
							@table.Head() {
								{ i18n.T(ctx, "org.applications.col.created") }
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								{ i18n.T(ctx, "org.applications.col.actions") }
							}
						}
						@table.Body() {
							for _, app := range vmodel.Apps {
								@table.Row() {
									@table.Cell() {
										<div class="min-w-0">
											<div class="truncate text-sm font-semibold">{ app.Name() }</div>
											if app.Description() != "" {
												<div class="mt-0.5 truncate text-xs text-muted-foreground">{ app.Description() }</div>
											}
										</div>
									}
									@table.Cell() {
										<div class="flex flex-wrap gap-1">
											if len(vmodel.AppRoles[app.ID()]) == 0 {
												@common.Badge(common.ToneNegative, i18n.T(ctx, "org.applications.no_role_badge"))
											} else {
												for _, role := range vmodel.AppRoles[app.ID()] {
													@common.Badge(common.ToneInfo, role.Name())
												}
											}
										</div>
									}
									@table.Cell(table.CellProps{Class: "text-right tnum"}) {
										if vmodel.TokenCounts[app.ID()] == 0 {
											@common.Badge(common.ToneWarning, i18n.T(ctx, "org.applications.no_token_badge"))
										} else {
											{ strconv.Itoa(vmodel.TokenCounts[app.ID()]) }
										}
									}
									// TODO(rework-ux): la maquette chiffre les requêtes, le coût
									// et le dernier appel par application. port.UsageStore
									// enregistre bien l'ApplicationID, mais aucun agrégat n'est
									// exposé par application (cf. lot 7 du plan).
									@table.Cell(table.CellProps{Class: "text-right"}) {
										@common.PendingValue(i18n.T(ctx, "org.applications.usage_pending"))
									}
									@table.Cell(table.CellProps{Class: "text-right"}) {
										@common.PendingValue(i18n.T(ctx, "org.applications.cost_pending"))
									}
									@table.Cell() {
										if app.Active() {
											@common.Badge(common.TonePositive, i18n.T(ctx, "org.applications.status.active"))
										} else {
											@common.Badge(common.ToneNeutral, i18n.T(ctx, "org.applications.status.inactive"))
										}
									}
									@table.Cell() {
										@common.Mono(app.CreatedAt().Format("02/01/2006"))
									}
									@table.Cell(table.CellProps{Class: "text-right"}) {
										@button.Button(button.Props{
											Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/applications/", string(app.ID()), "/edit")),
											Variant: button.VariantOutline,
											Size:    button.SizeSm,
										}) {
											{ i18n.T(ctx, "org.applications.configure") }
										}
									}
								}
							}
						}
					}
				</div>
			}
		}
	}
}

templ ApplicationForm(vmodel ApplicationFormVModel) {
	{{ readonly := !common.HasPermission(ctx, vmodel.Org.ID(), rbac.PermApplicationsWrite) }}
	{{ title := i18n.T(ctx, "org.applications.new") }}
	{{ action := common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/applications")) }}
	if !vmodel.IsNew && vmodel.App != nil {
		{{ title = i18n.T(ctx, "org.applications.form.edit_title", vmodel.App.Name()) }}
		{{ action = common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/applications/", string(vmodel.App.ID()), "/edit")) }}
	}
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(title)) {
		<div class="max-w-3xl">
			<form method="POST" action={ templ.SafeURL(action) }>
				@common.PageHeader(common.PageHeaderProps{Title: title}) {
					@button.Button(button.Props{
						Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/applications")),
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
						Type:    button.TypeButton,
					}) {
						{ i18n.T(ctx, "org.applications.form.cancel") }
					}
					if !readonly {
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
							{ i18n.T(ctx, "org.applications.form.save") }
						}
					}
				}
				@common.FlashError(vmodel.Error, i18n.T(ctx, "org.applications.form.flash_subject"))
				@common.Section() {
					@common.SectionHeader() {
						@common.SectionTitle() {
							{ i18n.T(ctx, "org.applications.form.identity") }
						}
					}
					@common.SectionBody(common.SectionBodyProps{Class: "flex flex-col gap-3.5"}) {
						@form.Item() {
							@form.Label(form.LabelProps{For: "app_name"}) {
								{ i18n.T(ctx, "org.applications.form.name") }
							}
							@input.Input(input.Props{
								ID:          "app_name",
								Name:        "name",
								Value:       applicationName(vmodel),
								Placeholder: i18n.T(ctx, "org.applications.form.name_placeholder"),
								Disabled:    readonly,
								Attributes:  templ.Attributes{"required": "required"},
							})
						}
						@form.Item() {
							@form.Label(form.LabelProps{For: "app_description"}) {
								{ i18n.T(ctx, "org.applications.form.description") }
							}
							@input.Input(input.Props{
								ID:          "app_description",
								Name:        "description",
								Value:       applicationDescription(vmodel),
								Placeholder: i18n.T(ctx, "org.applications.form.description_placeholder"),
								Disabled:    readonly,
							})
						}
						if !vmodel.IsNew && vmodel.App != nil {
							@form.ItemFlex() {
								@switchcomp.Switch(switchcomp.Props{ID: "active", Name: "active", Checked: vmodel.App.Active(), Disabled: readonly})
								@form.Label(form.LabelProps{For: "active"}) {
									{ i18n.T(ctx, "org.applications.status.active") }
								}
							}
						}
					}
				}
				<div class="mt-3.5">
					@common.Section() {
						@common.SectionHeader() {
							@common.SectionTitle() {
								{ i18n.T(ctx, "org.applications.col.roles") }
							}
						}
						@common.SectionBody(common.SectionBodyProps{Class: "flex flex-col gap-3.5"}) {
							<p class="text-sm text-muted-foreground">
								{ i18n.T(ctx, "org.applications.form.roles_help") }
							</p>
							if len(vmodel.OrgRoles) == 0 {
								<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "org.applications.form.roles_empty") }</p>
							} else {
								if !vmodel.HasAssignedRole() && applicationTeamID(vmodel) == "" {
									@common.InfoBanner(common.ToneNegative, i18n.T(ctx, "org.applications.form.no_access_banner"))
								}
								<div class="flex flex-col gap-3">
									for _, role := range vmodel.OrgRoles {
										<div class="flex items-start gap-3">
											@checkbox.Checkbox(checkbox.Props{
												ID:       "role-" + string(role.ID()),
												Name:     "roles",
												Value:    string(role.ID()),
												Checked:  vmodel.AssignedRoleIDs[role.ID()],
												Disabled: readonly,
											})
											<div class="grid gap-0.5 leading-none">
												@label.Label(label.Props{For: "role-" + string(role.ID())}) {
													{ role.Name() }
												}
												if role.Description() != "" {
													<p class="text-xs text-muted-foreground">{ role.Description() }</p>
												}
											</div>
										</div>
									}
								</div>
							}
						}
					}
					@common.Section() {
						@common.SectionHeader() {
							@common.SectionTitle() {
								{ i18n.T(ctx, "org.applications.form.team") }
							}
						}
						@common.SectionBody(common.SectionBodyProps{Class: "flex flex-col gap-3.5"}) {
							<p class="text-sm text-muted-foreground">
								{ i18n.T(ctx, "org.applications.form.team_help") }
							</p>
							@selectbox.SelectBox(selectbox.Props{ID: "application-team"}) {
								@selectbox.Trigger(selectbox.TriggerProps{Name: "team_id", Disabled: readonly}) {
									@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "org.applications.form.no_team")})
								}
								@selectbox.Content(selectbox.ContentProps{NoSearch: len(vmodel.Teams) < 8}) {
									@selectbox.Group() {
										@selectbox.Item(selectbox.ItemProps{Value: "", Selected: applicationTeamID(vmodel) == ""}) {
											{ i18n.T(ctx, "org.applications.form.no_team") }
										}
										for _, team := range vmodel.Teams {
											@selectbox.Item(selectbox.ItemProps{Value: string(team.ID()), Selected: applicationTeamID(vmodel) == team.ID()}) {
												{ team.Name() + " (" + team.Slug() + ")" }
											}
										}
									}
								}
							}
						}
					}
				</div>
				if !readonly {
					<div class="mt-3.5">
						@button.Button(button.Props{Type: button.TypeSubmit}) {
							{ i18n.T(ctx, "org.applications.form.save") }
						}
					</div>
				}
			</form>
			if !vmodel.IsNew && vmodel.App != nil {
				@applicationTokensSection(vmodel, readonly)
				<div class="mt-3.5">
					@common.Section() {
						@common.SectionHeader() {
							@common.SectionTitle() {
								{ i18n.T(ctx, "org.applications.form.budget") }
							}
							@button.Button(button.Props{
								Href:    vmodel.QuotaEditURL,
								Variant: button.VariantOutline,
								Size:    button.SizeSm,
							}) {
								{ i18n.T(ctx, "org.applications.form.budget_edit") }
							}
						}
						@common.SectionBody(common.SectionBodyProps{Class: "space-y-2"}) {
							<p class="text-sm text-muted-foreground">
								{ i18n.T(ctx, "org.applications.form.budget_help") }
							</p>
							if vmodel.QuotaLoadError != "" {
								@common.InfoBanner(common.ToneNegative, vmodel.QuotaLoadError)
							}
							<p class="text-sm font-medium">
								{ vmodel.QuotaSummary }
							</p>
						}
					}
				</div>
				<div class="mt-3.5">
					@common.Section(common.SectionProps{Class: "border-destructive/40"}) {
						@common.SectionHeader(common.SectionHeaderProps{Class: "border-destructive/40"}) {
							@common.SectionTitle() {
								{ i18n.T(ctx, "org.applications.form.danger_zone") }
							}
						}
						@common.SectionBody(common.SectionBodyProps{Class: "flex flex-wrap items-center gap-3.5"}) {
							<p class="min-w-0 flex-1 text-sm text-muted-foreground">
								{ i18n.T(ctx, "org.applications.form.delete_help") }
							</p>
							@common.ConfirmDelete(common.ConfirmDeleteProps{
								URL:         common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/applications/", string(vmodel.App.ID()), "/delete")),
								Method:      "POST",
								Variant:     button.VariantDestructive,
								Label:       i18n.T(ctx, "org.applications.form.delete"),
								Title:       i18n.T(ctx, "org.applications.form.delete_title"),
								Description: i18n.T(ctx, "org.applications.form.delete_description"),
							})
						}
					}
				</div>
			}
		</div>
	}
}

// applicationTokensSection renders the API keys of an application: the creation
// form, then the keys themselves.
templ applicationTokensSection(vmodel ApplicationFormVModel, readonly bool) {
	{{ tokenAction := common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/applications/", string(vmodel.App.ID()), "/tokens")) }}
	<div class="mt-3.5">
		@common.Section() {
			@common.SectionHeader() {
				@common.SectionTitle() {
					{ i18n.T(ctx, "org.applications.tokens.title") }
				}
			}
			if vmodel.CreatedToken != "" {
				@common.SectionBody() {
					@alert.Alert(alert.Props{Variant: alert.VariantDefault}) {
						@alert.Title() {
							{ i18n.T(ctx, "org.applications.tokens.copy_now") }
						}
						@alert.Description() {
							<p class="mb-2">{ i18n.T(ctx, "org.applications.tokens.copy_help") }</p>
							@common.InlineSnippet(vmodel.CreatedToken)
						}
					}
				}
			}
			if !readonly {
				<form method="POST" action={ templ.SafeURL(tokenAction) }>
					@common.SectionBody(common.SectionBodyProps{Class: "flex flex-wrap items-end gap-3.5"}) {
						<div class="min-w-40 flex-1">
							@form.Item() {
								@form.Label(form.LabelProps{For: "token_label"}) {
									{ i18n.T(ctx, "org.applications.tokens.label") }
								}
								@input.Input(input.Props{ID: "token_label", Name: "label", Placeholder: i18n.T(ctx, "org.applications.tokens.label_placeholder")})
							}
						</div>
						<div class="w-40">
							@form.Item() {
								@form.Label(form.LabelProps{For: "token_expiry"}) {
									{ i18n.T(ctx, "org.applications.tokens.expiry") }
								}
								@input.Input(input.Props{ID: "token_expiry", Name: "expiry", Type: input.TypeNumber, Value: "365", Attributes: templ.Attributes{"min": "1"}})
							}
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit}) {
							{ i18n.T(ctx, "org.applications.tokens.generate") }
						}
					}
				</form>
			}
			if len(vmodel.Tokens) == 0 {
				@common.SectionBody(common.SectionBodyProps{Class: "border-t text-sm text-muted-foreground"}) {
					{ i18n.T(ctx, "org.applications.tokens.empty") }
				}
			} else {
				<div class="overflow-x-auto border-t">
					@table.Table() {
						@table.Header() {
							@table.Head() {
								{ i18n.T(ctx, "org.applications.tokens.label") }
							}
							@table.Head() {
								{ i18n.T(ctx, "org.applications.tokens.expiration") }
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								{ i18n.T(ctx, "org.applications.col.actions") }
							}
						}
						@table.Body() {
							for _, token := range vmodel.Tokens {
								@table.Row() {
									@table.Cell() {
										{ token.Label() }
									}
									@table.Cell() {
										if token.ExpiresAt() != nil {
											@common.Mono(token.ExpiresAt().Format("02/01/2006"))
										} else {
											<span class="text-sm text-muted-foreground">{ i18n.T(ctx, "org.applications.tokens.never") }</span>
										}
									}
									@table.Cell(table.CellProps{Class: "text-right"}) {
										if !readonly {
											@common.ConfirmDelete(common.ConfirmDeleteProps{
												URL:          common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/applications/", string(vmodel.App.ID()), "/tokens/", string(token.ID()), "/delete")),
												Method:       "POST",
												Tooltip:      i18n.T(ctx, "org.applications.tokens.revoke"),
												Title:        i18n.T(ctx, "org.applications.tokens.revoke_title"),
												Description:  i18n.T(ctx, "org.applications.tokens.revoke_description"),
												ConfirmLabel: i18n.T(ctx, "org.applications.tokens.revoke"),
											})
										}
									}
								}
							}
						}
					}
				</div>
			}
		}
	</div>
}

// applicationName and applicationDescription read the edited application, or the
// empty string on creation.
func applicationName(vmodel ApplicationFormVModel) string {
	if vmodel.IsNew || vmodel.App == nil {
		return ""
	}
	return vmodel.App.Name()
}

func applicationDescription(vmodel ApplicationFormVModel) string {
	if vmodel.IsNew || vmodel.App == nil {
		return ""
	}
	return vmodel.App.Description()
}

// applicationTeamID returns the team the edited application is bound to.
func applicationTeamID(vmodel ApplicationFormVModel) model.TeamID {
	if vmodel.App == nil {
		return ""
	}
	return vmodel.App.TeamID()
}
