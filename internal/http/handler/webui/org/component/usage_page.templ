package component

import (
	"context"
	"fmt"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/chart"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/form"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/pagination"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/popover"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/selectbox"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/table"
	"github.com/xolo-gateway/xolo/internal/i18n"
	"slices"
	"strconv"
	"strings"
)

// ── Org Usage Page ────────────────────────────────────────────────────────────
templ OrgUsagePage(vmodel OrgUsagePageVModel) {
	@common.AppLayout(
		vmodel.AppLayoutVModel,
		common.WithTitle(i18n.T(ctx, "org.usage.page_title", vmodel.Org.Name())),
	) {
		<div class="space-y-3.5">
			@common.PageHeader(common.PageHeaderProps{
				Title:    i18n.T(ctx, "org.usage.title"),
				Subtitle: orgDashboardMeta(ctx, vmodel),
			}) {
				@common.SegmentedNav(common.RangeSegments(ctx, vmodel.Range, func(r string) string {
					return common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/usage"), common.WithValues("range", r, "owner", strings.Join(vmodel.OwnerFilter, ",")))
				}))
				@orgUsageFilters(vmodel)
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Class:   "gap-1.5",
					Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/usage"), common.WithValues("range", vmodel.Range, "owner", strings.Join(vmodel.OwnerFilter, ","), "team", string(vmodel.TeamFilter), "format", "csv")),
				}) {
					@icon.Download(icon.Props{Class: "size-3.5"})
					CSV
				}
			}
			<!-- Org quota card -->
			if vmodel.OrgQuota != nil {
				<div>
					{{
						var budget *int64
						var spent int64
						periodLabel := "mensuel"
						switch {
						case vmodel.OrgQuota.MonthlyBudget() != nil:
							budget = vmodel.OrgQuota.MonthlyBudget()
							spent = vmodel.MonthlyCost
							periodLabel = "mensuel"
						case vmodel.OrgQuota.YearlyBudget() != nil:
							budget = vmodel.OrgQuota.YearlyBudget()
							spent = vmodel.YearlyCost
							periodLabel = "annuel"
						case vmodel.OrgQuota.DailyBudget() != nil:
							budget = vmodel.OrgQuota.DailyBudget()
							spent = vmodel.DailyCost
							periodLabel = "journalier"
						}
						pct := common.UsagePercent(spent, budget)
					}}
					<!-- Bandeau budget : liseré gauche coloré par le seuil atteint,
					comme la maquette. La couleur du liseré est celle de la jauge, donc
					la même règle de seuil (vert < 85 %, ambre 85-100 %, rouge >= 100 %). -->
					{{ forecast := projectedSpend(spent, periodLabel) }}
					{{ projectionPct := common.UsagePercent(forecast, budget) }}
					@common.Section(common.SectionProps{Class: budgetRuleClass(budget, pct)}) {
						@common.SectionBody(common.SectionBodyProps{Class: "space-y-2.5"}) {
							<div class="flex flex-wrap items-start gap-3">
								<!-- Titre, pastille de pourcentage et phrase de consommation sur
								une seule ligne : la maquette les lit d'un trait, « Budget
								mensuel pay-as-you-go · 64 % · 1 284,40 € sur 2 000,00 € ». -->
								<div class="flex min-w-0 flex-wrap items-center gap-2">
									<h2 class="text-sm font-semibold">{ usageBudgetTitle(ctx, periodLabel) }{ vmodel.BudgetTitle }</h2>
									if budget != nil {
										@common.Badge(common.BudgetTone(pct), fmt.Sprintf("%d %%", pct))
										<span class="text-xs text-muted-foreground">
											{ i18n.T(ctx, "org.usage.budget.consumed", common.FormatCost(ctx, spent, vmodel.Currency), common.FormatCost(ctx, *budget, vmodel.Currency)) }
										</span>
									} else {
										@common.Badge(common.ToneNeutral, i18n.T(ctx, "org.usage.budget.unlimited"))
										<span class="text-xs text-muted-foreground">
											{ i18n.T(ctx, "org.usage.budget.no_ceiling") }
										</span>
									}
								</div>
								<div class="ml-auto shrink-0">
									@button.Button(button.Props{
										Variant: button.VariantOutline,
										Size:    button.SizeSm,
										Class:   "gap-1.5",
										Href:    usageBudgetHref(ctx, vmodel),
									}) {
										@icon.Settings(icon.Props{Class: "size-3.5"})
										{ i18n.T(ctx, "org.usage.budget.manage") }
									}
								</div>
							</div>
							if budget != nil {
								@common.BudgetGauge(pct, projectionPct, "")
							}
							<div class="grid grid-cols-2 gap-3.5 sm:grid-cols-4">
								@budgetPeriodCell(i18n.T(ctx, "org.usage.budget.today"), common.FormatCost(ctx, vmodel.DailyCost, vmodel.Currency))
								@budgetPeriodCell(i18n.T(ctx, "org.usage.budget.this_month"), common.FormatCost(ctx, vmodel.MonthlyCost, vmodel.Currency))
								@budgetPeriodCell(i18n.T(ctx, "org.usage.budget.this_year"), common.FormatCost(ctx, vmodel.YearlyCost, vmodel.Currency))
								@budgetForecastCell(forecast, projectionPct, periodLabel, vmodel.Currency)
							</div>
						}
					}
				</div>
			}
			<!-- Subscription providers plan usage -->
			if !vmodel.TeamOnly {
				@SubscriptionUsageSection(vmodel.SubscriptionProviders)
			}
			<!-- Bande de KPI : cellules jointives séparées d'un filet, pas des
			cartes détachées (design system §06). -->
			@common.KPIBand(common.KPIBandProps{Class: "grid-cols-2 md:grid-cols-3 2xl:grid-cols-5"}) {
				@common.KPI(common.KPIProps{
					Label: i18n.T(ctx, "org.usage.kpi.requests"),
					Value: common.FormatCount(ctx, aggregateRequests(vmodel.Aggregate)),
				})
				@common.KPI(common.KPIProps{
					Label: i18n.T(ctx, "org.usage.kpi.tokens"),
					Value: common.FormatCount(ctx, aggregateTokens(vmodel.Aggregate)),
					Note:  cachedTokensNote(ctx, vmodel.Aggregate),
				})
				@common.KPI(common.KPIProps{
					Label: i18n.T(ctx, "org.usage.kpi.total_cost"),
					Value: totalCostValue(ctx, vmodel),
					Note:  i18n.T(ctx, "org.usage.kpi.total_cost_note"),
				})
				<!-- Les deux estimations énergétiques gardent leur cellule même
				lorsqu'elles ne sont pas calculables : une cellule omise laisserait
				une piste de grille vide dans la bande, qui se lit comme un défaut
				d'affichage et non comme une absence de donnée. -->
				if vmodel.TotalEnergyWh > 0 {
					@common.KPI(common.KPIProps{
						Label: i18n.T(ctx, "org.usage.kpi.energy"),
						Value: common.FormatEnergyWh(ctx, vmodel.TotalEnergyWh),
						Note:  i18n.T(ctx, "org.usage.kpi.energy_note"),
					})
				} else {
					@common.KPIPending(i18n.T(ctx, "org.usage.kpi.energy"), i18n.T(ctx, "org.usage.kpi.energy_pending"))
				}
				if vmodel.TotalCO2GramsMid > 0 {
					@common.KPI(common.KPIProps{
						Label: i18n.T(ctx, "org.usage.kpi.co2"),
						Value: common.FormatCO2Grams(ctx, vmodel.TotalCO2GramsMid),
						Note:  common.FormatCO2ToCarKilometers(ctx, vmodel.TotalCO2GramsMid),
					})
				} else {
					@common.KPIPending(i18n.T(ctx, "org.usage.kpi.co2"), i18n.T(ctx, "org.usage.kpi.co2_pending"))
				}
			}
			<!-- Chaque bloc de la maquette garde son cadre même sans donnée : un
			tableau de bord dont les sections disparaissent au gré du contenu ne se lit
			plus comme un tableau de bord, et l'absence de chiffre devient
			indiscernable d'un défaut de chargement.
			Grille de la maquette : le coût par jour occupe la largeur restante, la
			répartition par modèle une colonne fixe de 380 px à sa droite ; les deux
			palmarès se partagent ensuite la largeur à parts égales. -->
			{{ trueVal := true }}
			<div class="grid grid-cols-1 gap-3.5 xl:grid-cols-[minmax(0,1fr)_380px]">
				@common.Section() {
					@common.SectionHeader() {
						@common.SectionTitle() {
							<!-- Le titre suit le pas du graphique : au-delà d'un
							trimestre il agrège par mois. -->
							{ common.CostSeriesTitle(ctx, vmodel.Range) }
						}
					}
					if len(vmodel.ChartPerDay) > 0 {
						@common.SectionBody() {
							@common.CostChart(vmodel.ChartPerDay, vmodel.ChartCoveredPerDay, vmodel.Currency)
						}
					} else {
						@common.SectionEmpty(common.EmptyStateProps{
							Icon:        icon.ChartColumn,
							Title:       i18n.T(ctx, "org.usage.cost.empty_title"),
							Description: i18n.T(ctx, "org.usage.cost.empty_description"),
						})
					}
				}
				@common.Section() {
					@common.SectionHeader() {
						@common.SectionTitle() {
							{ i18n.T(ctx, "org.usage.models.title") }
						}
					}
					if len(vmodel.ChartSharesPerModel) > 0 {
						@common.SectionBody() {
							for _, share := range vmodel.ChartSharesPerModel {
								@common.ChartShareRow(share, "w-28")
							}
						}
					} else {
						@common.SectionEmpty(common.EmptyStateProps{
							Icon:        icon.BrainCircuit,
							Title:       i18n.T(ctx, "org.usage.models.empty_title"),
							Description: i18n.T(ctx, "org.usage.models.empty_description"),
						})
					}
				}
			</div>
			<!-- Les deux palmarès sont des listes à barres, pas des histogrammes : la
			maquette les lit comme un classement, où le nom compte autant que la valeur
			— un axe de catégories tronquerait les noms de modèle. -->
			<div class="grid grid-cols-1 gap-3.5 lg:grid-cols-2">
				@common.Section() {
					@common.SectionHeader() {
						@common.SectionTitle() {
							{ i18n.T(ctx, "org.usage.callers.title") }
						}
						<span class="ml-auto text-xs text-muted-foreground">{ i18n.T(ctx, "org.usage.callers.note") }</span>
					}
					if len(vmodel.ChartPerUser) > 0 {
						@common.SectionBody() {
							for _, row := range common.RankedRows(vmodel.ChartPerUser) {
								@common.RankedRow(row, common.RankedRowProps{
									Initials: true,
									Value:    common.FormatCost(ctx, int64(row.Value*1_000_000), vmodel.Currency),
								})
							}
						}
					} else {
						@common.SectionEmpty(common.EmptyStateProps{
							Icon:        icon.Users,
							Title:       i18n.T(ctx, "org.usage.callers.empty_title"),
							Description: i18n.T(ctx, "org.usage.callers.empty_description"),
						})
					}
				}
				@common.Section() {
					@common.SectionHeader() {
						@common.SectionTitle() {
							{ i18n.T(ctx, "org.usage.providers.title") }
						}
					}
					if len(vmodel.ChartPerProvider) > 0 {
						@common.SectionBody() {
							for _, row := range common.RankedRows(vmodel.ChartPerProvider) {
								@common.RankedRow(row, common.RankedRowProps{
									Mono:  true,
									Value: common.ProviderCostValue(ctx, row.Value, vmodel.Currency, vmodel.PlanCoveredProviders[row.Label]),
								})
							}
						}
					} else {
						@common.SectionEmpty(common.EmptyStateProps{
							Icon:        icon.Server,
							Title:       i18n.T(ctx, "org.usage.providers.empty_title"),
							Description: i18n.T(ctx, "org.usage.providers.empty_description"),
						})
					}
				}
			</div>
			if len(vmodel.ChartSubTokensPerUser) > 0 {
				@common.Section() {
					@common.SectionHeader() {
						@common.SectionTitle() {
							{ i18n.T(ctx, "org.usage.subscription.title") }
						}
						<span class="ml-auto text-xs text-muted-foreground">{ i18n.T(ctx, "org.usage.subscription.note") }</span>
					}
					@common.SectionBody() {
						@chart.Chart(chart.Props{
							Variant:     chart.VariantBar,
							ShowXLabels: true,
							ShowYLabels: true,
							ShowYGrid:   true,
							ShowLegend:  false,
							BeginAtZero: &trueVal,
							Class:       "h-64",
							Data: chart.Data{
								Labels: common.ChartLabels(vmodel.ChartSubTokensPerUser),
								Datasets: []chart.Dataset{{
									Label:           i18n.T(ctx, "org.usage.subscription.chart_label"),
									Data:            common.ChartValues(vmodel.ChartSubTokensPerUser),
									BackgroundColor: common.ChartColor(1),
								}},
							},
						})
					}
				}
			}
			<!-- Usage records table -->
			@common.Section() {
				@common.SectionHeader() {
					@common.SectionTitle() {
						{ i18n.T(ctx, "org.usage.records.title") }
					}
					<span class="ml-auto font-mono text-2xs text-muted-foreground">
						{ recordsRangeLabel(vmodel) }
					</span>
				}
				if len(vmodel.Records) > 0 {
					<div class="overflow-x-auto">
						@table.Table() {
							@table.Header() {
								@table.Head() {
									{ i18n.T(ctx, "org.usage.records.timestamp") }
								}
								@table.Head() {
									{ i18n.T(ctx, "org.usage.records.caller") }
								}
								@table.Head() {
									{ i18n.T(ctx, "org.usage.records.model") }
								}
								@table.Head(table.HeadProps{Class: "text-right"}) {
									{ i18n.T(ctx, "org.usage.records.tokens") }
								}
								@table.Head(table.HeadProps{Class: "text-right"}) {
									{ i18n.T(ctx, "org.usage.records.latency") }
								}
								@table.Head(table.HeadProps{Class: "text-right"}) {
									{ i18n.T(ctx, "org.usage.records.cost") }
								}
								@table.Head(table.HeadProps{Class: "text-right"}) {
									{ i18n.T(ctx, "org.usage.kpi.energy") }
								}
								@table.Head() {
									{ i18n.T(ctx, "org.usage.records.status") }
								}
							}
							@table.Body() {
								for _, dr := range vmodel.Records {
									@table.Row() {
										@table.Cell() {
											@common.Mono(dr.Record.CreatedAt().Format("02/01 15:04:05"))
										}
										@table.Cell() {
											{ displayOwner(vmodel.Users, vmodel.ApplicationsMap, dr.Record) }
										}
										@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
											{ dr.DisplayModelName }
										}
										@table.Cell(table.CellProps{Class: "text-right tnum"}) {
											<span class="inline-flex items-center gap-1.5">
												{ fmt.Sprintf("%d / %d", dr.Record.PromptTokens(), dr.Record.CompletionTokens()) }
												if dr.Record.CachedTokens() > 0 {
													<span
														title={ i18n.T(ctx, "org.usage.records.cached_tokens", dr.Record.CachedTokens()) }
														class="cursor-help text-muted-foreground"
													>
														@icon.DatabaseZap(icon.Props{Class: "size-3.5"})
													</span>
												}
											</span>
										}
										// TODO(rework-ux): la maquette affiche la latence et le
										// code de statut de chaque appel. model.UsageRecord ne
										// porte ni l'un ni l'autre — le proxy n'enregistre que la
										// consommation, pas l'issue de la requête (cf. lot 7).
										@table.Cell(table.CellProps{Class: "text-right"}) {
											@common.PendingValue(i18n.T(ctx, "org.usage.records.latency_pending"))
										}
										@table.Cell(table.CellProps{Class: "text-right tnum"}) {
											<span class="inline-flex items-center gap-1.5">
												if dr.Converted {
													<span
														title={ common.FormatCost(ctx, dr.Record.Cost(), dr.Record.Currency()) }
														class="cursor-help underline decoration-dotted"
													>
														{ common.FormatCost(ctx, dr.DisplayCost, dr.DisplayCurrency) }
													</span>
												} else {
													{ common.FormatCost(ctx, dr.DisplayCost, dr.DisplayCurrency) }
												}
												if dr.Record.PlanCovered() {
													<span
														title={ i18n.T(ctx, "org.usage.records.plan_covered") }
														class="cursor-help text-muted-foreground"
													>
														@icon.Receipt(icon.Props{Class: "size-3.5"})
													</span>
												}
											</span>
										}
										@table.Cell(table.CellProps{Class: "text-right tnum text-muted-foreground"}) {
											if dr.EnergyWh > 0 {
												<span
													title={ i18n.T(ctx, "org.usage.records.energy_range", common.FormatEnergyWh(ctx, dr.EnergyLowWh), common.FormatEnergyWh(ctx, dr.EnergyHighWh), common.FormatCO2Grams(ctx, dr.CO2GramsMid)) }
													class="cursor-help underline decoration-dotted"
												>
													{ common.FormatEnergyWh(ctx, dr.EnergyWh) }
												</span>
											} else {
												—
											}
										}
										@table.Cell() {
											@common.PendingValue(i18n.T(ctx, "org.usage.records.status_pending"))
										}
									}
								}
							}
						}
					</div>
				} else {
					@common.SectionEmpty(common.EmptyStateProps{
						Icon:        icon.ChartLine,
						Title:       i18n.T(ctx, "org.usage.records.empty_title"),
						Description: i18n.T(ctx, "org.usage.records.empty_description"),
					}) {
						@button.Button(button.Props{
							Variant: button.VariantOutline,
							Size:    button.SizeSm,
							Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/providers")),
						}) {
							{ i18n.T(ctx, "org.usage.records.view_providers") }
						}
					}
				}
			}
			if len(vmodel.Records) > 0 {
				@pagination.Pagination() {
					@pagination.Content() {
						@pagination.Previous(pagination.PreviousProps{
							Href:     common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/usage"), common.WithValues("range", vmodel.Range, "page", fmt.Sprintf("%d", vmodel.Page-1), "owner", strings.Join(vmodel.OwnerFilter, ","))),
							Disabled: vmodel.Page <= 1,
							Label:    i18n.T(ctx, "org.usage.pagination.previous"),
						})
						@pagination.Next(pagination.NextProps{
							Href:     common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/usage"), common.WithValues("range", vmodel.Range, "page", fmt.Sprintf("%d", vmodel.Page+1), "owner", strings.Join(vmodel.OwnerFilter, ","))),
							Disabled: !vmodel.HasNext,
							Label:    i18n.T(ctx, "org.usage.pagination.next"),
						})
					}
				}
			}
		</div>
	}
}

// orgUsageFilters renders the "Filtres" button of the mockup: the owner filter
// moves behind it instead of sitting exposed in the header, and the button
// carries the number of criteria currently applied.
//
// The panel is a GET form, so applying a filter is a plain navigation that keeps
// the criteria in the URL — shareable, bookmarkable, and unaffected by the swap.
templ orgUsageFilters(vmodel OrgUsagePageVModel) {
	if len(vmodel.Members) > 0 || len(vmodel.Applications) > 0 || len(vmodel.Teams) > 0 {
		{{ activeCount := len(vmodel.OwnerFilter) }}
		if vmodel.TeamFilter != "" && !vmodel.TeamOnly {
			{{ activeCount++ }}
		}
		@popover.Trigger(popover.TriggerProps{For: "usage-filters"}) {
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Size:    button.SizeSm,
				Class:   "gap-1.5",
				Type:    button.TypeButton,
			}) {
				@icon.ListFilter(icon.Props{Class: "size-3.5"})
				{ i18n.T(ctx, "org.usage.filters.button") }
				if activeCount > 0 {
					<span class="rounded-full bg-primary-tint px-1.5 font-mono text-2xs font-semibold text-primary">
						{ strconv.Itoa(activeCount) }
					</span>
				}
			}
		}
		@popover.Content(popover.ContentProps{ID: "usage-filters", Placement: popover.PlacementBottomEnd, Class: "w-80 p-3.5"}) {
			<form method="GET" class="flex flex-col gap-3">
				<input type="hidden" name="range" value={ vmodel.Range }/>
				if len(vmodel.Teams) > 0 {
					@form.Item() {
						@form.Label(form.LabelProps{For: "team-trigger"}) {
							{ i18n.T(ctx, "org.usage.filters.team") }
						}
						@selectbox.SelectBox(selectbox.Props{ID: "usage-team"}) {
							@selectbox.Trigger(selectbox.TriggerProps{ID: "team-trigger", Name: "team"}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "org.usage.filters.all_teams")})
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: len(vmodel.Teams) < 8}) {
								@selectbox.Group() {
									if !vmodel.TeamOnly {
										@selectbox.Item(selectbox.ItemProps{Value: "", Selected: vmodel.TeamFilter == ""}) {
											{ i18n.T(ctx, "org.usage.filters.all_teams") }
										}
									}
									for _, team := range vmodel.Teams {
										@selectbox.Item(selectbox.ItemProps{Value: string(team.ID()), Selected: vmodel.TeamFilter == team.ID()}) {
											{ team.Name() }
										}
									}
								}
							}
						}
					}
				}
				@form.Item() {
					@form.Label(form.LabelProps{For: "owner-trigger"}) {
						{ i18n.T(ctx, "org.usage.records.caller") }
					}
					@selectbox.SelectBox(selectbox.Props{Multiple: true}) {
						@selectbox.Trigger(selectbox.TriggerProps{
							ID:                "owner-trigger",
							Name:              "owner",
							Multiple:          true,
							ShowPills:         false,
							SelectedCountText: i18n.T(ctx, "org.usage.filters.selected_count"),
						}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "org.usage.filters.all_callers"), Multiple: true})
						}
						@selectbox.Content(selectbox.ContentProps{SearchPlaceholder: i18n.T(ctx, "org.usage.filters.search")}) {
							@selectbox.Group() {
								for _, m := range vmodel.Members {
									if m.User() != nil {
										@selectbox.Item(selectbox.ItemProps{
											Value:    string(m.User().ID()),
											Selected: slices.Contains(vmodel.OwnerFilter, string(m.User().ID())),
										}) {
											<span class="flex items-center gap-2">
												@icon.User(icon.Props{Class: "size-3.5 text-muted-foreground"})
												{ m.User().DisplayName() }
											</span>
										}
									}
								}
							}
							@selectbox.Group() {
								for _, app := range vmodel.Applications {
									@selectbox.Item(selectbox.ItemProps{
										Value:    string(app.ID()),
										Selected: slices.Contains(vmodel.OwnerFilter, string(app.ID())),
									}) {
										<span class="flex items-center gap-2">
											@icon.AppWindow(icon.Props{Class: "size-3.5 text-muted-foreground"})
											{ app.Name() }
										</span>
									}
								}
							}
						}
					}
				}
				<div class="flex items-center gap-2">
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
						{ i18n.T(ctx, "org.usage.filters.apply") }
					}
					if activeCount > 0 {
						@button.Button(button.Props{
							Variant: button.VariantGhost,
							Size:    button.SizeSm,
							Type:    button.TypeButton,
							Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/usage"), common.WithValues("range", vmodel.Range)),
						}) {
							{ i18n.T(ctx, "org.usage.filters.reset") }
						}
					}
				</div>
			</form>
		}
	}
}

// budgetPeriodCell renders one of the running totals under the budget gauge.
templ budgetPeriodCell(label string, value string) {
	<div>
		<div class="text-2xs font-semibold uppercase tracking-caps text-muted-foreground">{ label }</div>
		<div class="mt-0.5 tnum text-sm font-semibold">{ value }</div>
	</div>
}

// budgetForecastCell renders the end-of-period projection, coloured on the tone
// the projection itself lands in — the point of the figure is to say, before the
// ceiling is hit, that it is going to be.
templ budgetForecastCell(forecast int64, projectionPct int, periodLabel string, currency string) {
	<div>
		<div class="text-2xs font-semibold uppercase tracking-caps text-muted-foreground">
			{ forecastLabel(ctx, periodLabel) }
		</div>
		<div class={ "mt-0.5 tnum text-sm font-semibold", common.BudgetTone(projectionPct).TextClass() }>
			{ common.FormatCost(ctx, forecast, currency) }
		</div>
	</div>
}

// usageBudgetHref is the page managing the budget the usage card shows.
func usageBudgetHref(ctx context.Context, vmodel OrgUsagePageVModel) string {
	if vmodel.BudgetHref != "" {
		return common.BaseURLString(ctx, common.WithPath(vmodel.BudgetHref))
	}
	return common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/quota"))
}

// usageBudgetTitle names the budget banner after the period periodLabel carries.
func usageBudgetTitle(ctx context.Context, periodLabel string) string {
	switch periodLabel {
	case "annuel":
		return i18n.T(ctx, "org.usage.budget.title_yearly")
	case "journalier":
		return i18n.T(ctx, "org.usage.budget.title_daily")
	default:
		return i18n.T(ctx, "org.usage.budget.title_monthly")
	}
}
