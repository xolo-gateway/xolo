package component

import (
	"fmt"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/alert"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/table"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

// ── Invites Page ──────────────────────────────────────────────────────────────
templ InvitesPage(vmodel InvitesPageVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(i18n.T(ctx, "org.invites.page_title", vmodel.Org.Name()))) {
		<div class="space-y-6">
			@common.PageHeader(common.PageHeaderProps{
				Title:    i18n.T(ctx, "org.invites.title"),
				Subtitle: i18n.T(ctx, "org.invites.subtitle"),
			}) {
				if vmodel.CanCreate {
					@button.Button(button.Props{Size: button.SizeSm, Href: common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/invites/new"))}) {
						@icon.Plus(icon.Props{Class: "h-4 w-4 mr-2"})
						{ i18n.T(ctx, "org.invites.new") }
					}
				}
			}
			if vmodel.NewURL != "" {
				@alert.Alert(alert.Props{Variant: alert.VariantDefault}) {
					@alert.Description() {
						<div class="font-medium">{ i18n.T(ctx, "org.invites.link_created") }</div>
						<div class="mt-1">
							@common.InlineSnippet(vmodel.NewURL)
						</div>
					}
				}
			}
			if vmodel.NewURL == "" {
				@common.FlashToast(vmodel.Success, i18n.T(ctx, "org.invites.flash_subject"))
			}
			if len(vmodel.Invites) == 0 {
				@common.EmptyState(common.EmptyStateProps{
					Icon:        icon.Mail,
					Title:       i18n.T(ctx, "org.invites.empty_title"),
					Description: i18n.T(ctx, "org.invites.empty_description"),
				})
			} else {
				@common.Section() {
					@table.Table() {
						@table.Header() {
							@table.Head() {
								{ i18n.T(ctx, "org.invites.col.recipient") }
							}
							@table.Head() {
								{ i18n.T(ctx, "org.invites.col.role") }
							}
							@table.Head() {
								{ i18n.T(ctx, "org.invites.col.expires") }
							}
							@table.Head() {
								{ i18n.T(ctx, "org.invites.col.uses") }
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								{ i18n.T(ctx, "org.invites.col.actions") }
							}
						}
						@table.Body() {
							for _, inv := range vmodel.Invites {
								@table.Row() {
									@table.Cell() {
										if inv.InviteeEmail() != nil {
											<div class="font-medium">{ *inv.InviteeEmail() }</div>
											<div class="text-xs text-muted-foreground">{ i18n.T(ctx, "org.invites.targeted") }</div>
										} else {
											<div class="font-medium">{ i18n.T(ctx, "org.invites.open") }</div>
											<div class="text-xs text-muted-foreground">{ i18n.T(ctx, "org.invites.shared_link") }</div>
										}
									}
									@table.Cell() {
										@common.Badge(common.ToneInfo, roleLabelFromMap(ctx, vmodel.RoleNames, inv.Role()))
										if name, ok := vmodel.TeamNames[inv.TeamID()]; ok {
											<span class="ml-1">
												@common.Badge(common.ToneNeutral, i18n.T(ctx, "org.invites.team_badge", name))
											</span>
										}
									}
									@table.Cell(table.CellProps{Class: "text-muted-foreground"}) {
										if inv.ExpiresAt() != nil {
											{ inv.ExpiresAt().Format("2006-01-02") }
										} else {
											{ i18n.T(ctx, "org.invites.never") }
										}
									}
									@table.Cell(table.CellProps{Class: "text-muted-foreground"}) {
										if inv.MaxUses() != nil {
											{ fmt.Sprintf("%d / %d", inv.UsesCount(), *inv.MaxUses()) }
										} else {
											{ fmt.Sprintf("%d / ∞", inv.UsesCount()) }
										}
									}
									@table.Cell(table.CellProps{Class: "text-right"}) {
										<div class="inline-flex items-center gap-1">
											if inv.RevokedAt() != nil {
												@common.Badge(common.ToneNegative, i18n.T(ctx, "org.invites.revoked"))
											}
											@common.CopyValueButton(vmodel.BaseURL+"/join/"+string(inv.ID()), i18n.T(ctx, "org.invites.copy_link"))
											if vmodel.CanManageAll || vmodel.WritableTeams[inv.TeamID()] {
												if inv.RevokedAt() == nil {
													@common.ConfirmDelete(common.ConfirmDeleteProps{
														URL:          common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/invites/", string(inv.ID()))),
														Icon:         icon.Ban,
														Tooltip:      i18n.T(ctx, "org.invites.revoke"),
														Title:        i18n.T(ctx, "org.invites.revoke_title"),
														Description:  i18n.T(ctx, "org.invites.revoke_description"),
														ConfirmLabel: i18n.T(ctx, "org.invites.revoke"),
													})
												}
												@common.ConfirmDelete(common.ConfirmDeleteProps{
													URL:         common.BaseURLString(ctx, common.WithPath("/orgs/", vmodel.Org.Slug(), "/admin/invites/", string(inv.ID()), "/delete")),
													Tooltip:     i18n.T(ctx, "org.invites.delete"),
													Title:       i18n.T(ctx, "org.invites.delete_title"),
													Description: i18n.T(ctx, "org.invites.delete_description"),
												})
											}
										</div>
									}
								}
							}
						}
					}
				}
			}
		</div>
	}
}
