	"github.com/xolo-gateway/xolo/internal/core/model"
	"github.com/xolo-gateway/xolo/internal/i18n"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/radio"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/collapsible"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/form"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/input"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/textarea"
)

// ── Subscription Plan Editor ──────────────────────────────────────────────────

// SubscriptionPlanEditor renders an editable subscription plan form section.
// Form fields emitted:
//   - plan_label
//   - plan_constraint_count          (hidden, JS-managed)
//   - plan_c{i}_kind                 ("rolling_window" | "concurrency")
//   - plan_c{i}_label
//   - plan_c{i}_duration             (Go duration string, e.g. "5h", "168h")
//   - plan_c{i}_reset_in             (time until next reset, e.g. "4h29m", "4d13h"; empty = sliding window)
//   - plan_c{i}_token_budget         (number of tokens, empty = no limit)
//   - plan_c{i}_value_budget         (dollars, empty = no limit)
//   - plan_c{i}_max_concurrent       (integer, empty = no limit)
//   - plan_c{i}_reserve_ratio        (percent 0-100, empty = allocator default)
//   - plan_c{i}_pace_slack           (percent 0-100, empty = allocator default)
//   - plan_c{i}_happy_hour_start     (percent 1-100, empty = allocator default; 100 disables)
//   - plan_c{i}_happy_hour_max_lead  (duration, e.g. "1h", "2d"; empty = allocator default)
//   - plan_c{i}_scope                ("provider", "model": each upstream model metered on its own, or "shared": one budget, each model weighted by its own)
//   - plan_c{i}_model_budgets        (one "model = budget" override per line, see parsePlanModelBudgets)
// submitted, when not nil, is the form as it was posted: the page is being
// rendered back with an error, and every field shows what the operator typed —
// the rejected value included — rather than what is stored.
templ SubscriptionPlanEditor(plan *model.SubscriptionPlan, readonly bool, submitted url.Values) {
	{{ constraints := []model.PlanConstraint(nil) }}
	{{ planLabel := "" }}
	if plan != nil {
		{{ constraints = plan.Constraints }}
		{{ planLabel = plan.Label }}
	}
	@common.Section() {
		@common.SectionHeader() {
			@common.SectionTitle() {
				{ i18n.T(ctx, "org.plan.title") }
			}
		}
		@common.SectionBody(common.SectionBodyProps{Class: "space-y-4"}) {
			@form.Item() {
				@form.Label(form.LabelProps{For: "plan_label"}) {
					{ i18n.T(ctx, "org.plan.label") }
				}
				@input.Input(input.Props{ID: "plan_label", Name: "plan_label", Value: planLabel, Placeholder: i18n.T(ctx, "org.plan.label_placeholder"), Disabled: readonly})
			}
			<div class="space-y-1">
				<p class="text-xs font-medium text-muted-foreground">{ i18n.T(ctx, "org.plan.constraints") }</p>
				<div
					id="plan-constraints"
					class="space-y-3"
					data-xolo-rows
					data-rows-template="plan-constraint-tpl"
					data-rows-count="plan-constraint-count"
				>
					for i, c := range constraints {
						@planConstraintRow(i, c, readonly, submitted)
					}
				</div>
			</div>
			// Hidden input : porte le nombre de lignes, tenu à jour par le module de
			// lignes répétables d'assets/js/xolo.js.
			<input type="hidden" id="plan-constraint-count" name="plan_constraint_count" value={ fmt.Sprintf("%d", len(constraints)) }/>
			if !readonly {
				@button.Button(button.Props{
					Type:       "button",
					Variant:    button.VariantOutline,
					Class:      "w-full",
					Attributes: templ.Attributes{"data-xolo-row-add": "plan-constraints"},
				}) {
					{ i18n.T(ctx, "org.plan.add_constraint") }
				}
			}
		}
	}
	// Modèle cloné à l'ajout d'une contrainte. planConstraintRow avec idx -1 émet
	// des noms à trou (plan_c{i}_kind, …) que la renumérotation réécrit.
	if !readonly {
		<template id="plan-constraint-tpl">
			@planConstraintRow(-1, model.PlanConstraint{}, false, nil)
		</template>
	}
}

// planConstraintRow renders one constraint entry.
// idx = -1 → template row; names use placeholder "{i}" replaced by JS.
templ planConstraintRow(idx int, c model.PlanConstraint, readonly bool, submitted url.Values) {
	{{ idxKey := fmt.Sprintf("%d", idx) }}
	if idx == -1 {
		{{ idxKey = "{i}" }}
	}
	{{ kindName := "plan_c" + idxKey + "_kind" }}
	{{ labelName := "plan_c" + idxKey + "_label" }}
	{{ durationName := "plan_c" + idxKey + "_duration" }}
	{{ resetInName := "plan_c" + idxKey + "_reset_in" }}
	{{ tokenBudgetName := "plan_c" + idxKey + "_token_budget" }}
	{{ valueBudgetName := "plan_c" + idxKey + "_value_budget" }}
	{{ maxConcName := "plan_c" + idxKey + "_max_concurrent" }}
	{{ reserveName := "plan_c" + idxKey + "_reserve_ratio" }}
	{{ paceSlackName := "plan_c" + idxKey + "_pace_slack" }}
	{{ happyStartName := "plan_c" + idxKey + "_happy_hour_start" }}
	{{ happyLeadName := "plan_c" + idxKey + "_happy_hour_max_lead" }}
	{{ scopeName := "plan_c" + idxKey + "_scope" }}
	{{ modelBudgetsName := "plan_c" + idxKey + "_model_budgets" }}
	// A form rendered back reads the scope from the submission alone, never
	// from the stored plan, as the editor does for every other field.
	{{ scope := c.Scope }}
	if submitted != nil {
		{{ scope = model.PlanConstraintScope(submitted.Get(scopeName)) }}
	}
	if scope == "" {
		{{ scope = model.PlanScopeProvider }}
	}
	{{ modelBudgetsStr := submittedOr(submitted, modelBudgetsName, formatModelBudgets(c.ModelBudgets)) }}
	// Duration value: empty string when zero (template row or unset).
	{{ durStr := "" }}
	if c.Duration > 0 {
		{{ durStr = c.Duration.Duration().String() }}
	}
	{{ durStr = submittedOr(submitted, durationName, durStr) }}
	// Reset countdown value: rendered from the anchor so re-saving is idempotent.
	{{ resetInStr := "" }}
	if c.IsAnchored() {
		{{ resetInStr = formatResetIn(time.Until(c.NextResetAt(time.Now()))) }}
	}
	{{ resetInStr = submittedOr(submitted, resetInName, resetInStr) }}
	// Token budget: display as raw integer.
	{{ tokenBudgetStr := "" }}
	if c.TokenBudget != nil {
		{{ tokenBudgetStr = fmt.Sprintf("%d", *c.TokenBudget) }}
	}
	{{ tokenBudgetStr = submittedOr(submitted, tokenBudgetName, tokenBudgetStr) }}
	// Value budget: display as dollars (microcents / 1_000_000).
	{{ valueBudgetStr := "" }}
	if c.ValueBudget != nil {
		{{ valueBudgetStr = formatBudgetField(*c.ValueBudget) }}
	}
	{{ valueBudgetStr = submittedOr(submitted, valueBudgetName, valueBudgetStr) }}
	// Fair-share tuning: ratios are edited as percentages, empty meaning "default".
	{{ reserveStr := submittedOr(submitted, reserveName, formatRatioField(c.ReserveRatio)) }}
	{{ paceSlackStr := submittedOr(submitted, paceSlackName, formatRatioField(c.PaceSlack)) }}
	{{ happyStartStr := submittedOr(submitted, happyStartName, formatRatioField(c.HappyHourStart)) }}
	{{ happyLeadStr := "" }}
	if c.HappyHourMaxLead != nil {
		{{ happyLeadStr = c.HappyHourMaxLead.Duration().String() }}
	}
	{{ happyLeadStr = submittedOr(submitted, happyLeadName, happyLeadStr) }}
	// Max concurrent: display as integer.
	{{ maxConcStr := "" }}
	if c.MaxConcurrent != nil {
		{{ maxConcStr = fmt.Sprintf("%d", *c.MaxConcurrent) }}
	}
	{{ maxConcStr = submittedOr(submitted, maxConcName, maxConcStr) }}
	// rolling_window visible by default if kind matches (hidden for template row where kind is empty).
	{{ showRolling := c.Kind == model.ConstraintRollingWindow }}
	{{ showConcurrency := c.Kind == model.ConstraintConcurrency }}
	<div data-xolo-row class="rounded-md border p-3 space-y-3 bg-muted/30">
		// ── Header row: kind selector + delete button ─────────────────────
		<div class="flex items-center gap-2">
			<div class="flex-1 space-y-1">
				@form.Label(form.LabelProps{For: "plan-kind-" + idxKey}) {
					{ i18n.T(ctx, "org.plan.kind") }
				}
				// TODO(rework-ux): passer sur selectbox.* une fois le lot 8 fait.
				// Ce <select> est cloné depuis le <template> ci-dessus par
				// le module de lignes répétables. selectbox.* portalise son contenu sur
				// document.body sous un identifiant tiré au hasard au rendu :
				// deux lignes clonées pointeraient sur le même contenu. La
				// conversion suppose donc de remplacer d'abord l'ajout de ligne
				// par un fragment HTMX, qui rendrait chaque ligne côté serveur.
				<select
					id={ "plan-kind-" + idxKey }
					name={ kindName }
					data-xolo-name={ "plan_c{i}_kind" }
					data-xolo-row-variant
					class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs outline-none focus-visible:border-ring focus-visible:ring-ring/50 focus-visible:ring-[3px] disabled:opacity-50"
					disabled?={ readonly }
				>
					<option
						value=""
						if c.Kind == "" {
							selected
						}
					>{ i18n.T(ctx, "org.plan.kind_placeholder") }</option>
					<option
						value="rolling_window"
						if c.Kind == model.ConstraintRollingWindow {
							selected
						}
					>{ i18n.T(ctx, "org.plan.kind_rolling_window") }</option>
					<option
						value="concurrency"
						if c.Kind == model.ConstraintConcurrency {
							selected
						}
					>{ i18n.T(ctx, "org.plan.kind_concurrency") }</option>
				</select>
			</div>
			if !readonly {
				@button.Button(button.Props{
					Type:    button.TypeButton,
					Variant: button.VariantOutline,
					Size:    button.SizeIcon,
					Class:   "mt-5 text-muted-foreground hover:text-destructive hover:border-destructive",
					Attributes: templ.Attributes{
						"data-xolo-row-remove": "",
						"title":                i18n.T(ctx, "org.plan.remove_constraint"),
					},
				}) {
					@icon.X(icon.Props{Size: 15})
				}
			}
		</div>
		// ── Label (all kinds) ──────────────────────────────────────────────
		<div class="space-y-1">
			@form.Label() {
				{ i18n.T(ctx, "org.plan.constraint_label") }
			}
			@input.Input(input.Props{
				Name:        labelName,
				Value:       c.Label,
				Placeholder: i18n.T(ctx, "org.plan.constraint_label_placeholder"),
				Disabled:    readonly,
				Attributes:  templ.Attributes{"data-xolo-name": "plan_c{i}_label"},
			})
		</div>
		// ── Rolling window fields ──────────────────────────────────────────
		<div
			data-xolo-variant="rolling_window"
			class="space-y-3"
			hidden?={ !showRolling }
		>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
				<div class="space-y-1">
					@form.Label() {
						{ i18n.T(ctx, "org.plan.duration") }
					}
					@form.Description() {
						@templ.Raw(i18n.T(ctx, "org.plan.duration_help", planCode("5h"), planCode("168h"), planCode("30m")))
					}
					@input.Input(input.Props{
						Name:        durationName,
						Value:       durStr,
						Placeholder: i18n.T(ctx, "org.plan.duration_placeholder"),
						Disabled:    readonly,
						Attributes:  templ.Attributes{"data-xolo-name": "plan_c{i}_duration"},
					})
				</div>
				<div class="space-y-1">
					@form.Label() {
						{ i18n.T(ctx, "org.plan.reset_in") }
					}
					@form.Description() {
						@templ.Raw(i18n.T(ctx, "org.plan.reset_in_help", planCode("4h29m"), planCode("4d13h")))
					}
					@input.Input(input.Props{
						Name:        resetInName,
						Value:       resetInStr,
						Placeholder: i18n.T(ctx, "org.plan.reset_in_placeholder"),
						Disabled:    readonly,
						Attributes:  templ.Attributes{"data-xolo-name": "plan_c{i}_reset_in"},
					})
				</div>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
				<div class="space-y-1">
					@form.Label() {
						{ i18n.T(ctx, "org.plan.token_budget") }
					}
					@input.Input(input.Props{
						Name:        tokenBudgetName,
						Type:        input.TypeNumber,
						Value:       tokenBudgetStr,
						Placeholder: i18n.T(ctx, "org.plan.token_budget_placeholder"),
						Disabled:    readonly,
						Attributes:  templ.Attributes{"data-xolo-name": "plan_c{i}_token_budget", "min": "0"},
					})
				</div>
				<div class="space-y-1">
					@form.Label() {
						{ i18n.T(ctx, "org.plan.value_budget") }
					}
					@input.Input(input.Props{
						Name:        valueBudgetName,
						Type:        input.TypeNumber,
						Value:       valueBudgetStr,
						Placeholder: i18n.T(ctx, "org.plan.value_budget_placeholder"),
						Disabled:    readonly,
						Attributes:  templ.Attributes{"data-xolo-name": "plan_c{i}_value_budget", "min": "0", "step": "any"},
					})
				</div>
			</div>
			// ── Metering scope ─────────────────────────────────────────────
			<div class="space-y-3 rounded-md border bg-background p-3">
				<div class="space-y-2">
					@form.Label() {
						{ i18n.T(ctx, "org.plan.scope") }
					}
					for _, opt := range planScopeOptions {
						<label class="flex items-start gap-2 text-sm">
							@radio.Radio(radio.Props{
								ID:         "plan_c" + idxKey + "_scope_" + string(opt.Scope),
								Name:       scopeName,
								Value:      string(opt.Scope),
								Checked:    scope == opt.Scope,
								Disabled:   readonly,
								Class:      "mt-0.5 shrink-0",
								Attributes: templ.Attributes{"data-xolo-name": "plan_c{i}_scope", "data-xolo-id": "plan_c{i}_scope_" + string(opt.Scope)},
							})
							<span class="space-y-0.5">
								<span class="block font-medium">{ i18n.T(ctx, opt.LabelKey) }</span>
								<span class="block text-xs text-muted-foreground">{ i18n.T(ctx, opt.HelpKey) }</span>
							</span>
						</label>
					}
					@form.Description() {
						{ i18n.T(ctx, "org.plan.scope_help") }
					}
				</div>
				<div class="space-y-1">
					@form.Label() {
						{ i18n.T(ctx, "org.plan.model_budgets") }
					}
					@form.Description() {
						@templ.Raw(i18n.T(ctx, "org.plan.model_budgets_help", planCode(i18n.T(ctx, "org.plan.model_budgets_syntax")), planCode("kimi-k3 = 3"), planCode("deepseek-v4.1-flash = 16, 50000000 tokens"), planCode("longcat-2.5-preview-free = "+i18n.T(ctx, "org.plan.model_budgets_unlimited"))))
					}
					@textarea.Textarea(textarea.Props{
						ID:          "plan_c" + idxKey + "_model_budgets",
						Name:        modelBudgetsName,
						Value:       modelBudgetsStr,
						Rows:        4,
						Placeholder: "kimi-k3 = 3",
						Disabled:    readonly,
						Class:       "font-mono text-xs",
						Attributes:  templ.Attributes{"data-xolo-name": "plan_c{i}_model_budgets", "data-xolo-id": "plan_c{i}_model_budgets"},
					})
				</div>
			</div>
			// ── Fair-share tuning ──────────────────────────────────────────
			// Left empty these keep the defaults; they are here because a plan whose
			// shape differs from the usual one (a handful of heavy users, a weekly
			// window) is tuned per provider, not per deployment.
			// collapsible plutôt qu'accordion : accordion.Item rend un
			// <details name="accordion"> dont le nom est écrit en dur, et des
			// <details> de même nom forment un groupe exclusif à l'échelle du
			// document — ouvrir les réglages d'une contrainte fermerait ceux de
			// toutes les autres. Le JS de collapsible ne travaille que par
			// délégation et closest(), jamais par identifiant, donc une ligne
			// clonée depuis le <template> ci-dessus reste autonome.
			@collapsible.Collapsible(collapsible.Props{
				Class: "rounded-md border bg-background p-3",
				// Sans ID explicite, le composant s'en tire un au rendu : la ligne
				// modèle n'étant rendue qu'une fois, chaque ligne ajoutée clonerait
				// le même. L'identifiant est donc dérivé de l'index et renuméroté
				// par le module de lignes répétables, comme les noms de champs.
				ID:         "plan_c" + idxKey + "_fairshare",
				Attributes: templ.Attributes{"data-xolo-id": "plan_c{i}_fairshare"},
			}) {
				@collapsible.Trigger(collapsible.TriggerProps{Class: "cursor-pointer text-sm font-medium"}) {
					{ i18n.T(ctx, "org.plan.fairshare") }
				}
				@collapsible.Content(collapsible.ContentProps{Class: "pt-3"}) {
					<div class="space-y-3">
						@form.Description() {
							{ i18n.T(ctx, "org.plan.fairshare_help") }
						}
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
							<div class="space-y-1">
								@form.Label() {
									{ i18n.T(ctx, "org.plan.reserve") }
								}
								@form.Description() {
									{ i18n.T(ctx, "org.plan.reserve_help") }
								}
								@input.Input(input.Props{
									Name:        reserveName,
									Type:        input.TypeNumber,
									Value:       reserveStr,
									Placeholder: "30",
									Disabled:    readonly,
									Attributes:  templ.Attributes{"data-xolo-name": "plan_c{i}_reserve_ratio", "min": "0", "max": "100", "step": "any"},
								})
							</div>
							<div class="space-y-1">
								@form.Label() {
									{ i18n.T(ctx, "org.plan.pace_slack") }
								}
								@form.Description() {
									{ i18n.T(ctx, "org.plan.pace_slack_help") }
								}
								@input.Input(input.Props{
									Name:        paceSlackName,
									Type:        input.TypeNumber,
									Value:       paceSlackStr,
									Placeholder: "15",
									Disabled:    readonly,
									Attributes:  templ.Attributes{"data-xolo-name": "plan_c{i}_pace_slack", "min": "0", "max": "100", "step": "any"},
								})
							</div>
							<div class="space-y-1">
								@form.Label() {
									{ i18n.T(ctx, "org.plan.happy_start") }
								}
								@form.Description() {
									{ i18n.T(ctx, "org.plan.happy_start_help") }
								}
								@input.Input(input.Props{
									Name:        happyStartName,
									Type:        input.TypeNumber,
									Value:       happyStartStr,
									Placeholder: "90",
									Disabled:    readonly,
									Attributes:  templ.Attributes{"data-xolo-name": "plan_c{i}_happy_hour_start", "min": "1", "max": "100", "step": "any"},
								})
							</div>
							<div class="space-y-1">
								@form.Label() {
									{ i18n.T(ctx, "org.plan.happy_lead") }
								}
								@form.Description() {
									{ i18n.T(ctx, "org.plan.happy_lead_help") }
								}
								@input.Input(input.Props{
									Name:        happyLeadName,
									Value:       happyLeadStr,
									Placeholder: i18n.T(ctx, "org.plan.happy_lead_placeholder"),
									Disabled:    readonly,
									Attributes:  templ.Attributes{"data-xolo-name": "plan_c{i}_happy_hour_max_lead"},
								})
							</div>
						</div>
					</div>
				}
			}
		</div>
		// ── Concurrency fields ─────────────────────────────────────────────
		<div
			data-xolo-variant="concurrency"
			class="space-y-1"
			hidden?={ !showConcurrency }
		>
			@form.Label() {
				{ i18n.T(ctx, "org.plan.max_concurrent") }
			}
			@input.Input(input.Props{
				Name:        maxConcName,
				Type:        input.TypeNumber,
				Value:       maxConcStr,
				Placeholder: i18n.T(ctx, "org.plan.max_concurrent_placeholder"),
				Disabled:    readonly,
				Attributes:  templ.Attributes{"data-xolo-name": "plan_c{i}_max_concurrent", "min": "1"},
			})
		</div>
	</div>
}

// submittedOr returns the value the operator posted for a field, falling back
// to the stored one. Only a form rendered back with an error carries submitted
// values; a rejected value is then shown as typed, so the operator sees what
// was refused instead of an empty field.
func submittedOr(submitted url.Values, name, stored string) string {
	if submitted == nil {
		return stored
	}
	if _, ok := submitted[name]; !ok {
		return stored
	}
	return submitted.Get(name)
}

// planScopeOption is one choice of the metering scope of a rolling window.
type planScopeOption struct {
	Scope    model.PlanConstraintScope
	LabelKey string
	HelpKey  string
}

var planScopeOptions = []planScopeOption{
	{model.PlanScopeProvider, "org.plan.scope_provider", "org.plan.scope_provider_help"},
	{model.PlanScopeModel, "org.plan.scope_model", "org.plan.scope_model_help"},
	{model.PlanScopeShared, "org.plan.scope_shared", "org.plan.scope_shared_help"},
}

// formatModelBudgets renders per-model overrides in the one-per-line syntax
// the form parses back, sorted by model so that re-saving is idempotent.
func formatModelBudgets(budgets map[string]model.PlanBudget) string {
	names := make([]string, 0, len(budgets))
	for name := range budgets {
		names = append(names, name)
	}
	slices.Sort(names)
	var sb strings.Builder
	for _, name := range names {
		b := budgets[name]
		parts := make([]string, 0, 2)
		if b.ValueBudget != nil {
			parts = append(parts, formatBudgetField(*b.ValueBudget))
		}
		if b.TokenBudget != nil {
			parts = append(parts, fmt.Sprintf("%d tokens", *b.TokenBudget))
		}
		if len(parts) == 0 {
			parts = append(parts, "illimité")
		}
		sb.WriteString(name + " = " + strings.Join(parts, ", ") + "\n")
	}
	return sb.String()
}

// formatRatioField renders a stored fraction as the percentage the form edits,
// trimming the trailing ".0" of whole values. Empty means "use the default".
func formatRatioField(ratio *float64) string {
	if ratio == nil {
		return ""
	}
	// Rounded first: the stored fraction times 100 is not exact in float64 for a
	// handful of whole percentages (7, 14, 28, 29, 55…), and "7.000000000000001"
	// in the field is the display/engine gap the rest of this form removes.
	pct := math.Round(*ratio*100*1e6) / 1e6
	if pct == math.Trunc(pct) {
		return fmt.Sprintf("%d", int(pct))
	}
	return strconv.FormatFloat(pct, 'f', -1, 64)
}

// formatResetIn renders a remaining duration in a compact, parseable form ("4d13h29m",
// "4h29m", "42m") for pre-filling the "reset dans" field. Kept in sync with the
// parseResetIn parser used on form submission.
func formatResetIn(remaining time.Duration) string {
	if remaining <= 0 {
		return ""
	}
	days := int(remaining.Hours()) / 24
	hours := int(remaining.Hours()) % 24
	mins := int(remaining.Minutes()) % 60
	switch {
	case days > 0:
		return fmt.Sprintf("%dd%dh%dm", days, hours, mins)
	case hours > 0:
		return fmt.Sprintf("%dh%dm", hours, mins)
	default:
		return fmt.Sprintf("%dm", mins)
	}
}

// planCode wraps an example in a <code> element, for help text rendered raw
// from a message whose arguments carry markup.
func planCode(s string) string {
	return "<code>" + html.EscapeString(s) + "</code>"
}
