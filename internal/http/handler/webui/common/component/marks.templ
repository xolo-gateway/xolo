package component

import (
	"fmt"

	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/avatar"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/progress"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/tooltip"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/utils"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

// Badge is *the* badge of the design system (§06 « Badges & états »), and the
// only one: a flat tinted label, 10,5 px semi-bold on a 4 px radius, 1,5 px by
// 7 px of padding. « actif », « inactif », « 429 », « brouillon », « visite
// admin » — an état, a role, a count and a tag are all the same object, and the
// tone is the only thing that separates them.
//
// No border, no dot, no size variant: the tint is what marks it. Anything that
// needs to stand out more is not a badge.
//
// Geometry in px because it is the design system's own, and the spacing scale of
// the product is compressed for density (--spacing: 0.2222rem), so no step of it
// lands on these values.
templ Badge(tone Tone, label string) {
	<span class={ "inline-block rounded-sm px-[7px] py-[1.5px] text-[10.5px] font-semibold",
		tone.BadgeClass() }>{ label }</span>
}

// Mono renders an identifier — slug, model name, timestamp, key — in the
// monospace face the design system reserves for machine-written values.
templ Mono(value string) {
	<span class="font-mono text-xs text-muted-foreground">{ value }</span>
}

// InlineStat renders one figure of the compact strip the mockup puts on the
// right of a list row ("Modèles 12 · Coût 30 j 412 € · p95 780 ms").
//
// It is the row-level counterpart of KPI: same 10 px caps label, but a 13 px
// value instead of 21 px, and no frame — a row is already framed.
templ InlineStat(label string, tone Tone) {
	<div class="min-w-0">
		<div class="text-2xs font-semibold uppercase tracking-caps text-muted-foreground">{ label }</div>
		<div class={ "mt-0.5 text-sm font-semibold tnum", tone.TextClass(), templ.KV("text-foreground", tone == ToneNeutral) }>
			{ children... }
		</div>
	</div>
}

// IconSquare renders the tinted rounded square the mockup puts at the head of a
// provider, middleware or plugin row. The tint is a token utility pair passed by
// the caller ("bg-primary-tint text-primary"), because the colour carries the kind
// of the object, which only the screen knows.
templ IconSquare(glyph func(...icon.Props) templ.Component, tintClass string) {
	<span class={ "flex size-8 shrink-0 items-center justify-center rounded-md", tintClass }>
		@glyph(icon.Props{Class: "size-4"})
	</span>
}

// InitialSquare renders the rounded square holding the initials of an
// organisation, used at the head of every organisation row.
//
// Square and monospace because the design system marks a *space* that way — an
// organisation, the platform console, a provider — as opposed to a person, who
// gets the round PersonAvatar. `tintClass` defaults to the organisation pair
// (§02: primary tint background, primary text); pass one only for the objects
// that carry a colour of their own, such as a provider reflecting its health.
templ InitialSquare(label string, tintClass ...string) {
	<span class={ "flex size-6.5 shrink-0 items-center justify-center rounded-md font-mono text-2xs font-bold",
		defaultString(tintClass, "bg-primary-tint text-primary") }>
		{ Initials(label) }
	</span>
}

// PersonAvatar renders the initials disc of a human being: round, neutral and in
// the interface face, so a member never reads like an organisation. Every list
// of people in the product goes through it.
//
// `sizeClass` overrides the default 26 px of a table row (e.g. "size-6" in the
// sidebar footer, "size-5" in a ranked list).
templ PersonAvatar(name string, sizeClass ...string) {
	@avatar.Avatar(avatar.Props{Class: defaultString(sizeClass, "size-6.5")}) {
		@avatar.Fallback(avatar.FallbackProps{Class: "text-2xs font-bold text-muted-foreground"}) {
			{ Initials(name) }
		}
	}
}

// defaultString returns the single optional variadic value, or `fallback` when
// the caller left it out.
func defaultString(values []string, fallback string) string {
	if len(values) > 0 && values[0] != "" {
		return values[0]
	}
	return fallback
}

// BudgetGauge renders a budget bar with its percentage pill, on the thresholds
// of the design system.
//
// `projection` is the end-of-period forecast as a percentage of the ceiling; a
// black tick is drawn at that position when it is above zero.
templ BudgetGauge(pct int, projection int, label string) {
	<div class="flex flex-col gap-1.5">
		if label != "" {
			<div class="flex items-baseline gap-2">
				<span class="text-[11.5px] text-muted-foreground">{ label }</span>
				<span class="ml-auto">
					@Badge(BudgetTone(pct), fmt.Sprintf("%d %%", pct))
				</span>
			</div>
		}
		<div class="relative">
			@progress.Progress(progress.Props{
				Value:    min(pct, 100),
				BarClass: "h-1.5 " + BudgetBarClass(pct),
				Class:    "h-1.5",
			})
			if projection > 0 && projection <= 100 {
				<!-- Repère de projection de fin de période. La position dépend
				d'une valeur calculée, donc d'un style inline : aucune classe
				utilitaire ne peut porter un pourcentage arbitraire. -->
				<span
					class="absolute top-1/2 h-3 w-0.5 -translate-y-1/2 rounded-full bg-foreground"
					style={ fmt.Sprintf("left:%d%%", projection) }
					title={ i18n.T(ctx, "common.budget.projection") }
				></span>
			}
		</div>
	</div>
}

// ComingSoon marks a control whose backing feature does not exist yet (lot 7 of
// docs/plan/rework-ux.md). The badge is what tells a user the blank is
// deliberate rather than a failure to load.
templ ComingSoon() {
	@Badge(ToneNeutral, i18n.T(ctx, "common.coming_soon"))
}

// PendingValue renders the placeholder of a column the domain cannot fill yet:
// an em dash carrying the explanation in a tooltip, so the column can keep the
// place it has in the mockup without pretending to hold a figure.
templ PendingValue(reason string) {
	{{ id := "pending-" + utils.RandomID() }}
	@tooltip.Tooltip() {
		@tooltip.Trigger(tooltip.TriggerProps{For: id}) {
			<span class="cursor-help text-muted-foreground/50">—</span>
		}
		@tooltip.Content(tooltip.ContentProps{ID: id, Position: tooltip.PositionTop}) {
			{ reason }
		}
	}
}

// SectionNote renders the small grey sentence the mockup puts under a table to
// explain a behaviour ("« Ouvrir » vous place dans le contexte de …").
templ SectionNote() {
	<p class="mt-2.5 px-0.5 text-xs text-muted-foreground">
		{ children... }
	</p>
}

// InfoBanner renders the informational strip of the design system (§07): a
// sentence, an icon, and an optional action pushed to the right by the children.
templ InfoBanner(tone Tone, message string) {
	<div class={ "flex flex-wrap items-center gap-2.5 rounded-lg border px-3.5 py-2.5 text-sm", bannerClass(tone) }>
		@bannerIcon(tone)
		<span class="min-w-0 flex-1">{ message }</span>
		{ children... }
	</div>
}

templ bannerIcon(tone Tone) {
	switch tone {
		case TonePositive:
			@icon.CircleCheck(icon.Props{Class: "size-4 shrink-0"})
		case ToneWarning, ToneNegative:
			@icon.TriangleAlert(icon.Props{Class: "size-4 shrink-0"})
		default:
			@icon.Info(icon.Props{Class: "size-4 shrink-0"})
	}
}

// bannerClass returns the border/tint/foreground triplet of an InfoBanner.
func bannerClass(tone Tone) string {
	switch tone {
	case TonePositive:
		return "border-success/25 bg-success-tint text-success"
	case ToneWarning:
		return "border-warning/25 bg-warning-tint text-warning"
	case ToneNegative:
		return "border-destructive/25 bg-destructive-tint text-destructive"
	default:
		return "border-primary/25 bg-primary/5 text-primary"
	}
}
