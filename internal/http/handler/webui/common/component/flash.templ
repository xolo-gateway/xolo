package component

import (
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/alert"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/toast"
)

// FlashToast renders the outcome of the previous request as a toast.
//
// Handlers redirect to `?success=<verb>` after a mutation; every screen used to
// turn that into its own banner — an alert.Alert here, a hand-rolled green div
// there. The feedback is transient, so it belongs in a toast, and wording it in
// one place keeps the vocabulary of the verbs consistent.
//
// `subject` names what was acted on ("Le middleware", "Le rôle"); leave it empty
// for a generic wording.
templ FlashToast(success, subject string) {
	if success != "" {
		@toast.Toast(toast.Props{
			Variant:     toast.VariantSuccess,
			Title:       "Opération réussie",
			Description: flashMessage(success, subject),
			Dismissible: true,
			Icon:        true,
		})
	}
}

// FlashError renders the reason the previous request failed.
//
// Unlike FlashToast this stays on screen: a failure is something to read and act
// on, not something to catch before it fades. `subject` names what the operation
// was about ("Un middleware", "Un modèle virtuel").
templ FlashError(reason, subject string) {
	if reason != "" {
		@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
			@alert.Description() {
				{ errorMessage(reason, subject) }
			}
		}
	}
}

// errorMessage words the `?error=` code. Handlers also pass free-form messages
// through the same field, so anything unrecognised is shown as-is.
func errorMessage(reason, subject string) string {
	switch reason {
	case "exists":
		if subject == "" {
			return "Un élément portant ce nom existe déjà."
		}
		return subject + " portant ce nom existe déjà."
	case "name_required":
		return "Le nom est obligatoire."
	case "create_failed":
		return "La création a échoué."
	case "update_failed":
		return "L'enregistrement a échoué."
	case "delete_failed":
		return "La suppression a échoué."
	default:
		return reason
	}
}

// flashMessage words the `?success=` verb, optionally about a named subject.
func flashMessage(success, subject string) string {
	var action string
	switch success {
	case "created":
		action = "a été créé."
	case "updated", "saved":
		action = "a été enregistré."
	case "deleted":
		action = "a été supprimé."
	case "revoked":
		action = "a été révoqué."
	default:
		// Unknown verbs still deserve feedback rather than silence.
		return "L'opération a été effectuée."
	}

	if subject == "" {
		return "L'élément " + action
	}
	return subject + " " + action
}
