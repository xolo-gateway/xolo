package component

import (
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/alert"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

type ErrorPageVModel struct {
	Message string
	Links   []LinkItem
}

type LinkItem struct {
	URL   string
	Label string
}

templ ErrorPage(vmodel ErrorPageVModel) {
	// Comme StandaloneLayout : hors coquille applicative, donc rechargement complet.
	@Page(WithTitle(i18n.T(ctx, "error.title")), WithBodyAttributes(templ.Attributes{"hx-boost": "false"})) {
		<div id="content" class="flex min-h-[calc(100vh-4rem)] items-center justify-center max-w-3xl p-4 mx-auto">
			@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
				@alert.Title() {
					<div class="flex items-center gap-2">
						@icon.CircleAlert()
						<span>{ i18n.T(ctx, "error.title") }</span>
					</div>
				}
				@alert.Description() {
					<div class="space-y-4">
						<p>{ vmodel.Message }</p>
						if len(vmodel.Links) > 0 {
							<div class="flex flex-wrap items-center gap-2">
								for _, l := range vmodel.Links {
									@button.Button(button.Props{Href: l.URL}) {
										{ l.Label }
									}
								}
							</div>
						}
					</div>
				}
			}
		</div>
	}
}
