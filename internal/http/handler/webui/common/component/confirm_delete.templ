package component

import (
	"net/http"
	"strings"

	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/dialog"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

// ConfirmDeleteProps configures a destructive action guarded by a dialog.
type ConfirmDeleteProps struct {
	// URL receives the request once the action is confirmed.
	URL string
	// Method is the HTTP verb of that request. Defaults to DELETE; the alert
	// routes expose their deletion as a POST on a /delete path instead.
	Method string
	// Label is the text of the trigger button. Empty renders an icon-only button.
	Label string
	// Title and Description word the confirmation dialog. Description should
	// name what is about to disappear, and say so if it cannot be undone.
	Title       string
	Description string
	// ConfirmLabel is the text of the destructive button in the dialog.
	// Defaults to "Supprimer".
	ConfirmLabel string
	// Variant overrides the look of the trigger. Row actions stay ghost (the
	// default); the standalone button at the bottom of an editor is solid.
	Variant button.Variant
	// Icon overrides the trigger icon, for actions that are not a deletion
	// (revoking an invite, for instance).
	Icon func(...icon.Props) templ.Component
	// Title attribute of the trigger, for icon-only buttons.
	Tooltip string
	// Class adds utilities to the trigger, for the places where the default
	// square does not fit — an action sitting on a line of text rather than in
	// a row of its own.
	Class string
}

// ConfirmDelete renders a destructive action: a trigger button, and a dialog
// asking for confirmation before the request leaves.
//
// It replaces the `onclick="if(confirm(…))fetch(…,{method:'DELETE'})"` one-liner
// that used to be copied onto every delete button. The request is now an
// hx-delete: the handlers answer 303 to the list page, and the swap attributes
// inherited from <body> drop that page's #content in place.
templ ConfirmDelete(props ConfirmDeleteProps) {
	{{ confirmLabel := props.ConfirmLabel }}
	if confirmLabel == "" {
		{{ confirmLabel = i18n.T(ctx, "common.delete") }}
	}
	{{ variant := props.Variant }}
	if variant == "" {
		{{ variant = button.VariantGhost }}
	}
	{{ triggerIcon := props.Icon }}
	if triggerIcon == nil {
		{{ triggerIcon = icon.Trash2 }}
	}
	@dialog.Dialog() {
		@dialog.Trigger() {
			@button.Button(button.Props{
				Variant:    variant,
				Size:       triggerSize(props.Label),
				Class:      destructiveHint(variant) + " " + props.Class,
				Type:       button.TypeButton,
				Attributes: triggerAttributes(props.Tooltip),
			}) {
				if props.Label != "" {
					@triggerIcon(icon.Props{Size: 14, Class: "mr-2"})
					{ props.Label }
				} else {
					@triggerIcon(icon.Props{Size: 15})
				}
			}
		}
		<!-- Le panneau est `fixed`, mais il reste dans le DOM là où le déclencheur
		a été écrit : il hérite donc de la typographie de son hôte. Dans un en-tête
		de table cela donnait un dialogue en capitales dont le texte, en
		`whitespace-nowrap`, débordait du cadre avec ses boutons. On repart d'une
		typographie neutre. -->
		@dialog.Content(dialog.ContentProps{
			Class: "max-w-md whitespace-normal text-left font-sans text-sm font-normal normal-case tracking-normal text-foreground",
		}) {
			@dialog.Header() {
				@dialog.Title() {
					{ props.Title }
				}
				if props.Description != "" {
					@dialog.Description() {
						{ props.Description }
					}
				}
			}
			@dialog.Footer() {
				@dialog.Close() {
					@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeButton}) {
						{ i18n.T(ctx, "common.cancel") }
					}
				}
				@button.Button(button.Props{
					Variant:    button.VariantDestructive,
					Type:       button.TypeButton,
					Attributes: requestAttributes(props.Method, props.URL),
				}) {
					{ confirmLabel }
				}
			}
		}
	}
}

// triggerSize keeps an icon-only trigger square instead of letting it inherit
// the padding of a labelled button.
func triggerSize(label string) button.Size {
	if label == "" {
		return button.SizeIcon
	}
	return button.SizeSm
}

// destructiveHint tints a ghost trigger red — encre *et* survol. Le survol gris
// de la variante fantôme ferait d'une suppression un contrôle comme un autre,
// alors que le design system réserve la teinte destructive à ces actions.
func destructiveHint(variant button.Variant) string {
	if variant == button.VariantGhost {
		return "text-destructive hover:bg-destructive-tint hover:text-destructive"
	}
	return ""
}

// triggerAttributes puts the tooltip on the trigger, which is the only way an
// icon-only button says what it does on hover.
func triggerAttributes(tooltip string) templ.Attributes {
	if tooltip == "" {
		return nil
	}
	return templ.Attributes{"title": tooltip}
}

// requestAttributes turns the verb into the matching hx-* attribute.
func requestAttributes(method, url string) templ.Attributes {
	attr := "hx-delete"
	if strings.EqualFold(method, http.MethodPost) {
		attr = "hx-post"
	}
	return templ.Attributes{
		attr:          url,
		"hx-push-url": "true",
	}
}
