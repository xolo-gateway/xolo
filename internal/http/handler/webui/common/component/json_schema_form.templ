package component

import (
	"fmt"

	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/checkbox"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/form"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/input"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/selectbox"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/textarea"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

// JSONSchemaFormArrayObjectField renders a dynamic list editor for array-of-objects fields.
// existingJSON is the current JSON array string (e.g. "[{...},{...}]").
// The field submits as a hidden input named "{name}__json".
//
// The markup here is only an anchor: the rows are built in the browser by the
// array-field module of assets/js/xolo.js, from the schema carried by
// `data-schema`. It is the one editor the server cannot render — the schemas
// come from the plugins, at runtime.
templ JSONSchemaFormArrayObjectField(name string, schema map[string]any, existingJSON string) {
	{{ itemsSchemaJSON := marshalJSON(schema["items"]) }}
	<div
		class="array-field-root flex flex-col gap-3"
		data-field={ name }
		data-items={ existingJSON }
		data-schema={ itemsSchemaJSON }
	>
		<div class="array-field-items flex flex-col gap-3"></div>
		<!-- hidden input: no templui equivalent, not rendered -->
		<input type="hidden" class="array-field-json" name={ name + "__json" }/>
		@button.Button(button.Props{
			Type:    button.TypeButton,
			Variant: button.VariantOutline,
			Class:   "array-field-add",
		}) {
			{ i18n.T(ctx, "common.add_item") }
		}
	</div>
}

templ JSONSchemaFormField(name string, schema map[string]any, value string) {
	if isArrayOfObjects(schema) {
		@JSONSchemaFormArrayObjectField(name, schema, value)
	} else {
		switch schema["type"] {
			case "boolean":
				<div class="flex items-center gap-2">
					@checkbox.Checkbox(checkbox.Props{
						ID:      name,
						Name:    name,
						Checked: value == "true",
					})
					@form.Label(form.LabelProps{For: name}) {
						{ getTitle(schema, name) }
					}
				</div>
			case "number", "integer":
				<div class="flex flex-col gap-1">
					@form.Label(form.LabelProps{For: name}) {
						{ getTitle(schema, name) }
					}
					if desc, ok := schema["description"].(string); ok && desc != "" {
						<p class="text-xs text-muted-foreground">{ desc }</p>
					}
					@input.Input(input.Props{
						ID:    name,
						Name:  name,
						Type:  input.TypeNumber,
						Value: value,
					})
				</div>
			default:
				if enum, ok := schema["enum"].([]any); ok {
					<div class="flex flex-col gap-1">
						@form.Label(form.LabelProps{For: name}) {
							{ getTitle(schema, name) }
						}
						if desc, ok := schema["description"].(string); ok && desc != "" {
							<p class="text-xs text-muted-foreground">{ desc }</p>
						}
						@selectbox.SelectBox(selectbox.Props{ID: name}) {
							@selectbox.Trigger(selectbox.TriggerProps{Name: name}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: getTitle(schema, name)})
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
								@selectbox.Group() {
									for _, opt := range enum {
										@selectbox.Item(selectbox.ItemProps{
											Value:    fmt.Sprintf("%v", opt),
											Selected: fmt.Sprintf("%v", opt) == value,
										}) {
											{ fmt.Sprintf("%v", opt) }
										}
									}
								}
							}
						}
					</div>
				} else {
					<div class="flex flex-col gap-1">
						@form.Label(form.LabelProps{For: name}) {
							{ getTitle(schema, name) }
						}
						if desc, ok := schema["description"].(string); ok && desc != "" {
							<p class="text-xs text-muted-foreground">{ desc }</p>
						}
						if format, _ := schema["format"].(string); format == "textarea" {
							@textarea.Textarea(textarea.Props{
								ID:    name,
								Name:  name,
								Value: value,
								Class: "font-mono min-h-32",
							})
						} else {
							@input.Input(input.Props{
								ID:    name,
								Name:  name,
								Type:  input.TypeText,
								Value: value,
							})
						}
					</div>
				}
		}
	}
}

templ JSONSchemaForm(action string, properties map[string]map[string]any, values map[string]string, fieldErrors map[string]string) {
	<form method="POST" action={ templ.SafeURL(action) } class="flex flex-col gap-4">
		for name, schema := range properties {
			<div>
				if t, _ := schema["type"].(string); t == "array" {
					<p class="text-sm font-medium mb-2">{ getTitle(schema, name) }</p>
				}
				@JSONSchemaFormField(name, schema, values[name])
				if msg, ok := fieldErrors[name]; ok {
					@form.Message(form.MessageProps{Variant: form.MessageVariantError, Class: "mt-1"}) {
						{ msg }
					}
				}
			</div>
		}
		if msg, ok := fieldErrors["_"]; ok {
			@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
				{ msg }
			}
		}
		@button.Button(button.Props{Type: button.TypeSubmit}) {
			{ i18n.T(ctx, "common.save") }
		}
	</form>
}
