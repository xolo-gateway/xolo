package component

import (
	"fmt"

	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/progress"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

// BudgetBar renders the consumption bar of a budget, coloured by how close to
// the ceiling the spending is.
//
// `heightClass` overrides the bar thickness (progress.Progress ships h-2.5):
// the dashboards want a thinner bar than the dedicated budget screen. It is
// merged after the component's own size class, so it wins.
//
// `ariaLabel` is the text of the caption the caller draws next to the bar.
templ BudgetBar(pct int, heightClass string, ariaLabel ...string) {
	@progress.Progress(progress.Props{
		Value:     pct,
		AriaLabel: defaultString(ariaLabel, ""),
		BarClass:  QuotaBarClass(pct) + " " + heightClass,
	})
}

// ChartShareRow renders one entry of a "répartition par …" legend: colour
// swatch, label, share bar and percentage.
//
// `labelWidth` is a width utility for the label column — the org and personal
// dashboards give it different room because they sit in cards of different spans.
templ ChartShareRow(share ChartShare, labelWidth string) {
	<div class="flex items-center gap-2.5 py-1.5">
		<span class={ "w-2.5 h-2.5 rounded-xs shrink-0 " + share.ColorClass }></span>
		<span class={ "text-sm font-mono text-foreground overflow-hidden text-ellipsis whitespace-nowrap " + labelWidth }>{ share.Label }</span>
		@progress.Progress(progress.Props{
			Value:     share.Pct,
			AriaLabel: defaultString([]string{share.Label}, i18n.T(ctx, "common.unidentified")),
			Class:     "flex-1",
			BarClass:  "h-1.5 " + share.ColorClass,
		})
		<span class="text-xs text-muted-foreground w-10 text-right">{ fmt.Sprintf("%d%%", share.Pct) }</span>
	</div>
}

// RankedRowProps configures how one entry of a leaderboard is drawn.
type RankedRowProps struct {
	// Initials prefixes the row with the initials disc of a person, as the
	// mockup's "Top consommateurs" does.
	Initials bool
	// Mono prefixes the row with a colour swatch and sets the label in the
	// monospace face, for machine-written names (providers, models).
	Mono bool
	// Value is the already-formatted figure closing the row.
	Value string
}

// Ranked is one entry of a leaderboard: a label, its share of the leader, and
// the raw value the caller formats.
type Ranked struct {
	Label      string
	Value      float64
	Pct        int
	ColorClass string
}

// RankedRow renders one entry of the "Top consommateurs" / "Coût par
// fournisseur" lists.
//
// The mockup draws these as ranked bar lists rather than as bar charts: the
// reading is "who spends the most", where the name matters as much as the
// figure — a category axis would truncate the names and lose the ranking.
templ RankedRow(row Ranked, props RankedRowProps) {
	<div class="flex items-center gap-2.5 py-1.5">
		if props.Initials {
			@PersonAvatar(row.Label, "size-5")
		}
		if props.Mono {
			<span class={ "size-2 shrink-0 rounded-xs", row.ColorClass }></span>
		}
		<span
			class={ "w-32 shrink-0 overflow-hidden text-ellipsis whitespace-nowrap text-sm",
				templ.KV("font-mono text-xs", props.Mono) }
		>
			{ row.Label }
		</span>
		@progress.Progress(progress.Props{
			Value:     row.Pct,
			AriaLabel: defaultString([]string{row.Label}, i18n.T(ctx, "common.unidentified")),
			Class:     "flex-1",
			BarClass:  "h-1.5 " + rankedBarClass(row.ColorClass),
		})
		<span class="w-20 shrink-0 text-right text-xs tnum text-muted-foreground">{ props.Value }</span>
	</div>
}

// rankedBarClass falls back to the primary colour, which is what the mockup uses
// for a list whose entries carry no colour of their own.
func rankedBarClass(colorClass string) string {
	if colorClass == "" {
		return "bg-primary"
	}
	return colorClass
}
