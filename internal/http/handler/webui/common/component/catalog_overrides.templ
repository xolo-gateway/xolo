package component

import (
	"github.com/xolo-gateway/xolo/internal/core/model"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/form"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/input"
	switchcomp "github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/switch"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

// CatalogOverridesFields renders what a virtual model declares in the model
// catalogue. Xolo derives these values from the models the pipeline calls; the
// fields are for pipelines that choose their model at run time, or for a card
// that should say something else. ParseCatalogOverrides reads them back.
templ CatalogOverridesFields(o *model.CatalogOverrides) {
	{{ caps := overrideCaps(o) }}
	<div class="space-y-4">
		<div class="space-y-1">
			@form.Label(form.LabelProps{}) {
				{ i18n.T(ctx, "common.catalog.title") }
			}
			@form.Description() {
				{ i18n.T(ctx, "common.catalog.description") }
			}
		</div>
		<div class="grid grid-cols-2 gap-3">
			<div class="space-y-2">
				@form.Label(form.LabelProps{For: "catalog_context_window"}) {
					{ i18n.T(ctx, "common.catalog.context_window") }
				}
				@input.Input(input.Props{ID: "catalog_context_window", Name: "catalog_context_window", Type: "number", Value: overrideContextWindow(o), Placeholder: i18n.T(ctx, "common.catalog.derived"), Attributes: templ.Attributes{"min": "0", "step": "1"}})
			</div>
			<div class="space-y-2">
				@form.Label(form.LabelProps{For: "catalog_max_output_tokens"}) {
					{ i18n.T(ctx, "common.catalog.max_output") }
				}
				@input.Input(input.Props{ID: "catalog_max_output_tokens", Name: "catalog_max_output_tokens", Type: "number", Value: overrideMaxOutput(o), Placeholder: i18n.T(ctx, "common.catalog.derived"), Attributes: templ.Attributes{"min": "0", "step": "1"}})
			</div>
		</div>
		<div class="space-y-2">
			@form.ItemFlex() {
				@switchcomp.Switch(switchcomp.Props{ID: "catalog_caps_declared", Name: "catalog_caps_declared", Checked: overrideCapsDeclared(o)})
				@form.Label(form.LabelProps{For: "catalog_caps_declared"}) {
					{ i18n.T(ctx, "common.catalog.declare_caps") }
				}
			}
			<div class="grid grid-cols-2 gap-2 pl-2">
				@form.ItemFlex() {
					@switchcomp.Switch(switchcomp.Props{ID: "catalog_cap_tools", Name: "catalog_cap_tools", Checked: caps.Tools})
					@form.Label(form.LabelProps{For: "catalog_cap_tools"}) {
						{ i18n.T(ctx, "common.catalog.cap.tools") }
					}
				}
				@form.ItemFlex() {
					@switchcomp.Switch(switchcomp.Props{ID: "catalog_cap_vision", Name: "catalog_cap_vision", Checked: caps.Vision})
					@form.Label(form.LabelProps{For: "catalog_cap_vision"}) {
						{ i18n.T(ctx, "common.catalog.cap.vision") }
					}
				}
				@form.ItemFlex() {
					@switchcomp.Switch(switchcomp.Props{ID: "catalog_cap_reasoning", Name: "catalog_cap_reasoning", Checked: caps.Reasoning})
					@form.Label(form.LabelProps{For: "catalog_cap_reasoning"}) {
						{ i18n.T(ctx, "common.catalog.cap.reasoning") }
					}
				}
				@form.ItemFlex() {
					@switchcomp.Switch(switchcomp.Props{ID: "catalog_cap_audio", Name: "catalog_cap_audio", Checked: caps.Audio})
					@form.Label(form.LabelProps{For: "catalog_cap_audio"}) {
						{ i18n.T(ctx, "common.catalog.cap.audio") }
					}
				}
			</div>
		</div>
	</div>
}
