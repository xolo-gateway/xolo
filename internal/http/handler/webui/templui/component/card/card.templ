			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Title(props ...TitleProps) {
	{{ var p TitleProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Level == 2 {
		<h2
			if p.ID != "" {
				id={ p.ID }
			}
			class={
				utils.TwMerge(
					"text-lg font-semibold leading-none tracking-tight",
					p.Class,
				),
			}
			{ p.Attributes... }
		>
			{ children... }
		</h2>
	} else {
		<h3
			if p.ID != "" {
				id={ p.ID }
			}
			class={
				utils.TwMerge(
					"text-lg font-semibold leading-none tracking-tight",
					p.Class,
				),
			}
			{ p.Attributes... }
		>
			{ children... }
		</h3>
	}
}

