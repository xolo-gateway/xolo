// templui component code - version: v1.5.0 installed by templui v1.5.0
// 📚 Documentation: https://templui.io/docs/components/code
package code

import "github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/utils"

type Props struct {
	ID        string
	Class     string
	Attrs     templ.Attributes
	Language  string
	CodeClass string
}

// Code renders a syntax-highlighted block.
//
// Upstream emits the highlight.js <link> and <script> here, once per block and
// pointing at cdnjs. Both were moved to Script(): Xolo must run offline (see the
// self-hosted fonts in templui.css), and Script() is registered once per page in
// common.baseScripts() instead of being repeated for every block on the page.
templ Code(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = "code-" + utils.RandomID() }}
	}
	<div
		id={ p.ID }
		class={ utils.TwMerge("relative code-component", p.Class) }
		data-tui-code-component
		{ p.Attrs... }
	>
		<pre class="overflow-hidden!">
			<code
				data-tui-code-block
				class={
					utils.TwMerge(
						"language-"+p.Language,
						"overflow-y-auto! rounded-md block text-sm max-h-[500px]",
						"hljs-target",
						p.CodeClass,
					),
				}
			>
				{ children... }
			</code>
		</pre>
	</div>
}

templ Script() {
	// highlight.js is vendored under assets/vendor/ rather than pulled from a CDN.
	// Only the light theme is served — the product is light-only — and its
	// stylesheet is linked from the page head, before ours, so the corrections
	// this project makes to it win.
	<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/assets/vendor/highlight.min.js") }></script>
	<script defer nonce={ templ.GetNonce(ctx) } src={ utils.ScriptURL("/assets/js/code.min.js") }></script>
}
