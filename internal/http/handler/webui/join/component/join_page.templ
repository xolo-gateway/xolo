package component

import (
	"github.com/xolo-gateway/xolo/internal/core/model"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/card"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

type JoinPageVModel struct {
	User       model.User
	Org        model.Organization
	RoleName   string
	LoginURL   string
	DeclineURL string
}

templ JoinPage(vmodel JoinPageVModel) {
	@common.StandaloneLayout(common.WithTitle(i18n.T(ctx, "join.page.title", vmodel.Org.Name()))) {
		@card.Card() {
			@card.Header() {
				@card.Title() {
					{ i18n.T(ctx, "join.page.heading", vmodel.Org.Name()) }
				}
			}
			@card.Content() {
				<div class="space-y-4">
					<p class="text-sm text-muted-foreground">
						@templ.Raw(i18n.T(ctx, "join.page.invited", strongName(vmodel.Org.Name())))
					</p>
					<div class="flex items-center gap-2.5 text-sm">
						<span class="font-medium">{ i18n.T(ctx, "join.role_label") }</span>
						@common.Badge(common.ToneInfo, vmodel.RoleName)
					</div>
					if vmodel.User == nil {
						<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "join.page.login_required") }</p>
						@button.Button(button.Props{Href: vmodel.LoginURL, Class: "w-full"}) {
							{ i18n.T(ctx, "join.sign_in") }
						}
					} else {
						<div class="flex gap-2.5">
							<form method="POST" class="flex-1">
								@button.Button(button.Props{Type: button.TypeSubmit, Class: "w-full"}) {
									{ i18n.T(ctx, "join.page.accept") }
								}
							</form>
							<form method="POST" action={ templ.SafeURL(vmodel.DeclineURL) } class="flex-1">
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Class: "w-full"}) {
									{ i18n.T(ctx, "join.page.decline") }
								}
							</form>
						</div>
					}
				</div>
			}
		}
	}
}

// JoinLogin intentionally receives no organization, recipient or role.
templ JoinLogin(loginURL string) {
	@common.StandaloneLayout(common.WithTitle(i18n.T(ctx, "join.login.title"))) {
		@card.Card() {
			@card.Header() {
				@card.Title() {
					{ i18n.T(ctx, "join.login.title") }
				}
			}
			@card.Content() {
				<p class="mb-4 text-sm text-muted-foreground">{ i18n.T(ctx, "join.login.description") }</p>
				@button.Button(button.Props{Href: loginURL, Class: "w-full"}) {
					{ i18n.T(ctx, "join.sign_in") }
				}
			}
		}
	}
}

// strongName emphasizes an organization name inside a translated sentence. The
// name is escaped: only the markup around it is trusted.
func strongName(name string) string {
	return `<strong class="text-foreground">` + templ.EscapeString(name) + `</strong>`
}
