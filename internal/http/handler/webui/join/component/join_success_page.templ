package component

import (
	"github.com/xolo-gateway/xolo/internal/core/model"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/card"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

type JoinSuccessVModel struct {
	User          model.User
	OrgName       string
	OrgSlug       string
	RoleName      string
	AlreadyMember bool
	Destination   string
}

templ JoinSuccess(vmodel JoinSuccessVModel) {
	@common.StandaloneLayout(common.WithTitle(i18n.T(ctx, "join.success.title", vmodel.OrgName))) {
		@card.Card() {
			@card.Header() {
				@card.Title() {
					{ i18n.T(ctx, "join.success.heading") }
				}
			}
			@card.Content() {
				<div class="space-y-4">
					if vmodel.AlreadyMember {
						<p class="text-sm text-muted-foreground">
							@templ.Raw(i18n.T(ctx, "join.success.already_member", strongName(vmodel.OrgName)))
						</p>
					} else {
						<p class="text-sm text-muted-foreground">
							@templ.Raw(i18n.T(ctx, "join.success.joined", strongName(vmodel.OrgName)))
						</p>
					}
					if vmodel.RoleName != "" {
						<p class="text-sm">{ i18n.T(ctx, "join.success.role", vmodel.RoleName) }</p>
					}
					@button.Button(button.Props{Href: vmodel.Destination, Class: "w-full"}) {
						{ i18n.T(ctx, "join.success.continue") }
					}
				</div>
			}
		}
	}
}
