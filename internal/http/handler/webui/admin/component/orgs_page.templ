package component

import (
	"fmt"

	"github.com/xolo-gateway/xolo/internal/core/model"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/checkbox"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/form"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/input"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/table"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

type OrgsPageVModel struct {
	common.AppLayoutVModel

	// Orgs are the rows matching the current filters, richest first.
	Orgs []OverviewOrg
	// Currency is the reference every cost is converted into.
	Currency string
	// TotalOrgs, TotalMembers describe the whole set, not the filtered one: the
	// subtitle states what the platform holds.
	TotalOrgs    int
	TotalMembers int

	Search string
	// Status is the active segment: "", "active" or "inactive".
	Status  string
	Success string
}

type OrgFormVModel struct {
	common.AppLayoutVModel
	Org   model.Organization
	IsNew bool
	Error string
}

templ OrgsPage(vmodel OrgsPageVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(i18n.T(ctx, "admin.orgs.title"))) {
		@common.PageHeader(common.PageHeaderProps{
			Title:    i18n.T(ctx, "admin.orgs.title"),
			Subtitle: i18n.T(ctx, "admin.orgs.subtitle", fmt.Sprint(vmodel.TotalOrgs), fmt.Sprint(vmodel.TotalMembers), vmodel.Currency),
		}) {
			@button.Button(button.Props{
				Href:  common.BaseURLString(ctx, common.WithPath("/admin/orgs/new")),
				Size:  button.SizeSm,
				Class: "gap-1.5 bg-platform text-platform-foreground hover:bg-platform/90",
			}) {
				@icon.Plus(icon.Props{Class: "size-3.5"})
				{ i18n.T(ctx, "admin.orgs.new") }
			}
		}
		if vmodel.Success != "" {
			<div class="mb-3.5">
				@common.InfoBanner(common.TonePositive, orgsSuccessMessage(ctx, vmodel.Success))
			</div>
		}
		@common.FilterBar() {
			@common.SearchFilter(common.SearchFilterProps{
				Name:        "q",
				Value:       vmodel.Search,
				Placeholder: i18n.T(ctx, "admin.orgs.search_placeholder"),
				Attributes: templ.Attributes{
					"hx-get":        common.BaseURLString(ctx, common.WithPath("/admin/orgs")),
					"hx-trigger":    "input changed delay:250ms, search",
					"hx-target":     "#orgs-results",
					"hx-select":     "#orgs-results",
					"hx-swap":       "outerHTML",
					"hx-push-url":   "true",
					"hx-include":    "[name='status']",
					"hx-select-oob": "unset",
					"autocomplete":  "off",
				},
			})
			<!-- Le segment courant voyage avec la recherche : hx-include le lit ici
			plutôt que de le recopier dans l'URL du champ. -->
			<input type="hidden" name="status" value={ vmodel.Status }/>
			@common.SegmentedNav(orgsSegments(ctx, vmodel))
		}
		@orgsResults(vmodel)
	}
}

templ orgsResults(vmodel OrgsPageVModel) {
	<div id="orgs-results">
		if len(vmodel.Orgs) == 0 {
			if vmodel.Search != "" || vmodel.Status != "" {
				@common.EmptyState(common.EmptyStateProps{
					Icon:        icon.Search,
					Title:       i18n.T(ctx, "admin.orgs.no_match.title"),
					Description: i18n.T(ctx, "admin.orgs.no_match.description"),
				}) {
					@button.Button(button.Props{
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
						Href:    common.BaseURLString(ctx, common.WithPath("/admin/orgs")),
					}) {
						{ i18n.T(ctx, "admin.orgs.clear_filters") }
					}
				}
			} else {
				@common.EmptyState(common.EmptyStateProps{
					Icon:        icon.Building2,
					Title:       i18n.T(ctx, "admin.orgs.empty.title"),
					Description: i18n.T(ctx, "admin.orgs.empty.description"),
				}) {
					@button.Button(button.Props{
						Size:  button.SizeSm,
						Href:  common.BaseURLString(ctx, common.WithPath("/admin/orgs/new")),
						Class: "bg-platform text-platform-foreground hover:bg-platform/90",
					}) {
						{ i18n.T(ctx, "admin.orgs.new") }
					}
				}
			}
		} else {
			@common.Section() {
				@table.Table() {
					@table.Header() {
						@table.Head() {
							{ i18n.T(ctx, "admin.orgs.col.org") }
						}
						@table.Head(table.HeadProps{Class: "text-right"}) {
							{ i18n.T(ctx, "admin.orgs.col.members") }
						}
						@table.Head(table.HeadProps{Class: "text-right"}) {
							{ i18n.T(ctx, "admin.orgs.col.applications") }
						}
						@table.Head(table.HeadProps{Class: "text-right"}) {
							{ i18n.T(ctx, "admin.orgs.col.cost_30d") }
						}
						@table.Head(table.HeadProps{Class: "text-right"}) {
							{ i18n.T(ctx, "admin.orgs.col.tokens") }
						}
						@table.Head(table.HeadProps{Class: "text-right"}) {
							{ i18n.T(ctx, "admin.orgs.col.requests") }
						}
						@table.Head(table.HeadProps{Class: "w-38"}) {
							{ i18n.T(ctx, "admin.orgs.col.monthly_budget") }
						}
						@table.Head(table.HeadProps{Class: "text-right"}) {
							{ i18n.T(ctx, "admin.orgs.col.errors") }
						}
						@table.Head(table.HeadProps{Class: "text-right"}) {
							{ i18n.T(ctx, "admin.orgs.col.p95") }
						}
						@table.Head() {
							{ i18n.T(ctx, "admin.orgs.col.status") }
						}
						@table.Head(table.HeadProps{Class: "text-right"}) {
							{ i18n.T(ctx, "admin.orgs.col.actions") }
						}
					}
					@table.Body() {
						for _, org := range vmodel.Orgs {
							@table.Row() {
								@table.Cell() {
									<div class="flex items-center gap-2.5">
										@common.InitialSquare(org.Name)
										<div class="min-w-0">
											<div class="truncate text-sm font-semibold">{ org.Name }</div>
											@common.Mono(org.Slug)
										</div>
									</div>
								}
								@table.Cell(table.CellProps{Class: "text-right text-sm"}) {
									{ fmt.Sprintf("%d", org.Members) }
								}
								@table.Cell(table.CellProps{Class: "text-right"}) {
									<!-- TODO(rework-ux): les applications M2M sont
									déclarées par organisation et la console n'a pas de
									store pour les compter hors contexte d'organisation
									(cf. lot 7 du plan). -->
									@common.PendingValue(i18n.T(ctx, "admin.orgs.applications_pending"))
								}
								@table.Cell(table.CellProps{Class: "text-right text-sm font-semibold"}) {
									{ common.FormatCostCompact(ctx, org.Cost, vmodel.Currency) }
								}
								@table.Cell(table.CellProps{Class: "text-right text-sm text-muted-foreground"}) {
									{ common.FormatCount(ctx, org.Tokens) }
								}
								@table.Cell(table.CellProps{Class: "text-right text-sm text-muted-foreground"}) {
									{ common.FormatCount(ctx, org.Requests) }
								}
								@table.Cell() {
									<!-- TODO(rework-ux): les quotas vivent dans le store
									de quotas de l'organisation ; la console ne le
									consulte pas. La jauge de la maquette attend un
									agrégat budget/consommation cross-organisation
									(cf. lot 7 du plan). -->
									@common.PendingValue(i18n.T(ctx, "admin.orgs.monthly_budget_pending"))
								}
								@table.Cell(table.CellProps{Class: "text-right"}) {
									<!-- TODO(rework-ux): aucun compteur de statuts de
									réponse n'existe (cf. Santé du proxy, lot 7). -->
									@common.PendingValue(i18n.T(ctx, "admin.orgs.error_rate_pending"))
								}
								@table.Cell(table.CellProps{Class: "text-right"}) {
									<!-- TODO(rework-ux): aucun histogramme de latence
									n'est collecté (cf. Santé du proxy, lot 7). -->
									@common.PendingValue(i18n.T(ctx, "admin.orgs.latency_pending"))
								}
								@table.Cell() {
									if org.Active {
										@common.Badge(common.TonePositive, i18n.T(ctx, "admin.orgs.status.active"))
									} else {
										@common.Badge(common.ToneNeutral, i18n.T(ctx, "admin.orgs.status.inactive"))
									}
								}
								@table.Cell(table.CellProps{Class: "text-right"}) {
									<div class="flex items-center justify-end gap-1.5">
										@button.Button(button.Props{
											Href:    common.BaseURLString(ctx, common.WithPath("/orgs/", org.Slug, "/usage")),
											Variant: button.VariantOutline,
											Size:    button.SizeSm,
										}) {
											{ i18n.T(ctx, "admin.orgs.open") }
										}
										@button.Button(button.Props{
											Href:    common.BaseURLString(ctx, common.WithPath("/admin/orgs/", string(org.ID), "/edit")),
											Variant: button.VariantGhost,
											Size:    button.SizeIcon,
											Class:   "size-7",
											Attributes: templ.Attributes{
												"title":      i18n.T(ctx, "admin.orgs.edit"),
												"aria-label": i18n.T(ctx, "admin.orgs.edit_named", org.Name),
											},
										}) {
											@icon.Pencil(icon.Props{Class: "size-3.5"})
										}
									</div>
								}
							}
						}
					}
				}
			}
			@common.SectionNote() {
				{ i18n.T(ctx, "admin.orgs.open_note") }
			}
		}
	</div>
}

templ OrgForm(vmodel OrgFormVModel) {
	{{ title := i18n.T(ctx, "admin.orgs.new") }}
	{{ action := common.BaseURLString(ctx, common.WithPath("/admin/orgs")) }}
	if !vmodel.IsNew && vmodel.Org != nil {
		{{ title = i18n.T(ctx, "admin.orgs.form.edit_title", vmodel.Org.Name()) }}
		{{ action = common.BaseURLString(ctx, common.WithPath("/admin/orgs/", string(vmodel.Org.ID()), "/edit")) }}
	}
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(title)) {
		<div class="max-w-2xl">
			@common.PageHeader(common.PageHeaderProps{
				Title:    title,
				Subtitle: i18n.T(ctx, "admin.orgs.form.subtitle"),
			})
			if vmodel.Error != "" {
				<div class="mb-3.5">
					@common.InfoBanner(common.ToneNegative, vmodel.Error)
				</div>
			}
			<form method="POST" action={ templ.SafeURL(action) }>
				@common.Section() {
					@common.SectionBody(common.SectionBodyProps{Class: "space-y-3.5"}) {
						@form.Item() {
							@form.Label(form.LabelProps{For: "org-name"}) {
								{ i18n.T(ctx, "admin.orgs.form.name") }
							}
							if !vmodel.IsNew && vmodel.Org != nil {
								@input.Input(input.Props{ID: "org-name", Name: "name", Value: vmodel.Org.Name()})
							} else {
								@input.Input(input.Props{ID: "org-name", Name: "name", Placeholder: i18n.T(ctx, "admin.orgs.form.name_placeholder")})
							}
						}
						@form.Item() {
							@form.Label(form.LabelProps{For: "org-slug"}) {
								{ i18n.T(ctx, "admin.orgs.form.slug") }
							}
							if !vmodel.IsNew && vmodel.Org != nil {
								@input.Input(input.Props{ID: "org-slug", Name: "slug", Value: vmodel.Org.Slug(), Disabled: true})
								@form.Description() {
									{ i18n.T(ctx, "admin.orgs.form.slug_frozen") }
								}
							} else {
								@input.Input(input.Props{ID: "org-slug", Name: "slug", Placeholder: i18n.T(ctx, "admin.orgs.form.slug_placeholder")})
								@form.Description() {
									{ i18n.T(ctx, "admin.orgs.form.slug_hint") }
								}
							}
						}
						@form.Item() {
							@form.Label(form.LabelProps{For: "org-description"}) {
								{ i18n.T(ctx, "admin.orgs.form.description") }
							}
							if !vmodel.IsNew && vmodel.Org != nil {
								@input.Input(input.Props{ID: "org-description", Name: "description", Value: vmodel.Org.Description()})
							} else {
								@input.Input(input.Props{ID: "org-description", Name: "description"})
							}
						}
						if !vmodel.IsNew && vmodel.Org != nil {
							<div class="flex items-center gap-2">
								@checkbox.Checkbox(checkbox.Props{ID: "active", Name: "active", Checked: vmodel.Org.Active()})
								@form.Label(form.LabelProps{For: "active"}) {
									{ i18n.T(ctx, "admin.orgs.form.active") }
								}
							</div>
						}
					}
					@common.SectionHeader(common.SectionHeaderProps{Class: "border-b-0 border-t"}) {
						@button.Button(button.Props{Type: "submit", Size: button.SizeSm}) {
							{ i18n.T(ctx, "admin.orgs.form.save") }
						}
						@button.Button(button.Props{
							Variant: button.VariantGhost,
							Size:    button.SizeSm,
							Href:    common.BaseURLString(ctx, common.WithPath("/admin/orgs")),
						}) {
							{ i18n.T(ctx, "admin.orgs.form.cancel") }
						}
					}
				}
			</form>
		</div>
	}
}
