package component

import (
	formx "github.com/bornholm/go-x/templx/form"
	"github.com/xolo-gateway/xolo/internal/core/model"
	commonComp "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/form"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

type EditUserPageVModel struct {
	AppLayoutVModel commonComp.AppLayoutVModel
	User            model.User
	UserForm        *formx.Form
}

templ EditUserPage(vmodel EditUserPageVModel) {
	@commonComp.AppLayout(vmodel.AppLayoutVModel,
		commonComp.WithTitle(i18n.T(ctx, "admin.edit_user.title")),
	) {
		<div class="max-w-3xl">
			@commonComp.PageHeader(commonComp.PageHeaderProps{
				Title:    vmodel.User.DisplayName(),
				Subtitle: i18n.T(ctx, "admin.edit_user.subtitle"),
			}) {
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Href:    commonComp.BaseURLString(ctx, commonComp.WithPath("/admin/users")),
					Class:   "gap-1.5",
				}) {
					@icon.ArrowLeft(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "admin.edit_user.back") }
				}
			}
			<div class="space-y-3.5">
				@commonComp.Section() {
					@commonComp.SectionHeader() {
						@commonComp.SectionTitle() {
							{ i18n.T(ctx, "admin.edit_user.identity") }
						}
					}
					@commonComp.SectionBody(commonComp.SectionBodyProps{Class: "grid gap-3.5 sm:grid-cols-2"}) {
						@readOnlyField(i18n.T(ctx, "admin.edit_user.display_name"), vmodel.User.DisplayName(), false)
						@readOnlyField(i18n.T(ctx, "admin.edit_user.email"), vmodel.User.Email(), true)
						@readOnlyField(i18n.T(ctx, "admin.edit_user.provider"), vmodel.User.Provider(), true)
						@readOnlyField(i18n.T(ctx, "admin.edit_user.subject"), vmodel.User.Subject(), true)
					}
				}
				@commonComp.Section() {
					@commonComp.SectionHeader() {
						@commonComp.SectionTitle() {
							{ i18n.T(ctx, "admin.edit_user.editable_settings") }
						}
					}
					@commonComp.SectionBody() {
						@formx.FormWrapper(vmodel.UserForm, commonComp.BaseURL(ctx, commonComp.WithPath("/admin/users/"+string(vmodel.User.ID())+"/edit")), "POST") {
							<div class="flex items-center gap-2 pt-1">
								@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Class: "gap-1.5"}) {
									@icon.Save(icon.Props{Class: "size-3.5"})
									{ i18n.T(ctx, "admin.edit_user.save") }
								}
								@button.Button(button.Props{
									Variant: button.VariantGhost,
									Size:    button.SizeSm,
									Href:    commonComp.BaseURLString(ctx, commonComp.WithPath("/admin/users")),
								}) {
									{ i18n.T(ctx, "admin.edit_user.cancel") }
								}
							</div>
						}
					}
				}
				@commonComp.Section(commonComp.SectionProps{Class: "border-destructive/40"}) {
					@commonComp.SectionHeader(commonComp.SectionHeaderProps{Class: "border-destructive/40"}) {
						@commonComp.SectionTitle() {
							{ i18n.T(ctx, "admin.edit_user.danger_zone") }
						}
					}
					@commonComp.SectionBody(commonComp.SectionBodyProps{Class: "flex flex-wrap items-center gap-3.5"}) {
						<p class="min-w-0 flex-1 text-sm text-muted-foreground">
							{ i18n.T(ctx, "admin.edit_user.delete_warning") }
						</p>
						@commonComp.ConfirmDelete(commonComp.ConfirmDeleteProps{
							URL:         commonComp.BaseURLString(ctx, commonComp.WithPath("/admin/users/"+string(vmodel.User.ID()))),
							Label:       i18n.T(ctx, "admin.edit_user.delete"),
							Variant:     button.VariantDestructive,
							Title:       i18n.T(ctx, "admin.edit_user.delete"),
							Description: i18n.T(ctx, "admin.edit_user.delete_confirm", vmodel.User.Email()),
						})
					}
				}
			</div>
		</div>
	}
}

// readOnlyField renders a value the administrator cannot change: it comes from
// the identity provider, so it is displayed rather than edited.
templ readOnlyField(label string, value string, mono bool) {
	@form.Item() {
		@form.Label() {
			{ label }
		}
		<div class={ "rounded-md border bg-muted/50 px-2.5 py-2 text-sm", templ.KV("font-mono", mono) }>
			if value != "" {
				{ value }
			} else {
				<span class="text-muted-foreground">—</span>
			}
		</div>
	}
}
