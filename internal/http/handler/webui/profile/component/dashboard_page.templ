package component

import (
	"fmt"
	"github.com/xolo-gateway/xolo/internal/core/model"
	"github.com/xolo-gateway/xolo/internal/core/port"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	orgcomponent "github.com/xolo-gateway/xolo/internal/http/handler/webui/org/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/pagination"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/table"
)

type OrgUsage struct {
	Membership  model.Membership
	Quota       *model.EffectiveQuota
	DailyCost   int64
	MonthlyCost int64
	YearlyCost  int64
	Currency    string
}

type ModelUsage struct {
	Model     model.LLMModel
	Org       model.Organization
	Aggregate *port.UsageAggregate
	Provider  model.Provider // nil for virtual models
}

type DisplayUsageRecord struct {
	Record           model.UsageRecord
	DisplayModelName string
	DisplayCost      int64
	DisplayCurrency  string
	Converted        bool
	EnergyWh         float64 // midpoint estimation in Wh (0 = unknown)
	EnergyLowWh      float64
	EnergyHighWh     float64
	CO2GramsMid      float64 // gCO₂ at world-average carbon intensity
	CO2GramsMin      float64 // gCO₂ at France nuclear intensity (best case)
	CO2GramsMax      float64 // gCO₂ at coal plant intensity (worst case)
}

type DashboardPageVModel struct {
	AppLayoutVModel       common.AppLayoutVModel
	OrgUsages             []OrgUsage
	Aggregate             *port.UsageAggregate
	Records               []DisplayUsageRecord
	Orgs                  map[model.OrgID]model.Organization
	Range                 string
	Page                  int
	PageSize              int
	HasNext               bool
	SubscriptionProviders []orgcomponent.SubscriptionProviderUsage
	ChartPerDay           []ProfileChartDataPoint
	// ChartCoveredPerDay is the value of the requests covered by a subscription,
	// stacked on ChartPerDay bar for bar.
	ChartCoveredPerDay  []ProfileChartDataPoint
	ChartSharesPerModel []ChartShare
	ChartPerProvider    []ProfileChartDataPoint
	// PlanCoveredProviders holds the labels of ChartPerProvider billed by
	// subscription.
	PlanCoveredProviders map[string]bool
	TotalEnergyWh         float64 // sum of midpoint estimates (0 if all unknown)
	TotalCO2GramsMid      float64 // sum of CO₂ midpoints (world average, grams)
}

// ChartShare represents a value's share of a total, as a percentage, with
// an associated chart color (cycling through the design system's palette).
type ChartShare = common.ChartShare

templ DashboardPage(vmodel DashboardPageVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel,
		common.WithTitle("Usage"),
	) {
		<div class="space-y-3.5">
			<!-- En-tête : mêmes contrôles que le tableau de bord d'organisation —
			segments de période et export CSV — pour que les deux écrans d'usage se
			pilotent de la même façon. -->
			@common.PageHeader(common.PageHeaderProps{
				Title:    "Mon usage",
				Subtitle: personalDashboardMeta(vmodel),
			}) {
				@common.SegmentedNav(common.RangeSegments(vmodel.Range, func(r string) string {
					return common.BaseURLString(ctx, common.WithPath("/usage"), common.WithValues("range", r))
				}))
				@button.Button(button.Props{
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Class:   "gap-1.5",
					Href:    common.BaseURLString(ctx, common.WithPath("/usage"), common.WithValues("range", vmodel.Range, "format", "csv")),
				}) {
					@icon.Download(icon.Props{Class: "size-3.5"})
					CSV
				}
			}
			<!-- Budget par organisation : une seule section, comme la maquette
			« Mon usage », et non une carte par organisation. -->
			@common.Section() {
				@common.SectionHeader() {
					@common.SectionTitle() {
						Mon budget par organisation
					}
				}
				if len(vmodel.OrgUsages) > 0 {
					@common.SectionBody(common.SectionBodyProps{Class: "space-y-3.5"}) {
						for _, ou := range vmodel.OrgUsages {
							@personalOrgBudget(ou)
						}
					}
				} else {
					@common.SectionEmpty(common.EmptyStateProps{
						Icon:        icon.Building2,
						Title:       "Aucune organisation",
						Description: "Vos budgets apparaîtront ici dès que vous rejoindrez une organisation.",
					})
				}
			}
			<!-- Subscription providers plan usage -->
			@orgcomponent.SubscriptionUsageSection(vmodel.SubscriptionProviders)
			<!-- Bande de KPI : mêmes cellules jointives que le tableau de bord
			d'organisation, pour que les deux écrans se lisent de la même façon. Les
			cellules d'estimation gardent leur place quand le calcul est impossible :
			une cellule omise laisserait une piste de grille vide. -->
			@common.KPIBand(common.KPIBandProps{Class: "grid-cols-2 md:grid-cols-3 2xl:grid-cols-5"}) {
				@common.KPI(common.KPIProps{
					Label: "Requêtes",
					Value: common.FormatCount(personalRequests(vmodel.Aggregate)),
				})
				@common.KPI(common.KPIProps{
					Label: "Tokens",
					Value: common.FormatCount(personalTokens(vmodel.Aggregate)),
					Note:  personalCachedTokensNote(vmodel.Aggregate),
				})
				@common.KPI(common.KPIProps{
					Label: "Coût total",
					Value: personalTotalCostValue(vmodel),
				})
				if vmodel.TotalEnergyWh > 0 {
					@common.KPI(common.KPIProps{
						Label: "Énergie",
						Value: common.FormatEnergyWh(vmodel.TotalEnergyWh),
						Note:  common.FormatEnergyToHuman(vmodel.TotalEnergyWh),
					})
				} else {
					@common.KPIPending("Énergie", "Nécessite les paramètres actifs des modèles appelés")
				}
				if vmodel.TotalCO2GramsMid > 0 {
					@common.KPI(common.KPIProps{
						Label: "CO₂",
						Value: common.FormatCO2Grams(vmodel.TotalCO2GramsMid),
						Note:  common.FormatCO2ToCarKilometers(vmodel.TotalCO2GramsMid),
					})
				} else {
					@common.KPIPending("CO₂", "Dérivé de l'estimation énergétique")
				}
			}
			<!-- Chaque bloc garde son cadre même sans donnée, comme le tableau de
			bord d'organisation : un écran dont les sections disparaissent au gré du
			contenu ne se lit plus comme un tableau de bord, et l'absence de chiffre
			devient indiscernable d'un défaut de chargement.
			Même grille que l'overview d'organisation : le coût par jour prend la
			largeur restante, la répartition par modèle une colonne de 380 px. -->
			<div class="grid grid-cols-1 gap-3.5 xl:grid-cols-[minmax(0,1fr)_380px]">
				@common.Section() {
					@common.SectionHeader() {
						@common.SectionTitle() {
							<!-- Le titre suit le pas du graphique : au-delà d'un
							trimestre il agrège par mois. -->
							{ common.CostSeriesTitle(vmodel.Range) }
						}
					}
					if len(vmodel.ChartPerDay) > 0 {
						@common.SectionBody() {
							@common.CostChart(vmodel.ChartPerDay, vmodel.ChartCoveredPerDay, personalCurrency(vmodel))
						}
					} else {
						@common.SectionEmpty(common.EmptyStateProps{
							Icon:        icon.ChartColumn,
							Title:       "Aucune consommation sur la période",
							Description: "Vos requêtes apparaîtront ici dès votre premier appel.",
						})
					}
				}
				@common.Section() {
					@common.SectionHeader() {
						@common.SectionTitle() {
							Répartition par modèle
						}
					}
					if len(vmodel.ChartSharesPerModel) > 0 {
						@common.SectionBody() {
							for _, share := range vmodel.ChartSharesPerModel {
								@common.ChartShareRow(share, "w-28")
							}
						}
					} else {
						@common.SectionEmpty(common.EmptyStateProps{
							Icon:        icon.BrainCircuit,
							Title:       "Aucun modèle appelé",
							Description: "La répartition se remplit dès qu'une requête cite un modèle.",
						})
					}
				}
			</div>
			<!-- Coût par fournisseur : liste classée, comme l'overview
			d'organisation — un axe de catégories tronquerait les noms. -->
			@common.Section() {
				@common.SectionHeader() {
					@common.SectionTitle() {
						Coût par fournisseur
					}
				}
				if len(vmodel.ChartPerProvider) > 0 {
					@common.SectionBody() {
						for _, row := range common.RankedRows(vmodel.ChartPerProvider) {
							@common.RankedRow(row, common.RankedRowProps{
								Mono:  true,
								Value: common.ProviderCostValue(row.Value, personalCurrency(vmodel), vmodel.PlanCoveredProviders[row.Label]),
							})
						}
					}
				} else {
					@common.SectionEmpty(common.EmptyStateProps{
						Icon:        icon.Server,
						Title:       "Aucun fournisseur sollicité",
						Description: "Le coût se ventile par fournisseur dès la première requête servie.",
					})
				}
			}
			<!-- Requêtes récentes : le tableau garde son cadre et son en-tête même
			vide, comme sur l'overview d'organisation. -->
			@common.Section() {
				@common.SectionHeader() {
					@common.SectionTitle() {
						Requêtes récentes
					}
					<span class="ml-auto font-mono text-2xs text-muted-foreground">
						{ personalRecordsRangeLabel(vmodel) }
					</span>
				}
				if len(vmodel.Records) > 0 {
					<div class="overflow-x-auto">
						@table.Table() {
							@table.Header() {
								@table.Head() {
									Date
								}
								@table.Head() {
									Modèle
								}
								@table.Head() {
									Organisation
								}
								@table.Head() {
									Tokens (in/out)
								}
								@table.Head() {
									Coût
								}
								@table.Head() {
									Énergie
								}
								@table.Head() {
									CO₂
								}
							}
							@table.Body() {
								for _, dr := range vmodel.Records {
									@table.Row() {
										@table.Cell() {
											{ dr.Record.CreatedAt().Format("2006-01-02 15:04") }
										}
										@table.Cell() {
											<span class="font-mono">{ dr.DisplayModelName }</span>
										}
										@table.Cell() {
											if org, ok := vmodel.Orgs[dr.Record.OrgID()]; ok {
												@common.Badge(common.ToneNeutral, org.Name())
											} else {
												@common.Badge(common.ToneNeutral, string(dr.Record.OrgID()))
											}
										}
										@table.Cell() {
											<div class="flex items-center gap-1.5">
												{ fmt.Sprintf("%d / %d", dr.Record.PromptTokens(), dr.Record.CompletionTokens()) }
												if dr.Record.CachedTokens() > 0 {
													<span
														title={ fmt.Sprintf("%d tokens en cache", dr.Record.CachedTokens()) }
														class="cursor-help text-muted-foreground"
													>
														@icon.DatabaseZap(icon.Props{Class: "h-3.5 w-3.5"})
													</span>
												}
											</div>
										}
										@table.Cell() {
											<div class="flex items-center gap-1.5">
												if dr.Converted {
													<span
														title={ common.FormatCost(dr.Record.Cost(), dr.Record.Currency()) }
														class="cursor-help underline decoration-dotted"
													>
														{ common.FormatCost(dr.DisplayCost, dr.DisplayCurrency) }
													</span>
												} else {
													{ common.FormatCost(dr.DisplayCost, dr.DisplayCurrency) }
												}
												if dr.Record.PlanCovered() {
													<span
														title="Requête couverte par un forfait abonnement"
														class="cursor-help text-muted-foreground"
													>
														@icon.Receipt(icon.Props{Class: "h-3.5 w-3.5"})
													</span>
												}
											</div>
										}
										@table.Cell() {
											if dr.EnergyWh > 0 {
												<span
													title={ fmt.Sprintf("min: %s / max: %s", common.FormatEnergyWh(dr.EnergyLowWh), common.FormatEnergyWh(dr.EnergyHighWh)) }
													class="cursor-help underline decoration-dotted"
												>
													{ common.FormatEnergyWh(dr.EnergyWh) }
												</span>
											} else {
												—
											}
										}
										@table.Cell() {
											if dr.CO2GramsMid > 0 {
												<span
													title={ fmt.Sprintf("CO₂ France : %s / monde : %s / charbon : %s", common.FormatCO2Grams(dr.CO2GramsMin), common.FormatCO2Grams(dr.CO2GramsMid), common.FormatCO2Grams(dr.CO2GramsMax)) }
													class="cursor-help underline decoration-dotted text-muted-foreground"
												>
													{ common.FormatCO2Grams(dr.CO2GramsMid) }
												</span>
											} else {
												—
											}
										}
									}
								}
							}
						}
					</div>
				} else {
					@common.SectionEmpty(common.EmptyStateProps{
						Icon:        icon.Receipt,
						Title:       "Aucune requête sur la période",
						Description: "Le détail de vos appels s'affichera ici, du plus récent au plus ancien.",
					})
				}
			}
			if len(vmodel.Records) > 0 {
				@pagination.Pagination() {
					@pagination.Content() {
						@pagination.Previous(pagination.PreviousProps{
							Href:     common.BaseURLString(ctx, common.WithPath("/usage"), common.WithValues("range", vmodel.Range, "page", fmt.Sprintf("%d", vmodel.Page-1))),
							Disabled: vmodel.Page <= 1,
							Label:    "Précédent",
						})
						@pagination.Next(pagination.NextProps{
							Href:     common.BaseURLString(ctx, common.WithPath("/usage"), common.WithValues("range", vmodel.Range, "page", fmt.Sprintf("%d", vmodel.Page+1))),
							Disabled: !vmodel.HasNext,
							Label:    "Suivant",
						})
					}
				}
			}
		</div>
	}
}

// personalOrgBudget renders one line of « Mon budget par organisation » : le nom
// de l'organisation, les rôles qu'on y tient, la dépense sur le plafond, puis la
// jauge — la même que celle du tableau de bord d'organisation, donc les mêmes
// seuils de couleur.
templ personalOrgBudget(ou OrgUsage) {
	{{ vm := newPersonalOrgBudget(ou) }}
	<div>
		<div class="mb-1.5 flex flex-wrap items-baseline gap-2">
			<span class="text-sm font-semibold">{ vm.Name }</span>
			if vm.Roles != "" {
				<span class="text-xs text-muted-foreground">{ vm.Roles }</span>
			}
			if vm.Budget == nil {
				@common.Badge(common.ToneNeutral, "Illimité")
			}
			<span class="ml-auto tnum text-xs text-muted-foreground">{ vm.SpentLabel() }</span>
		</div>
		if vm.Budget != nil {
			@common.BudgetGauge(vm.Percent, 0, "")
		}
	</div>
}
