package component

import (
	"github.com/xolo-gateway/xolo/internal/i18n"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	orgcomponent "github.com/xolo-gateway/xolo/internal/http/handler/webui/org/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/form"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/input"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/selectbox"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/textarea"
	"strconv"
)

templ PersonalModelsPage(vmodel PersonalModelsPageVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(i18n.T(ctx, "profile.personal_models.title"))) {
		@common.PageHeader(common.PageHeaderProps{
			Title:    i18n.T(ctx, "profile.personal_models.title"),
			Subtitle: i18n.T(ctx, "profile.personal_models.subtitle"),
		}) {
			<div class="hidden">
				@input.Input(input.Props{
					ID:         "pvm-import-input",
					Type:       input.TypeFile,
					FileAccept: ".json,application/json",
					Attributes: templ.Attributes{
						"data-xolo-import":   vmodel.BaseURL + "/api/personal-models/import",
						"data-redirect-base": common.BaseURLString(ctx, common.WithPath("/profile/personal-models/")),
					},
				})
			</div>
			@button.Button(button.Props{
				Variant: button.VariantOutline,
				Size:    button.SizeSm,
				Attributes: templ.Attributes{
					"data-xolo-file-trigger": "pvm-import-input",
					"type":                   "button",
				},
			}) {
				{ i18n.T(ctx, "profile.personal_models.import") }
			}
			@button.Button(button.Props{
				Size:  button.SizeSm,
				Class: "gap-1.5",
				Href:  common.BaseURLString(ctx, common.WithPath("/profile/personal-models/new")),
			}) {
				@icon.Plus(icon.Props{Class: "size-3.5"})
				{ i18n.T(ctx, "profile.personal_models.new") }
			}
		}
		@common.FlashToast(vmodel.Success, i18n.T(ctx, "profile.personal_models.subject_definite"))
		@common.FlashError(vmodel.Error, i18n.T(ctx, "profile.personal_models.subject_indefinite"))
		if len(vmodel.VirtualModels) == 0 {
			@common.EmptyState(common.EmptyStateProps{
				Icon:        icon.Network,
				Title:       i18n.T(ctx, "profile.personal_models.empty.title"),
				Description: i18n.T(ctx, "profile.personal_models.empty.description"),
			}) {
				@button.Button(button.Props{
					Size: button.SizeSm,
					Href: common.BaseURLString(ctx, common.WithPath("/profile/personal-models/new")),
				}) {
					{ i18n.T(ctx, "profile.personal_models.new") }
				}
			}
		} else {
			<div class="grid items-start gap-3.5 lg:grid-cols-[340px_minmax(0,1fr)]">
				@personalModelList(vmodel)
				@personalModelDetail(vmodel)
			</div>
		}
	}
}

// personalModelList is the master column of the screen, identical in shape to the
// organisation one: the whole set, the selected entry highlighted, selection
// carried by `?vm=` so a pane survives a reload and stays shareable.
templ personalModelList(vmodel PersonalModelsPageVModel) {
	@common.Section() {
		@common.SectionHeader() {
			@common.SectionTitle() {
				{ i18n.T(ctx, "profile.personal_models.count", len(vmodel.VirtualModels)) }
			}
		}
		<div class="flex flex-col">
			for _, vm := range vmodel.VirtualModels {
				{{ selected := vmodel.Selected != nil && vm.ID() == vmodel.Selected.ID() }}
				<a
					href={ templ.SafeURL(common.BaseURLString(ctx, common.WithPath("/profile/personal-models"), common.WithValues("vm", string(vm.ID())))) }
					class={ "border-b px-4 py-2.5 last:border-b-0 hover:bg-row-hover", templ.KV("bg-primary/5", selected) }
					aria-current?={ selected }
				>
					<span class="flex items-center gap-2">
						<span class="min-w-0 flex-1 truncate font-mono text-sm font-semibold">~/{ vm.Name() }</span>
						if vm.Graph() != nil && len(vm.Graph().Nodes) > 0 {
							@common.Badge(common.TonePositive, i18n.T(ctx, "profile.personal_models.badge.active"))
						} else {
							@common.Badge(common.ToneNeutral, i18n.T(ctx, "profile.personal_models.badge.draft"))
						}
					</span>
					if vm.Description() != "" {
						<span class="mt-0.5 block text-xs text-muted-foreground">{ vm.Description() }</span>
					}
					<span class="mt-1.5 block font-mono text-2xs text-muted-foreground">
						{ i18n.T(ctx, "profile.personal_models.node_count", orgcomponent.GraphNodeCount(vm.Graph())) }
					</span>
				</a>
			}
		</div>
	}
}

// personalModelDetail previews the pipeline of the selected model, read-only, as
// an invitation to open the editor.
templ personalModelDetail(vmodel PersonalModelsPageVModel) {
	if vm := vmodel.Selected; vm != nil {
		{{ pipelineHref := common.BaseURLString(ctx, common.WithPath("/profile/personal-models/", string(vm.ID()), "/pipeline")) }}
		@common.Section() {
			@common.SectionHeader() {
				@common.SectionTitle() {
					<span class="font-mono">~/{ vm.Name() }</span>
				}
				<span class="text-xs text-muted-foreground">{ i18n.T(ctx, "profile.personal_models.preview") }</span>
				<span class="ml-auto flex flex-wrap items-center gap-1">
					@button.Button(button.Props{
						Href:    common.BaseURLString(ctx, common.WithPath("/profile/personal-models/", string(vm.ID()), "/edit")),
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
					}) {
						{ i18n.T(ctx, "profile.personal_models.rename") }
					}
					@button.Button(button.Props{
						Href:    common.BaseURLString(ctx, common.WithPath("/api/personal-models/", string(vm.ID()), "/export")),
						Variant: button.VariantOutline,
						Size:    button.SizeSm,
					}) {
						{ i18n.T(ctx, "profile.personal_models.export") }
					}
					@common.ConfirmDelete(common.ConfirmDeleteProps{
						URL:         common.BaseURLString(ctx, common.WithPath("/profile/personal-models/", string(vm.ID()))),
						Tooltip:     i18n.T(ctx, "profile.personal_models.delete"),
						Title:       i18n.T(ctx, "profile.personal_models.delete_title"),
						Description: i18n.T(ctx, "profile.personal_models.delete_description"),
					})
					@button.Button(button.Props{Href: pipelineHref, Size: button.SizeSm, Class: "gap-1.5"}) {
						@icon.Workflow(icon.Props{Class: "size-3.5"})
						{ i18n.T(ctx, "profile.personal_models.open_editor") }
					}
				</span>
			}
			@orgcomponent.PipelinePreview(vm.Graph(), pipelineHref)
			<div class="flex flex-wrap gap-6 border-t px-4 py-3">
				@common.InlineStat(i18n.T(ctx, "profile.personal_models.stat.nodes"), common.ToneNeutral) {
					{ strconv.Itoa(orgcomponent.GraphNodeCount(vm.Graph())) }
				}
				@common.InlineStat(i18n.T(ctx, "profile.personal_models.stat.edges"), common.ToneNeutral) {
					{ strconv.Itoa(orgcomponent.GraphEdgeCount(vm.Graph())) }
				}
				<!-- Mêmes colonnes en attente que côté organisation : l'usage n'est
				pas encore agrégé par modèle virtuel (lot 7 du plan). -->
				@common.InlineStat(i18n.T(ctx, "profile.personal_models.stat.calls_30d"), common.ToneNeutral) {
					@common.PendingValue(i18n.T(ctx, "profile.personal_models.stat.calls_pending"))
				}
				@common.InlineStat(i18n.T(ctx, "profile.personal_models.stat.latency_p50"), common.ToneNeutral) {
					@common.PendingValue(i18n.T(ctx, "profile.personal_models.stat.latency_pending"))
				}
			</div>
		}
	}
}

templ PersonalModelFormPage(vmodel PersonalModelFormVModel) {
	{{ title := i18n.T(ctx, "profile.personal_models.form.new_title") }}
	{{ action := common.BaseURLString(ctx, common.WithPath("/profile/personal-models")) }}
	if !vmodel.IsNew {
		{{ title = i18n.T(ctx, "profile.personal_models.form.edit_title") }}
		{{ action = common.BaseURLString(ctx, common.WithPath("/profile/personal-models/", string(vmodel.VirtualModel.ID()), "/edit")) }}
	}
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(title)) {
		<div class="space-y-6">
			@common.PageHeader(common.PageHeaderProps{
				Title: title,
			})
			@common.FlashError(vmodel.Error, i18n.T(ctx, "profile.personal_models.subject_indefinite"))
			<form method="POST" action={ templ.SafeURL(action) } class="space-y-4">
				<div class="space-y-2">
					@form.Label() {
						{ i18n.T(ctx, "profile.personal_models.form.name") }
					}
					if vmodel.IsNew {
						@input.Input(input.Props{
							Name:        "name",
							Placeholder: i18n.T(ctx, "profile.personal_models.form.name_placeholder"),
							Attributes:  templ.Attributes{"required": true},
						})
						@form.Description() {
							{ i18n.T(ctx, "profile.personal_models.form.name_help_new") }
						}
					} else {
						@input.Input(input.Props{
							Name:        "name",
							Value:       vmodel.Name,
							Placeholder: i18n.T(ctx, "profile.personal_models.form.name_placeholder"),
							Attributes:  templ.Attributes{"required": true, "autocomplete": "off"},
						})
						@form.Description() {
							{ i18n.T(ctx, "profile.personal_models.form.name_help_edit") }
						}
					}
				</div>
				<div class="space-y-2">
					@form.Label() {
						{ i18n.T(ctx, "profile.personal_models.form.description") }
					}
					@textarea.Textarea(textarea.Props{Name: "description", Rows: 3, Value: vmodel.Description})
				</div>
				if len(vmodel.Teams) > 0 {
					<div class="space-y-2">
						@form.Label(form.LabelProps{For: "pvm-team-trigger"}) {
							{ i18n.T(ctx, "profile.personal_models.form.team") }
						}
						@selectbox.SelectBox(selectbox.Props{ID: "pvm-team"}) {
							@selectbox.Trigger(selectbox.TriggerProps{ID: "pvm-team-trigger", Name: "team_id"}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "profile.personal_models.form.no_team")})
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: len(vmodel.Teams) < 8}) {
								@selectbox.Group() {
									@selectbox.Item(selectbox.ItemProps{Value: "", Selected: vmodel.TeamID == ""}) {
										{ i18n.T(ctx, "profile.personal_models.form.no_team") }
									}
									for _, opt := range vmodel.Teams {
										@selectbox.Item(selectbox.ItemProps{Value: string(opt.TeamID), Selected: vmodel.TeamID == opt.TeamID}) {
											{ opt.Label() }
										}
									}
								}
							}
						}
						@form.Description() {
							{ i18n.T(ctx, "profile.personal_models.form.team_help") }
						}
					</div>
				}
				if vmodel.VirtualModel != nil {
					@common.CatalogOverridesFields(vmodel.VirtualModel.CatalogOverrides())
				} else {
					@common.CatalogOverridesFields(nil)
				}
				<div class="flex gap-2">
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						{ i18n.T(ctx, "profile.personal_models.form.save") }
					}
					@button.Button(button.Props{
						Href:    common.BaseURLString(ctx, common.WithPath("/profile/personal-models")),
						Variant: button.VariantOutline,
					}) {
						{ i18n.T(ctx, "profile.personal_models.form.cancel") }
					}
				</div>
			</form>
		</div>
	}
}
