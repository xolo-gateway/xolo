package component

import (
	"context"
	"encoding/json"
	"fmt"
	"github.com/xolo-gateway/xolo/internal/core/model"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/accordion"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/card"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
)

const DefaultMaxDisplayedModels int = 3

type ModelsPageVModel struct {
	AppLayoutVModel common.AppLayoutVModel
	ModelUsages     []ModelUsage
	AllModelUsages  []ModelUsage
	Range           string
	RemainingCount  int
	// ShowAll mirrors the show_all query parameter from the request so the
	// period selector can round-trip the expanded state. Defaults to false
	// when the request did not ask for the full list.
	ShowAll bool
	// Sort selects how the model list is ordered: "" (default) orders by
	// aggregate usage; "price" orders by total cost (prompt + completion
	// per 1K tokens). Unknown values are normalised to "" by the handler.
	Sort string
	// Order is the direction of the sort: "asc" or "desc". Each criterion
	// has its own default (price asc, usage desc) and Order reflects the
	// effective direction so the URL and the toggle button never disagree.
	Order string
	// OrderExplicit is true when the request explicitly carried ?order=...
	// (i.e. the user picked a non-default direction). The range form
	// round-trips Order only when this is true, so the default view
	// does not pollute its bookmark with a redundant ?order=... param.
	OrderExplicit bool
}

templ ModelsPage(vmodel ModelsPageVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel,
		common.WithTitle("Modèles"),
	) {
		<div class="space-y-6">
			<!-- Header + period selector -->
			<div class="flex items-center justify-between">
				<div class="flex items-center gap-4">
					@icon.BrainCircuit(icon.Props{Class: "h-8 w-8"})
					@common.PageHeader(common.PageHeaderProps{
						Title: "Modèles d'org.",
					})
				</div>
				<div class="flex items-center gap-3">
					@modelsSortControl(vmodel.Sort, vmodel.Order)
					<form method="GET" class="flex items-center gap-2">
						@common.RangeSelect(vmodel.Range)
						if vmodel.Sort != "" {
							<input type="hidden" name="sort" value={ vmodel.Sort }/>
						}
						if vmodel.OrderExplicit {
							<input type="hidden" name="order" value={ vmodel.Order }/>
						}
						if vmodel.ShowAll {
							<input type="hidden" name="show_all" value="true"/>
						}
					</form>
				</div>
			</div>
			<!-- Models list -->
			if len(vmodel.ModelUsages) == 0 {
				<p class="text-sm text-muted-foreground">Aucun modèle disponible.</p>
			} else {
				<div class="space-y-4">
					<div id="models-grid" class="flex flex-col gap-3">
						{{ max := DefaultMaxDisplayedModels }}
						if vmodel.RemainingCount == 0 {
							{{ max = len(vmodel.ModelUsages) }}
						}
						for _, mu := range vmodel.ModelUsages[:max] {
							@modelCard(mu)
						}
					</div>
					if vmodel.RemainingCount > 0 {
						{{ href := templ.SafeURL(common.MutateCurrentURL(ctx, common.WithoutValues("show_all", "*"), common.WithValues("show_all", "true"))) }}
						<a
							href={ href }
							class="text-sm text-muted-foreground hover:text-foreground underline cursor-pointer"
						>
							Afficher { fmt.Sprintf("%d", vmodel.RemainingCount) } modèle(s) supplémentaire(s)
						</a>
					}
				</div>
			}
			<!-- How-to card -->
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Accès à l'API
					}
					<p class="text-sm text-muted-foreground">Xolo expose une API compatible OpenAI. Utilisez les paramètres ci-dessous avec vos outils habituels.</p>
				}
				@card.Content() {
					<div class="space-y-4">
						<!-- Base URL -->
						<div class="space-y-1">
							<p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">URL de base</p>
							@common.InlineSnippet(common.BaseURLString(ctx, common.WithPath("/api/v1")))
						</div>
						<!-- Auth + model name -->
						<div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
							<div class="space-y-1">
								<p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Authentification</p>
								<p>En-tête HTTP <code class="bg-muted rounded px-1 text-xs">Authorization: Bearer &lt;clé-api&gt;</code></p>
								<p class="text-xs text-muted-foreground">Créez une clé API depuis <a href={ common.BaseURL(ctx, common.WithPath("/profile/tokens")) } class="underline">votre profil</a>.</p>
							</div>
							<div class="space-y-1">
								<p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Nom du modèle</p>
								<p>Format <code class="bg-muted rounded px-1 text-xs">&lt;organisation&gt;/&lt;modèle&gt;</code></p>
								<p class="text-xs text-muted-foreground">Le nom complet est affiché sur chaque carte ci-dessous.</p>
							</div>
						</div>
						<!-- Tool examples -->
						<div class="space-y-2">
							<p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">Exemples d'utilisation</p>
							@accordion.Accordion(accordion.Props{Class: "rounded-md border divide-y"}) {
								@apiExample("bash", "curl", curlExample(common.BaseURLString(ctx, common.WithPath("/api/v1")))) {
									@icon.Terminal(icon.Props{Class: "h-4 w-4 shrink-0"})
								}
								@apiExample("python", "Python · openai", pythonExample(common.BaseURLString(ctx, common.WithPath("/api/v1")))) {
									@icon.Code(icon.Props{Class: "h-4 w-4 shrink-0"})
								}
								@apiExample("json", "OpenCode · ~/.config/opencode/config.json", openCodeConfigExample(common.BaseURLString(ctx, common.WithPath("/api/v1")), vmodel.AllModelUsages)) {
									@icon.Code(icon.Props{Class: "h-4 w-4 shrink-0"})
								}
								@apiExample("bash", "Claude Code · variables d'environnement", claudeCodeExample(common.BaseURLString(ctx, common.WithPath("/api")))) {
									@icon.Terminal(icon.Props{Class: "h-4 w-4 shrink-0"})
								}
							}
						</div>
					</div>
				}
			}
		</div>
	}
}

// apiExample renders one collapsible call example. The children are the icon
// shown ahead of the title.
templ apiExample(language, title, snippet string) {
	@accordion.Item() {
		@accordion.Trigger(accordion.TriggerProps{Class: "items-center gap-2 px-3 py-2"}) {
			{ children... }
			<!-- Le titre porte le `flex-1` : le trigger est un `justify-between`,
			et un titre laissé en nœud de texte y devient un élément de flex
			centré entre l'icône et le chevron. -->
			<span class="flex-1 truncate">{ title }</span>
		}
		@accordion.Content(accordion.ContentProps{Class: "pb-0 border-t"}) {
			@common.Snippet(language, snippet)
		}
	}
}

// modelsSortControl renders a two-segment cyclic control (Usage /
// Prix) that mirrors the SegmentedNav used for the period selector
// (24 h / 7 j / 30 j / 12 m) on the org and personal dashboards.
// Each segment is cyclic: clicking the inactive segment once enters
// the new criterion at its natural default direction; clicking the
// active segment again cycles through the available directions.
//
// Active and inactive segments are both rendered as <a> links: the
// active one carries the URL of the next direction in the cycle, the
// inactive one carries the URL of the criterion's natural default.
// Server-rendered, bookmarkable, no JS.
//
// URL contract:
//   Usage ↓ (default):  /models
//   Usage ↑            : /models?order=asc
//   Prix ↑  (default): /models?sort=price
//   Prix ↓             : /models?sort=price&order=desc
templ modelsSortControl(currentSort string, currentOrder string) {
	@common.SegmentedNav([]common.Segment{
		usageSegment(ctx, currentSort, currentOrder),
		priceSegment(ctx, currentSort, currentOrder),
	})
}

// usageSegment returns the Usage segment of the sort control. The
// active label embeds the current direction (Usage ↓ or Usage ↑);
// its href carries the OPPOSITE direction so a click cycles the
// order. The inactive label is plain "Usage" and its href drops
// `sort` and `order` so the user lands on the criterion's natural
// default (Usage ↓).
func usageSegment(ctx context.Context, currentSort string, currentOrder string) common.Segment {
	if currentSort != "price" {
		// Usage is active: label carries direction, href carries the
		// opposite direction so the next click toggles. We must drop
		// any existing `order` first because httpURL.WithValues uses
		// query.Add (append); without the drop the URL would carry
		// `order=asc&order=desc` on a page that already had ?order=asc,
		// and Go's url.Values.Get returns the first value, breaking
		// the toggle on reachable bookmarks.
		if currentOrder == "asc" {
			return common.Segment{
				Label:  "Usage ↑",
				Href:   common.MutateCurrentURL(ctx, common.WithoutValues("order", "*")),
				Active: true,
			}
		}
		return common.Segment{
			Label:  "Usage ↓",
			Href:   common.MutateCurrentURL(ctx, common.WithoutValues("order", "*"), common.WithValues("order", "asc")),
			Active: true,
		}
	}
	// Inactive: a single "Usage" tab lands on the criterion's natural
	// default (Usage ↓ = no params).
	href := common.MutateCurrentURL(ctx, common.WithoutValues("sort", "*"), common.WithoutValues("order", "*"))
	return common.Segment{Label: "Usage", Href: href}
}

// priceSegment returns the Prix segment of the sort control. Same
// cyclic pattern: 1st click from Usage → Prix ↑ (asc, the criterion
// default), 2nd click on Prix ↑ → Prix ↓ (desc), 3rd click → Prix ↑
// again.
func priceSegment(ctx context.Context, currentSort string, currentOrder string) common.Segment {
	if currentSort == "price" {
		// Prix is active: same drop-then-add pattern as usageSegment
		// to avoid duplicate `order` params on reachable bookmarks.
		if currentOrder == "desc" {
			return common.Segment{
				Label:  "Prix ↓",
				Href:   common.MutateCurrentURL(ctx, common.WithoutValues("order", "*")),
				Active: true,
			}
		}
		return common.Segment{
			Label:  "Prix ↑",
			Href:   common.MutateCurrentURL(ctx, common.WithoutValues("order", "*"), common.WithValues("order", "desc")),
			Active: true,
		}
	}
	// Inactive: a single "Prix" tab lands on the criterion's natural
	// default (Prix ↑ = ?sort=price).
	href := common.MutateCurrentURL(ctx,
		common.WithoutValues("sort", "*", "order", "*"),
		common.WithValues("sort", "price"),
	)
	return common.Segment{Label: "Prix", Href: href}
}

templ modelCard(mu ModelUsage) {
	@card.Card() {
		@card.Content(card.ContentProps{Class: "flex items-start gap-4"}) {
			<div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-md bg-accent">
				if mu.Model.IsVirtual() {
					@icon.Network(icon.Props{Size: 20, Class: "text-primary"})
				} else {
					@icon.BrainCircuit(icon.Props{Size: 20, Class: "text-primary"})
				}
			</div>
			<div class="flex-1 min-w-0">
				<div class="flex items-center gap-2">
					<span class="font-semibold font-mono text-sm truncate">
						if mu.Org != nil {
							{ mu.Org.Slug() + "/" + mu.Model.ProxyName() }
						} else {
							{ mu.Model.ProxyName() }
						}
					</span>
					if mu.Model.IsVirtual() {
						@common.Badge(common.ToneInfo, "virtuel")
					}
					if mu.Model.Capabilities().Embeddings {
						@common.Badge(common.ToneNeutral, "embeddings")
					}
					if mu.Provider != nil && mu.Provider.BillingMode() == model.BillingModeSubscription {
						@common.Badge(common.ToneNeutral, "abonnement")
					} else if mu.Provider != nil {
						@common.Badge(common.ToneNeutral, "pay-as-you-go")
					}
				</div>
				if mu.Model.Description() != "" {
					<p class="text-xs text-muted-foreground mt-0.5 whitespace-normal break-words [overflow-wrap:anywhere] line-clamp-3">
						{ mu.Model.Description() }
					</p>
				}
				if mu.Org != nil {
					<div class="mt-1">
						@common.Badge(common.ToneNeutral, mu.Org.Name())
					</div>
				}
			</div>
			if mu.Aggregate != nil && mu.Aggregate.TotalRequests > 0 {
				<div class="flex gap-4 shrink-0 self-start">
					<div class="text-right">
						<div class="text-sm font-semibold">{ fmt.Sprintf("%d", mu.Aggregate.TotalRequests) }</div>
						<div class="text-xs text-muted-foreground">req.</div>
					</div>
					<div class="text-right">
						<div class="text-sm font-semibold">{ fmt.Sprintf("%d", mu.Aggregate.TotalTokens) }</div>
						<div class="text-xs text-muted-foreground">tokens</div>
					</div>
					<div class="text-right">
						<div class="text-sm font-semibold">{ common.FormatCost(mu.Aggregate.TotalCost, mu.Aggregate.Currency) }</div>
						<div class="text-xs text-muted-foreground">coût</div>
					</div>
				</div>
			} else if !mu.Model.IsVirtual() {
				<div class="flex gap-4 shrink-0 self-start">
					<div class="text-right">
						<div class="text-sm font-semibold">{ formatCostPerM(mu.Model.PromptCostPer1KTokens(), orgCurrency(mu.Org)) }</div>
						<div class="text-xs text-muted-foreground">prompt / 1M</div>
					</div>
					<div class="text-right">
						<div class="text-sm font-semibold">{ formatCostPerM(mu.Model.CompletionCostPer1KTokens(), orgCurrency(mu.Org)) }</div>
						<div class="text-xs text-muted-foreground">complétion / 1M</div>
					</div>
				</div>
			}
		}
	}
}

func curlExample(baseURL string) string {
	return `curl ` + baseURL + `/chat/completions \
  -H "Authorization: Bearer <clé-api>" \
  -H "Content-Type: application/json" \
  -d '{
    "model": "<organisation>/<modèle>",
    "messages": [{"role": "user", "content": "Bonjour !"}]
  }'`
}

func pythonExample(baseURL string) string {
	return `from openai import OpenAI

client = OpenAI(
    base_url="` + baseURL + `",
    api_key="<clé-api>",
)

response = client.chat.completions.create(
    model="<organisation>/<modèle>",
    messages=[{"role": "user", "content": "Bonjour !"}],
)
print(response.choices[0].message.content)`
}

func claudeCodeExample(baseURL string) string {
	return `export ANTHROPIC_BASE_URL="` + baseURL + `"
export ANTHROPIC_AUTH_TOKEN="<clé-api>"
export ANTHROPIC_MODEL="<organisation>/<modèle>"
export ANTHROPIC_SMALL_FAST_MODEL="<organisation>/<modèle>"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

claude`
}

func openCodeConfigExample(baseURL string, modelUsages []ModelUsage) string {
	type providerOptions struct {
		BaseURL string `json:"baseURL"`
		APIKey  string `json:"apiKey"`
	}
	type providerEntry struct {
		NPM     string                         `json:"npm"`
		Name    string                         `json:"name"`
		Options providerOptions                `json:"options"`
		Models  map[string]model.OpenCodeModelEntry `json:"models"`
	}
	type configRoot struct {
		Schema   string                   `json:"$schema"`
		Provider map[string]providerEntry `json:"provider"`
	}

	models := make(map[string]model.OpenCodeModelEntry)
	for _, mu := range modelUsages {
		if mu.Model.Capabilities().Embeddings {
			continue
		}
		var name string
		if mu.Org != nil {
			name = mu.Org.Slug() + "/" + mu.Model.ProxyName()
		} else {
			name = mu.Model.ProxyName()
		}

		entry := model.OpenCodeEntry(
			mu.Model.Capabilities(),
			mu.Model.ContextWindow(),
			mu.Model.OutputWindow(),
		)
		entry.Name = name

		models[name] = entry
	}

	cfg := configRoot{
		Schema: "https://opencode.ai/config.json",
		Provider: map[string]providerEntry{
			"xolo": {
				NPM:  "@ai-sdk/openai-compatible",
				Name: "Xolo",
				Options: providerOptions{
					BaseURL: baseURL,
					APIKey:  "{env:XOLO_API_KEY}",
				},
				Models: models,
			},
		},
	}

	data, err := json.MarshalIndent(cfg, "", "  ")
	if err != nil {
		return ""
	}
	return string(data)
}

func formatCostPerM(microcentsPer1K int64, currency string) string {
	return common.FormatCost(microcentsPer1K*1000, currency)
}

func orgCurrency(org model.Organization) string {
	if org == nil {
		return "USD"
	}
	currency := org.Currency()
	if currency == "" {
		return "USD"
	}
	return currency
}

templ ModelsGrid(modelUsages []ModelUsage) {
	<div id="models-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
		for _, mu := range modelUsages {
			@card.Card() {
				@card.Header() {
					@card.Title() {
						if mu.Org != nil {
							{ mu.Org.Slug() + "/" + mu.Model.ProxyName() }
						} else {
							{ mu.Model.ProxyName() }
						}
					}
					if mu.Org != nil {
						<p class="text-xs text-muted-foreground">{ mu.Org.Name() }</p>
					}
				}
				@card.Content() {
					<div class="space-y-3">
						if mu.Model.Description() != "" {
							<p class="text-sm text-muted-foreground">{ mu.Model.Description() }</p>
						}
						<div class="grid grid-cols-2 gap-2 text-sm">
							<div>
								<span class="text-muted-foreground">Prompt (1M tokens)</span>
								<p class="font-medium">{ formatCostPerM(mu.Model.PromptCostPer1KTokens(), orgCurrency(mu.Org)) }</p>
							</div>
							<div>
								<span class="text-muted-foreground">Complétion (1M tokens)</span>
								<p class="font-medium">{ formatCostPerM(mu.Model.CompletionCostPer1KTokens(), orgCurrency(mu.Org)) }</p>
							</div>
						</div>
						if mu.Aggregate != nil && mu.Aggregate.TotalRequests > 0 {
							<div class="border-t pt-3 grid grid-cols-3 gap-2 text-sm">
								<div>
									<span class="text-muted-foreground">Requêtes</span>
									<p class="font-medium">{ fmt.Sprintf("%d", mu.Aggregate.TotalRequests) }</p>
								</div>
								<div>
									<span class="text-muted-foreground">Tokens</span>
									<p class="font-medium">{ fmt.Sprintf("%d", mu.Aggregate.TotalTokens) }</p>
								</div>
								<div>
									<span class="text-muted-foreground">Coût</span>
									<p class="font-medium">{ common.FormatCost(mu.Aggregate.TotalCost, mu.Aggregate.Currency) }</p>
								</div>
							</div>
						}
					</div>
				}
			}
		}
	</div>
}
