	"slices"
	"strings"
	"unicode/utf8"
)

// CatalogModel is a model the user can call, as the models page lists it.
type CatalogModel struct {
	Model    model.LLMModel
	Org      model.Organization
	Provider model.Provider // nil for virtual models
	// Names are the names the user can call the model by: "<org>/<model>"
	// for the organization-wide access, "<org>/<team>/<model>" per team.
	Names []string
	// CapabilitiesUndetermined is true for a virtual model whose capabilities
	// are neither derived from its pipeline nor declared by its catalogue
	// overrides: the false values of Model.Capabilities() then mean unknown.
	CapabilitiesUndetermined bool
}

// ModelNames returns the names a model row shows, the qualified name when
// none were resolved.
func ModelNames(m CatalogModel) []string {
	if len(m.Names) > 0 {
		return m.Names
	}
	if m.Org != nil {
		return []string{m.Org.Slug() + "/" + m.Model.ProxyName()}
	}
	return []string{m.Model.ProxyName()}
}

// ProviderName is the name of the model's provider, empty for a virtual model.
func ProviderName(m CatalogModel) string {
	if m.Provider == nil {
		return ""
	}
	return m.Provider.Name()
}

// Values of the type filter.
const (
	ModelsTypeDirect  = "direct"
	ModelsTypeVirtual = "virtual"
)

// Values of the sort control. The name order is the default.
const (
	ModelsSortName    = "name"
	ModelsSortPrice   = "price"
	ModelsSortNewest  = "newest"
	ModelsSortContext = "context"
)

var ModelsSorts = []string{ModelsSortName, ModelsSortPrice, ModelsSortNewest, ModelsSortContext}

// ModelCapabilityKeys are the capabilities the list can be filtered on, as
// the query string names them.
var ModelCapabilityKeys = []string{"tools", "vision", "reasoning", "audio"}

// HasCapability tells whether caps include the capability named by key.
func HasCapability(caps model.ModelCapabilities, key string) bool {
	switch key {
	case "tools":
		return caps.Tools
	case "vision":
		return caps.Vision
	case "reasoning":
		return caps.Reasoning
	case "audio":
		return caps.Audio
	default:
		return false
	}
}

// ModelsFilter is the search, the filters and the order of the models page,
// read from its query string.
type ModelsFilter struct {
	Query    string
	Provider string
	Kind     string
	// Type is "", ModelsTypeDirect or ModelsTypeVirtual.
	Type string
	// Capabilities lists the capabilities a model must all have.
	Capabilities []string
	Sort         string
}

// Active tells whether the filter narrows the list.
func (f ModelsFilter) Active() bool {
	return f.Query != "" || f.Provider != "" || f.Kind != "" || f.Type != "" || len(f.Capabilities) > 0
}

// ModelsFacets are the choices the filter controls offer, drawn from the
// models the user can call. A control is hidden when it could not narrow the
// list.
type ModelsFacets struct {
	Providers []string
	Kinds     []model.ModelKind
	// Virtual is true when the list mixes direct and virtual models.
	Virtual bool
	// SeveralOrgs is true when the models come from more than one
	// organization: each row then names its organization.
	SeveralOrgs bool
}

type ModelsPageVModel struct {
	AppLayoutVModel common.AppLayoutVModel
	// Models are the models matching the filter, in its order.
	Models []CatalogModel
	// AllModels are every model the user can call: the call examples are
	// built from them, whatever the filter.
	AllModels []CatalogModel
	Filter    ModelsFilter
	Facets    ModelsFacets
}

templ ModelsPage(vmodel ModelsPageVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel,
		common.WithTitle(i18n.T(ctx, "profile.models.page_title")),
	) {
		<div class="space-y-6">
			@common.PageHeader(common.PageHeaderProps{
				Title:    i18n.T(ctx, "profile.models.title"),
				Subtitle: i18n.T(ctx, "profile.models.subtitle"),
			}) {
				@button.Button(button.Props{
					Href:    common.BaseURLString(ctx, common.WithPath("/usage")),
					Variant: button.VariantOutline,
					Size:    button.SizeSm,
					Class:   "gap-1.5",
				}) {
					@icon.ChartColumn(icon.Props{Class: "size-3.5"})
					{ i18n.T(ctx, "profile.models.usage_link") }
				}
			}
			@modelsAPIAccess(vmodel.AllModels)
			if len(vmodel.AllModels) == 0 {
				<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "profile.models.empty") }</p>
			} else {
				<div>
					@modelsFilterBar(vmodel)
					@modelsResults(vmodel)
				</div>
			}
		</div>
	}
}

// modelsAPIAccess tells how to call the models. It comes before the list, so a
// long list does not push it out of sight: the base URL and the authentication
// stay visible, the name format and the call examples fold away.
templ modelsAPIAccess(models []CatalogModel) {
	@card.Card() {
		@card.Header() {
			@card.Title() {
				{ i18n.T(ctx, "profile.models.api.title") }
			}
			<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "profile.models.api.intro") }</p>
		}
		@card.Content() {
			<div class="space-y-4">
				<div class="grid grid-cols-1 gap-3 text-sm md:grid-cols-2">
					<!-- Base URL -->
					<div class="min-w-0 space-y-1">
						<p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">{ i18n.T(ctx, "profile.models.api.base_url") }</p>
						@common.InlineSnippet(common.BaseURLString(ctx, common.WithPath("/api/v1")))
					</div>
					<div class="space-y-1">
						<p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">{ i18n.T(ctx, "profile.models.api.auth") }</p>
						<p>{ i18n.T(ctx, "profile.models.api.http_header") } <code class="bg-muted rounded px-1 text-xs">{ "Authorization: Bearer <" + i18n.T(ctx, "profile.models.api.key_placeholder") + ">" }</code></p>
						<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "profile.models.api.create_key_before") } <a href={ common.BaseURL(ctx, common.WithPath("/profile/tokens")) } class="underline">{ i18n.T(ctx, "profile.models.api.create_key_link") }</a>{ i18n.T(ctx, "profile.models.api.create_key_after") }</p>
					</div>
				</div>
				@collapsible.Collapsible(collapsible.Props{Class: "group/api"}) {
					@collapsible.Trigger(collapsible.TriggerProps{
						Class:      "inline-flex cursor-pointer items-center gap-1 text-sm font-medium text-muted-foreground hover:text-foreground",
						Attributes: templ.Attributes{"role": "button", "tabindex": "0", "aria-expanded": "false"},
					}) {
						@icon.ChevronRight(icon.Props{Class: "size-4 transition-transform group-data-[tui-collapsible-state=open]/api:rotate-90"})
						{ i18n.T(ctx, "profile.models.api.more") }
					}
					@collapsible.Content() {
						<div class="space-y-4 pt-4 text-sm">
							<div class="space-y-1">
								<p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">{ i18n.T(ctx, "profile.models.api.model_name") }</p>
								<p>{ i18n.T(ctx, "profile.models.api.format") } <code class="bg-muted rounded px-1 text-xs">{ i18n.T(ctx, "profile.models.api.model_name_format") }</code></p>
								<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "profile.models.api.full_name_hint") }</p>
							</div>
							<!-- Tool examples -->
							<div class="space-y-2">
								<p class="text-xs font-medium uppercase tracking-wide text-muted-foreground">{ i18n.T(ctx, "profile.models.api.examples") }</p>
								@accordion.Accordion(accordion.Props{Class: "rounded-md border divide-y"}) {
									@apiExample("bash", "curl", curlExample(ctx, common.BaseURLString(ctx, common.WithPath("/api/v1")))) {
										@icon.Terminal(icon.Props{Class: "h-4 w-4 shrink-0"})
									}
									@apiExample("python", "Python · openai", pythonExample(ctx, common.BaseURLString(ctx, common.WithPath("/api/v1")))) {
										@icon.Code(icon.Props{Class: "h-4 w-4 shrink-0"})
									}
									@apiExample("json", "OpenCode · ~/.config/opencode/config.json", openCodeConfigExample(common.BaseURLString(ctx, common.WithPath("/api/v1")), models)) {
										@icon.Code(icon.Props{Class: "h-4 w-4 shrink-0"})
									}
									@apiExample("bash", i18n.T(ctx, "profile.models.api.claude_code_title"), claudeCodeExample(ctx, common.BaseURLString(ctx, common.WithPath("/api")))) {
										@icon.Terminal(icon.Props{Class: "h-4 w-4 shrink-0"})
									}
								}
								if names := undeterminedModelNames(models); len(names) > 0 {
									<p class="text-xs text-muted-foreground">
										{ i18n.T(ctx, "profile.models.undetermined.before") }
										for i, name := range names {
											if i > 0 {
												{ ", " }
											}
											<span class="font-mono">{ name }</span>
										}
										{ " " }{ i18n.T(ctx, "profile.models.undetermined.after") }
									</p>
								}
							</div>
						</div>
					}
				}
			</div>
		}
	}
}

// apiExample renders one collapsible call example. The children are the icon
// shown ahead of the title.
templ apiExample(language, title, snippet string) {
	@accordion.Item() {
		@accordion.Trigger(accordion.TriggerProps{Class: "items-center gap-2 px-3 py-2"}) {
			{ children... }
			<!-- Le titre porte le `flex-1` : le trigger est un `justify-between`,
			et un titre laissé en nœud de texte y devient un élément de flex
			centré entre l'icône et le chevron. -->
			<span class="flex-1 truncate">{ title }</span>
		}
		@accordion.Content(accordion.ContentProps{Class: "pb-0 border-t"}) {
			@common.Snippet(language, snippet)
		}
	}
}

// modelsLiveAttributes swap the results in place as the filter changes, and
// keep the URL in step so a filtered view can be shared. The form still works
// without JavaScript: Enter in the search field submits it.
func modelsLiveAttributes(ctx context.Context, trigger string) templ.Attributes {
	return templ.Attributes{
		"hx-get":        common.BaseURLString(ctx, common.WithPath("/models")),
		"hx-trigger":    trigger,
		"hx-include":    "#models-filters",
		"hx-target":     "#models-results",
		"hx-select":     "#models-results",
		"hx-swap":       "outerHTML",
		"hx-push-url":   "true",
		"hx-select-oob": "unset",
	}
}

// searchAttributes refresh the results as the user types, rather than on the
// change event the field only fires when it loses focus.
func searchAttributes(ctx context.Context) templ.Attributes {
	attrs := modelsLiveAttributes(ctx, "input changed delay:250ms, search")
	attrs["autocomplete"] = "off"
	attrs["aria-label"] = i18n.T(ctx, "profile.models.search_placeholder")
	return attrs
}

templ modelsFilterBar(vmodel ModelsPageVModel) {
	<form
		id="models-filters"
		method="GET"
		action={ templ.SafeURL(common.BaseURLString(ctx, common.WithPath("/models"))) }
		{ modelsLiveAttributes(ctx, "change")... }
	>
		@common.FilterBar() {
			@common.SearchFilter(common.SearchFilterProps{
				ID:          "models-search",
				Name:        "q",
				Value:       vmodel.Filter.Query,
				Placeholder: i18n.T(ctx, "profile.models.search_placeholder"),
				Attributes:  searchAttributes(ctx),
			})
			if len(vmodel.Facets.Providers) > 1 {
				@modelsSelect("models-provider", "provider", vmodel.Filter.Provider, providerOptions(ctx, vmodel.Facets.Providers))
			}
			if vmodel.Facets.Virtual {
				@modelsSelect("models-type", "type", vmodel.Filter.Type, []modelsOption{
					{Value: "", Label: i18n.T(ctx, "profile.models.filter.type_all")},
					{Value: ModelsTypeDirect, Label: i18n.T(ctx, "profile.models.filter.type_direct")},
					{Value: ModelsTypeVirtual, Label: i18n.T(ctx, "profile.models.filter.type_virtual")},
				})
			}
			if len(vmodel.Facets.Kinds) > 1 {
				@modelsSelect("models-kind", "kind", vmodel.Filter.Kind, kindOptions(ctx, vmodel.Facets.Kinds))
			}
			<div class="sm:ml-auto">
				@modelsSelect("models-sort", "sort", vmodel.Filter.Sort, []modelsOption{
					{Value: ModelsSortName, Label: i18n.T(ctx, "profile.models.sort.name")},
					{Value: ModelsSortPrice, Label: i18n.T(ctx, "profile.models.sort.price")},
					{Value: ModelsSortNewest, Label: i18n.T(ctx, "profile.models.sort.newest")},
					{Value: ModelsSortContext, Label: i18n.T(ctx, "profile.models.sort.context")},
				})
			</div>
		}
		<fieldset class="mb-3 flex flex-wrap items-center gap-x-4 gap-y-2">
			<legend class="sr-only">{ i18n.T(ctx, "profile.models.filter.capabilities") }</legend>
			<span class="text-xs text-muted-foreground" aria-hidden="true">{ i18n.T(ctx, "profile.models.filter.capabilities") }</span>
			for _, key := range ModelCapabilityKeys {
				<div class="flex items-center gap-1.5">
					@checkbox.Checkbox(checkbox.Props{
						ID:      "models-cap-" + key,
						Name:    "cap",
						Value:   key,
						Checked: slices.Contains(vmodel.Filter.Capabilities, key),
					})
					@form.Label(form.LabelProps{For: "models-cap-" + key, Class: "text-sm font-normal"}) {
						{ capabilityLabel(ctx, key) }
					}
				</div>
			}
		</fieldset>
	</form>
}

type modelsOption struct {
	Value string
	Label string
}

func providerOptions(ctx context.Context, providers []string) []modelsOption {
	options := []modelsOption{{Value: "", Label: i18n.T(ctx, "profile.models.filter.provider_all")}}
	for _, p := range providers {
		options = append(options, modelsOption{Value: p, Label: p})
	}
	return options
}

func kindOptions(ctx context.Context, kinds []model.ModelKind) []modelsOption {
	options := []modelsOption{{Value: "", Label: i18n.T(ctx, "profile.models.filter.kind_all")}}
	for _, k := range kinds {
		options = append(options, modelsOption{Value: string(k), Label: common.ModelKindLabel(ctx, k)})
	}
	return options
}

func capabilityLabel(ctx context.Context, key string) string {
	return i18n.T(ctx, "common.catalog.cap."+key)
}

// modelsSelect renders one filter of the bar. The select box fires a change
// event on its hidden input, which the form listens to.
templ modelsSelect(id, name, value string, options []modelsOption) {
	@selectbox.SelectBox(selectbox.Props{ID: id, Class: "w-auto"}) {
		@selectbox.Trigger(selectbox.TriggerProps{Name: name, Class: "h-8 min-w-40"}) {
			@selectbox.Value()
		}
		@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
			@selectbox.Group() {
				for _, o := range options {
					@selectbox.Item(selectbox.ItemProps{Value: o.Value, Selected: o.Value == value}) {
						{ o.Label }
					}
				}
			}
		}
	}
}

templ modelsResults(vmodel ModelsPageVModel) {
	<div id="models-results">
		<div class="mb-2 flex items-center gap-3 text-xs text-muted-foreground">
			if vmodel.Filter.Active() {
				<span>{ i18n.T(ctx, "profile.models.count_filtered", len(vmodel.Models), len(vmodel.AllModels)) }</span>
				<a href={ templ.SafeURL(common.BaseURLString(ctx, common.WithPath("/models"))) } class="underline hover:text-foreground">
					{ i18n.T(ctx, "profile.models.clear_filters") }
				</a>
			} else {
				<span>{ i18n.T(ctx, "profile.models.count", len(vmodel.Models)) }</span>
			}
			<span class="ml-auto">{ i18n.T(ctx, "profile.models.price_unit") }</span>
		</div>
		if len(vmodel.Models) == 0 {
			@common.EmptyState(common.EmptyStateProps{
				Icon:        icon.SearchX,
				Title:       i18n.T(ctx, "profile.models.no_match.title"),
				Description: i18n.T(ctx, "profile.models.no_match.description"),
				Compact:     true,
			})
		} else {
			@common.Section() {
				<!-- Une longue liste défile dans sa propre boîte, sous un en-tête
				figé : un en-tête collant à la page est impossible, la section et
				le tableau étant eux-mêmes des conteneurs de défilement. -->
				<div class="sm:[&>div]:max-h-[70vh]">
					@table.Table() {
						@table.Header(table.HeaderProps{Class: "sticky top-0 z-10 bg-card shadow-[inset_0_-1px_0_var(--color-border)]"}) {
							@table.Head() {
								{ i18n.T(ctx, "profile.models.col.model") }
							}
							@table.Head() {
								{ i18n.T(ctx, "profile.models.col.provider") }
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								{ i18n.T(ctx, "profile.models.col.prompt") }
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								{ i18n.T(ctx, "profile.models.col.completion") }
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								{ i18n.T(ctx, "profile.models.col.context") }
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								{ i18n.T(ctx, "profile.models.col.output") }
							}
							@table.Head() {
								{ i18n.T(ctx, "profile.models.col.capabilities") }
							}
						}
						@table.Body() {
							for _, m := range vmodel.Models {
								@modelRow(m, vmodel.Facets.SeveralOrgs)
							}
						}
					}
				</div>
			}
		}
	</div>
}

templ modelRow(m CatalogModel, showOrg bool) {
	@table.Row() {
		@table.Cell(table.CellProps{Class: "min-w-60 max-w-md whitespace-normal"}) {
			<div class="flex flex-wrap items-center gap-x-2 gap-y-1">
				if m.Model.IsVirtual() {
					@icon.Network(icon.Props{Class: "size-3.5 shrink-0 text-primary"})
				} else {
					@icon.BrainCircuit(icon.Props{Class: "size-3.5 shrink-0 text-primary"})
				}
				{{ nameID := "model-" + utils.RandomID() }}
				<span id={ nameID } class="font-mono text-xs font-semibold break-all">{ ModelNames(m)[0] }</span>
				@copybutton.CopyButton(copybutton.Props{
					TargetID: nameID,
					Class:    "size-6 shrink-0",
					Attrs:    templ.Attributes{"title": i18n.T(ctx, "common.copy")},
				})
				if showOrg && m.Org != nil {
					@common.Badge(common.ToneNeutral, m.Org.Name())
				}
			</div>
			if names := ModelNames(m); len(names) > 1 {
				<p class="text-xs text-muted-foreground">
					{ i18n.T(ctx, "profile.models.also") }
					for i, name := range names[1:] {
						if i > 0 {
							{ ", " }
						}
						<span class="font-mono">{ name }</span>
					}
				</p>
			}
			if m.Model.Description() != "" {
				@modelDescription(m.Model.Description())
			}
		}
		@table.Cell() {
			if m.Model.IsVirtual() {
				@common.Badge(common.ToneInfo, i18n.T(ctx, "profile.models.badge.virtual"))
			} else if m.Provider != nil {
				<div class="text-sm">{ m.Provider.Name() }</div>
				if m.Provider.BillingMode() == model.BillingModeSubscription {
					@common.Badge(common.ToneNeutral, i18n.T(ctx, "profile.models.badge.subscription"))
				}
			}
		}
		@table.Cell(table.CellProps{Class: "text-right tnum text-sm"}) {
			if !m.Model.IsVirtual() {
				{ formatCostPerM(ctx, m.Model.PromptCostPer1KTokens(), orgCurrency(m.Org)) }
			} else {
				<span class="text-muted-foreground">—</span>
			}
		}
		@table.Cell(table.CellProps{Class: "text-right tnum text-sm"}) {
			if !m.Model.IsVirtual() {
				{ formatCostPerM(ctx, m.Model.CompletionCostPer1KTokens(), orgCurrency(m.Org)) }
			} else {
				<span class="text-muted-foreground">—</span>
			}
		}
		@table.Cell(table.CellProps{Class: "text-right tnum text-sm text-muted-foreground"}) {
			{ formatTokenWindow(m.Model.ContextWindow()) }
		}
		@table.Cell(table.CellProps{Class: "text-right tnum text-sm text-muted-foreground"}) {
			{ formatTokenWindow(m.Model.OutputWindow()) }
		}
		@table.Cell() {
			<div class="flex flex-wrap gap-1">
				if m.Model.Kind() != model.ModelKindCompletion {
					@common.Badge(common.ToneInfo, common.ModelKindLabel(ctx, m.Model.Kind()))
				}
				if m.CapabilitiesUndetermined {
					@common.Badge(common.ToneWarning, i18n.T(ctx, "profile.models.badge.undetermined"))
				} else {
					for _, key := range ModelCapabilityKeys {
						if HasCapability(m.Model.Capabilities(), key) {
							@common.Badge(common.ToneNeutral, capabilityLabel(ctx, key))
						}
					}
				}
			</div>
		}
	}
}

// modelDescription shows the first paragraph of a description on one line. A
// longer one unfolds in full, rendered as Markdown: the description is written
// in a text area, paragraphs and lists included.
templ modelDescription(description string) {
	if summary, more := descriptionSummary(description); !more {
		<p class="text-xs text-muted-foreground break-words [overflow-wrap:anywhere] line-clamp-1">{ summary }</p>
	} else {
		@collapsible.Collapsible(collapsible.Props{Class: "group/desc"}) {
			<!-- Replié, la ligne de résumé porte « Plus » ; déplié, elle s'efface
			devant le texte complet, que « Moins » referme en dessous. -->
			<div class="flex items-baseline gap-2 text-xs text-muted-foreground group-data-[tui-collapsible-state=open]/desc:hidden">
				<p class="min-w-0 flex-1 break-words [overflow-wrap:anywhere] line-clamp-1">{ summary }</p>
				@modelDescriptionToggle(i18n.T(ctx, "profile.models.description.more"), false)
			</div>
			@collapsible.Content() {
				@common.MarkdownWithVariants(description, "max-w-none text-xs text-muted-foreground [&>*]:my-1 [&_ul]:list-disc [&_ol]:list-decimal [&_ul]:pl-4 [&_ol]:pl-4")
				<div class="text-xs text-muted-foreground">
					@modelDescriptionToggle(i18n.T(ctx, "profile.models.description.less"), true)
				</div>
			}
		}
	}
}

templ modelDescriptionToggle(label string, expanded bool) {
	@collapsible.Trigger(collapsible.TriggerProps{
		Class:      "inline-block shrink-0 cursor-pointer underline hover:text-foreground",
		Attributes: templ.Attributes{"role": "button", "tabindex": "0", "aria-expanded": fmt.Sprint(expanded)},
	}) {
		{ label }
	}
}

// descriptionSummaryLength is about what a line of the model column holds.
const descriptionSummaryLength = 80

// descriptionSummary returns the first paragraph of a description on a single
// line, and whether the description holds more than that line shows.
func descriptionSummary(description string) (string, bool) {
	description = strings.TrimSpace(strings.ReplaceAll(description, "\r\n", "\n"))
	first, rest, _ := strings.Cut(description, "\n\n")
	summary := strings.Join(strings.Fields(first), " ")
	return summary, strings.TrimSpace(rest) != "" || utf8.RuneCountInString(summary) > descriptionSummaryLength
}

// formatTokenWindow writes a context or output window in thousands of tokens,
// a dash when it is unknown.
func formatTokenWindow(v int64) string {
	if v <= 0 {
		return "—"
	}
	if v < 1_000 {
		return fmt.Sprintf("%d", v)
	}
	return fmt.Sprintf("%d k", v/1_000)
}

func curlExample(ctx context.Context, baseURL string) string {
	return `curl ` + baseURL + `/chat/completions \
  -H "Authorization: Bearer <` + i18n.T(ctx, "profile.models.api.key_placeholder") + `>" \
  -H "Content-Type: application/json" \
  -d '{
    "model": "` + i18n.T(ctx, "profile.models.api.model_name_format") + `",
    "messages": [{"role": "user", "content": "` + i18n.T(ctx, "profile.models.example.greeting") + `"}]
  }'`
}

func pythonExample(ctx context.Context, baseURL string) string {
	return `from openai import OpenAI

client = OpenAI(
    base_url="` + baseURL + `",
    api_key="<` + i18n.T(ctx, "profile.models.api.key_placeholder") + `>",
)

response = client.chat.completions.create(
    model="` + i18n.T(ctx, "profile.models.api.model_name_format") + `",
    messages=[{"role": "user", "content": "` + i18n.T(ctx, "profile.models.example.greeting") + `"}],
)
print(response.choices[0].message.content)`
}

func claudeCodeExample(ctx context.Context, baseURL string) string {
	modelName := i18n.T(ctx, "profile.models.api.model_name_format")
	return `export ANTHROPIC_BASE_URL="` + baseURL + `"
export ANTHROPIC_AUTH_TOKEN="<` + i18n.T(ctx, "profile.models.api.key_placeholder") + `>"
export ANTHROPIC_MODEL="` + modelName + `"
export ANTHROPIC_SMALL_FAST_MODEL="` + modelName + `"
export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

claude`
}

func openCodeConfigExample(baseURL string, catalog []CatalogModel) string {
	type providerOptions struct {
		BaseURL string `json:"baseURL"`
		APIKey  string `json:"apiKey"`
	}
	type providerEntry struct {
		NPM     string                              `json:"npm"`
		Name    string                              `json:"name"`
		Options providerOptions                     `json:"options"`
		Models  map[string]model.OpenCodeModelEntry `json:"models"`
	}
	type configRoot struct {
		Schema   string                   `json:"$schema"`
		Provider map[string]providerEntry `json:"provider"`
	}

	models := make(map[string]model.OpenCodeModelEntry)
	for _, m := range catalog {
		// A coding agent only holds conversations.
		if m.Model.Kind() != model.ModelKindCompletion {
			continue
		}
		for _, name := range ModelNames(m) {
			entry := model.OpenCodeEntry(
				m.Model.Capabilities(),
				m.Model.ContextWindow(),
				m.Model.OutputWindow(),
			)
			entry.Name = name

			models[name] = entry
		}
	}

	cfg := configRoot{
		Schema: "https://opencode.ai/config.json",
		Provider: map[string]providerEntry{
			"xolo": {
				NPM:  "@ai-sdk/openai-compatible",
				Name: "Xolo",
				Options: providerOptions{
					BaseURL: baseURL,
					APIKey:  "{env:XOLO_API_KEY}",
				},
				Models: models,
			},
		},
	}

	data, err := json.MarshalIndent(cfg, "", "  ")
	if err != nil {
		return ""
	}
	return string(data)
}

// undeterminedModelNames lists the names of the completion models whose
// capabilities are undetermined, sorted alphabetically.
func undeterminedModelNames(catalog []CatalogModel) []string {
	var names []string
	for _, m := range catalog {
		if m.CapabilitiesUndetermined && m.Model.Kind() == model.ModelKindCompletion {
			names = append(names, ModelNames(m)...)
		}
	}
	slices.Sort(names)
	return names
}

func formatCostPerM(ctx context.Context, microcentsPer1K int64, currency string) string {
	return common.FormatCost(ctx, microcentsPer1K*1000, currency)
}

func orgCurrency(org model.Organization) string {
	if org == nil {
		return "USD"
	}
	currency := org.Currency()
	if currency == "" {
		return "USD"
	}
	return currency
}
