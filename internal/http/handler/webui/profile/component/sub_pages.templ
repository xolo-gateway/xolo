package component

import (
	"github.com/xolo-gateway/xolo/internal/i18n"
	"github.com/xolo-gateway/xolo/internal/core/model"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/alert"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/table"
)

// ─── Invitations ────────────────────────────────────────────────────────────

type InvitationsPageVModel struct {
	common.AppLayoutVModel
	Invites   []model.InviteToken
	RoleNames map[model.InviteTokenID]string
}

templ InvitationsPage(vmodel InvitationsPageVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel) {
		<div class="space-y-6">
			<div class="flex items-center gap-4">
				@icon.Mail(icon.Props{Class: "h-8 w-8"})
				@common.PageHeader(common.PageHeaderProps{
					Title: i18n.T(ctx, "profile.invitations.title"),
				})
				if len(vmodel.Invites) == 0 {
					@alert.Alert(alert.Props{Variant: alert.VariantDefault}) {
						@alert.Description(alert.DescriptionProps{}) {
							{ i18n.T(ctx, "profile.invitations.empty") }
						}
					}
				} else {
					@common.Section() {
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head() {
										{ i18n.T(ctx, "profile.invitations.col.organization") }
									}
									@table.Head() {
										{ i18n.T(ctx, "profile.invitations.col.role") }
									}
									@table.Head() {
										{ i18n.T(ctx, "profile.invitations.col.expiration") }
									}
									@table.Head(table.HeadProps{Class: "text-right"}) {
										{ i18n.T(ctx, "profile.invitations.col.actions") }
									}
								}
							}
							@table.Body() {
								for _, inv := range vmodel.Invites {
									@table.Row() {
										@table.Cell() {
											if inv.Org() != nil {
												{ inv.Org().Name() }
											} else {
												{ string(inv.OrgID()) }
											}
										}
										@table.Cell() {
											@common.Badge(common.ToneInfo, vmodel.RoleNames[inv.ID()])
										}
										@table.Cell(table.CellProps{Class: "text-muted-foreground"}) {
											if inv.ExpiresAt() != nil {
												{ inv.ExpiresAt().Format(i18n.T(ctx, "profile.date_layout")) }
											} else {
												—
											}
										}
										@table.Cell(table.CellProps{Class: "text-right"}) {
											@button.Button(button.Props{
												Href:    common.BaseURLString(ctx, common.WithPath("/join/", string(inv.ID()))),
												Variant: button.VariantDefault,
												Size:    button.SizeSm,
											}) {
												{ i18n.T(ctx, "profile.invitations.join") }
											}
										}
									}
								}
							}
						}
					}
				}
			</div>
		</div>
	}
}

// ─── Chart helpers ───────────────────────────────────────────────────────────

type ProfileChartDataPoint = common.ChartDataPoint
