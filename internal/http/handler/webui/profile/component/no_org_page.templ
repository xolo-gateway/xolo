package component

import (
	"github.com/xolo-gateway/xolo/internal/core/model"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
)

type NoOrgPageVModel struct {
	User        model.User
	Invites     []model.InviteToken
	DeclinedIDs []string
	// IsAdmin marks a platform administrator: they are not stuck here, the
	// console is theirs and it is where an organisation gets created.
	IsAdmin bool
}

func isDeclined(id string, declinedIDs []string) bool {
	for _, d := range declinedIDs {
		if d == id {
			return true
		}
	}
	return false
}

// noOrgDescription words the emptiness for who is reading it: a plain account
// waits for an invitation, an administrator creates the organisation.
func noOrgDescription(isAdmin bool) string {
	if isAdmin {
		return "Xolo s'utilise depuis une organisation : c'est elle qui porte les fournisseurs, les modèles et le budget. Créez-en une depuis la console plateforme."
	}

	return "Xolo s'utilise depuis une organisation : c'est elle qui porte les fournisseurs, les modèles et le budget. Demandez à un administrateur de vous y inviter."
}

// inviteRoleLabel returns the display label for an organization role.
func inviteRoleLabel(role string) string {
	switch role {
	case model.RoleOrgAdmin, model.RoleOrgOwner:
		return "Administrateur"
	default:
		return "Utilisateur"
	}
}

// NoOrgPage is the first screen a freshly provisioned account lands on: either
// the invitations waiting for it, or an explanation of why the product is empty.
templ NoOrgPage(vmodel NoOrgPageVModel) {
	{{
		var pending []model.InviteToken
		for _, inv := range vmodel.Invites {
			if !isDeclined(string(inv.ID()), vmodel.DeclinedIDs) {
				pending = append(pending, inv)
			}
		}
	}}
	@common.StandaloneLayout(common.WithTitle("Aucune organisation")) {
		if len(pending) == 0 {
			@common.EmptyState(common.EmptyStateProps{
				Icon:        icon.Building2,
				Title:       "Aucune organisation",
				Description: "Xolo s'utilise depuis une organisation : c'est elle qui porte les fournisseurs, les modèles et le budget. Demandez à un administrateur de vous y inviter.",
			}) {
				if vmodel.IsAdmin {
					@button.Button(button.Props{
						Href: common.BaseURLString(ctx, common.WithPath("/admin/")),
						Size: button.SizeSm,
					}) {
						Console plateforme
					}
				}
				@button.Button(button.Props{
					Href:       common.BaseURLString(ctx, common.WithPath("/auth/oidc/logout")),
					Variant:    button.VariantOutline,
					Size:       button.SizeSm,
					Attributes: templ.Attributes{"hx-boost": "false"},
				}) {
					Déconnexion
				}
			}
		} else {
			<div class="space-y-3">
				<div>
					<h1 class="text-xl font-semibold tracking-tight">Invitations en attente</h1>
					<p class="mt-1 text-sm text-muted-foreground">
						Rejoignez une organisation pour commencer à utiliser la passerelle.
					</p>
				</div>
				for _, inv := range pending {
					@common.Section() {
						@common.SectionBody(common.SectionBodyProps{Class: "space-y-3"}) {
							<div class="flex flex-wrap items-center gap-2.5">
								<span class="text-base font-semibold">
									if inv.Org() != nil {
										{ inv.Org().Name() }
									} else {
										{ string(inv.OrgID()) }
									}
								</span>
								@common.Badge(common.ToneInfo, inviteRoleLabel(inv.Role()))
							</div>
							<div class="flex flex-wrap gap-2">
								@button.Button(button.Props{
									Size:  button.SizeSm,
									Href:  common.BaseURLString(ctx, common.WithPath("/join/", string(inv.ID()))),
									Class: "flex-1",
								}) {
									Rejoindre l'organisation
								}
								<form method="POST" action={ common.BaseURL(ctx, common.WithPath("/join/", string(inv.ID()), "/decline")) } class="flex-1">
									@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm, Class: "w-full"}) {
										Décliner
									}
								</form>
							</div>
						}
					}
				}
			</div>
		}
	}
}
