package component

import (
	"context"

	"github.com/xolo-gateway/xolo/internal/i18n"
	"github.com/xolo-gateway/xolo/internal/core/model"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
)

type NoOrgPageVModel struct {
	User        model.User
	Invites     []model.InviteToken
	RoleNames   map[model.InviteTokenID]string
	DeclinedIDs []string
	// IsAdmin marks a platform administrator: they are not stuck here, the
	// console is theirs and it is where an organisation gets created.
	IsAdmin bool
}

func isDeclined(id string, declinedIDs []string) bool {
	for _, d := range declinedIDs {
		if d == id {
			return true
		}
	}
	return false
}

// noOrgDescription words the emptiness for who is reading it: a plain account
// waits for an invitation, an administrator creates the organisation.
func noOrgDescription(ctx context.Context, isAdmin bool) string {
	if isAdmin {
		return i18n.T(ctx, "profile.no_org.description_admin")
	}

	return i18n.T(ctx, "profile.no_org.description")
}

// NoOrgPage is the first screen a freshly provisioned account lands on: either
// the invitations waiting for it, or an explanation of why the product is empty.
templ NoOrgPage(vmodel NoOrgPageVModel) {
	{{
		var pending []model.InviteToken
		for _, inv := range vmodel.Invites {
			if !isDeclined(string(inv.ID()), vmodel.DeclinedIDs) {
				pending = append(pending, inv)
			}
		}
	}}
	@common.StandaloneLayout(common.WithTitle(i18n.T(ctx, "profile.no_org.title"))) {
		if len(pending) == 0 {
			@common.EmptyState(common.EmptyStateProps{
				Icon:        icon.Building2,
				Title:       i18n.T(ctx, "profile.no_org.title"),
				Description: i18n.T(ctx, "profile.no_org.description"),
			}) {
				if vmodel.IsAdmin {
					@button.Button(button.Props{
						Href: common.BaseURLString(ctx, common.WithPath("/admin/")),
						Size: button.SizeSm,
					}) {
						{ i18n.T(ctx, "profile.no_org.platform_console") }
					}
				}
				@button.Button(button.Props{
					Href:       common.BaseURLString(ctx, common.WithPath("/auth/oidc/logout")),
					Variant:    button.VariantOutline,
					Size:       button.SizeSm,
					Attributes: templ.Attributes{"hx-boost": "false"},
				}) {
					{ i18n.T(ctx, "profile.no_org.logout") }
				}
			}
		} else {
			<div class="space-y-3">
				<div>
					<h1 class="text-xl font-semibold tracking-tight">{ i18n.T(ctx, "profile.invitations.title") }</h1>
					<p class="mt-1 text-sm text-muted-foreground">
						{ i18n.T(ctx, "profile.no_org.invitations_subtitle") }
					</p>
				</div>
				for _, inv := range pending {
					@common.Section() {
						@common.SectionBody(common.SectionBodyProps{Class: "space-y-3"}) {
							<div class="flex flex-wrap items-center gap-2.5">
								<span class="text-base font-semibold">
									if inv.Org() != nil {
										{ inv.Org().Name() }
									} else {
										{ string(inv.OrgID()) }
									}
								</span>
								@common.Badge(common.ToneInfo, vmodel.RoleNames[inv.ID()])
							</div>
							<div class="flex flex-wrap gap-2">
								@button.Button(button.Props{
									Size:  button.SizeSm,
									Href:  common.BaseURLString(ctx, common.WithPath("/join/", string(inv.ID()))),
									Class: "flex-1",
								}) {
									{ i18n.T(ctx, "profile.no_org.join") }
								}
								<form method="POST" action={ common.BaseURL(ctx, common.WithPath("/no-org/invitations/", string(inv.ID()), "/decline")) } class="flex-1">
									@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm, Class: "w-full"}) {
										{ i18n.T(ctx, "profile.no_org.decline") }
									}
								</form>
							</div>
						}
					}
				}
			</div>
		}
	}
}
