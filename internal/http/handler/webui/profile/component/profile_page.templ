package component

import (
	"github.com/xolo-gateway/xolo/internal/i18n"
	"github.com/xolo-gateway/xolo/internal/core/model"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/form"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/input"
)

type ProfilePageVModel struct {
	AppLayoutVModel common.AppLayoutVModel
	User            model.User
}

templ ProfilePage(vmodel ProfilePageVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(i18n.T(ctx, "profile.profile.title"))) {
		<div class="max-w-2xl">
			@common.PageHeader(common.PageHeaderProps{
				Title:    i18n.T(ctx, "profile.profile.title"),
				Subtitle: i18n.T(ctx, "profile.profile.subtitle"),
			})
			@common.Section() {
				@common.SectionHeader() {
					@common.SectionTitle() {
						{ i18n.T(ctx, "profile.profile.account_info") }
					}
				}
				@common.SectionBody(common.SectionBodyProps{Class: "space-y-3.5"}) {
					@form.Item() {
						@form.Label(form.LabelProps{For: "profile-name"}) {
							{ i18n.T(ctx, "profile.profile.display_name") }
						}
						@input.Input(input.Props{
							ID:       "profile-name",
							Value:    vmodel.User.DisplayName(),
							Readonly: true,
						})
					}
					@form.Item() {
						@form.Label(form.LabelProps{For: "profile-email"}) {
							{ i18n.T(ctx, "profile.profile.email") }
						}
						@input.Input(input.Props{
							ID:       "profile-email",
							Value:    vmodel.User.Email(),
							Readonly: true,
						})
					}
					@form.Item() {
						@form.Label(form.LabelProps{For: "profile-provider"}) {
							{ i18n.T(ctx, "profile.profile.identity_provider") }
						}
						@input.Input(input.Props{
							ID:       "profile-provider",
							Value:    vmodel.User.Provider(),
							Readonly: true,
							Class:    "font-mono",
						})
						@form.Description() {
							{ i18n.T(ctx, "profile.profile.identity_provider_help") }
						}
					}
				}
			}
		</div>
	}
}
