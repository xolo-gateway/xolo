package component

import (
	"context"

	"github.com/xolo-gateway/xolo/internal/i18n"
	"github.com/xolo-gateway/xolo/internal/core/model"
	common "github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/alert"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/dialog"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/form"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/input"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/selectbox"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/table"
)

type TokensPageVModel struct {
	AppLayoutVModel common.AppLayoutVModel
	AuthTokens      []model.AuthToken
	OrgMemberships  []model.Membership
	// Teams are the user's teams, a token can be bound to one of them.
	Teams        []TeamOption
	CreatedToken string
	DeletedToken    bool

	// Error carries the failure code of the previous create-token request.
	// Rendered as an alert at the top of the dialog and, when non-empty,
	// causes the dialog to open again so the user can fix the form without
	// hunting for the "New key" button.
	Error string

	// OpenDialog forces the dialog to its open state on first render. Set
	// when the previous request bounced back with an error, so the user can
	// fix the form without hunting for the "New key" button. A successful
	// create does NOT reopen it: the clear-text token is shown in a
	// page-level alert, and opening the modal on top would dim that alert
	// behind the overlay.
	OpenDialog bool

	// FormLabel / FormOrgID / FormExpiresAt round-trip the user's draft
	// across a redirect so a missing organisation does not throw away the
	// name or the expiry they just typed.
	FormLabel     string
	FormOrgID     model.OrgID
	FormExpiresAt string
	FormTeamID    model.TeamID
}

templ TokensPage(vmodel TokensPageVModel) {
	@common.AppLayout(vmodel.AppLayoutVModel, common.WithTitle(i18n.T(ctx, "profile.tokens.title"))) {
		<div class="space-y-6">
			<!-- Header -->
			@common.PageHeader(common.PageHeaderProps{
				Title:    i18n.T(ctx, "profile.tokens.title"),
				Subtitle: i18n.T(ctx, "profile.tokens.subtitle"),
			}) {
				@dialog.Trigger(dialog.TriggerProps{For: "token-create-dialog"}) {
					@button.Button(button.Props{Size: button.SizeSm}) {
						@icon.Plus(icon.Props{Class: "h-4 w-4 mr-2"})
						{ i18n.T(ctx, "profile.tokens.new") }
					}
				}
			}
			if vmodel.DeletedToken {
				@common.InfoBanner(common.TonePositive, i18n.T(ctx, "profile.tokens.deleted"))
			}
			if vmodel.CreatedToken != "" {
				@alert.Alert(alert.Props{Variant: alert.VariantDefault}) {
					@alert.Description() {
						<div class="font-medium">{ i18n.T(ctx, "profile.tokens.created") }</div>
						<div class="text-sm mt-1">{ i18n.T(ctx, "profile.tokens.copy_now") }</div>
						<div class="mt-2">
							@common.InlineSnippet(vmodel.CreatedToken)
						</div>
					}
				}
			}
			<!-- Auth Tokens Section -->
			@apiCallExample()
			if len(vmodel.AuthTokens) == 0 {
				@common.EmptyState(common.EmptyStateProps{
					Icon:        icon.KeyRound,
					Title:       i18n.T(ctx, "profile.tokens.empty.title"),
					Description: i18n.T(ctx, "profile.tokens.empty.description"),
				})
			} else {
				@common.Section() {
					@table.Table() {
						@table.Header() {
							@table.Head() {
								{ i18n.T(ctx, "profile.tokens.col.name") }
							}
							@table.Head() {
								{ i18n.T(ctx, "profile.tokens.col.organization") }
							}
							@table.Head() {
								{ i18n.T(ctx, "profile.tokens.col.expiration") }
							}
							@table.Head(table.HeadProps{Class: "text-right"}) {
								{ i18n.T(ctx, "profile.tokens.col.actions") }
							}
						}
						@table.Body() {
							for _, token := range vmodel.AuthTokens {
								@table.Row() {
									@table.Cell() {
										<span class="font-medium">{ token.Label() }</span>
									}
									@table.Cell(table.CellProps{Class: "text-muted-foreground"}) {
										{ tokenOrgName(token, vmodel.OrgMemberships) }
										if team := tokenTeamName(ctx, token, vmodel.Teams); team != "" {
											<span class="ml-1 text-xs text-muted-foreground">{ "· " + team }</span>
										}
									}
									@table.Cell(table.CellProps{Class: "text-muted-foreground"}) {
										{ tokenExpiry(ctx, token) }
									}
									@table.Cell(table.CellProps{Class: "text-right"}) {
										@common.ConfirmDelete(common.ConfirmDeleteProps{
											URL:          common.BaseURLString(ctx, common.WithPath("/profile/tokens/", string(token.ID()))),
											Label:        i18n.T(ctx, "profile.tokens.revoke"),
											Title:        i18n.T(ctx, "profile.tokens.revoke_title"),
											Description:  i18n.T(ctx, "profile.tokens.revoke_description"),
											ConfirmLabel: i18n.T(ctx, "profile.tokens.revoke"),
										})
									}
								}
							}
						}
					}
				}
			}
		</div>
		<!-- Token Creation Dialog -->
		@dialog.Dialog(dialog.Props{ID: "token-create-dialog", Open: vmodel.OpenDialog}) {
			@dialog.Content() {
				@dialog.Header() {
					@dialog.Title(dialog.TitleProps{}) {
						{ i18n.T(ctx, "profile.tokens.dialog.title") }
					}
				}
				<div class="space-y-4">
					if vmodel.Error != "" && !orgErrorSuppressedByEmptyMemberships(vmodel) {
						@common.FlashError(vmodel.Error, "")
					}
					<div class="p-3 rounded-md bg-warning-tint text-warning text-sm">
						<strong>{ i18n.T(ctx, "profile.tokens.dialog.important") }</strong> { i18n.T(ctx, "profile.tokens.dialog.warning") }
					</div>
					<form id="token-create-form" method="POST" action={ common.BaseURL(ctx, common.WithPath("/profile/tokens")) } class="space-y-4" novalidate>
						@form.Item() {
							@form.Label(form.LabelProps{For: "token-label"}) {
								{ i18n.T(ctx, "profile.tokens.form.label") }
							}
							@input.Input(input.Props{
								Name:        "label",
								ID:          "token-label",
								Placeholder: i18n.T(ctx, "profile.tokens.form.label_placeholder"),
								Value:       vmodel.FormLabel,
								HasError:    vmodel.Error == "label_required",
							})
							if vmodel.Error == "label_required" {
								@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
									{ i18n.T(ctx, "profile.tokens.form.label_required") }
								}
							}
						}
						@form.Item() {
							@form.Label(form.LabelProps{For: "token-org-trigger"}) {
								{ i18n.T(ctx, "profile.tokens.form.organization") } <span class="text-destructive">*</span>
							}
							if len(vmodel.OrgMemberships) == 0 {
								@form.Description() {
									{ i18n.T(ctx, "profile.tokens.form.no_membership") }
								}
							} else {
								@selectbox.SelectBox(selectbox.Props{ID: "token-org"}) {
									@selectbox.Trigger(selectbox.TriggerProps{
										ID:       "token-org-trigger",
										Name:     "org_id",
										HasError: vmodel.Error == "org_required",
									}) {
										@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "profile.tokens.form.organization_placeholder")})
									}
									@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
										@selectbox.Group() {
											for _, m := range vmodel.OrgMemberships {
												if m.Org() != nil {
													@selectbox.Item(selectbox.ItemProps{
														Value:    string(m.OrgID()),
														Selected: vmodel.FormOrgID != "" && m.OrgID() == vmodel.FormOrgID,
													}) {
														{ m.Org().Name() }
													}
												}
											}
										}
									}
									if vmodel.Error == "org_required" {
										@form.Message(form.MessageProps{Variant: form.MessageVariantError}) {
											{ i18n.T(ctx, "profile.tokens.form.organization_required") }
										}
									}
								}
							}
						}
						if len(vmodel.Teams) > 0 {
							@form.Item() {
								@form.Label(form.LabelProps{For: "token-team-trigger"}) {
									{ i18n.T(ctx, "profile.tokens.form.team") }
								}
								@selectbox.SelectBox(selectbox.Props{ID: "token-team"}) {
									@selectbox.Trigger(selectbox.TriggerProps{ID: "token-team-trigger", Name: "team_id"}) {
										@selectbox.Value(selectbox.ValueProps{Placeholder: i18n.T(ctx, "profile.tokens.form.no_team")})
									}
									@selectbox.Content(selectbox.ContentProps{NoSearch: len(vmodel.Teams) < 8}) {
										@selectbox.Group() {
											@selectbox.Item(selectbox.ItemProps{Value: "", Selected: vmodel.FormTeamID == ""}) {
												{ i18n.T(ctx, "profile.tokens.form.no_team") }
											}
											for _, opt := range vmodel.Teams {
												@selectbox.Item(selectbox.ItemProps{Value: string(opt.TeamID), Selected: vmodel.FormTeamID == opt.TeamID}) {
													{ opt.Label() }
												}
											}
										}
									}
								}
								@form.Description() {
									{ i18n.T(ctx, "profile.tokens.form.team_help") }
								}
							}
						}
						@form.Item() {
							@form.Label(form.LabelProps{For: "token-expires"}) {
								{ i18n.T(ctx, "profile.tokens.form.expires_at") }
							}
							@input.Input(input.Props{ID: "token-expires", Name: "expires_at", Type: input.TypeDate, Value: vmodel.FormExpiresAt})
						}
					</form>
				</div>
				@dialog.Footer(dialog.FooterProps{}) {
					<!-- Le bouton vit dans le pied du dialogue, hors du <form>.
					L'attribut `form` de HTML5 le rattache au formulaire par son id,
					sans JavaScript. La validation native est délibérément désactivée
					par `novalidate` sur le formulaire : les `required` que le selectbox
					dépose sur des `<input>` nichés dans un `<button>` ne sont pas
					fiables d'un navigateur à l'autre (le contenu d'un bouton ne peut
					pas accueillir d'élément interactif selon la spec), et la
					validation côté serveur renvoie déjà un message clair via
					`?error=<code>`. -->
					@button.Button(button.Props{
						Type:     button.TypeSubmit,
						Form:     "token-create-form",
						Size:     button.SizeSm,
						Disabled: len(vmodel.OrgMemberships) == 0,
					}) {
						{ i18n.T(ctx, "profile.tokens.form.submit") }
					}
				}
			}
		}
	}
}

// orgErrorSuppressedByEmptyMemberships hides the dialog-level org_required
// alert when the user belongs to no organisation at all: the form below
// already tells them to contact an admin, and a stacked "Veuillez
// sélectionner une organisation" reads as a contradiction rather than a
// helpful cue. Other error codes (label_required, invalid_form, etc.)
// keep their alert unchanged.
func orgErrorSuppressedByEmptyMemberships(vmodel TokensPageVModel) bool {
	if vmodel.Error != "org_required" {
		return false
	}
	return len(vmodel.OrgMemberships) == 0
}

func tokenOrgName(token model.AuthToken, memberships []model.Membership) string {
	if token.OrgID() == "" {
		return "—"
	}
	for _, m := range memberships {
		if m.OrgID() == token.OrgID() && m.Org() != nil {
			return m.Org().Name()
		}
	}
	return string(token.OrgID())
}

func tokenExpiry(ctx context.Context, token model.AuthToken) string {
	if token.ExpiresAt() == nil {
		return "—"
	}
	return token.ExpiresAt().Format(i18n.T(ctx, "profile.date_layout"))
}

// apiCallExample shows how to spend a key, which is the first thing anyone
// landing on this screen needs. The base URL comes from the request, so a
// deployment behind a reverse proxy shows its own address rather than a
// placeholder.
templ apiCallExample() {
	{{ baseURL := common.BaseURLString(ctx, common.WithPath("/v1")) }}
	<div class="mb-3.5">
		@common.Section() {
			@common.SectionHeader() {
				@common.SectionTitle() {
					{ i18n.T(ctx, "profile.tokens.example.title") }
				}
				<span class="ml-auto text-xs text-muted-foreground">{ i18n.T(ctx, "profile.tokens.example.compatible") }</span>
			}
			@common.SectionBody(common.SectionBodyProps{Class: "space-y-2.5"}) {
				<div class="flex flex-wrap items-center gap-2 text-sm">
					<span class="text-muted-foreground">{ i18n.T(ctx, "profile.tokens.example.base_url") }</span>
					<span class="min-w-48 flex-1">
						@common.InlineSnippet(baseURL)
					</span>
				</div>
				@common.Snippet("bash", "curl "+baseURL+"/chat/completions \\\n"+
					"  -H \"Authorization: Bearer $XOLO_API_KEY\" \\\n"+
					"  -H \"Content-Type: application/json\" \\\n"+
					"  -d '{\"model\": \""+i18n.T(ctx, "profile.tokens.example.model")+"\", \"messages\": [{\"role\": \"user\", \"content\": \""+i18n.T(ctx, "profile.tokens.example.greeting")+"\"}]}'")
			}
		}
	</div>
}

// tokenTeamName names the team a token is bound to, empty when none or when
// the user left it.
func tokenTeamName(ctx context.Context, token model.AuthToken, teams []TeamOption) string {
	if token.TeamID() == "" {
		return ""
	}
	for _, t := range teams {
		if t.TeamID == token.TeamID() {
			return t.TeamName
		}
	}
	return i18n.T(ctx, "profile.tokens.team_gone")
}
