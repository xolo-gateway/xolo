package component

import (
	"fmt"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/common/component"
	templuibutton "github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	templuicard "github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/card"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/icon"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

type Provider struct {
	ID    string
	Label string
	Icon  string
}

type LoginPageVModel struct {
	Providers []Provider
	Version   string
	APIDocURL string
}

// LoginPage renders the authentication screen. It goes through the shared
// standalone shell (brand, centred column, legal footer) instead of building its
// own page chrome.
templ LoginPage(vmodel LoginPageVModel) {
	@component.StandaloneLayout(component.WithTitle(i18n.T(ctx, "auth.title"))) {
		@templuicard.Card() {
			@templuicard.Header(templuicard.HeaderProps{Class: "text-center"}) {
				@templuicard.Title() {
					{ i18n.T(ctx, "auth.login.heading") }
				}
				@templuicard.Description() {
					{ i18n.T(ctx, "auth.login.oidc_description") }
				}
			}
			@templuicard.Content(templuicard.ContentProps{Class: "space-y-3"}) {
				for _, p := range vmodel.Providers {
					@templuibutton.Button(templuibutton.Props{
						Variant: templuibutton.VariantOutline,
						Class:   "w-full justify-center gap-2",
						Href:    fmt.Sprintf("/auth/oidc/providers/%s", p.ID),
						// The provider hand-off leaves the application: a boosted swap
						// would have nothing to put back into #content.
						Attributes: templ.Attributes{
							"hx-boost": "false",
						},
					}) {
						{{ providerIcon := p.Icon }}
						if providerIcon == "" {
							{{ providerIcon = "log-in" }}
						}
						@icon.Icon(providerIcon)(icon.Props{Class: "h-4 w-4"})
						{ p.Label }
					}
				}
			}
			if vmodel.Version != "" {
				@templuicard.Footer(templuicard.FooterProps{Class: "justify-center"}) {
					<p class="font-mono text-xs text-muted-foreground">{ vmodel.Version }</p>
				}
			}
		}
	}
}
