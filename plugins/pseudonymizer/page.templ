package main

import (
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/alert"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/badge"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/card"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/checkbox"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/input"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/label"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

// page renders the pseudonymizer plugin configuration UI.
templ page(pd uiPageData) {
	<!DOCTYPE html>
	<html class="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<base href={ pd.BasePath }/>
			<link rel="stylesheet" href="/assets/templui.css"/>
		</head>
		<body class="bg-background text-foreground min-h-screen p-4 space-y-4">
			<h1 class="text-lg font-semibold">{ i18n.T(ctx, "plugin.pseudonymizer.title") }</h1>
			<p class="text-sm text-muted-foreground">
				{ i18n.T(ctx, "plugin.pseudonymizer.intro") }
			</p>

			if pd.Success {
				@alert.Alert(alert.Props{Variant: alert.VariantDefault}) {
					@alert.Description() {
						{ i18n.T(ctx, "plugin.pseudonymizer.saved") }
					}
				}
			}
			if pd.Error != "" {
				@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
					@alert.Description() {
						{ pd.Error }
					}
				}
			}

			<!-- Model status -->
			@card.Card() {
				@card.Header() {
					@card.Title() { { i18n.T(ctx, "plugin.pseudonymizer.models.title") } }
				}
				@card.Content() {
					if len(pd.ModelStatus) == 0 {
						<p class="text-sm text-muted-foreground italic">
							{ i18n.T(ctx, "plugin.pseudonymizer.models.unavailable") }
						</p>
					} else {
						<div class="flex flex-wrap gap-2">
							for _, ms := range pd.ModelStatus {
								@modelStatusBadge(ms)
							}
						</div>
						<p class="text-xs text-muted-foreground mt-2">
							{ i18n.T(ctx, "plugin.pseudonymizer.models.download_hint") }
						</p>
					}
				}
			}

			<form method="POST" action="api/config" class="space-y-4">
				<!-- Language & Strategy -->
				@card.Card() {
					@card.Header() {
						@card.Title() { { i18n.T(ctx, "plugin.pseudonymizer.anonymization.title") } }
					}
					@card.Content() {
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div class="space-y-1">
								@label.Label(label.Props{For: "language"}) { { i18n.T(ctx, "plugin.pseudonymizer.language.label") } }
								<select
									id="language"
									name="language"
									class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
								>
									<option value="auto" if pd.Config.Language == LanguageAuto { selected }>{ i18n.T(ctx, "plugin.pseudonymizer.language.auto") }</option>
									for _, lang := range pd.Languages {
										<option value={ lang } if pd.Config.Language == lang { selected }>{ languageLabel(lang) }</option>
									}
								</select>
								<p class="text-xs text-muted-foreground">
									{ i18n.T(ctx, "plugin.pseudonymizer.language.help") }
								</p>
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "fallback_language"}) { { i18n.T(ctx, "plugin.pseudonymizer.fallback_language.label") } }
								<select
									id="fallback_language"
									name="fallback_language"
									class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
								>
									for _, lang := range pd.Languages {
										<option value={ lang } if pd.Config.FallbackLanguage == lang { selected }>{ languageLabel(lang) }</option>
									}
								</select>
								<p class="text-xs text-muted-foreground">
									{ i18n.T(ctx, "plugin.pseudonymizer.fallback_language.help") }
								</p>
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "strategy"}) { { i18n.T(ctx, "plugin.pseudonymizer.strategy.label") } }
								<select
									id="strategy"
									name="strategy"
									class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
								>
									<option value="tag" if pd.Config.Strategy == "tag" { selected }>Tag — [PERSON_1]</option>
									<option value="redact" if pd.Config.Strategy == "redact" { selected }>Redact — ████</option>
									<option value="hash" if pd.Config.Strategy == "hash" { selected }>Hash — [PER_a1b2c3]</option>
									<option value="consistent" if pd.Config.Strategy == "consistent" { selected }>{ i18n.T(ctx, "plugin.pseudonymizer.strategy.consistent") }</option>
								</select>
							</div>
						</div>
					}
				}

				<!-- Filters -->
				@card.Card() {
					@card.Header() {
						@card.Title() { { i18n.T(ctx, "plugin.pseudonymizer.filters.title") } }
					}
					@card.Content() {
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div class="space-y-1">
								@label.Label(label.Props{For: "min_confidence"}) { { i18n.T(ctx, "plugin.pseudonymizer.min_confidence.label") } }
								@input.Input(input.Props{
									ID:          "min_confidence",
									Name:        "min_confidence",
									Type:        "number",
									Value:       formatFloat(pd.Config.MinConfidence),
									Placeholder: "0",
									Attributes:  templ.Attributes{"step": "0.05", "min": "0", "max": "1"},
								})
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "max_tokens"}) { { i18n.T(ctx, "plugin.pseudonymizer.max_tokens.label") } }
								@input.Input(input.Props{
									ID:          "max_tokens",
									Name:        "max_tokens",
									Type:        "number",
									Value:       formatInt(pd.Config.MaxTokens),
									Placeholder: "0",
									Attributes:  templ.Attributes{"min": "0"},
								})
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "min_runes"}) { { i18n.T(ctx, "plugin.pseudonymizer.min_runes.label") } }
								@input.Input(input.Props{
									ID:          "min_runes",
									Name:        "min_runes",
									Type:        "number",
									Value:       formatInt(pd.Config.MinRunes),
									Placeholder: "0",
									Attributes:  templ.Attributes{"min": "0"},
								})
								<p class="text-xs text-muted-foreground">
									{ i18n.T(ctx, "plugin.pseudonymizer.min_runes.help") }
								</p>
							</div>
						</div>
					}
				}

			<!-- Vérification -->
			@card.Card() {
				@card.Header() {
					@card.Title() { { i18n.T(ctx, "plugin.pseudonymizer.verification.title") } }
				}
				@card.Content() {
					<div class="space-y-3">
						@checkboxRow("verification", i18n.T(ctx, "plugin.pseudonymizer.verification.label"), i18n.T(ctx, "plugin.pseudonymizer.verification.help"), pd.Config.Verification)
						@checkboxRow("verification_strict", i18n.T(ctx, "plugin.pseudonymizer.verification_strict.label"), i18n.T(ctx, "plugin.pseudonymizer.verification_strict.help"), pd.Config.VerificationStrict)
					</div>
				}
			}

			<!-- Pièces jointes -->
			@card.Card() {
				@card.Header() {
					@card.Title() { { i18n.T(ctx, "plugin.pseudonymizer.attachments.title") } }
				}
				@card.Content() {
					<div class="space-y-3">
						@checkboxRow("process_attachments", i18n.T(ctx, "plugin.pseudonymizer.process_attachments.label"), i18n.T(ctx, "plugin.pseudonymizer.process_attachments.help"), pd.Config.ProcessAttachments)
						<div class="space-y-1">
							@label.Label(label.Props{For: "unsupported_attachments"}) { { i18n.T(ctx, "plugin.pseudonymizer.unsupported_attachments.label") } }
							<select
								id="unsupported_attachments"
								name="unsupported_attachments"
								class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
							>
								<option value="block" if pd.Config.UnsupportedAttachments == "block" { selected }>{ i18n.T(ctx, "plugin.pseudonymizer.unsupported_attachments.block") }</option>
								<option value="remove" if pd.Config.UnsupportedAttachments == "remove" { selected }>{ i18n.T(ctx, "plugin.pseudonymizer.unsupported_attachments.remove") }</option>
							</select>
							<p class="text-xs text-muted-foreground">
								{ i18n.T(ctx, "plugin.pseudonymizer.unsupported_attachments.help") }
							</p>
						</div>
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div class="space-y-1">
								@label.Label(label.Props{For: "max_attachment_bytes"}) { { i18n.T(ctx, "plugin.pseudonymizer.max_attachment_bytes.label") } }
								@input.Input(input.Props{
									ID:          "max_attachment_bytes",
									Name:        "max_attachment_bytes",
									Type:        "number",
									Value:       formatInt(pd.Config.MaxAttachmentBytes),
									Placeholder: "10485760",
									Attributes:  templ.Attributes{"min": "0"},
								})
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "max_attachment_chars"}) { { i18n.T(ctx, "plugin.pseudonymizer.max_attachment_chars.label") } }
								@input.Input(input.Props{
									ID:          "max_attachment_chars",
									Name:        "max_attachment_chars",
									Type:        "number",
									Value:       formatInt(pd.Config.MaxAttachmentChars),
									Placeholder: "200000",
									Attributes:  templ.Attributes{"min": "0"},
								})
							</div>
						</div>
					</div>
				}
			}

			<!-- Options -->
			@card.Card() {
				@card.Header() {
					@card.Title() { { i18n.T(ctx, "plugin.pseudonymizer.options.title") } }
				}
					@card.Content() {
						<div class="space-y-3">
							@checkboxRow("builtin_regex_patterns", i18n.T(ctx, "plugin.pseudonymizer.builtin_regex.label"), i18n.T(ctx, "plugin.pseudonymizer.builtin_regex.help"), pd.Config.BuiltinRegexPatterns)
							@checkboxRow("builtin_secret_patterns", i18n.T(ctx, "plugin.pseudonymizer.builtin_secret.label"), i18n.T(ctx, "plugin.pseudonymizer.builtin_secret.help"), pd.Config.BuiltinSecretPatterns)
							@checkboxRow("siren_contextual", i18n.T(ctx, "plugin.pseudonymizer.siren_contextual.label"), i18n.T(ctx, "plugin.pseudonymizer.siren_contextual.help"), pd.Config.SirenContextual)
							@checkboxRow("first_name_reclassify", i18n.T(ctx, "plugin.pseudonymizer.first_name_reclassify.label"), i18n.T(ctx, "plugin.pseudonymizer.first_name_reclassify.help"), pd.Config.FirstNameReclassify)
							@checkboxRow("merge", i18n.T(ctx, "plugin.pseudonymizer.merge.label"), i18n.T(ctx, "plugin.pseudonymizer.merge.help"), pd.Config.Merge)
							@checkboxRow("name_completion", i18n.T(ctx, "plugin.pseudonymizer.name_completion.label"), i18n.T(ctx, "plugin.pseudonymizer.name_completion.help"), pd.Config.NameCompletion)
							@checkboxRow("inject_instruction", i18n.T(ctx, "plugin.pseudonymizer.inject_instruction.label"), i18n.T(ctx, "plugin.pseudonymizer.inject_instruction.help"), pd.Config.InjectInstruction)
						</div>
					}
				}

				<!-- Model store -->
				@card.Card() {
					@card.Header() {
						@card.Title() { { i18n.T(ctx, "plugin.pseudonymizer.store.title") } }
					}
					@card.Content() {
						<div class="space-y-3">
							<div class="space-y-1">
								@label.Label(label.Props{For: "cache_dir"}) { { i18n.T(ctx, "plugin.pseudonymizer.cache_dir.label") } }
								@input.Input(input.Props{
									ID:          "cache_dir",
									Name:        "cache_dir",
									Value:       pd.Config.CacheDir,
									Placeholder: i18n.T(ctx, "plugin.pseudonymizer.cache_dir.placeholder"),
								})
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "manifest_url"}) { { i18n.T(ctx, "plugin.pseudonymizer.manifest_url.label") } }
								@input.Input(input.Props{
									ID:          "manifest_url",
									Name:        "manifest_url",
									Value:       pd.Config.ManifestURL,
									Placeholder: i18n.T(ctx, "plugin.pseudonymizer.manifest_url.placeholder"),
								})
							</div>
							@checkboxRow("offline", i18n.T(ctx, "plugin.pseudonymizer.offline.label"), i18n.T(ctx, "plugin.pseudonymizer.offline.help"), pd.Config.Offline)
						</div>
					}
				}

				<!-- Save -->
				<div class="flex justify-end">
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						{ i18n.T(ctx, "plugin.pseudonymizer.save") }

					}
				</div>
			</form>

			<!-- Sécurité -->
			@card.Card() {
				@card.Header() {
					@card.Title() { { i18n.T(ctx, "plugin.pseudonymizer.hash_key.title") } }
				}
				@card.Content() {
					if pd.NodeID == "" {
						<p class="text-sm text-muted-foreground italic">
							{ i18n.T(ctx, "plugin.pseudonymizer.hash_key.no_node") }
						</p>
					} else {
						<form method="POST" action="/api/secrets/hash_key" class="space-y-3">
							<div class="space-y-1">
								@label.Label(label.Props{For: "hash_key"}) { { i18n.T(ctx, "plugin.pseudonymizer.hash_key.label") } }
								@input.Input(input.Props{
									ID:          "hash_key",
									Name:        "hash_key",
									Type:        input.TypePassword,
									Placeholder: hashKeyPlaceholder(pd.HasHashKey),
								})
								<p class="text-xs text-muted-foreground">
									if pd.HasHashKey {
										{ i18n.T(ctx, "plugin.pseudonymizer.hash_key.configured") }
									} else {
										{ i18n.T(ctx, "plugin.pseudonymizer.hash_key.help") }
									}
								</p>
							</div>
							<div class="flex justify-end">
								@button.Button(button.Props{Type: button.TypeSubmit}) {
									{ i18n.T(ctx, "plugin.pseudonymizer.hash_key.save") }
								}
							</div>
						</form>
						if pd.HasHashKey {
							<form method="POST" action="/api/secrets/hash_key/delete" class="flex justify-end">
								@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeSubmit}) {
									{ i18n.T(ctx, "plugin.pseudonymizer.hash_key.delete") }
								}
							</form>
						}
					}
				}
			}
		</body>
	</html>
}

templ modelStatusBadge(ms modelStatusEntry) {
	if ms.Cached {
		@badge.Badge(badge.Props{}) {
			✓ { ms.Lang }
		}
	} else {
		@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
			○ { ms.Lang }
		}
	}
}

templ checkboxRow(name, title, description string, checked bool) {
	<div class="flex items-start gap-3">
		<div class="mt-0.5">
			@checkbox.Checkbox(checkbox.Props{ID: name, Name: name, Checked: checked})
		</div>
		<div class="space-y-0.5">
			@label.Label(label.Props{For: name}) { { title } }
			<p class="text-xs text-muted-foreground">{ description }</p>
		</div>
	</div>
}
