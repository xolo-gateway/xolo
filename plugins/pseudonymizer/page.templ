package main

import (
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/alert"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/badge"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/card"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/checkbox"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/input"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/label"
)

// page renders the pseudonymizer plugin configuration UI.
templ page(pd uiPageData) {
	<!DOCTYPE html>
	<html class="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<base href={ pd.BasePath }/>
			<link rel="stylesheet" href="/assets/templui.css"/>
		</head>
		<body class="bg-background text-foreground min-h-screen p-4 space-y-4">
			<h1 class="text-lg font-semibold">Pseudonymisation</h1>
			<p class="text-sm text-muted-foreground">
				Anonymise automatiquement les entités nommées (personnes, lieux, organisations…) dans les
				messages avant transmission au LLM, et rétablit les données originales dans la réponse.
			</p>

			if pd.Success {
				@alert.Alert(alert.Props{Variant: alert.VariantDefault}) {
					@alert.Description() {
						Configuration sauvegardée avec succès.
					}
				}
			}
			if pd.Error != "" {
				@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
					@alert.Description() {
						{ pd.Error }
					}
				}
			}

			<!-- Model status -->
			@card.Card() {
				@card.Header() {
					@card.Title() { Modèles NER disponibles }
				}
				@card.Content() {
					if len(pd.ModelStatus) == 0 {
						<p class="text-sm text-muted-foreground italic">
							Impossible de lister les modèles disponibles (pas de connexion réseau ou cache vide).
						</p>
					} else {
						<div class="flex flex-wrap gap-2">
							for _, ms := range pd.ModelStatus {
								@modelStatusBadge(ms)
							}
						</div>
						<p class="text-xs text-muted-foreground mt-2">
							Les modèles non encore en cache seront téléchargés automatiquement lors du premier appel.
						</p>
					}
				}
			}

			<form method="POST" action="api/config" class="space-y-4">
				<!-- Language & Strategy -->
				@card.Card() {
					@card.Header() {
						@card.Title() { Anonymisation }
					}
					@card.Content() {
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div class="space-y-1">
								@label.Label(label.Props{For: "language"}) { Langue }
								<select
									id="language"
									name="language"
									class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
								>
									<option value="auto" if pd.Config.Language == LanguageAuto { selected }>Détection automatique</option>
									for _, lang := range pd.Languages {
										<option value={ lang } if pd.Config.Language == lang { selected }>{ languageLabel(lang) }</option>
									}
								</select>
								<p class="text-xs text-muted-foreground">
									En détection automatique, la langue est déterminée à chaque requête à partir des
									messages, parmi les modèles disponibles.
								</p>
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "fallback_language"}) { Langue de repli }
								<select
									id="fallback_language"
									name="fallback_language"
									class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
								>
									for _, lang := range pd.Languages {
										<option value={ lang } if pd.Config.FallbackLanguage == lang { selected }>{ languageLabel(lang) }</option>
									}
								</select>
								<p class="text-xs text-muted-foreground">
									Utilisée lorsque la détection n'est pas fiable (message trop court, langue non supportée).
								</p>
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "strategy"}) { Stratégie }
								<select
									id="strategy"
									name="strategy"
									class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
								>
									<option value="tag" if pd.Config.Strategy == "tag" { selected }>Tag — [PERSON_1]</option>
									<option value="redact" if pd.Config.Strategy == "redact" { selected }>Redact — ████</option>
									<option value="hash" if pd.Config.Strategy == "hash" { selected }>Hash — [PER_a1b2c3]</option>
									<option value="consistent" if pd.Config.Strategy == "consistent" { selected }>Consistent — numérotation stable</option>
								</select>
							</div>
						</div>
					}
				}

				<!-- Filters -->
				@card.Card() {
					@card.Header() {
						@card.Title() { Filtres NER }
					}
					@card.Content() {
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div class="space-y-1">
								@label.Label(label.Props{For: "min_confidence"}) { Confiance minimale (0.0 – 1.0) }
								@input.Input(input.Props{
									ID:          "min_confidence",
									Name:        "min_confidence",
									Type:        "number",
									Value:       formatFloat(pd.Config.MinConfidence),
									Placeholder: "0",
									Attributes:  templ.Attributes{"step": "0.05", "min": "0", "max": "1"},
								})
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "max_tokens"}) { Tokens max par entité (0 = illimité) }
								@input.Input(input.Props{
									ID:          "max_tokens",
									Name:        "max_tokens",
									Type:        "number",
									Value:       formatInt(pd.Config.MaxTokens),
									Placeholder: "0",
									Attributes:  templ.Attributes{"min": "0"},
								})
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "min_runes"}) { Caractères min par entité (0 = illimité) }
								@input.Input(input.Props{
									ID:          "min_runes",
									Name:        "min_runes",
									Type:        "number",
									Value:       formatInt(pd.Config.MinRunes),
									Placeholder: "0",
									Attributes:  templ.Attributes{"min": "0"},
								})
								<p class="text-xs text-muted-foreground">
									Écarte les fragments d'un ou deux signes qu'un texte disloqué (copier-coller de PDF,
									colonnes entrelacées) fait étiqueter à tort comme des entités.
								</p>
							</div>
						</div>
					}
				}

			<!-- Vérification -->
			@card.Card() {
				@card.Header() {
					@card.Title() { Vérification de la sortie }
				}
				@card.Content() {
					<div class="space-y-3">
						@checkboxRow("verification", "Observer les fuites (sans bloquer)", "Mesure les fuites de PII résiduelles sans bloquer la requête. Toute fuite est émise comme événement.", pd.Config.Verification)
						@checkboxRow("verification_strict", "Mode strict — bloque les requêtes sur fuite", "Toute fuite détectée provoque l'échec de l'anonymisation (fail-closed).", pd.Config.VerificationStrict)
					</div>
				}
			}

			<!-- Pièces jointes -->
			@card.Card() {
				@card.Header() {
					@card.Title() { Pièces jointes }
				}
				@card.Content() {
					<div class="space-y-3">
						@checkboxRow("process_attachments", "Traiter les pièces jointes documentaires", "Extrait le texte des documents joints (PDF, DOCX, ODT, CSV/TSV, texte), le pseudonymise et le transmet à la place du fichier. Le fichier d'origine n'est jamais transmis au modèle.", pd.Config.ProcessAttachments)
						<div class="space-y-1">
							@label.Label(label.Props{For: "unsupported_attachments"}) { Pièces jointes non traitables }
							<select
								id="unsupported_attachments"
								name="unsupported_attachments"
								class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
							>
								<option value="block" if pd.Config.UnsupportedAttachments == "block" { selected }>Bloquer — la requête est refusée</option>
								<option value="remove" if pd.Config.UnsupportedAttachments == "remove" { selected }>Retirer — la pièce jointe est écartée, la requête passe</option>
							</select>
							<p class="text-xs text-muted-foreground">
								S'applique aux fichiers dont le contenu ne peut pas être pseudonymisé : image, PDF scanné,
								format inconnu, fichier référencé à distance (identifiant ou URL) ou trop volumineux.
							</p>
						</div>
						<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
							<div class="space-y-1">
								@label.Label(label.Props{For: "max_attachment_bytes"}) { Taille max par fichier (octets, 0 = illimité) }
								@input.Input(input.Props{
									ID:          "max_attachment_bytes",
									Name:        "max_attachment_bytes",
									Type:        "number",
									Value:       formatInt(pd.Config.MaxAttachmentBytes),
									Placeholder: "10485760",
									Attributes:  templ.Attributes{"min": "0"},
								})
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "max_attachment_chars"}) { Caractères max extraits par fichier }
								@input.Input(input.Props{
									ID:          "max_attachment_chars",
									Name:        "max_attachment_chars",
									Type:        "number",
									Value:       formatInt(pd.Config.MaxAttachmentChars),
									Placeholder: "200000",
									Attributes:  templ.Attributes{"min": "0"},
								})
							</div>
						</div>
					</div>
				}
			}

			<!-- Options -->
			@card.Card() {
				@card.Header() {
					@card.Title() { Options }
				}
					@card.Content() {
						<div class="space-y-3">
							@checkboxRow("builtin_regex_patterns", "Patterns regex intégrés", "Détecte EMAIL, IPV4/6, IBAN, SIRET, SIREN, PHONE automatiquement.", pd.Config.BuiltinRegexPatterns)
							@checkboxRow("builtin_secret_patterns", "Patterns secrets intégrés", "Détecte JWT, clés API (OpenAI, AWS, GitHub, Slack…) automatiquement.", pd.Config.BuiltinSecretPatterns)
							@checkboxRow("siren_contextual", "SIREN contextuel", "N'accepte un SIREN que précédé d'un marqueur textuel (« SIREN 123456782 »). Réduit les faux positifs sur les identifiants à neuf chiffres, au prix de quelques oublis. Sans effet si les patterns regex intégrés sont désactivés.", pd.Config.SirenContextual)
							@checkboxRow("first_name_reclassify", "Reclassification des prénoms", "Reclasse les entités LOC d'un seul token en PER si le token est un prénom connu.", pd.Config.FirstNameReclassify)
							@checkboxRow("merge", "Fusion des entités adjacentes", "Fusionne les entités adjacentes de même type (prénom + nom de famille).", pd.Config.Merge)
							@checkboxRow("name_completion", "Complétion des noms", "Complète les entités PER partielles avec le token de nom de famille adjacent.", pd.Config.NameCompletion)
							@checkboxRow("inject_instruction", "Instruction de préservation des jetons", "Ajoute une instruction système (dans la langue détectée) demandant au LLM de recopier les jetons de substitution sans les modifier. Ignoré pour la stratégie « redact ».", pd.Config.InjectInstruction)
						</div>
					}
				}

				<!-- Model store -->
				@card.Card() {
					@card.Header() {
						@card.Title() { Stockage des modèles }
					}
					@card.Content() {
						<div class="space-y-3">
							<div class="space-y-1">
								@label.Label(label.Props{For: "cache_dir"}) { Répertoire de cache }
								@input.Input(input.Props{
									ID:          "cache_dir",
									Name:        "cache_dir",
									Value:       pd.Config.CacheDir,
									Placeholder: "Défaut : répertoire cache système",
								})
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "manifest_url"}) { URL du manifest }
								@input.Input(input.Props{
									ID:          "manifest_url",
									Name:        "manifest_url",
									Value:       pd.Config.ManifestURL,
									Placeholder: "Défaut : dépôt officiel go-anon",
								})
							</div>
							@checkboxRow("offline", "Mode hors-ligne", "Désactive les téléchargements réseau. Nécessite des modèles déjà en cache.", pd.Config.Offline)
						</div>
					}
				}

				<!-- Save -->
				<div class="flex justify-end">
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Sauvegarder
					}
				</div>
			</form>

			<!-- Sécurité -->
			@card.Card() {
				@card.Header() {
					@card.Title() { Clé HMAC (stratégie hash) }
				}
				@card.Content() {
					if pd.NodeID == "" {
						<p class="text-sm text-muted-foreground italic">
							Contexte de nœud absent — la clé HMAC ne peut pas être gérée depuis cette UI.
						</p>
					} else {
						<form method="POST" action="/api/secrets/hash_key" class="space-y-3">
							<div class="space-y-1">
								@label.Label(label.Props{For: "hash_key"}) { Clé HMAC }
								@input.Input(input.Props{
									ID:          "hash_key",
									Name:        "hash_key",
									Type:        input.TypePassword,
									Placeholder: hashKeyPlaceholder(pd.HasHashKey),
								})
								<p class="text-xs text-muted-foreground">
									if pd.HasHashKey {
										Une clé est déjà configurée pour ce nœud. Laisser vide pour la conserver.
									} else {
										Hex ou base64, ≥ 32 octets. Stockée séparément de la configuration.
									}
								</p>
							</div>
							<div class="flex justify-end">
								@button.Button(button.Props{Type: button.TypeSubmit}) {
									Enregistrer la clé
								}
							</div>
						</form>
						if pd.HasHashKey {
							<form method="POST" action="/api/secrets/hash_key/delete" class="flex justify-end">
								@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeSubmit}) {
									Supprimer la clé
								}
							</form>
						}
					}
				}
			}
		</body>
	</html>
}

templ modelStatusBadge(ms modelStatusEntry) {
	if ms.Cached {
		@badge.Badge(badge.Props{}) {
			✓ { ms.Lang }
		}
	} else {
		@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
			○ { ms.Lang }
		}
	}
}

templ checkboxRow(name, title, description string, checked bool) {
	<div class="flex items-start gap-3">
		<div class="mt-0.5">
			@checkbox.Checkbox(checkbox.Props{ID: name, Name: name, Checked: checked})
		</div>
		<div class="space-y-0.5">
			@label.Label(label.Props{For: name}) { { title } }
			<p class="text-xs text-muted-foreground">{ description }</p>
		</div>
	</div>
}
