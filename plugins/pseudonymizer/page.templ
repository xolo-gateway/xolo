package main

import (
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/alert"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/badge"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/card"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/checkbox"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/input"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/label"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/radio"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

// page renders the pseudonymizer plugin configuration UI, in the narrow panel
// of the pipeline editor. The essentials come first; the fine tuning sits in a
// closed "advanced" section. Fields that only concern one engine or one
// strategy follow the choice on the page itself, through CSS (:has), before
// anything is saved.
templ page(pd uiPageData) {
	<!DOCTYPE html>
	<html class="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<base href={ pd.BasePath }/>
			<link rel="stylesheet" href="/assets/templui.css"/>
		</head>
		<body class="bg-background text-foreground min-h-screen">
			<form id="config-form" method="POST" action="api/config" class="group/form space-y-4 p-4">
				<div class="space-y-1">
					<h1 class="text-lg font-semibold">{ i18n.T(ctx, "plugin.pseudonymizer.title") }</h1>
					<p class="text-sm text-muted-foreground">{ i18n.T(ctx, "plugin.pseudonymizer.intro") }</p>
				</div>
				if pd.Success {
					@alert.Alert(alert.Props{Variant: alert.VariantDefault}) {
						@alert.Description() {
							{ i18n.T(ctx, "plugin.pseudonymizer.saved") }
						}
					}
				}
				if pd.Error != "" {
					@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
						@alert.Description() {
							{ pd.Error }
						}
					}
				}
				<!-- Moteur -->
				@card.Card() {
					@card.Header() {
						@card.Title() { { i18n.T(ctx, "plugin.pseudonymizer.engine.title") } }
					}
					@card.Content() {
						<div class="space-y-4">
							<div class="space-y-2">
								@choice("engine", "crf", pd.Config.Engine != engineIndecis, i18n.T(ctx, "plugin.pseudonymizer.engine.crf.label"), i18n.T(ctx, "plugin.pseudonymizer.engine.crf.help"))
								@choice("engine", "indecis", pd.Config.Engine == engineIndecis, i18n.T(ctx, "plugin.pseudonymizer.engine.indecis.label"), i18n.T(ctx, "plugin.pseudonymizer.engine.indecis.help"))
							</div>
							<div class={ "space-y-1", crfOnly }>
								if len(pd.ModelStatus) == 0 {
									<p class="text-xs text-muted-foreground italic">{ i18n.T(ctx, "plugin.pseudonymizer.models.unavailable") }</p>
								} else {
									<div class="flex flex-wrap gap-2">
										for _, ms := range pd.ModelStatus {
											@modelStatusBadge(ms)
										}
									</div>
									<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "plugin.pseudonymizer.models.download_hint") }</p>
								}
							</div>
							<div class={ "space-y-1", indecisOnly }>
								<div class="flex flex-wrap items-center gap-2">
									<span class="text-xs font-medium">{ pd.Indecis.Name }</span>
									@indecisStatusBadge(pd.Indecis)
								</div>
								if !pd.Indecis.Local {
									<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "plugin.pseudonymizer.models.indecis_hint") }</p>
								}
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "language"}) { { i18n.T(ctx, "plugin.pseudonymizer.language.label") } }
								@nativeSelect("language") {
									<option value="auto" if pd.Config.Language == LanguageAuto { selected }>{ i18n.T(ctx, "plugin.pseudonymizer.language.auto") }</option>
									for _, lang := range pd.Languages {
										<option value={ lang } if pd.Config.Language == lang { selected }>{ languageLabel(lang) }</option>
									}
								}
								<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "plugin.pseudonymizer.language.help") }</p>
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "fallback_language"}) { { i18n.T(ctx, "plugin.pseudonymizer.fallback_language.label") } }
								@nativeSelect("fallback_language") {
									for _, lang := range pd.Languages {
										<option value={ lang } if pd.Config.FallbackLanguage == lang { selected }>{ languageLabel(lang) }</option>
									}
								}
								<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "plugin.pseudonymizer.fallback_language.help") }</p>
							</div>
						</div>
					}
				}
				<!-- Ce qui est masqué -->
				@card.Card() {
					@card.Header() {
						@card.Title() { { i18n.T(ctx, "plugin.pseudonymizer.types.title") } }
						@card.Description() { { i18n.T(ctx, "plugin.pseudonymizer.types.help") } }
					}
					@card.Content() {
						<div class="space-y-4">
							for _, group := range pageTypeGroups {
								<fieldset class="space-y-2">
									<legend class="text-xs font-medium uppercase tracking-wide text-muted-foreground mb-2">{ typeGroupTitle(ctx, group.Key) }</legend>
									<div class="grid grid-cols-2 gap-x-4 gap-y-2">
										for _, t := range group.Types {
											<input type="hidden" name="types_shown" value={ string(t.Type) }/>
											<div class={ "flex items-start gap-2", templ.KV(indecisOnly, t.IndecisOnly) }>
												<div class="mt-0.5">
													@checkbox.Checkbox(checkbox.Props{ID: "type_" + string(t.Type), Name: "types", Value: string(t.Type), Checked: typeChecked(pd.Config, group.Key, t.Type)})
												</div>
												@label.Label(label.Props{For: "type_" + string(t.Type), Class: "font-normal leading-snug"}) {
													{ i18n.T(ctx, "plugin.pseudonymizer.type." + string(t.Type)) }
													<span class="block text-xs text-muted-foreground">{ string(t.Type) }</span>
												}
											</div>
										}
									</div>
								</fieldset>
							}
							<div class={ "space-y-1", indecisOnly }>
								@label.Label(label.Props{For: "bias"}) { { i18n.T(ctx, "plugin.pseudonymizer.bias.label") } }
								@input.Input(input.Props{
									ID:         "bias",
									Name:       "bias",
									Type:       "number",
									Value:      formatBias(pd.Config.Bias),
									Attributes: templ.Attributes{"step": "0.5", "min": "0", "max": "10", "required": "required"},
								})
								<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "plugin.pseudonymizer.bias.help") }</p>
							</div>
						</div>
					}
				}
				<!-- Remplacement -->
				@card.Card() {
					@card.Header() {
						@card.Title() { { i18n.T(ctx, "plugin.pseudonymizer.strategy.title") } }
					}
					@card.Content() {
						<div class="space-y-4">
							<div class="space-y-2">
								@choiceExample("strategy", "tag", pd.Config.Strategy != "hash" && pd.Config.Strategy != "redact", i18n.T(ctx, "plugin.pseudonymizer.strategy.tag.label"), "⟦PERSON_1_a1b2c3⟧", i18n.T(ctx, "plugin.pseudonymizer.strategy.tag.help"))
								@choiceExample("strategy", "hash", pd.Config.Strategy == "hash", i18n.T(ctx, "plugin.pseudonymizer.strategy.hash.label"), "⟦PER_3f2a9c1d8b7e6a50⟧", i18n.T(ctx, "plugin.pseudonymizer.strategy.hash.help"))
								@choiceExample("strategy", "redact", pd.Config.Strategy == "redact", i18n.T(ctx, "plugin.pseudonymizer.strategy.redact.label"), "████████", i18n.T(ctx, "plugin.pseudonymizer.strategy.redact.help"))
							</div>
							<div class={ "space-y-2 rounded-md border border-border p-3", hashOnly }>
								@hashKeyFields(pd)
							</div>
							<div class={ notRedact }>
								@checkboxRow("inject_instruction", i18n.T(ctx, "plugin.pseudonymizer.inject_instruction.label"), i18n.T(ctx, "plugin.pseudonymizer.inject_instruction.help"), pd.Config.InjectInstruction)
							</div>
						</div>
					}
				}
				<!-- En cas de fuite -->
				@card.Card() {
					@card.Header() {
						@card.Title() { { i18n.T(ctx, "plugin.pseudonymizer.leak.title") } }
						@card.Description() { { i18n.T(ctx, "plugin.pseudonymizer.leak.help") } }
					}
					@card.Content() {
						<div class="space-y-2">
							@choice("leak", "off", verificationMode(pd.Config) == verifyNone, i18n.T(ctx, "plugin.pseudonymizer.leak.off.label"), i18n.T(ctx, "plugin.pseudonymizer.leak.off.help"))
							@choice("leak", "report", verificationMode(pd.Config) == verifyObserve, i18n.T(ctx, "plugin.pseudonymizer.leak.report.label"), i18n.T(ctx, "plugin.pseudonymizer.leak.report.help"))
							@choice("leak", "block", verificationMode(pd.Config) == verifyBlock, i18n.T(ctx, "plugin.pseudonymizer.leak.block.label"), i18n.T(ctx, "plugin.pseudonymizer.leak.block.help"))
						</div>
					}
				}
				<!-- Pièces jointes -->
				@card.Card() {
					@card.Header() {
						@card.Title() { { i18n.T(ctx, "plugin.pseudonymizer.attachments.title") } }
					}
					@card.Content() {
						<div class="space-y-4">
							@checkboxRow("process_attachments", i18n.T(ctx, "plugin.pseudonymizer.process_attachments.label"), i18n.T(ctx, "plugin.pseudonymizer.process_attachments.help"), pd.Config.ProcessAttachments)
							<div class="space-y-1">
								@label.Label(label.Props{For: "unsupported_attachments"}) { { i18n.T(ctx, "plugin.pseudonymizer.unsupported_attachments.label") } }
								@nativeSelect("unsupported_attachments") {
									<option value="block" if pd.Config.UnsupportedAttachments == "block" { selected }>{ i18n.T(ctx, "plugin.pseudonymizer.unsupported_attachments.block") }</option>
									<option value="remove" if pd.Config.UnsupportedAttachments == "remove" { selected }>{ i18n.T(ctx, "plugin.pseudonymizer.unsupported_attachments.remove") }</option>
								}
								<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "plugin.pseudonymizer.unsupported_attachments.help") }</p>
							</div>
							<div class="grid grid-cols-2 gap-4">
								@numberField("max_attachment_bytes", i18n.T(ctx, "plugin.pseudonymizer.max_attachment_bytes.label"), formatInt(pd.Config.MaxAttachmentBytes), "10485760", "", "")
								@numberField("max_attachment_chars", i18n.T(ctx, "plugin.pseudonymizer.max_attachment_chars.label"), formatInt(pd.Config.MaxAttachmentChars), "200000", "", "")
							</div>
						</div>
					}
				}
				<!-- Réglages avancés -->
				<details class="group/advanced rounded-xl border border-border bg-card">
					<summary class="flex cursor-pointer list-none items-center justify-between px-6 py-4 text-sm font-semibold">
						{ i18n.T(ctx, "plugin.pseudonymizer.advanced.title") }
						<span class="text-muted-foreground transition-transform group-open/advanced:rotate-90">›</span>
					</summary>
					<div class="space-y-6 px-6 pb-6">
						<div class="space-y-4">
							<div class="grid grid-cols-2 gap-4">
								@numberField("min_confidence", i18n.T(ctx, "plugin.pseudonymizer.min_confidence.label"), formatFloat(pd.Config.MinConfidence), "0", "0.05", "1")
								@numberField("max_tokens", i18n.T(ctx, "plugin.pseudonymizer.max_tokens.label"), formatInt(pd.Config.MaxTokens), "0", "", "")
								@numberField("min_runes", i18n.T(ctx, "plugin.pseudonymizer.min_runes.label"), formatInt(pd.Config.MinRunes), "0", "", "")
							</div>
							<p class="text-xs text-muted-foreground">{ i18n.T(ctx, "plugin.pseudonymizer.advanced.filters_help") }</p>
							@checkboxRow("siren_contextual", i18n.T(ctx, "plugin.pseudonymizer.siren_contextual.label"), i18n.T(ctx, "plugin.pseudonymizer.siren_contextual.help"), pd.Config.SirenContextual)
							<div class={ "space-y-4", crfOnly }>
								@checkboxRow("first_name_reclassify", i18n.T(ctx, "plugin.pseudonymizer.first_name_reclassify.label"), i18n.T(ctx, "plugin.pseudonymizer.first_name_reclassify.help"), pd.Config.FirstNameReclassify)
								@checkboxRow("merge", i18n.T(ctx, "plugin.pseudonymizer.merge.label"), i18n.T(ctx, "plugin.pseudonymizer.merge.help"), pd.Config.Merge)
								@checkboxRow("name_completion", i18n.T(ctx, "plugin.pseudonymizer.name_completion.label"), i18n.T(ctx, "plugin.pseudonymizer.name_completion.help"), pd.Config.NameCompletion)
							</div>
						</div>
						<div class="space-y-4">
							<h2 class="text-xs font-medium uppercase tracking-wide text-muted-foreground">{ i18n.T(ctx, "plugin.pseudonymizer.store.title") }</h2>
							@textField("cache_dir", i18n.T(ctx, "plugin.pseudonymizer.cache_dir.label"), pd.Config.CacheDir, i18n.T(ctx, "plugin.pseudonymizer.cache_dir.placeholder"), "")
							@textField("manifest_url", i18n.T(ctx, "plugin.pseudonymizer.manifest_url.label"), pd.Config.ManifestURL, i18n.T(ctx, "plugin.pseudonymizer.manifest_url.placeholder"), crfOnly)
							@textField("model_url", i18n.T(ctx, "plugin.pseudonymizer.model_url.label"), pd.Config.ModelURL, i18n.T(ctx, "plugin.pseudonymizer.model_url.placeholder"), indecisOnly)
							@textField("model_dir", i18n.T(ctx, "plugin.pseudonymizer.model_dir.label"), pd.Config.ModelDir, i18n.T(ctx, "plugin.pseudonymizer.model_dir.placeholder"), indecisOnly)
							@checkboxRow("offline", i18n.T(ctx, "plugin.pseudonymizer.offline.label"), i18n.T(ctx, "plugin.pseudonymizer.offline.help"), pd.Config.Offline)
						</div>
					</div>
				</details>
				<div class="sticky bottom-0 -mx-4 flex justify-end border-t border-border bg-background px-4 py-3">
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						{ i18n.T(ctx, "plugin.pseudonymizer.save") }
					}
				</div>
			</form>
			<!-- The HMAC key is a secret of the node, saved apart from the
			     configuration: its fields sit in the strategy card but belong
			     to these forms. -->
			<form id="hash-key-form" method="POST" action="/api/secrets/hash_key"></form>
			<form id="hash-key-delete-form" method="POST" action="/api/secrets/hash_key/delete"></form>
		</body>
	</html>
}

// The page shows or hides a field according to the choice made on it: the
// engine and strategy radios are inside the form named "form".
const (
	crfOnly     = "group-has-[#engine-indecis:checked]/form:hidden"
	indecisOnly = "group-has-[#engine-crf:checked]/form:hidden"
	hashOnly    = "group-has-[#strategy-tag:checked]/form:hidden group-has-[#strategy-redact:checked]/form:hidden"
	notRedact   = "group-has-[#strategy-redact:checked]/form:hidden"
)

// hashKeyFields manages the HMAC key of the hash strategy, which belongs to the
// node's secrets: its fields submit hash-key-form, not the configuration.
templ hashKeyFields(pd uiPageData) {
	if pd.NodeID == "" {
		<p class="text-xs text-muted-foreground italic">{ i18n.T(ctx, "plugin.pseudonymizer.hash_key.no_node") }</p>
	} else {
		@label.Label(label.Props{For: "hash_key"}) { { i18n.T(ctx, "plugin.pseudonymizer.hash_key.label") } }
		@input.Input(input.Props{
			ID:          "hash_key",
			Name:        "hash_key",
			Type:        input.TypePassword,
			Form:        "hash-key-form",
			Placeholder: hashKeyPlaceholder(pd.HasHashKey),
			PasswordToggleLabel:     i18n.T(ctx, "common.show_password"),
			PasswordToggleHideLabel: i18n.T(ctx, "common.hide_password"),
		})
		<p class="text-xs text-muted-foreground">
			if pd.HasHashKey {
				{ i18n.T(ctx, "plugin.pseudonymizer.hash_key.configured") }
			} else {
				{ i18n.T(ctx, "plugin.pseudonymizer.hash_key.help") }
			}
		</p>
		<div class="flex justify-end gap-2">
			if pd.HasHashKey {
				@button.Button(button.Props{Variant: button.VariantOutline, Type: button.TypeSubmit, Form: "hash-key-delete-form"}) {
					{ i18n.T(ctx, "plugin.pseudonymizer.hash_key.delete") }
				}
			}
			@button.Button(button.Props{Variant: button.VariantSecondary, Type: button.TypeSubmit, Form: "hash-key-form"}) {
				{ i18n.T(ctx, "plugin.pseudonymizer.hash_key.save") }
			}
		</div>
	}
}

// choice is one option of a radio group, as a card the whole of which selects
// it.
templ choice(name, value string, checked bool, title, description string) {
	<label for={ name + "-" + value } class="flex cursor-pointer items-start gap-3 rounded-md border border-border p-3 has-[:checked]:border-primary has-[:checked]:bg-primary/5">
		<div class="mt-0.5">
			@radio.Radio(radio.Props{ID: name + "-" + value, Name: name, Value: value, Checked: checked})
		</div>
		<div class="space-y-0.5">
			<div class="text-sm font-medium">{ title }</div>
			<p class="text-xs text-muted-foreground">{ description }</p>
		</div>
	</label>
}

// choiceExample is a choice that shows what it produces.
templ choiceExample(name, value string, checked bool, title, example, description string) {
	<label for={ name + "-" + value } class="flex cursor-pointer items-start gap-3 rounded-md border border-border p-3 has-[:checked]:border-primary has-[:checked]:bg-primary/5">
		<div class="mt-0.5">
			@radio.Radio(radio.Props{ID: name + "-" + value, Name: name, Value: value, Checked: checked})
		</div>
		<div class="min-w-0 space-y-0.5">
			<div class="flex flex-wrap items-baseline gap-x-2">
				<span class="text-sm font-medium">{ title }</span>
				<code class="text-xs text-muted-foreground break-all">{ example }</code>
			</div>
			<p class="text-xs text-muted-foreground">{ description }</p>
		</div>
	</label>
}

// nativeSelect is a native select: the page loads no script, and the templui
// selectbox is a script popover.
templ nativeSelect(name string) {
	<select
		id={ name }
		name={ name }
		class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-xs focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring"
	>
		{ children... }
	</select>
}

// numberField is a labelled number input; step and max are optional.
templ numberField(name, title, value, placeholder, step, max string) {
	<div class="space-y-1">
		@label.Label(label.Props{For: name}) { { title } }
		@input.Input(input.Props{
			ID:          name,
			Name:        name,
			Type:        "number",
			Value:       value,
			Placeholder: placeholder,
			Attributes:  numberAttributes(step, max),
		})
	</div>
}

// textField is a labelled text input, in a block of the given class.
templ textField(name, title, value, placeholder, class string) {
	<div class={ "space-y-1", class }>
		@label.Label(label.Props{For: name}) { { title } }
		@input.Input(input.Props{ID: name, Name: name, Value: value, Placeholder: placeholder})
	</div>
}

templ modelStatusBadge(ms modelStatusEntry) {
	if ms.Cached {
		@badge.Badge(badge.Props{}) {
			✓ { ms.Lang }
		}
	} else {
		@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
			○ { ms.Lang }
		}
	}
}

templ indecisStatusBadge(ms indecisStatus) {
	if ms.Local {
		@badge.Badge(badge.Props{}) {
			{ i18n.T(ctx, "plugin.pseudonymizer.models.local") }
		}
	} else if ms.Cached {
		@badge.Badge(badge.Props{}) {
			✓ { i18n.T(ctx, "plugin.pseudonymizer.models.cached") }
		}
	} else {
		@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
			○ { i18n.T(ctx, "plugin.pseudonymizer.models.missing") }
		}
	}
}

templ checkboxRow(name, title, description string, checked bool) {
	<div class="flex items-start gap-3">
		<div class="mt-0.5">
			@checkbox.Checkbox(checkbox.Props{ID: name, Name: name, Checked: checked})
		</div>
		<div class="space-y-0.5">
			@label.Label(label.Props{For: name}) { { title } }
			<p class="text-xs text-muted-foreground">{ description }</p>
		</div>
	</div>
}
