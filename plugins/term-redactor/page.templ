package main

import (
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/alert"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/card"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/input"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/label"
)

// page renders the term-redactor plugin configuration UI.
templ page(pd uiPageData) {
	<!DOCTYPE html>
	<html class="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<base href={ pd.BasePath }/>
			<link rel="stylesheet" href="/assets/templui.css"/>
		</head>
		<body class="bg-background text-foreground min-h-screen p-4 space-y-4">
			<h1 class="text-lg font-semibold">Masquage de termes externes</h1>
			<p class="text-sm text-muted-foreground">
				Récupère une liste de termes (noms de clients, de patrimoine...) depuis
				une API externe et les remplace par un jeton réversible avant que la
				requête n'atteigne le LLM. Placez ce nœud avant le pseudonymiseur dans
				le pipeline pour qu'il ne re-détecte pas ces jetons comme des entités.
			</p>

			if pd.Success {
				@alert.Alert(alert.Props{Variant: alert.VariantDefault}) {
					@alert.Description() {
						Configuration sauvegardée avec succès.
					}
				}
			}

			<form id="main-form" method="POST" action="api/config" class="space-y-6">
				<input type="hidden" name="nodeId" value={ pd.NodeID }/>
				@card.Card() {
					@card.Header() {
						@card.Title() { Source des termes }
					}
					@card.Content() {
						<div class="space-y-4">
							<div class="space-y-1">
								@label.Label(label.Props{For: "api_url"}) { URL de l'API des termes }
								@input.Input(input.Props{
									ID:          "api_url",
									Name:        "api_url",
									Value:       pd.Config.APIURL,
									Placeholder: "https://exemple.tld/api/termes",
								})
								<p class="text-xs text-muted-foreground">
									Doit renvoyer un tableau JSON d'objets avec les champs uuid, name et, optionnellement, category.
								</p>
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "api_auth_header_name"}) { Nom de l'en-tête d'authentification }
								@input.Input(input.Props{
									ID:          "api_auth_header_name",
									Name:        "api_auth_header_name",
									Value:       pd.Config.APIAuthHeaderName,
									Placeholder: "Authorization",
								})
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "api_auth_value"}) { Valeur d'authentification }
								@input.Input(input.Props{
									ID:          "api_auth_value",
									Name:        "api_auth_value",
									Type:        input.TypePassword,
									Placeholder: apiAuthValuePlaceholder(pd.HasAPIAuthValue),
								})
								<p class="text-xs text-muted-foreground">
									if pd.HasAPIAuthValue {
										Une valeur est déjà configurée pour ce nœud. Laisser vide pour la conserver.
									} else {
										ex: jeton Bearer. Stockée séparément, jamais affichée. Laisser vide si l'API ne requiert pas d'authentification.
									}
								</p>
							</div>
						</div>
					}
				}

				@card.Card() {
					@card.Header() {
						@card.Title() { Cache et résilience }
					}
					@card.Content() {
						<div class="space-y-4">
							<div class="space-y-1">
								@label.Label(label.Props{For: "cache_ttl_seconds"}) { Durée de vie du cache (secondes) }
								@input.Input(input.Props{
									ID:          "cache_ttl_seconds",
									Name:        "cache_ttl_seconds",
									Type:        input.TypeNumber,
									Value:       zeroAsEmpty(pd.Config.CacheTTLSeconds),
									Placeholder: "600",
								})
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "http_timeout_seconds"}) { Timeout HTTP (secondes) }
								@input.Input(input.Props{
									ID:          "http_timeout_seconds",
									Name:        "http_timeout_seconds",
									Type:        input.TypeNumber,
									Value:       zeroAsEmpty(pd.Config.HTTPTimeoutSeconds),
									Placeholder: "5",
								})
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "min_retry_interval_seconds"}) { Intervalle minimal entre tentatives (secondes) }
								@input.Input(input.Props{
									ID:          "min_retry_interval_seconds",
									Name:        "min_retry_interval_seconds",
									Type:        input.TypeNumber,
									Value:       zeroAsEmpty(pd.Config.MinRetryIntervalSeconds),
									Placeholder: "10",
								})
								<p class="text-xs text-muted-foreground">
									Évite de solliciter l'API à chaque requête pendant une panne. En cas
									d'échec, la dernière liste connue continue d'être utilisée ; si aucune
									liste n'a jamais pu être récupérée, la requête passe sans masquage.
								</p>
							</div>
						</div>
					}
				}

				@card.Card() {
					@card.Header() {
						@card.Title() { Jetons de remplacement }
					}
					@card.Content() {
						<div class="space-y-4">
							<div class="space-y-1">
								@label.Label(label.Props{For: "token_hex_length"}) { Longueur du jeton (caractères) }
								@input.Input(input.Props{
									ID:          "token_hex_length",
									Name:        "token_hex_length",
									Type:        input.TypeNumber,
									Value:       zeroAsEmpty(pd.Config.TokenHexLength),
									Placeholder: "8",
								})
								<p class="text-xs text-muted-foreground">
									Allongée automatiquement en cas de collision entre deux termes.
								</p>
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "token_prefix_fallback"}) { Préfixe par défaut du jeton }
								@input.Input(input.Props{
									ID:          "token_prefix_fallback",
									Name:        "token_prefix_fallback",
									Value:       pd.Config.TokenPrefixFallback,
									Placeholder: "ENTITY",
								})
								<p class="text-xs text-muted-foreground">
									Utilisé quand une entrée de l'API n'a pas de category (ex: sans elle,
									pas de distinction [CLIENT_...] / [PATRIMOINE_...]).
								</p>
							</div>
						</div>
					}
				}

				<div class="flex justify-end">
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Sauvegarder
					}
				</div>
			</form>
		</body>
	</html>
}
