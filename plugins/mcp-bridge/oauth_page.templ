package main

import (
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/alert"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/card"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

// connectPage lets a user authorize Xolo on an MCP server.
templ connectPage(pd connectPageData) {
	<!DOCTYPE html>
	<html class="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<base href={ pd.BasePath }/>
			<link rel="stylesheet" href="/assets/templui.css"/>
		</head>
		<body class="bg-background text-foreground min-h-screen p-4 space-y-4">
			<h1 class="text-lg font-semibold">{ i18n.T(ctx, "plugin.mcp_bridge.connect.title") }</h1>
			if pd.Error != "" {
				@alert.Alert(alert.Props{Variant: alert.VariantDestructive}) {
					@alert.Description() {
						{ pd.Error }
					}
				}
			} else if pd.Done {
				@alert.Alert(alert.Props{Variant: alert.VariantDefault}) {
					@alert.Description() {
						{ i18n.T(ctx, "plugin.mcp_bridge.connect.done", pd.Host) }
					}
				}
			} else {
				<form method="POST" action="connect" class="space-y-4">
					<input type="hidden" name="nodeId" value={ pd.NodeID }/>
					<input type="hidden" name="endpoint" value={ pd.Endpoint }/>
					@card.Card() {
						@card.Content() {
							<p class="text-sm pt-6">
								{ i18n.T(ctx, "plugin.mcp_bridge.connect.request_before") }
								<strong>{ pd.Host }</strong>
								{ i18n.T(ctx, "plugin.mcp_bridge.connect.request_after", pd.Endpoint) }
							</p>
							<p class="text-xs text-muted-foreground pt-2">
								{ i18n.T(ctx, "plugin.mcp_bridge.connect.warning") }
							</p>
						}
					}
					<div class="flex justify-end">
						@button.Button(button.Props{Type: button.TypeSubmit}) {
							{ i18n.T(ctx, "plugin.mcp_bridge.connect.submit") }

						}
					</div>
				</form>
			}
		</body>
	</html>
}
