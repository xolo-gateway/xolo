package main

import (
	"strings"

	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/alert"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/card"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/input"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/label"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/textarea"
)

// page renders the mcp-bridge plugin configuration UI.
templ page(pd uiPageData) {
	<!DOCTYPE html>
	<html class="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<base href={ pd.BasePath }/>
			<link rel="stylesheet" href="/assets/templui.css"/>
		</head>
		<body class="bg-background text-foreground min-h-screen p-4 space-y-4">
			<h1 class="text-lg font-semibold">Serveur MCP (Streamable HTTP)</h1>
			<p class="text-sm text-muted-foreground">
				Les tools exposés par ce serveur seront proposés au LLM. Les appels
				d'outils correspondants sont résolus automatiquement côté serveur et
				ne sont jamais renvoyés au client de l'API.
			</p>

			if pd.Success {
				@alert.Alert(alert.Props{Variant: alert.VariantDefault}) {
					@alert.Description() {
						Configuration sauvegardée avec succès.
					}
				}
			}

			<form id="main-form" method="POST" action="api/config" class="space-y-6">
				<input type="hidden" name="nodeId" value={ pd.NodeID }/>
				@card.Card() {
					@card.Header() {
						@card.Title() { Connexion }
					}
					@card.Content() {
						<div class="space-y-4">
							<div class="space-y-1">
								@label.Label(label.Props{For: "endpoint"}) { URL du serveur MCP }
								@input.Input(input.Props{
									ID:          "endpoint",
									Name:        "endpoint",
									Value:       pd.Config.Endpoint,
									Placeholder: "https://mcp.example.com/mcp",
								})
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "auth_mode"}) { Authentification }
								<select id="auth_mode" name="auth_mode" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm">
									<option value="static" selected?={ pd.Config.AuthMode != "oauth" }>En-tête fixe, commun à tous les utilisateurs</option>
									<option value="oauth" selected?={ pd.Config.AuthMode == "oauth" }>OAuth, chaque utilisateur autorise l'accès en son nom</option>
								</select>
								<p class="text-xs text-muted-foreground">
									En mode OAuth, l'assistant donne à chaque utilisateur un lien pour autoriser
									Xolo lors de sa première demande ; l'en-tête ci-dessous est alors ignoré.
								</p>
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "auth_header_name"}) { Nom de l'en-tête d'authentification }
								@input.Input(input.Props{
									ID:          "auth_header_name",
									Name:        "auth_header_name",
									Value:       pd.Config.AuthHeaderName,
									Placeholder: "Authorization",
								})
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "auth_value"}) { Valeur d'authentification }
								@input.Input(input.Props{
									ID:          "auth_value",
									Name:        "auth_value",
									Type:        input.TypePassword,
									Placeholder: authValuePlaceholder(pd.HasAuthValue),
								})
								<p class="text-xs text-muted-foreground">
									if pd.HasAuthValue {
										Une valeur est déjà configurée pour ce nœud. Laisser vide pour la conserver.
									} else {
										ex: jeton Bearer. Stockée séparément, jamais affichée.
									}
								</p>
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "tool_filter"}) { Tools autorisés (séparés par des virgules) }
								@input.Input(input.Props{
									ID:          "tool_filter",
									Name:        "tool_filter",
									Value:       strings.Join(pd.Config.ToolFilter, ", "),
									Placeholder: "vide = tous les tools exposés",
								})
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "resources"}) { Ressources MCP injectées (URI ou nom, une par ligne) }
								@textarea.Textarea(textarea.Props{
									ID:          "resources",
									Name:        "resources",
									Value:       strings.Join(pd.Config.Resources, "\n"),
									Rows:        3,
									Placeholder: "file:///contexte/procedure.md",
								})
								<p class="text-xs text-muted-foreground">
									Lues à chaque requête et injectées avant le premier appel au modèle.
									Le modèle n'a pas à décider de les consulter.
								</p>
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "prefetch_tool"}) { Tool pré-appelé }
								@input.Input(input.Props{
									ID:          "prefetch_tool",
									Name:        "prefetch_tool",
									Value:       pd.Config.PrefetchTool,
									Placeholder: "vide = le modèle décide seul",
								})
								<p class="text-xs text-muted-foreground">
									Appelé une fois avant le premier appel au modèle, à chaque requête ;
									le résultat est injecté dans la conversation. Doit faire partie des tools autorisés.
								</p>
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "prefetch_arguments"}) { Arguments du tool pré-appelé (JSON) }
								@textarea.Textarea(textarea.Props{
									ID:          "prefetch_arguments",
									Name:        "prefetch_arguments",
									Value:       pd.Config.PrefetchArguments,
									Rows:        3,
									Placeholder: `{"query": "{{last_user_message}}"}`,
								})
								<p class="text-xs text-muted-foreground">
									Valeurs disponibles : &#123;&#123;last_user_message&#125;&#125;, &#123;&#123;user_id&#125;&#125;,
									&#123;&#123;org_id&#125;&#125;, &#123;&#123;display_name&#125;&#125;, &#123;&#123;session_id&#125;&#125;.
									Vide = <code>{}</code>.
								</p>
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "prefetch_label"}) { Titre du bloc injecté }
								@input.Input(input.Props{
									ID:          "prefetch_label",
									Name:        "prefetch_label",
									Value:       pd.Config.PrefetchLabel,
									Placeholder: "vide = pas de titre",
								})
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "prefetch_result_template"}) { Gabarit du résultat pré-appelé }
								@textarea.Textarea(textarea.Props{
									ID:          "prefetch_result_template",
									Name:        "prefetch_result_template",
									Value:       pd.Config.PrefetchResultTemplate,
									Rows:        3,
									Placeholder: "vide = résultat brut",
								})
								<p class="text-xs text-muted-foreground">
									Chaque &#123;&#123;result&#125;&#125; est remplacé par le texte du résultat.
								</p>
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "timeout_seconds"}) { Timeout (secondes) }
								@input.Input(input.Props{
									ID:          "timeout_seconds",
									Name:        "timeout_seconds",
									Type:        input.TypeNumber,
									Value:       zeroAsEmpty(pd.Config.TimeoutSeconds),
									Placeholder: "120",
								})
								<p class="text-xs text-muted-foreground">
									Les outils MCP de type RAG peuvent être lents (recherche +
									génération). Vide = défaut (120s).
								</p>
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "max_consecutive_tool_calls"}) { Appels d'outils consécutifs max. }
								@input.Input(input.Props{
									ID:          "max_consecutive_tool_calls",
									Name:        "max_consecutive_tool_calls",
									Type:        input.TypeNumber,
									Value:       zeroAsEmpty(pd.Config.MaxConsecutiveToolCalls),
									Placeholder: "2",
								})
								<p class="text-xs text-muted-foreground">
									Au-delà, le LLM est forcé de répondre sans appeler d'outil supplémentaire. Vide = défaut (2).
								</p>
							</div>
						</div>
					}
				}

				<div class="flex justify-end">
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						Sauvegarder
					}
				</div>
			</form>
		</body>
	</html>
}
