package main

import (
	"strings"

	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/alert"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/button"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/card"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/input"
	"github.com/xolo-gateway/xolo/internal/http/handler/webui/templui/component/label"
	"github.com/xolo-gateway/xolo/internal/i18n"
)

// page renders the mcp-bridge plugin configuration UI.
templ page(pd uiPageData) {
	<!DOCTYPE html>
	<html class="dark">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<base href={ pd.BasePath }/>
			<link rel="stylesheet" href="/assets/templui.css"/>
		</head>
		<body class="bg-background text-foreground min-h-screen p-4 space-y-4">
			<h1 class="text-lg font-semibold">{ i18n.T(ctx, "plugin.mcp_bridge.title") }</h1>
			<p class="text-sm text-muted-foreground">
				{ i18n.T(ctx, "plugin.mcp_bridge.intro") }
			</p>

			if pd.Success {
				@alert.Alert(alert.Props{Variant: alert.VariantDefault}) {
					@alert.Description() {
						{ i18n.T(ctx, "plugin.mcp_bridge.saved") }
					}
				}
			}

			<form id="main-form" method="POST" action="api/config" class="space-y-6">
				<input type="hidden" name="nodeId" value={ pd.NodeID }/>
				@card.Card() {
					@card.Header() {
						@card.Title() { { i18n.T(ctx, "plugin.mcp_bridge.connection.title") } }
					}
					@card.Content() {
						<div class="space-y-4">
							<div class="space-y-1">
								@label.Label(label.Props{For: "endpoint"}) { { i18n.T(ctx, "plugin.mcp_bridge.endpoint.label") } }
								@input.Input(input.Props{
									ID:          "endpoint",
									Name:        "endpoint",
									Value:       pd.Config.Endpoint,
									Placeholder: "https://mcp.example.com/mcp",
								})
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "auth_mode"}) { { i18n.T(ctx, "plugin.mcp_bridge.auth_mode.label") } }
								<select id="auth_mode" name="auth_mode" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm">
									<option value="static" selected?={ pd.Config.AuthMode != "oauth" }>{ i18n.T(ctx, "plugin.mcp_bridge.auth_mode.static") }</option>
									<option value="oauth" selected?={ pd.Config.AuthMode == "oauth" }>{ i18n.T(ctx, "plugin.mcp_bridge.auth_mode.oauth") }</option>
								</select>
								<p class="text-xs text-muted-foreground">
									{ i18n.T(ctx, "plugin.mcp_bridge.auth_mode.help") }
								</p>
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "auth_header_name"}) { { i18n.T(ctx, "plugin.mcp_bridge.auth_header_name.label") } }
								@input.Input(input.Props{
									ID:          "auth_header_name",
									Name:        "auth_header_name",
									Value:       pd.Config.AuthHeaderName,
									Placeholder: "Authorization",
								})
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "auth_value"}) { { i18n.T(ctx, "plugin.mcp_bridge.auth_value.label") } }
								@input.Input(input.Props{
									ID:          "auth_value",
									Name:        "auth_value",
									Type:        input.TypePassword,
									Placeholder: authValuePlaceholder(pd.HasAuthValue),
								})
								<p class="text-xs text-muted-foreground">
									if pd.HasAuthValue {
										{ i18n.T(ctx, "plugin.mcp_bridge.auth_value.configured") }
									} else {
										{ i18n.T(ctx, "plugin.mcp_bridge.auth_value.help") }
									}
								</p>
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "tool_filter"}) { { i18n.T(ctx, "plugin.mcp_bridge.tool_filter.label") } }
								@input.Input(input.Props{
									ID:          "tool_filter",
									Name:        "tool_filter",
									Value:       strings.Join(pd.Config.ToolFilter, ", "),
									Placeholder: i18n.T(ctx, "plugin.mcp_bridge.tool_filter.placeholder"),
								})
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "timeout_seconds"}) { { i18n.T(ctx, "plugin.mcp_bridge.timeout.label") } }
								@input.Input(input.Props{
									ID:          "timeout_seconds",
									Name:        "timeout_seconds",
									Type:        input.TypeNumber,
									Value:       zeroAsEmpty(pd.Config.TimeoutSeconds),
									Placeholder: "120",
								})
								<p class="text-xs text-muted-foreground">
									{ i18n.T(ctx, "plugin.mcp_bridge.timeout.help") }
								</p>
							</div>
							<div class="space-y-1">
								@label.Label(label.Props{For: "max_consecutive_tool_calls"}) { { i18n.T(ctx, "plugin.mcp_bridge.max_tool_calls.label") } }
								@input.Input(input.Props{
									ID:          "max_consecutive_tool_calls",
									Name:        "max_consecutive_tool_calls",
									Type:        input.TypeNumber,
									Value:       zeroAsEmpty(pd.Config.MaxConsecutiveToolCalls),
									Placeholder: "2",
								})
								<p class="text-xs text-muted-foreground">
									{ i18n.T(ctx, "plugin.mcp_bridge.max_tool_calls.help") }
								</p>
							</div>
						</div>
					}
				}

				<div class="flex justify-end">
					@button.Button(button.Props{Type: button.TypeSubmit}) {
						{ i18n.T(ctx, "plugin.mcp_bridge.save") }

					}
				</div>
			</form>
		</body>
	</html>
}
